@echo off
setlocal
REM ============================================================
REM  check_node_modules.cmd - Guardia pre-arranque de node_modules
REM
REM  Un package.json corrupto (bytes nulos) hace que Turbopack no pueda
REM  resolver el modulo y el arranque falla con "Can't resolve tailwindcss"
REM  o similar, sin apuntar a la causa real. Ya ha pasado en este repo:
REM  un node_modules huerfano en la raiz con 822 paquetes, 226 de ellos
REM  con el package.json relleno de bytes nulos.
REM
REM  HIBRIDO (default):
REM   - Si node o el doctor faltan: [WARN] y continua (exit 0).
REM   - Si se detecta corrupcion: [ERROR] y aborta (exit 1).
REM  MODO /strict (para scripts que exigen node):
REM   - Si node o el doctor faltan: [ERROR] y aborta (exit 1).
REM
REM  Uso: call "%~dp0check_node_modules.cmd" [/strict]
REM  Nota: %~dp0 apunta a scripts\, el doctor vive junto a este .cmd.
REM  Exit codes del doctor: 0 limpio - 1 corrupcion - 2 uso/entorno.
REM ============================================================

set "STRICT="
if /i "%~1"=="/strict" set "STRICT=1"

where node >nul 2>&1
if errorlevel 1 (
    if defined STRICT (
        echo [ERROR] node no encontrado en PATH - necesario para check_node_modules_integrity.mjs.
        exit /b 1
    )
    echo [WARN] node no encontrado en PATH - no se puede validar node_modules. Continuando...
    exit /b 0
)

if not exist "%~dp0check_node_modules_integrity.mjs" (
    if defined STRICT (
        echo [ERROR] Doctor %~dp0check_node_modules_integrity.mjs no encontrado - no se puede validar.
        exit /b 1
    )
    echo [WARN] Doctor %~dp0check_node_modules_integrity.mjs no encontrado - no se puede validar. Continuando...
    exit /b 0
)

REM Se escanean las DOS raices a proposito: la del repo (donde apareció la
REM corrupcion historica) y web/ (donde viven las dependencias reales).
REM Una raiz sin node_modules se salta sola, no es un error.
node "%~dp0check_node_modules_integrity.mjs" --dir "%~dp0.." --dir "%~dp0..\web"
set "DOCTOR_EXIT=%ERRORLEVEL%"

if "%DOCTOR_EXIT%"=="0" (
    echo [OK] node_modules integro.
    exit /b 0
)

if "%DOCTOR_EXIT%"=="1" (
    echo.
    echo [ERROR] node_modules corrupto - el arranque fallaria con errores de
    echo         resolucion de modulos que no apuntan a la causa real.
    echo         Repara con:
    echo             node scripts\check_node_modules_integrity.mjs --delete --yes
    echo         y reinstala las dependencias dentro de web\ con:
    echo             cd web ^&^& npm install
    exit /b 1
)

echo [ERROR] El doctor termino con codigo %DOCTOR_EXIT% inesperado - abortando.
exit /b 1