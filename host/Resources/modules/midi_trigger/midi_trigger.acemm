schemaVersion: "7.2.3"
id: midi_trigger
metadata:
  name: MIDI TRIGGER
  family: midi
  version: 1.0.0
  rack: { hp: 12, height_mode: "1U" }
ui:
  dimensions: { width: 180, height: 140 }
  skin: industrial
  layout:
    containers:
      - id: left
        label: Displays
        pos: { x: 5, y: 5 }
        size: { w: 80, h: 130 }
        variant: inset
      - id: right
        label: Performance
        pos: { x: 90, y: 5 }
        size: { w: 85, h: 130 }
        variant: panel
  controls:
    # --- LEFT CONTAINER: NOTE & OCTAVE ---
    - id: d_note
      bind: note_idx
      pos: { x: 5, y: 15 }
      presentation:
        container: left
        component: display
        variant: oled
        size: { w: 70, h: 36 }
        attachments: [{ type: label, text: "NOTE" }]
    
    - id: d_oct
      bind: octave
      pos: { x: 5, y: 65 }
      presentation:
        container: left
        component: display
        variant: led
        size: { w: 70, h: 36 }
        attachments: [{ type: label, text: "OCTAVE" }]

    # --- RIGHT CONTAINER: TRIG, MIDI OUT & VELOCITY ---
    - id: b_trig
      bind: trigger
      pos: { x: 8, y: 15 }
      presentation:
        container: right
        component: button
        variant: cyan
        size: { w: 34, h: 34 }
        attachments: [{ type: label, text: "TRIG" }]

    - id: port_out
      bind: midi_out
      pos: { x: 10, y: 70 }
      presentation:
        container: right
        component: port
        variant: industrial
        size: { w: 30, h: 30 }
        attachments: [{ type: label, text: "MIDI" }]

    - id: s_vel
      bind: velocity
      pos: { x: 55, y: 15 }
      presentation:
        container: right
        component: slider-v
        variant: industrial
        size: { w: 18, h: 85 }
        attachments: [{ type: label, text: "VEL" }]
resources:
  wasm: midi_trigger.wasm
