{
  "id": "test_parity_v7",
  "schemaVersion": "7.1",
  "metadata": {
    "name": "00-TEST-PARITY",
    "version": "1.0.0",
    "author": "OMEGA Core Team",
    "family": "utility",
    "status": "experimental",
    "tags": ["test", "parity"],
    "description": "Visual Parity Reference Manifest.",
    "rack": { "hp": 24, "slot": "main", "height_mode": "full" }
  },
  "ui": {
    "skin": "industrial",
    "dimensions": { "width": 360, "height": 420 },
    "layout": {
      "containers": [
        { "id": "c_prim", "label": "PRIMITIVES", "pos": { "x": 10, "y": 10 }, "size": { "w": 340, "h": 120 }, "variant": "panel" },
        { "id": "c_att", "label": "ATTACHMENTS", "pos": { "x": 10, "y": 140 }, "size": { "w": 340, "h": 120 }, "variant": "section" }
      ]
    },
    "controls": [
      { "id": "k1", "bind": "k_main", "pos": { "x": 40, "y": 60 }, "presentation": { "component": "knob", "variant": "A_cyan", "container": "c_prim" } },
      { "id": "p1", "bind": "p_in", "pos": { "x": 100, "y": 60 }, "presentation": { "component": "port", "variant": "B_audio", "container": "c_prim" } },
      { 
        "id": "k_att", "bind": "k_main", "pos": { "x": 180, "y": 200 }, 
        "presentation": { 
          "component": "knob", "variant": "B_white", "container": "c_att",
          "attachments": [
            { "type": "label", "text": "TOP", "position": "top" },
            { "type": "label", "text": "BOTTOM", "position": "bottom" }
          ]
        } 
      }
    ]
  }
}
