│                                                                 │
│    ┌─────────┐         ┌─────────┐         ┌─────────┐          │
│    │  LFO    │────────▶│ Filter  │────────▶│ Delay1  │────────┐  │
│    │         │         │         │         │(1sample)│       │  │
│    └─────────┘         └─────────┘         └────┬────┘       │  │
│           ▲                                      │              │  │
│           │         ┌─────────────┐              │              │  │
│           └─────────│ FeedbackOut │◄─────────────┘              │  │
│                     │  (marker)   │                             │  │
│                     └──────┬──────┘                             │  │
│                            │                                    │  │
│                     ┌──────┴──────┐                             │  │
│                     │ FeedbackIn    │─────────────────────────────┘  │
│                     │  (entry point)│                              │
│                     └───────────────┘                               │
│                                                                     │
│  El ciclo se "rompe" en FeedbackIn/Out, Delay1 garantiza 1 sample │
└─────────────────────────────────────────────────────────────────────┘
📐 ESTRUCTURAS DE FEEDBACK
cpp
Copy
// Source/Core/Modulation/FeedbackSystem.h
#pragma once
#include "ModulationGraphTypes.h"

namespace Omega::Core::Modulation {

// ============================================================
// TIPOS DE NODO DE FEEDBACK
// ============================================================

enum class FeedbackNodeRole {
    Entry,      // FeedbackInput: donde el ciclo "entra" al grafo principal
    Exit,       // FeedbackOutput: donde el ciclo "sale" del grafo principal
    Delay,      // Delay1: introduce latencia de 1 sample
    Tap         // FeedbackTap: lectura intermedia del ciclo
};

// Descriptor de path de feedback completo
struct FeedbackPath {
    NodeId entryNode;           // FeedbackInput
    NodeId exitNode;            // FeedbackOutput
    std::vector<NodeId> intermediateNodes;  // Delay1, procesadores, etc.
    std::vector<uint16_t> connectionIds;    // Conexiones que forman el ciclo
    
    // Propiedades calculadas
    int totalLatencySamples = 0;     // Suma de delays en el path
    bool isValid = false;            // Tiene al menos un Delay1?
    SignalType signalType;           // Tipo de señal que circula
    
    // Para UI
    juce::Colour visualColor;      // Color único por path
    juce::String name;               // "Feedback A", "Resonance Loop", etc.
};

// ============================================================
// GESTOR DE FEEDBACK (usa el PIMPL de ModulationGraph)
// ============================================================

class FeedbackManager {
public:
    explicit FeedbackManager(class ModulationGraph::Impl& graph);
    
    // Construcción de paths
    GraphResult<FeedbackPath> createPath(NodeId entry, NodeId exit);
    GraphResult<void> addToPath(NodeId pathEntry, NodeId nodeToAdd);
    GraphResult<void> removeFromPath(NodeId node);
    
    // Validación
    bool validatePath(const FeedbackPath& path) const;
    std::vector<juce::String> getPathErrors(const FeedbackPath& path) const;
    
    // Consulta
    std::vector<FeedbackPath> getAllPaths() const;
    std::optional<FeedbackPath> getPathContaining(NodeId node) const;
    
    // Compilación: modifica el grafo para romper ciclos
    // Retorna el orden de procesamiento con feedback nodes al final
    GraphResult<std::vector<NodeId>> compileWithFeedback(
        const std::vector<NodeId>& topoOrder);
    
    // Para runtime: índices de delay por path
    struct RuntimeFeedbackInfo {
        uint8_t pathIndex;
        uint8_t delayBufferIndex;      // Índice en array de delays globales
        uint8_t entryOutputIndex;      // Dónde escribe el feedback
        uint8_t exitInputIndex;        // Dónde lee el feedback
    };
    
    std::vector<RuntimeFeedbackInfo> buildRuntimeInfo() const;
    
private:
    ModulationGraph::Impl& graph_;
    std::vector<FeedbackPath> paths_;
    
    // Helpers
    bool detectPathCycle(const FeedbackPath& path) const;
    int calculatePathLatency(const FeedbackPath& path) const;
    void assignVisualColors();
};

// ============================================================
// NODO DELAY1 (el único que introduce latencia garantizada)
// ============================================================

class Delay1Node {
public:
    static constexpr int kLatencySamples = 1;
    
    // Procesamiento: output[n] = input[n-1]
    static void process(const float* input, float* output, 
                        int numSamples, float& state) noexcept;
    
    // Estado: solo necesita guardar el último sample del bloque anterior
    struct State {
        float previousSample = 0.0f;
    };
};

} // namespace Omega::Core::Modulation
🔧 IMPLEMENTACIÓN DEL SISTEMA DE FEEDBACK
cpp
Copy
// Source/Core/Modulation/FeedbackManager.cpp

#include "FeedbackManager.h"
#include "ModulationGraphImpl.h"

namespace Omega::Core::Modulation {

// ============================================================
// CREACIÓN DE PATHS DE FEEDBACK
// ============================================================

GraphResult<FeedbackPath> FeedbackManager::createPath(NodeId entry, NodeId exit) {
    auto* entryNode = graph_.findNode(entry);
    auto* exitNode = graph_.findNode(exit);
    
    if (!entryNode || !exitNode) {
        return std::unexpected(GraphError::NodeNotFound);
    }
    
    // Validar tipos de nodo
    if (entryNode->type != NodeType::FeedbackInput) {
        return std::unexpected(GraphError::PortTypeMismatch);  // Error apropiado
    }
    if (exitNode->type != NodeType::FeedbackOutput) {
        return std::unexpected(GraphError::PortTypeMismatch);
    }
    
    FeedbackPath path;
    path.entryNode = entry;
    path.exitNode = exit;
    path.name = "Feedback " + juce::String(paths_.size() + 1);
    
    // Verificar que hay conexión (directa o indirecta) de exit a entry
    // Esto es lo que forma el ciclo
    
    // BFS desde exit para encontrar camino a entry
    std::vector<NodeId> visited;
    std::queue<NodeId> queue;
    queue.push(exit);
    
    std::map<NodeId, NodeId> cameFrom;  // Para reconstruir path
    
    bool found = false;
    while (!queue.empty() && !found) {
        NodeId current = queue.front();
        queue.pop();
        
        auto* node = graph_.findNode(current);
        if (!node) continue;
        
        for (uint16_t connId : node->outgoingConnections) {
            auto* conn = graph_.findConnection(connId);
            if (!conn || conn->isFeedbackConnection) continue;
            
            NodeId next = conn->destNode;
            if (next == entry) {
                found = true;
                cameFrom[next] = current;
                break;
            }
            
            if (std::find(visited.begin(), visited.end(), next) == visited.end()) {
                visited.push_back(next);
                cameFrom[next] = current;
                queue.push(next);
            }
        }
    }
    
    if (!found) {
        return std::unexpected(GraphError::WouldCreateCycle);  // No hay ciclo = no hay feedback
    }
    
    // Reconstruir path de exit a entry
    NodeId current = entry;
    while (current != exit) {
        path.intermediateNodes.insert(path.intermediateNodes.begin(), current);
        current = cameFrom[current];
    }
    
    // Validar que tiene al menos un Delay1
    bool hasDelay = false;
    for (NodeId id : path.intermediateNodes) {
        auto* node = graph_.findNode(id);
        if (node && node->type == NodeType::Delay1) {
            hasDelay = true;
            path.totalLatencySamples += Delay1Node::kLatencySamples;
        }
    }
    
    path.isValid = hasDelay;
    if (!hasDelay) {
        return std::unexpected(GraphError::UnresolvedFeedbackPath);
    }
    
    // Marcar conexiones como feedback
    for (size_t i = 0; i < path.intermediateNodes.size() - 1; ++i) {
        NodeId from = (i == 0) ? exit : path.intermediateNodes[i-1];
        NodeId to = path.intermediateNodes[i];
        
        // Encontrar conexión y marcarla
        auto* fromNode = graph_.findNode(from);
        if (!fromNode) continue;
        
        for (uint16_t connId : fromNode->outgoingConnections) {
            auto* conn = graph_.findConnection(connId);
            if (conn && conn->destNode == to) {
                conn->isFeedbackConnection = true;
                path.connectionIds.push_back(connId);
            }
        }
    }
    
    // Marcar nodos
    entryNode->isInFeedbackPath = true;
    exitNode->isInFeedbackPath = true;
    for (NodeId id : path.intermediateNodes) {
        auto* node = graph_.findNode(id);
        if (node) node->isInFeedbackPath = true;
    }
    
    assignVisualColors();
    paths_.push_back(path);
    
    return path;
}

// ============================================================
// COMPILACIÓN CON FEEDBACK
// ============================================================

GraphResult<std::vector<NodeId>> FeedbackManager::compileWithFeedback(
    const std::vector<NodeId>& topoOrder) 
{
    // Separar nodos en: main graph vs feedback paths
    
    std::set<NodeId> feedbackNodes;
    for (const auto& path : paths_) {
        feedbackNodes.insert(path.entryNode);
        feedbackNodes.insert(path.exitNode);
        feedbackNodes.insert(path.intermediateNodes.begin(), 
                            path.intermediateNodes.end());
    }
    
    // Orden: primero el grafo principal (sin nodos de feedback)
    std::vector<NodeId> finalOrder;
    for (NodeId id : topoOrder) {
        if (!feedbackNodes.count(id)) {
            finalOrder.push_back(id);
        }
    }
    
    // Luego los feedback paths, en orden de latencia (menor primero)
    std::vector<std::pair<int, FeedbackPath>> sortedPaths;
    for (const auto& path : paths_) {
        sortedPaths.push_back({path.totalLatencySamples, path});
    }
    std::sort(sortedPaths.begin(), sortedPaths.end());
    
    for (const auto& [latency, path] : sortedPaths) {
        // Orden dentro del path: desde exit (output) hasta entry (input)
        // Pero con delays procesados en el orden correcto
        
        // Exit primero (genera señal que entra al ciclo)
        finalOrder.push_back(path.exitNode);
        
        // Nodos intermedios en orden de procesamiento
        for (NodeId id : path.intermediateNodes) {
            finalOrder.push_back(id);
        }
        
        // Entry al final (consume el feedback para el siguiente bloque)
        finalOrder.push_back(path.entryNode);
    }
    
    return finalOrder;
}

// ============================================================
// RUNTIME: PROCESAMIENTO DE FEEDBACK
// ============================================================

std::vector<FeedbackManager::RuntimeFeedbackInfo> 
FeedbackManager::buildRuntimeInfo() const 
{
    std::vector<RuntimeFeedbackInfo> info;
    
    for (size_t i = 0; i < paths_.size(); ++i) {
        const auto& path = paths_[i];
        
        RuntimeFeedbackInfo rt;
        rt.pathIndex = static_cast<uint8_t>(i);
        
        // El delay buffer se asigna en runtime global
        rt.delayBufferIndex = static_cast<uint8_t>(i);  // Uno por path
        
        // Índices de señal: se resuelven durante compilación del grafo
        // Estos son placeholders, se rellenan en ModulationRuntime::compileFromGraph
        
        info.push_back(rt);
    }
    
    return info;
}

// ============================================================
// DELAY1: IMPLEMENTACIÓN DE PROCESAMIENTO
// ============================================================

void Delay1Node::process(const float* input, float* output,
                          int numSamples, float& state) noexcept 
{
    // state = último sample del bloque anterior
    
    if (numSamples == 0) return;
    
    // Primer sample: state del bloque anterior
    output[0] = state;
    
    // Resto: shift de 1 sample
    for (int i = 1; i < numSamples; ++i) {
        output[i] = input[i-1];
    }
    
    // Guardar último sample para siguiente bloque
    state = input[numSamples - 1];
}

} // namespace Omega::Core::Modulation
🎨 VISUALIZACIÓN EN UI
cpp
Copy
// Source/UI/Components/ModulationGraphEditor.cpp (extracto)

void ModulationGraphEditor::paintFeedbackPaths(Graphics& g) {
    for (const auto& path : feedbackManager_.getAllPaths()) {
        // Color único por path
        g.setColour(path.visualColor.withAlpha(0.3f));
        
        // Dibujar "glow" alrededor del path
        Path outline;
        bool first = true;
        
        // Desde exit a entry, pasando por intermedios
        std::vector<NodeId> drawOrder;
        drawOrder.push_back(path.exitNode);
        drawOrder.insert(drawOrder.end(), 
                        path.intermediateNodes.begin(), 
                        path.intermediateNodes.end());
        drawOrder.push_back(path.entryNode);
        
        for (NodeId id : drawOrder) {
            auto pos = getNodePosition(id);
            if (first) {
                outline.startNewSubPath(pos.x, pos.y);
                first = false;
            } else {
                outline.lineTo(pos.x, pos.y);
            }
        }
        
        // Stroke grueso con blur
        g.strokePath(outline, PathStrokeType(8.0f, 
                     PathStrokeType::JointStyle::curved,
                     PathStrokeType::EndCapStyle::rounded));
        
        // Indicador de delay
        for (NodeId id : path.intermediateNodes) {
            auto* node = graph_.findNode(id);
            if (node && node->type == NodeType::Delay1) {
                auto pos = getNodePosition(id);
                g.setColour(Colours::white);
                g.drawText("1s", pos.x - 10, pos.y - 10, 20, 20, 
                          Justification::centred);
            }
        }
    }
}

void ModulationGraphEditor::drawConnection(Graphics& g, 
                                            const InternalConnection& conn) {
    auto start = getOutputPosition(conn.sourceNode, conn.sourcePortIndex);
    auto end = getInputPosition(conn.destNode, conn.destPortIndex);
    
    // Color según tipo y si es feedback
    Colour color;
    if (conn.isFeedbackConnection) {
        auto path = feedbackManager_.getPathContaining(conn.destNode);
        color = path ? path->visualColor : Colours::red;
    } else {
        color = getColorForSignalType(getSignalType(conn));
    }
    
    // Línea con curva de Bezier
    Path line;
    line.startNewSubPath(start);
    
    float midX = (start.x + end.x) * 0.5f;
    line.cubicTo(midX, start.y, midX, end.y, end.x, end.y);
    
    // Feedback: línea punteada o animada
    if (conn.isFeedbackConnection) {
        float dashLength = 5.0f + 2.0f * std::sin(animationPhase_);
        g.setColour(color);
        g.drawDashedLine(line, &dashLength, 1, 2.0f);
    } else {
        g.setColour(color);
        g.strokePath(line, PathStrokeType(2.0f));
    }
}
🔄 EJEMPLO COMPLETO: Resonator con Feedback
cpp
Copy
// Construcción de un filtro resonante con feedback positivo

auto graph = std::make_unique<ModulationGraph>();

// Nodos principales
auto osc = graph->addNode(NodeType::Oscillator, "Carrier").value();
auto filter = graph->addNode(NodeType::StateVariableFilter, "Resonant").value();
auto output = graph->addNode(NodeType::VoiceOutput, "Out").value();

// Nodos de feedback (el ciclo)
auto fbOut = graph->addFeedbackOutput("FB Send").value();
auto delay1 = graph->addNode(NodeType::Delay1, "1 Sample Delay").value();
auto scale = graph->addScale("Resonance Amount", 0.9f, 0.0f).value();
auto fbIn = graph->addFeedbackInput("FB Return").value();

// Grafo principal
osc >> filter >> output;

// Grafo de feedback (el ciclo)
filter >> fbOut >> delay1 >> scale >> fbIn;

// Conectar retorno del feedback al filtro
fbIn >> filter.input("resonance");  // El feedback modula resonancia

// Crear path explícito (esto valida y marca el ciclo)
auto pathResult = graph->getFeedbackManager().createPath(fbIn.id(), fbOut.id());
if (!pathResult) {
    // Error: no hay Delay1 en el path, o no hay conexión de vuelta
}

// Compilar
auto runtime = graph->compile(48000.0, 256).value();
📊 COMPARACIÓN: Con vs Sin Feedback Explícito
Table
Aspecto	Sin feedback (grafo DAG)	Con feedback explícito
Toposort	Simple Kahn	Kahn + detección de ciclos + ordenación de paths
Latencia	0 (feedforward)	≥1 sample por path
Estabilidad	Incondicional	Puede oscilar si ganancia > 1
Usos	FX, sintetizadores básicos	Filtros resonantes, delays, chorus, físicas
Detección de errores	Automática	Requiere validación de path
🎯 VALIDACIÓN DE FEEDBACK
cpp
Copy
// Validaciones que se ejecutan en createPath()

bool FeedbackManager::validatePath(const FeedbackPath& path) const {
    // 1. Debe tener exactamente un FeedbackInput y un FeedbackOutput
    // 2. Debe tener al menos un Delay1 (o nodo con latencia equivalente)
    // 3. La ganancia total del loop debe ser < 1 para estabilidad (warning si no)
    // 4. No debe haber "agujeros" (conexiones que salgan del path y no vuelvan)
    // 5. Tipos de señal consistentes a lo largo del path
    
    return path.isValid && calculatePathGain(path) < 1.0f;
}



Aquí está la serialización a ValueTree completa, con el esquema de datos, conversión bidireccional, migración de versiones, y optimizaciones para presets grandes.
MENSAJE 3: La serialización a ValueTree para presets
🎯 Filosofía de serialización
Table
Principio	Implementación
Human-readable	YAML/JSON para debugging, version control, diffs
Binary eficiente	ValueTree → XML comprimido o blob propio para producción
Versionado	Cada preset declara su versión de esquema
Migración automática	Upgraders registrados por versión
Parcial	Solo datos que cambian respecto a defaults
Validación	Schema validation antes de deserializar
