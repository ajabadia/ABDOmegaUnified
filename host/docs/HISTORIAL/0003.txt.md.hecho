// Source/Core/Modulation/ModulationGraphImpl.cpp

#include "ModulationGraphImpl.h"
#include <algorithm>
#include <queue>

namespace Omega::Core::Modulation::API {

// ============================================================
// CONSTRUCCIÓN / DESTRUCCIÓN
// ============================================================

ModulationGraph::Impl::Impl() {
    // Pre-poblar índices libres
    for (int i = 0; i < 32; ++i) freeNodeSlots.push_back(i);
    for (int i = 0; i < 64; ++i) freeConnectionSlots.push_back(i);
}

ModulationGraph::Impl::~Impl() = default;

void ModulationGraph::Impl::clear() {
    nodes.fill(std::nullopt);
    connections.fill(std::nullopt);
    freeNodeSlots.clear();
    freeConnectionSlots.clear();
    for (int i = 0; i < 32; ++i) freeNodeSlots.push_back(i);
    for (int i = 0; i < 64; ++i) freeConnectionSlots.push_back(i);
    
    nextNodeIdHigh = 1;
    nextNodeIdLow = 0;
    nextConnectionId = 0;
    
    isCompiled = false;
    isModified = true;
    lastCompileData.reset();
}

bool ModulationGraph::Impl::isEmpty() const {
    return std::all_of(nodes.begin(), nodes.end(), 
                       [](const auto& n) { return !n.has_value(); });
}

// ============================================================
// GENERACIÓN DE IDs
// ============================================================

NodeId ModulationGraph::Impl::generateNodeId() {
    NodeId id{nextNodeIdHigh, nextNodeIdLow};
    if (++nextNodeIdLow == 0) ++nextNodeIdHigh;
    return id;
}

uint16_t ModulationGraph::Impl::generateConnectionId() {
    // Reutilizar ID libre si existe
    if (!freeConnectionSlots.empty()) {
        uint16_t id = freeConnectionSlots.back();
        freeConnectionSlots.pop_back();
        return id;
    }
    // O crear nuevo
    return nextConnectionId++;
}

// ============================================================
// GESTIÓN DE NODOS
// ============================================================

GraphResult<NodeHandle> ModulationGraph::Impl::addNode(
    NodeType type,
    const juce::String& name,
    const NodeConfig* config) 
{
    // Verificar límite
    if (freeNodeSlots.empty()) {
        return std::unexpected(GraphError::MaxNodesReached);
    }
    
    // Obtener slot
    uint8_t slot = freeNodeSlots.back();
    freeNodeSlots.pop_back();
    
    // Construir nodo
    InternalNode node;
    node.id = generateNodeId();
    node.type = type;
    node.outputType = getDefaultOutputType(type);
    node.name = name.isEmpty() ? generateDefaultName(type) : name;
    
    if (config) {
        node.config = *config;
    } else {
        node.config = getDefaultConfig(type);
    }
    
    // Crear puertos por defecto
    node.inputPorts = getDefaultPortsForType(type, PortDirection::Input);
    node.outputPorts = getDefaultPortsForType(type, PortDirection::Output);
    
    // Guardar
    nodes[slot] = std::move(node);
    
    // Notificar
    for (auto& cb : onNodeAdded) {
        if (cb) cb(NodeHandle{nullptr, nodes[slot]->id});  // nullptr se rellena después
    }
    notifyModified();
    
    return NodeHandle{nullptr, nodes[slot]->id};
}

GraphResult<void> ModulationGraph::Impl::removeNode(NodeId id) {
    auto* node = findNode(id);
    if (!node) return std::unexpected(GraphError::NodeNotFound);
    
    // Eliminar todas las conexiones primero
    removeAllConnections(id);
    
    // Liberar slot
    for (size_t i = 0; i < nodes.size(); ++i) {
        if (nodes[i] && nodes[i]->id == id) {
            freeNodeSlots.push_back(static_cast<uint8_t>(i));
            nodes[i].reset();
            break;
        }
    }
    
    // Notificar
    for (auto& cb : onNodeRemoved) {
        if (cb) cb(id);
    }
    notifyModified();
    
    return {};
}

InternalNode* ModulationGraph::Impl::findNode(NodeId id) {
    for (auto& n : nodes) {
        if (n && n->id == id) return &*n;
    }
    return nullptr;
}

const InternalNode* ModulationGraph::Impl::findNode(NodeId id) const {
    for (auto& n : nodes) {
        if (n && n->id == id) return &*n;
    }
    return nullptr;
}

// ============================================================
// GESTIÓN DE CONEXIONES
// ============================================================

GraphResult<uint16_t> ModulationGraph::Impl::addConnection(
    NodeId srcId, uint8_t srcPort,
    NodeId dstId, uint8_t dstPort,
    float amount,
    bool isFeedback)
{
    // Validar nodos
    auto* src = findNode(srcId);
    auto* dst = findNode(dstId);
    if (!src) return std::unexpected(GraphError::NodeNotFound);
    if (!dst) return std::unexpected(GraphError::NodeNotFound);
    
    // Validar puertos
    if (srcPort >= src->outputPorts.size()) {
        return std::unexpected(GraphError::InvalidPortIndex);
    }
    if (dstPort >= dst->inputPorts.size()) {
        return std::unexpected(GraphError::InvalidPortIndex);
    }
    
    // Validar que input no esté ya conectado (a menos que sea multi)
    const auto& dstPortInfo = dst->inputPorts[dstPort];
    if (dstPortInfo.multiplicity == PortMultiplicity::Single) {
        for (uint16_t connId : dst->incomingConnections) {
            auto* conn = findConnection(connId);
            if (conn && conn->destPortIndex == dstPort) {
                return std::unexpected(GraphError::PortAlreadyConnected);
            }
        }
    }
    
    // Validar tipos
    auto srcType = src->outputPorts[srcPort].signalType;
    auto dstType = dst->inputPorts[dstPort].signalType;
    if (!validateTypesCompatible(srcType, dstType)) {
        return std::unexpected(GraphError::PortTypeMismatch);
    }
    
    // Detectar ciclo (a menos que sea conexión de feedback explícita)
    if (!isFeedback && wouldCreateCycle(srcId, dstId)) {
        return std::unexpected(GraphError::WouldCreateCycle);
    }
    
    // Verificar límite de conexiones
    if (freeConnectionSlots.empty() && nextConnectionId >= 64) {
        return std::unexpected(GraphError::MaxConnectionsReached);
    }
    
    // Crear conexión
    uint16_t connId = generateConnectionId();
    
    InternalConnection conn;
    conn.id = connId;
    conn.sourceNode = srcId;
    conn.sourcePortIndex = srcPort;
    conn.destNode = dstId;
    conn.destPortIndex = dstPort;
    conn.amount = amount;
    conn.isFeedbackConnection = isFeedback;
    
    // Guardar
    connections[connId] = conn;
    
    // Actualizar nodos
    src->outgoingConnections.push_back(connId);
    dst->incomingConnections.push_back(connId);
    
    // Notificar
    for (auto& cb : onConnectionAdded) {
        if (cb) cb(connId, NodeHandle{nullptr, srcId}, NodeHandle{nullptr, dstId});
    }
    notifyModified();
    
    return connId;
}

GraphResult<void> ModulationGraph::Impl::removeConnection(uint16_t connId) {
    auto* conn = findConnection(connId);
    if (!conn) return std::unexpected(GraphError::NodeNotFound);  // O error específico
    
    // Remover de nodos
    auto* src = findNode(conn->sourceNode);
    auto* dst = findNode(conn->destNode);
    
    if (src) {
        auto& out = src->outgoingConnections;
        out.erase(std::remove(out.begin(), out.end(), connId), out.end());
    }
    if (dst) {
        auto& in = dst->incomingConnections;
        in.erase(std::remove(in.begin(), in.end(), connId), in.end());
    }
    
    // Liberar
    connections[connId].reset();
    freeConnectionSlots.push_back(connId);
    
    // Notificar
    for (auto& cb : onConnectionRemoved) {
        if (cb) cb(connId);
    }
    notifyModified();
    
    return {};
}

void ModulationGraph::Impl::removeAllConnections(NodeId nodeId) {
    auto* node = findNode(nodeId);
    if (!node) return;
    
    // Copiar porque vamos a modificar durante iteración
    auto incoming = node->incomingConnections;
    auto outgoing = node->outgoingConnections;
    
    for (uint16_t id : incoming) removeConnection(id);
    for (uint16_t id : outgoing) removeConnection(id);
}

InternalConnection* ModulationGraph::Impl::findConnection(uint16_t id) {
    if (id >= connections.size()) return nullptr;
    if (!connections[id]) return nullptr;
    return &*connections[id];
}

// ============================================================
// VALIDACIÓN
// ============================================================

bool ModulationGraph::Impl::validateTypesCompatible(SignalType src, SignalType dst) const {
    if (src == dst) return true;
    
    // Conversiones permitidas
    switch (src) {
        case SignalType::Control:
            return dst == SignalType::Audio || dst == SignalType::Pitch;
        case SignalType::Audio:
            return dst == SignalType::Control;  // Con nodo de envolvente/detector
        case SignalType::Pitch:
            return dst == SignalType::Audio || dst == SignalType::Control;
        case SignalType::Phase:
            return dst == SignalType::Audio;
        case SignalType::Trigger:
            return dst == SignalType::Control || dst == SignalType::Audio;
    }
    return false;
}

bool ModulationGraph::Impl::wouldCreateCycle(NodeId src, NodeId dst) const {
    // DFS desde dst: ¿podemos llegar a src?
    std::set<NodeId> visited;
    std::vector<NodeId> stack{dst};
    
    while (!stack.empty()) {
        NodeId current = stack.back();
        stack.pop_back();
        
        if (current == src) return true;
        if (visited.count(current)) continue;
        visited.insert(current);
        
        auto* node = findNode(current);
        if (!node) continue;
        
        for (uint16_t connId : node->outgoingConnections) {
            auto* conn = findConnection(connId);
            if (conn && !conn->isFeedbackConnection) {
                stack.push_back(conn->destNode);
            }
        }
    }
    
    return false;
}

// ============================================================
// COMPILACIÓN: ALGORITMO TOPOLÓGICO + DETECCIÓN DE FEEDBACK
// ============================================================

GraphResult<ModulationGraph::Impl::CompileData> ModulationGraph::Impl::compileGraph() {
    CompileData data;
    
    // Paso 1: Construir grafo de dependencias (solo conexiones no-feedback)
    std::map<NodeId, std::set<NodeId>> dependencies;  // node -> nodes que dependen de él
    std::map<NodeId, int> inDegree;
    
    // Inicializar todos los nodos
    for (const auto& n : nodes) {
        if (!n) continue;
        inDegree[n->id] = 0;
    }
    
    // Contar grados de entrada (excluyendo feedback)
    for (const auto& c : connections) {
        if (!c) continue;
        if (c->isFeedbackConnection) {
            data.feedbackConnections.insert(c->id);
            continue;
        }
        
        dependencies[c->sourceNode].insert(c->destNode);
        inDegree[c->destNode]++;
    }
    
    // Paso 2: Kahn's algorithm
    std::queue<NodeId> queue;
    for (const auto& [id, degree] : inDegree) {
        if (degree == 0) queue.push(id);
    }
    
    while (!queue.empty()) {
        NodeId current = queue.front();
        queue.pop();
        data.topoOrder.push_back(current);
        
        for (NodeId dependent : dependencies[current]) {
            if (--inDegree[dependent] == 0) {
                queue.push(dependent);
            }
        }
    }
    
    // Paso 3: Detectar nodos no visitados (parte de ciclos o feedback)
    std::set<NodeId> visited(data.topoOrder.begin(), data.topoOrder.end());
    std::set<NodeId> unvisited;
    
    for (const auto& n : nodes) {
        if (!n) continue;
        if (!visited.count(n->id)) {
            unvisited.insert(n->id);
        }
    }
    
    // Paso 4: Identificar paths de feedback explícitos
    for (NodeId id : unvisited) {
        auto* node = findNode(id);
        if (!node) continue;
        
        // ¿Es nodo de feedback especial?
        if (node->type == NodeType::FeedbackInput || 
            node->type == NodeType::FeedbackOutput) {
            data.feedbackNodes.insert(id);
        } else {
            // Ciclo no resuelto = error
            data.errors.push_back({id, "Unresolved cycle: node not in feedback path"});
        }
    }
    
    // Paso 5: Ordenar feedback nodes (deben formar secuencia válida)
    // FeedbackInput -> ... -> FeedbackOutput, con Delay1 en medio
    
    // Verificar que cada FeedbackInput tenga su Output correspondiente
    // y que haya al menos un Delay1 en el path
    
    // (Implementación detallada omitida por brevedad)
    
    // Paso 6: Calcular latencias
    for (NodeId id : data.topoOrder) {
        auto* node = findNode(id);
        if (!node) continue;
        
        int maxInputLatency = 0;
        for (uint16_t connId : node->incomingConnections) {
            auto* conn = findConnection(connId);
            if (!conn) continue;
            
            auto* src = findNode(conn->sourceNode);
            if (!src) continue;
            
            int srcLatency = data.nodeLatencies[conn->sourceNode];
            int connLatency = conn->isFeedbackConnection ? 1 : 0;  // Feedback = 1 sample
            maxInputLatency = std::max(maxInputLatency, srcLatency + connLatency);
        }
        
        // Latencia propia del nodo
        int selfLatency = 0;
        if (node->type == NodeType::Delay1) selfLatency = 1;
        // ... otros nodos con latencia
        
        data.nodeLatencies[id] = maxInputLatency + selfLatency;
        
        if (maxInputLatency > 0) {
            node->latencyCompensation = maxInputLatency;
        }
    }
    
    // Verificar que grafo completo es válido
    if (!data.errors.empty()) {
        return std::unexpected(GraphError::UnresolvedFeedbackPath);
    }
    
    // Marcar compilado
    isCompiled = true;
    isModified = false;
    lastCompileData = data;
    
    return data;
}

// ============================================================
// SERIALIZACIÓN
// ============================================================

juce::ValueTree ModulationGraph::Impl::toValueTree() const {
    juce::ValueTree tree("ModulationGraph");
    tree.setProperty("version", 1, nullptr);
    
    // Nodos
    juce::ValueTree nodesTree("Nodes");
    for (const auto& n : nodes) {
        if (!n) continue;
        
        juce::ValueTree node("Node");
        node.setProperty("id", juce::String::toHexString(n->id.high) + 
                              juce::String::toHexString(n->id.low), nullptr);
        node.setProperty("type", static_cast<int>(n->type), nullptr);
        node.setProperty("name", n->name, nullptr);
        node.setProperty("outputType", static_cast<int>(n->outputType), nullptr);
        node.setProperty("uiX", n->uiPosition.x, nullptr);
        node.setProperty("uiY", n->uiPosition.y, nullptr);
        
        // Config específica
        juce::ValueTree config("Config");
        // Serializar unión según tipo...
        node.addChild(config, -1, nullptr);
        
        nodesTree.addChild(node, -1, nullptr);
    }
    tree.addChild(nodesTree, -1, nullptr);
    
    // Conexiones
    juce::ValueTree connsTree("Connections");
    for (const auto& c : connections) {
        if (!c) continue;
        
        juce::ValueTree conn("Connection");
        conn.setProperty("id", c->id, nullptr);
        conn.setProperty("srcNode", juce::String::toHexString(c->sourceNode.high) + 
                                     juce::String::toHexString(c->sourceNode.low), nullptr);
        conn.setProperty("srcPort", c->sourcePortIndex, nullptr);
        conn.setProperty("dstNode", juce::String::toHexString(c->destNode.high) + 
                                     juce::String::toHexString(c->destNode.low), nullptr);
        conn.setProperty("dstPort", c->destPortIndex, nullptr);
        conn.setProperty("amount", c->amount, nullptr);
        conn.setProperty("curve", c->curveType, nullptr);
        conn.setProperty("isFeedback", c->isFeedbackConnection, nullptr);
        
        connsTree.addChild(conn, -1, nullptr);
    }
    tree.addChild(connsTree, -1, nullptr);
    
    return tree;
}

GraphResult<void> ModulationGraph::Impl::fromValueTree(const juce::ValueTree& tree) {
    clear();
    
    // Deserializar nodos...
    // Deserializar conexiones...
    // Validar...
    
    isModified = true;
    isCompiled = false;
    
    return {};
}

// ============================================================
// NOTIFICACIONES
// ============================================================

void ModulationGraph::Impl::notifyModified() {
    isModified = true;
    isCompiled = false;
    for (auto& cb : onModified) {
        if (cb) cb();
    }
}

// ============================================================
// UTILIDADES DE TIPOS DE NODO
// ============================================================

SignalType getDefaultOutputType(NodeType type) {
    switch (type) {
        case NodeType::LFO: return SignalType::Audio;
        case NodeType::Envelope: return SignalType::Control;
        case NodeType::Random: return SignalType::Control;
        case NodeType::Noise: return SignalType::Audio;
        case NodeType::KeyTrack: return SignalType::Pitch;
        case NodeType::Velocity: return SignalType::Control;
        case NodeType::Mix: return SignalType::Audio;  // Hereda del input?
        case NodeType::Scale: return SignalType::Control;
        case NodeType::VoicePitch: return SignalType::Pitch;
        default: return SignalType::Control;
    }
}

NodeConfig getDefaultConfig(NodeType type) {
    NodeConfig cfg{};
    switch (type) {
        case NodeType::LFO:
            cfg.lfo.shape = 0;  // Sine
            cfg.lfo.rate = 1.0f;
            cfg.lfo.bpmSync = false;
            cfg.lfo.phase = 0.0f;
            break;
        case NodeType::Envelope:
            cfg.envelope.attack = 10.0f;
            cfg.envelope.decay = 100.0f;
            cfg.envelope.sustain = 0.5f;
            cfg.envelope.release = 200.0f;
            cfg.envelope.curve = 1;  // Exponential
            break;
        // ...
    }
    return cfg;
}

std::vector<PortInfo> ModulationGraph::Impl::getDefaultPortsForType(
    NodeType type, 
    PortDirection dir) 
{
    std::vector<PortInfo> ports;
    
    if (dir == PortDirection::Input) {
        switch (type) {
            case NodeType::Mix:
                ports.push_back({"in0", "Input 1", SignalType::Audio, 
                                PortDirection::Input, PortMultiplicity::Multiple, true, 0.0f, {}});
                ports.push_back({"in1", "Input 2", SignalType::Audio, 
                                PortDirection::Input, PortMultiplicity::Multiple, true, 0.0f, {}});
                break;
            case NodeType::Scale:
                ports.push_back({"signal", "Signal", SignalType::Audio, 
                                PortDirection::Input, PortMultiplicity::Single, true, 0.0f, {}});
                break;
            // ...
        }
    } else {  // Output
        switch (type) {
            case NodeType::LFO:
                ports.push_back({"signal", "Signal", SignalType::Audio, 
                                PortDirection::Output, PortMultiplicity::Multiple, false, 0.0f, {}});
                break;
            case NodeType::Envelope:
                ports.push_back({"level", "Level", SignalType::Control, 
                                PortDirection::Output, PortMultiplicity::Multiple, false, 0.0f, {}});
                break;
            // ...
        }
    }
    
    return ports;
}

} // namespace Omega::Core::Modulation::API
Esta implementación PIMPL proporciona:
Encapsulamiento completo: La API pública solo ve NodeHandle, PortRef, etc.
Gestión de memoria eficiente: Arrays fijos con slots libres, sin new/delete en runtime
Algoritmos robustos: Kahn's algorithm para toposort, DFS para detección de ciclos
Extensibilidad: Fácil añadir nuevos tipos de nodo en getDefaultPortsForType(), etc.



Aquí está el sistema de feedback explícito completo, con la arquitectura para romper ciclos de forma controlada mediante nodos FeedbackInput, FeedbackOutput y Delay1.
MENSAJE 2: El sistema de feedback explícito (cómo romper ciclos con Delay1)
🎯 Filosofía del feedback en OMEGA
Table
Aspecto	Diseño
Ciclos implícitos	PROHIBIDOS (error en compilación)
Ciclos explícitos	Permitidos, con compensación de latencia automática
Granularidad	Por nodo (no por grafo completo)
Delay mínimo	1 sample (garantizado por arquitectura)
Visualización	Feedback paths marcados en UI (color diferente)
🏗️ ARQUITECTURA DE FEEDBACK
plain
Copy
┌─────────────────────────────────────────────────────────────────┐
│  GRAFO CON CICLO (inválido)                                     │
│                                                                 │
│    ┌─────────┐         ┌─────────┐         ┌─────────┐          │
│    │  LFO    │────────▶│ Filter  │────────▶│  Delay  │────────┐  │
│    │         │         │         │         │  100ms  │        │  │
│    └─────────┘         └─────────┘         └─────────┘        │  │
│           ▲                                                    │  │
│           └────────────────────────────────────────────────────┘  │
│                              ↑                                  │
│                         Ciclo implícito: ERROR                  │
├─────────────────────────────────────────────────────────────────┤
