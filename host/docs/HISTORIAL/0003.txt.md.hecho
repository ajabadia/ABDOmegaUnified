// Source/Core/Preset/OmegaPresetSerializer.h
#pragma once
#include "OmegaPreset.h"
#include <juce_core/juce_core.h>

namespace Omega::Core::Preset {

// ============================================================
// VERSIONADO DE ESQUEMAS
// ============================================================

enum class PresetSchemaVersion : uint32_t {
    V1_Initial = 1,           // 2025-01: Estructura base
    V2_ModulationGraph = 2,   // 2025-03: Grafo de modulación
    V3_MultiEngine = 3,       // 2025-06: Múltiples engines
    V4_MPE_MIDI2 = 4,          // 2025-09: MPE y MIDI 2.0
    
    Current = V4
};

// ============================================================
// OPCIONES DE SERIALIZACIÓN
// ============================================================

struct SerializationOptions {
    bool includeDefaults = false;      // Incluir parámetros con valor default?
    bool includeUiPositions = true;    // Posiciones de nodos en grafo?
    bool humanReadable = true;         // Formato legible (más verbose)?
    bool includeHistory = true;        # Metadatos de Git-for-Sounds?
    
    // Compresión para binario
    enum class Compression { None, LZ4, Zstd } compression = Compression::LZ4;
};

// ============================================================
// RESULTADO DE OPERACIÓN
// ============================================================

struct SerializationResult {
    bool success;
    juce::String errorMessage;
    PresetSchemaVersion loadedVersion;
    bool wasMigrated;                  // Se aplicó migración automática?
    std::vector<juce::String> migrationLog;
};

// ============================================================
// SERIALIZADOR PRINCIPAL
// ============================================================

class OmegaPresetSerializer {
public:
    OmegaPresetSerializer();
    
    // Registro de migradores
    using MigrationFunc = std::function<juce::ValueTree(const juce::ValueTree&)>;
    void registerMigration(PresetSchemaVersion from, PresetSchemaVersion to, 
                           MigrationFunc func);
    
    // Serialización
    juce::ValueTree toValueTree(const OmegaPreset& preset,
                                 const SerializationOptions& options = {});
    
    SerializationResult fromValueTree(OmegaPreset& preset,
                                      const juce::ValueTree& tree,
                                      const AceCatalog* catalog = nullptr);  // Para validación
    
    // Formatos de salida
    juce::String toYaml(const OmegaPreset& preset,
                        const SerializationOptions& options = {});
    
    juce::MemoryBlock toBinary(const OmegaPreset& preset,
                               const SerializationOptions& options = {});
    
    // Deserialización desde formatos
    SerializationResult fromYaml(OmegaPreset& preset,
                                  const juce::String& yaml,
                                  const AceCatalog* catalog = nullptr);
    
    SerializationResult fromBinary(OmegaPreset& preset,
                                    const juce::MemoryBlock& data,
                                    const AceCatalog* catalog = nullptr);
    
    // Validación
    bool validateAgainstSchema(const juce::ValueTree& tree,
                                juce::String* errorMessage = nullptr) const;
    
    // Información de versión
    static PresetSchemaVersion detectVersion(const juce::ValueTree& tree);
    static juce::String versionToString(PresetSchemaVersion v);
    
private:
    std::map<std::pair<PresetSchemaVersion, PresetSchemaVersion>, MigrationFunc> migrations_;
    
    // Helpers de serialización
    juce::ValueTree serializeMetadata(const OmegaPreset& preset);
    juce::ValueTree serializeGlobal(const OmegaPreset& preset, bool includeDefaults);
    juce::ValueTree serializeLayer(const Layer& layer, bool includeDefaults, 
                                    bool includeUi);
    juce::ValueTree serializeVoiceArchitecture(const VoiceArchitecture& arch,
                                                bool includeDefaults);
    juce::ValueTree serializeModulationGraph(const class ModulationGraph& graph,
                                              bool includeUi);
    
    // Helpers de deserialización
    bool deserializeMetadata(OmegaPreset& preset, const juce::ValueTree& tree);
    bool deserializeLayer(Layer& layer, const juce::ValueTree& tree,
                          const AceCatalog* catalog);
    bool deserializeVoiceArchitecture(VoiceArchitecture& arch,
                                       const juce::ValueTree& tree,
                                       const AceCatalog* catalog);
    
    // Migración
    juce::ValueTree applyMigrations(juce::ValueTree tree,
                                     PresetSchemaVersion from,
                                     PresetSchemaVersion to);
};

// ============================================================
// SCHEMA VALIDATOR (para testing y debug)
// ============================================================

class PresetSchemaValidator {
public:
    struct ValidationError {
        juce::String path;           // "layers[0].voice_architecture.oscillators[1]"
        juce::String expected;
        juce::String actual;
        juce::String message;
    };
    
    struct Schema {
        juce::String type;           // "string", "number", "boolean", "object", "array"
        bool required = true;
        std::optional<juce::Range<double>> numericRange;
        std::vector<juce::String> enumValues;
        std::map<juce::String, Schema> properties;  // Para objetos
        std::optional<Schema> items;                  // Para arrays
    };
    
    static std::map<juce::String, Schema> getPresetSchemaV4();
    
    std::vector<ValidationError> validate(const juce::ValueTree& tree,
                                           const std::map<juce::String, Schema>& schema);
};

} // namespace Omega::Core::Preset
2. Implementación de serialización
cpp
Copy
// Source/Core/Preset/OmegaPresetSerializer.cpp

#include "OmegaPresetSerializer.h"
#include "../Modulation/ModulationGraphAPI.h"
#include <yaml-cpp/yaml.h>  // O parser YAML propio

namespace Omega::Core::Preset {

// ============================================================
// SERIALIZACIÓN: OMEGAPRESET → VALUETREE
// ============================================================

juce::ValueTree OmegaPresetSerializer::toValueTree(
    const OmegaPreset& preset,
    const SerializationOptions& options) 
{
    juce::ValueTree root("OMEGA_PRESET");
    
    // Versión de esquema
    root.setProperty("schema_version", 
                     static_cast<int>(PresetSchemaVersion::Current), nullptr);
    root.setProperty("ace_catalog_version", 
                     preset.getAceCatalogVersion(), nullptr);
    
    // Metadata
    root.addChild(serializeMetadata(preset), -1, nullptr);
    
    // Global
    root.addChild(serializeGlobal(preset, options.includeDefaults), -1, nullptr);
    
    // Layers
    juce::ValueTree layersTree("layers");
    for (const auto& layer : preset.getLayers()) {
        layersTree.addChild(serializeLayer(layer, options.includeDefaults, 
                                            options.includeUiPositions), 
                            -1, nullptr);
    }
    root.addChild(layersTree, -1, nullptr);
    
    // MIDI mappings (si hay)
    if (options.includeDefaults || !preset.getMidiMappings().empty()) {
        root.addChild(serializeMidiMappings(preset), -1, nullptr);
    }
    
    return root;
}

juce::ValueTree OmegaPresetSerializer::serializeMetadata(const OmegaPreset& preset) {
    juce::ValueTree meta("metadata");
    
    meta.setProperty("name", preset.getName(), nullptr);
    meta.setProperty("author", preset.getAuthor(), nullptr);
    meta.setProperty("created", preset.getCreationDate().toISO8601(true), nullptr);
    meta.setProperty("modified", preset.getModificationDate().toISO8601(true), nullptr);
    
    // Git-for-Sounds
    if (auto parent = preset.getParentCommit()) {
        meta.setProperty("parent_commit", *parent, nullptr);
    }
    if (auto msg = preset.getCommitMessage(); !msg.isEmpty()) {
        meta.setProperty("commit_message", msg, nullptr);
    }
    
    // Tags
    juce::ValueTree tags("tags");
    for (const auto& tag : preset.getTags()) {
        juce::ValueTree t("tag");
        t.setProperty("value", tag, nullptr);
        tags.addChild(t, -1, nullptr);
    }
    meta.addChild(tags, -1, nullptr);
    
    // Musical
    meta.setProperty("bpm", preset.getBpm(), nullptr);
    meta.setProperty("key", preset.getKey(), nullptr);
    meta.setProperty("time_signature", preset.getTimeSignature(), nullptr);
    
    return meta;
}

juce::ValueTree OmegaPresetSerializer::serializeLayer(
    const Layer& layer,
    bool includeDefaults,
    bool includeUi) 
{
    juce::ValueTree lt("layer");
    
    lt.setProperty("id", layer.id, nullptr);
    lt.setProperty("name", layer.name, nullptr);
    lt.setProperty("engine", layer.engine, nullptr);
    lt.setProperty("polyphony", layer.polyphony, nullptr);
    
    // Unison
    if (includeDefaults || layer.unison.voices != 1) {
        juce::ValueTree unison("unison");
        unison.setProperty("voices", layer.unison.voices, nullptr);
        unison.setProperty("detune", layer.unison.detune, nullptr);
        unison.setProperty("spread", layer.unison.spread, nullptr);
        lt.addChild(unison, -1, nullptr);
    }
    
    // Voice Architecture
    lt.addChild(serializeVoiceArchitecture(layer.voiceArch, includeDefaults), 
                -1, nullptr);
    
    // Modulation Graph
    if (layer.modGraph) {
        lt.addChild(serializeModulationGraph(*layer.modGraph, includeUi), 
                    -1, nullptr);
    }
    
    // Layer params
    juce::ValueTree params("layer_params");
    if (includeDefaults || layer.levelDb != 0.0f) {
        params.setProperty("level_db", layer.levelDb, nullptr);
    }
    if (includeDefaults || layer.pan != 0.0f) {
        params.setProperty("pan", layer.pan, nullptr);
    }
    params.setProperty("mute", layer.mute, nullptr);
    params.setProperty("solo", layer.solo, nullptr);
    lt.addChild(params, -1, nullptr);
    
    return lt;
}

juce::ValueTree OmegaPresetSerializer::serializeVoiceArchitecture(
    const VoiceArchitecture& arch,
    bool includeDefaults) 
{
    juce::ValueTree va("voice_architecture");
    
    // Oscillators
    juce::ValueTree oscs("oscillators");
    for (const auto& osc : arch.oscillators) {
        if (!osc.enabled && !includeDefaults) continue;
        
        juce::ValueTree o("oscillator");
        o.setProperty("slot", osc.slot, nullptr);
        o.setProperty("component_id", osc.componentId, nullptr);
        o.setProperty("enabled", osc.enabled, nullptr);
        
        // Solo parámetros no-default
        juce::ValueTree params("parameters");
        for (const auto& [id, value] : osc.parameters) {
            auto def = getDefaultParameter(osc.componentId, id);
            if (includeDefaults || !def || std::abs(value - *def) > 0.0001f) {
                juce::ValueTree p("param");
                p.setProperty("id", id, nullptr);
                p.setProperty("value", value, nullptr);
                params.addChild(p, -1, nullptr);
            }
        }
        if (params.getNumChildren() > 0) {
            o.addChild(params, -1, nullptr);
        }
        
        oscs.addChild(o, -1, nullptr);
    }
    if (oscs.getNumChildren() > 0) {
        va.addChild(oscs, -1, nullptr);
    }
    
    // Filters, Envelopes, LFOs, FX... (similar)
    
    return va;
}

juce::ValueTree OmegaPresetSerializer::serializeModulationGraph(
    const ModulationGraph& graph,
    bool includeUi) 
{
    juce::ValueTree mg("modulation_graph");
    mg.setProperty("version", 1, nullptr);
    
    // Nodos
    juce::ValueTree nodes("nodes");
    for (auto node : graph.getNodes()) {
        juce::ValueTree n("node");
        n.setProperty("id", node.id().toString(), nullptr);
        n.setProperty("type", static_cast<int>(node.type()), nullptr);
        n.setProperty("name", node.name(), nullptr);
        
        if (includeUi) {
            auto pos = node.uiPosition();
            n.setProperty("ui_x", pos.x, nullptr);
            n.setProperty("ui_y", pos.y, nullptr);
        }
        
        // Config específica del tipo
        juce::ValueTree cfg = serializeNodeConfig(node);
        n.addChild(cfg, -1, nullptr);
        
        nodes.addChild(n, -1, nullptr);
    }
    mg.addChild(nodes, -1, nullptr);
    
    // Conexiones
    juce::ValueTree conns("connections");
    for (auto connId : graph.getConnections()) {
        auto conn = graph.getConnection(connId);
        juce::ValueTree c("connection");
        
        c.setProperty("id", connId, nullptr);
        c.setProperty("source_node", conn.source.id().toString(), nullptr);
        c.setProperty("source_port", conn.sourcePort, nullptr);
        c.setProperty("dest_node", conn.dest.id().toString(), nullptr);
        c.setProperty("dest_port", conn.destPort, nullptr);
        
        if (conn.amount != 1.0f) {
            c.setProperty("amount", conn.amount, nullptr);
        }
        if (conn.curve != CurveType::Linear) {
            c.setProperty("curve", static_cast<int>(conn.curve), nullptr);
        }
        if (conn.isFeedback) {
            c.setProperty("is_feedback", true, nullptr);
        }
        
        conns.addChild(c, -1, nullptr);
    }
    mg.addChild(conns, -1, nullptr);
    
    return mg;
}
3. Deserialización con validación ACE
cpp
Copy
// Source/Core/Preset/OmegaPresetSerializerDeserialize.cpp

SerializationResult OmegaPresetSerializer::fromValueTree(
    OmegaPreset& preset,
    const juce::ValueTree& tree,
    const AceCatalog* catalog) 
{
    SerializationResult result;
    
    // 1. Detectar versión
    auto version = detectVersion(tree);
    result.loadedVersion = version;
    
    // 2. Validar schema
    if (!validateAgainstSchema(tree, &result.errorMessage)) {
        result.success = false;
        return result;
    }
    
    // 3. Migrar si es necesario
    juce::ValueTree migratedTree = tree;
    if (version < PresetSchemaVersion::Current) {
        migratedTree = applyMigrations(tree, version, PresetSchemaVersion::Current);
        result.wasMigrated = true;
    }
    
    // 4. Deserializar con validación ACE
    preset.clear();
    
    // Metadata
    if (!deserializeMetadata(preset, migratedTree.getChildWithName("metadata"))) {
        result.success = false;
        result.errorMessage = "Failed to deserialize metadata";
        return result;
    }
    
    // Global
    auto globalTree = migratedTree.getChildWithName("global");
    preset.setEngine(globalTree.getProperty("engine", "VirtualAnalog").toString());
    preset.setMasterGainDb(globalTree.getProperty("master_gain_db", 0.0f));
    
    // Layers con validación ACE
    auto layersTree = migratedTree.getChildWithName("layers");
    for (int i = 0; i < layersTree.getNumChildren(); ++i) {
        Layer layer;
        if (!deserializeLayer(layer, layersTree.getChild(i), catalog)) {
            // Validación ACE falló: component_id no existe
            if (catalog) {
                // Intentar fallback
                auto fallbackResult = applyComponentFallbacks(layer, *catalog);
                if (!fallbackResult.success) {
                    result.success = false;
                    result.errorMessage = "Layer " + layer.id + ": " + 
                                          fallbackResult.error;
                    return result;
                }
                result.migrationLog.push_back(
                    "Layer " + layer.id + ": applied " + 
                    juce::String(fallbackResult.numReplacements) + " fallbacks"
                );
            }
        }
        preset.addLayer(std::move(layer));
    }
    
    result.success = true;
    return result;
}

bool OmegaPresetSerializer::deserializeLayer(
    Layer& layer,
    const juce::ValueTree& tree,
    const AceCatalog* catalog) 
{
    layer.id = tree.getProperty("id", "A").toString();
    layer.name = tree.getProperty("name", "Layer").toString();
    layer.engine = tree.getProperty("engine", "VirtualAnalog").toString();
    layer.polyphony = tree.getProperty("polyphony", 16);
    
    // Unison
    auto unisonTree = tree.getChildWithName("unison");
    if (unisonTree.isValid()) {
        layer.unison.voices = unisonTree.getProperty("voices", 1);
        layer.unison.detune = unisonTree.getProperty("detune", 0.0f);
        layer.unison.spread = unisonTree.getProperty("spread", 0.0f);
    }
    
    // Voice Architecture con validación ACE
    auto vaTree = tree.getChildWithName("voice_architecture");
    if (!deserializeVoiceArchitecture(layer.voiceArch, vaTree, catalog)) {
        return false;
    }
    
    // Modulation Graph
    auto mgTree = tree.getChildWithName("modulation_graph");
    if (mgTree.isValid()) {
        layer.modGraph = std::make_unique<ModulationGraph>();
        // Deserializar nodos y conexiones...
    }
    
    // Layer params
    auto paramsTree = tree.getChildWithName("layer_params");
    layer.levelDb = paramsTree.getProperty("level_db", 0.0f);
    layer.pan = paramsTree.getProperty("pan", 0.0f);
    layer.mute = paramsTree.getProperty("mute", false);
    layer.solo = paramsTree.getProperty("solo", false);
    
    return true;
}

bool OmegaPresetSerializer::deserializeVoiceArchitecture(
    VoiceArchitecture& arch,
    const juce::ValueTree& tree,
    const AceCatalog* catalog) 
{
    // Oscillators
    auto oscsTree = tree.getChildWithName("oscillators");
    for (int i = 0; i < oscsTree.getNumChildren(); ++i) {
        auto oTree = oscsTree.getChild(i);
        OscillatorSlot slot;
        slot.slot = oTree.getProperty("slot", i + 1);
        slot.componentId = oTree.getProperty("component_id").toString();
        slot.enabled = oTree.getProperty("enabled", true);
        
        // VALIDACIÓN ACE
        if (catalog) {
            auto* comp = catalog->getComponent(slot.componentId);
            if (!comp) {
                // Componente no existe: marcar para fallback
                slot.componentId = catalog->getFallbackFor("Oscillator", "VirtualAnalog");
                if (slot.componentId.isEmpty()) {
                    return false;  // No hay fallback disponible
                }
                // Recuperar defaults del fallback
                comp = catalog->getComponent(slot.componentId);
            }
            
            // Validar parámetros contra schema del componente
            auto paramsTree = oTree.getChildWithName("parameters");
            for (const auto& param : comp->parameters) {
                float value = paramsTree.getProperty(juce::Identifier(param.id), 
                                                      param.defaultValue);
                // Clamp a rango válido
                value = juce::jlimit(param.min, param.max, value);
                slot.parameters[param.id] = value;
            }
        } else {
            // Sin catálogo: cargar tal cual (para testing offline)
            auto paramsTree = oTree.getChildWithName("parameters");
            for (int p = 0; p < paramsTree.getNumChildren(); ++p) {
                auto pTree = paramsTree.getChild(p);
                slot.parameters[pTree.getProperty("id").toString()] = 
                    pTree.getProperty("value", 0.0f);
            }
        }
        
        arch.oscillators.push_back(std::move(slot));
    }
    
    // Filters, Envelopes... (similar)
    
    return true;
}
4. Sistema de migración de versiones
cpp
Copy
// Source/Core/Preset/PresetMigrations.cpp

void OmegaPresetSerializer::registerDefaultMigrations() {
    // V1 → V2: Añadir modulation_graph si no existe
    registerMigration(PresetSchemaVersion::V1_Initial,
                      PresetSchemaVersion::V2_ModulationGraph,
                      [](const juce::ValueTree& old) {
        juce::ValueTree migrated = old.createCopy();
        
        // Para cada layer, añadir modulation_graph vacío si no tiene
        auto layers = migrated.getChildWithName("layers");
        for (int i = 0; i < layers.getNumChildren(); ++i) {
            auto layer = layers.getChild(i);
            if (!layer.getChildWithName("modulation_graph").isValid()) {
                juce::ValueTree mg("modulation_graph");
                mg.setProperty("version", 1, nullptr);
                mg.addChild(juce::ValueTree("nodes"), -1, nullptr);
                mg.addChild(juce::ValueTree("connections"), -1, nullptr);
                layer.addChild(mg, -1, nullptr);
            }
        }
        
        // Actualizar versión
        migrated.setProperty("schema_version", 2, nullptr);
        return migrated;
    });
    
    // V2 → V3: Separar engine por layer
    registerMigration(PresetSchemaVersion::V2_ModulationGraph,
                      PresetSchemaVersion::V3_MultiEngine,
                      [](const juce::ValueTree& old) {
        juce::ValueTree migrated = old.createCopy();
        
        // Engine global → copiar a cada layer
        auto globalEngine = migrated.getChildWithName("global")
                                  .getProperty("engine", "VirtualAnalog");
        auto layers = migrated.getChildWithName("layers");
        for (int i = 0; i < layers.getNumChildren(); ++i) {
            auto layer = layers.getChild(i);
            if (!layer.hasProperty("engine")) {
                layer.setProperty("engine", globalEngine, nullptr);
            }
        }
        
        migrated.setProperty("schema_version", 3, nullptr);
        return migrated;
    });
    
    // V3 → V4: Añadir MPE mappings
    registerMigration(PresetSchemaVersion::V3_MultiEngine,
                      PresetSchemaVersion::V4_MPE_MIDI2,
                      [](const juce::ValueTree& old) {
        juce::ValueTree migrated = old.createCopy();
        
        // Añadir sección midi_mappings si no existe
        if (!migrated.getChildWithName("midi_mappings").isValid()) {
            juce::ValueTree mm("midi_mappings");
            
            juce::ValueTree global("global");
            global.setProperty("mod_wheel", "ModWheel", nullptr);
            global.setProperty("pitch_bend", "PitchBend", nullptr);
            mm.addChild(global, -1, nullptr);
            
            migrated.addChild(mm, -1, nullptr);
        }
        
        migrated.setProperty("schema_version", 4, nullptr);
        return migrated;
    });
}

juce::ValueTree OmegaPresetSerializer::applyMigrations(
    juce::ValueTree tree,
    PresetSchemaVersion from,
    PresetSchemaVersion to) 
{
    auto current = from;
    while (current < to) {
        auto next = static_cast<PresetSchemaVersion>(static_cast<uint32_t>(current) + 1);
        
        auto it = migrations_.find({current, next});
        if (it != migrations_.end()) {
            tree = it->second(tree);
        } else {
            // No hay migrador específico: solo bump de versión
            tree.setProperty("schema_version", static_cast<int>(next), nullptr);
        }
        
        current = next;
    }
    return tree;
}
5. Serialización a YAML (human-readable)
cpp
Copy
// Source/Core/Preset/YamlSerializer.cpp

juce::String OmegaPresetSerializer::toYaml(
    const OmegaPreset& preset,
    const SerializationOptions& options) 
{
    auto tree = toValueTree(preset, options);
    
    // Convertir ValueTree a YAML string
    YAML::Emitter yaml;
    
    std::function<void(const juce::ValueTree&, YAML::Node&)> convertNode;
    convertNode = [&](const juce::ValueTree& vt, YAML::Node& yn) {
        // Propiedades
        for (int i = 0; i < vt.getNumProperties(); ++i) {
            auto name = vt.getPropertyName(i).toString().toStdString();
            auto val = vt.getPropertyAtIndex(i);
            
            if (val.isInt()) {
                yn[name] = (int)val;
            } else if (val.isInt64()) {
                yn[name] = (int64_t)val;
            } else if (val.isDouble()) {
                yn[name] = (double)val;
            } else if (val.isBool()) {
                yn[name] = (bool)val;
            } else {
                yn[name] = val.toString().toStdString();
            }
        }
        
        // Hijos
        for (int i = 0; i < vt.getNumChildren(); ++i) {
            auto child = vt.getChild(i);
            auto childName = child.getType().toString().toStdString();
            
            if (childName == "tag" || childName == "param") {
                // Elementos de array: añadir a sequence
                if (!yn[childName]) yn[childName] = YAML::Node(YAML::NodeType::Sequence);
                YAML::Node element;
                convertNode(child, element);
                yn[childName].push_back(element);
            } else {
                YAML::Node childNode;
                convertNode(child, childNode);
                yn[childName] = childNode;
            }
        }
    };
    
    YAML::Node root;
    convertNode(tree, root);
    
    yaml << root;
    return juce::String(yaml.c_str());
}

