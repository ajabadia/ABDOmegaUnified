// Cuando el usuario intenta conectar en UI:

bool ModulationGraph::canConnect(PortRef source, PortRef dest) const {
    // 1. Dirección
    if (source.direction_ != PortDirection::Output) return false;
    if (dest.direction_ != PortDirection::Input) return false;
    
    // 2. Tipos de señal
    auto srcType = source.info().signalType;
    auto dstType = dest.info().signalType;
    
    // Conversiones permitidas implícitas
    if (srcType == dstType) return true;
    if (srcType == SignalType::Audio && dstType == SignalType::Control) {
        // Audio → Control: necesita nodo de conversión (RMS, peak, etc.)
        return false;  // Sugerir nodo Abs/Average
    }
    if (srcType == SignalType::Control && dstType == SignalType::Audio) {
        // Control → Audio: OK con hold o interpolación
        return true;
    }
    if (srcType == SignalType::Pitch && dstType == SignalType::Audio) {
        // Pitch → Audio: conversión a frecuencia
        return false;  // Sugerir nodo PitchToFreq
    }
    
    // 3. Ciclo?
    if (wouldCreateCycle(source.node(), dest.node())) {
        // Sugerir FeedbackInput/Output
        return false;
    }
    
    return true;
}




