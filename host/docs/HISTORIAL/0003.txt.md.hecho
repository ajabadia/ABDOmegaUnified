// Source/UI/Components/ModulationGraphEditor.h
#pragma once
#include <juce_gui_extra/juce_gui_extra.h>
#include "../../Core/Modulation/ModulationGraphAPI.h"

namespace Omega::UI {

// ============================================================
// RENDERIZADO DE NODOS
// ============================================================

struct NodeVisualStyle {
    juce::Colour headerColor;
    juce::Colour bodyColor;
    juce::Colour borderColor;
    float cornerRadius = 4.0f;
    float headerHeight = 24.0f;
    float portDiameter = 10.0f;
    float portSpacing = 20.0f;
};

class NodeComponent : public juce::Component {
public:
    NodeComponent(Modulation::API::NodeHandle node,
                  ModulationGraphEditor& editor);
    
    void paint(juce::Graphics& g) override;
    void resized() override;
    
    // Interacción
    void mouseDown(const juce::MouseEvent& e) override;
    void mouseDrag(const juce::MouseEvent& e) override;
    void mouseUp(const juce::MouseEvent& e) override;
    void mouseDoubleClick(const juce::MouseEvent& e) override;
    
    // Puertos
    juce::Point<float> getInputPortPosition(int index) const;
    juce::Point<float> getOutputPortPosition(int index) const;
    int getInputPortAt(const juce::Point<float>& pos) const;
    int getOutputPortAt(const juce::Point<float>& pos) const;
    
    // Acceso
    Modulation::API::NodeHandle getNode() const { return node_; }
    void updateFromNode();  // Refrescar desde modelo
    
private:
    Modulation::API::NodeHandle node_;
    ModulationGraphEditor& editor_;
    NodeVisualStyle style_;
    
    juce::ComponentDragger dragger_;
    bool isSelected_ = false;
    
    // Cache de info de puertos
    std::vector<Modulation::API::PortInfo> inputs_;
    std::vector<Modulation::API::PortInfo> outputs_;
    
    void drawPort(juce::Graphics& g, const juce::Point<float>& center,
                  const Modulation::API::PortInfo& info, bool isConnected);
};

// ============================================================
// EDITOR PRINCIPAL
// ============================================================

class ModulationGraphEditor : public juce::Component,
                               public juce::AsyncUpdater,
                               public Modulation::API::ModulationGraph::GraphModifiedCallback
{
public:
    using GraphPtr = std::shared_ptr<Modulation::API::ModulationGraph>;
    
    explicit ModulationGraphEditor(GraphPtr graph);
    ~ModulationGraphEditor() override;
    
    void paint(juce::Graphics& g) override;
    void resized() override;
    
    // AsyncUpdater: cambios desde audio thread o message thread
    void handleAsyncUpdate() override;
    
    // Callback de modificación del grafo
    void operator()() override { triggerAsyncUpdate(); }
    
    // Interacción global
    void mouseDown(const juce::MouseEvent& e) override;
    void mouseDrag(const juce::MouseEvent& e) override;
    void mouseUp(const juce::MouseEvent& e) override;
    
    // Acciones
    void createNodeAt(const juce::Point<float>& pos, 
                      Modulation::API::NodeType type);
    void deleteSelectedNodes();
    void beginConnectionDrag(int outputPort, NodeComponent* sourceNode);
    void endConnectionDrag(int inputPort, NodeComponent* destNode);
    void cancelConnectionDrag();
    
    // Selección
    void selectNode(NodeComponent* node, bool addToSelection = false);
    void clearSelection();
    std::vector<NodeComponent*> getSelectedNodes() const;
    
    // Vista
    void zoomToFit();
    void setZoom(float scale);
    juce::Point<float> screenToGraph(const juce::Point<float>& screen) const;
    juce::Point<float> graphToScreen(const juce::Point<float>& graph) const;
    
    // Acceso
    GraphPtr getGraph() const { return graph_; }
    
private:
    GraphPtr graph_;
    
    // Componentes hijo
    juce::OwnedArray<NodeComponent> nodeComponents_;
    std::unique_ptr<juce::Viewport> viewport_;
    
    // Estado de interacción
    enum class DragMode { None, MoveNodes, CreateConnection, Pan, BoxSelect };
    DragMode dragMode_ = DragMode::None;
    
    struct ConnectionDragState {
        juce::Point<float> startPos;
        juce::Point<float> currentPos;
        NodeComponent* sourceNode = nullptr;
        int sourcePort = -1;
    } connectionDrag_;
    
    // Selección
    std::set<NodeComponent*> selection_;
    
    // Transformación de vista
    juce::AffineTransform viewTransform_;
    float zoom_ = 1.0f;
    juce::Point<float> panOffset_;
    
    // Feedback paths (para renderizado especial)
    std::vector<juce::Path> feedbackPaths_;
    
    // Helpers
    void rebuildNodeComponents();
    NodeComponent* findComponentForNode(Modulation::API::NodeId id);
    void updateFeedbackPaths();
    void drawGrid(juce::Graphics& g);
    void drawConnectionPreview(juce::Graphics& g);
    void drawFeedbackPaths(juce::Graphics& g);
};

} // namespace Omega::UI
