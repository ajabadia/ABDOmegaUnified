⚡ ¿POR DÓNDE EMPIEZAS REALMENTE?
Paso 0: Decisión de arquitectura
Antes de escribir código, define en pseudocódigo:
cpp
Copy
// ¿Cómo se ve un componente ACE en código?
class IComponent {
public:
    virtual ~IComponent() = default;
    virtual void process(AudioBlock& block, const ModulationValues& mod) = 0;
    virtual std::vector<ModTarget> getModulationTargets() const = 0;
    virtual ComponentInfo getInfo() const = 0;
};

// ¿Cómo se compone una voz?
class ComposedVoice : public IVoice {
    std::vector<std::unique_ptr<IOscillator>> oscillators;
    std::vector<std::unique_ptr<IFilter>> filters;
    // ... etc
    ModulationGraph modGraph;  // Cada voz tiene su grafo
};
Paso 1: AceCatalog funcional
cpp
Copy
// Source/Core/Ace/AceCatalog.h
namespace Omega::Ace {

struct ParameterDef {
    juce::String id;
    juce::String label;
    juce::String unit;
    float min, max, defaultValue;
};

struct ModTarget {
    juce::String id;
    juce::String label;
    juce::String unit;
};

struct ComponentInfo {
    juce::String id;           // "OSC-VA-001"
    juce::String name;
    juce::String family;       // "Oscillator", "Filter", etc.
    juce::String engine;       // "VirtualAnalog"
    juce::String modelId;      // "RolandJunoDco"
    juce::String origin;       // "Roland Juno-106"
    int version = 1;
    juce::String status;       // "active", "deprecated", "experimental"
    juce::StringArray tags;
    std::vector<ParameterDef> parameters;
    std::vector<ModTarget> modulationTargets;
};

class AceCatalog {
public:
    static std::unique_ptr<AceCatalog> createFromResources();
    
    const ComponentInfo* getComponent(const juce::String& id) const noexcept;
    std::vector<const ComponentInfo*> listByFamily(const juce::String& family) const;
    std::vector<const ComponentInfo*> listByEngine(const juce::String& engine) const;
    
    juce::String getFallbackFor(const juce::String& family, 
                                const juce::String& engine) const;
    
    bool isDeprecated(const juce::String& id) const noexcept;
    juce::String getReplacement(const juce::String& id) const; // empty if none
    
private:
    juce::HashMap<juce::String, ComponentInfo> components;
    std::map<std::pair<juce::String, juce::String>, juce::String> fallbacks;
    std::map<juce::String, juce::String> deprecatedReplacements;
};

} // namespace Omega::Ace
Paso 2: YAML de catálogo que cargue
Ya lo tienes en los documentos. Asegúrate de que:
Se parsea sin errores
Los fallbacks están definidos
Hay componentes genéricos para cada familia
Paso 3: OmegaPreset que use AceCatalog
cpp
Copy
// Source/Core/Preset/OmegaPreset.h
namespace Omega::Preset {

struct OscillatorSlot {
    juce::String componentId;  // "OSC-VA-001"
    bool enabled = true;
    std::map<juce::String, float> parameters;  // tune, pulse_width, etc.
};

struct FilterSlot {
    juce::String componentId;
    juce::String mode;  // "LP24", "HP+LP Series", etc.
    bool enabled = true;
    std::map<juce::String, float> parameters;
};

struct VoiceArchitecture {
    juce::String engine;  // "VirtualAnalog"
    int polyphony = 16;
    std::vector<OscillatorSlot> oscillators;
    std::vector<FilterSlot> filters;
    // ... envelopes, lfos, fx
};

struct ModulationRoute {
    juce::String source;       // "ENV1", "LFO1", "ModWheel"
    juce::String destination;  // "LayerA.Filter1.cutoff"
    float amount = 0.0f;
    juce::String curve;        // "linear", "exponential", "s-curve"
    bool bipolar = false;
};

struct Layer {
    juce::String id;           // "A", "B"
    juce::String name;
    VoiceArchitecture voiceArch;
    std::vector<ModulationRoute> modulation;
    float levelDb = 0.0f;
    float pan = 0.0f;
};

class OmegaPreset {
public:
    static OmegaPreset createEmpty(const juce::String& engine = "VirtualAnalog");
    static OmegaPreset fromValueTree(const juce::ValueTree& tree);
    static OmegaPreset fromYaml(const juce::String& yaml);
    
    juce::ValueTree toValueTree() const;
    juce::String toYaml() const;
    
    // Accesores
    juce::String getEngine() const;
    void setEngine(const juce::String& engine);
    
    std::vector<Layer> getLayers() const;
    void addLayer(const Layer& layer);
    void removeLayer(const juce::String& id);
    
    // Metadata
    juce::String getName() const;
    void setName(const juce::String& name);
    
private:
    juce::ValueTree root;
};

} // namespace Omega::Preset
Paso 4: Validador que conecte ambos
cpp
Copy
// Source/Core/Ace/AceValidator.h
namespace Omega::Ace {

enum class ValidationStatus { Ok, Degraded, Invalid };

struct ValidationIssue {
    ValidationStatus severity;
    juce::String scope;      // "Preset", "LayerA", "LayerA.Osc1"
    juce::String code;       // "UnknownComponent", "InvalidParameter", etc.
    juce::String message;
};

struct ValidationReport {
    ValidationStatus status;
    std::vector<ValidationIssue> issues;
};

class AceValidator {
public:
    explicit AceValidator(const AceCatalog& catalog);
    
    // Valida y opcionalmente corrige in-place
    ValidationReport validateAndRepair(Preset::OmegaPreset& preset);
    
private:
    const AceCatalog& catalog;
    
    ValidationReport validateLayer(Preset::Layer& layer);
    ValidationReport validateVoiceArch(Preset::VoiceArchitecture& arch);
    ValidationReport validateComponentSlot(const juce::String& slotType,
                                           const juce::String& componentId,
                                           std::map<juce::String, float>& params);
    ValidationReport validateModulation(const std::vector<Preset::ModulationRoute>& routes,
                                        const Preset::VoiceArchitecture& arch);
};

} // namespace Omega::Ace








Voy a diseñar el flujo completo del audio thread, mostrando exactamente cómo se conectan ACE, OmegaPreset, ModulationGraph y los engines sin violar ninguna de las reglas de thread-safety que estableciste.
🎯 PRINCIPIO DIRECTOR: "El audio thread solo ejecuta"
plain
Copy
┌─────────────────────────────────────────────────────────────────┐
│  MESSAGE/BACKGROUND THREAD                                       │
│  ├── Carga preset YAML → OmegaPreset                           │
│  ├── AceValidator::validateAndRepair()                         │
│  ├── VoiceFactory::createRuntime() → VoiceArchitectureRuntime  │
│  ├── ModulationGraph::compile() → ModulationRuntime            │
│  ├── EngineConfig snapshot                                     │
│  └── SWAP ATÓMICO ─────────────────────────────────────────┐   │
│                                                            │   │
├────────────────────────────────────────────────────────────┼───┤
│  AUDIO THREAD (lock-free, wait-free, zero allocation)      │   │
│  ├── Carga EngineConfig* atómico ◄─────────────────────────┘   │
│  ├── Para cada bloque:                                         │
│  │   ├── VoiceManager::renderBlock()                          │
│  │   │   ├── ModulationRuntime::updateSources()                │
│  │   │   ├── ModulationRuntime::applyToDestinations()          │
│  │   │   └── Cada voz: VoiceRuntime::process()                │
│  │   ├── EngineRouter::mixLayers()                              │
│  │   └── FXMaster::process()                                    │
│  └── NUNCA: YAML, ValueTree, strings, allocation, locks        │
└─────────────────────────────────────────────────────────────────┘
🏗️ ESTRUCTURAS DEL AUDIO THREAD
1. VoiceRuntime (snapshot inmutable de una voz)
cpp
Copy
// Source/DSP/Voices/VoiceRuntime.h
#pragma once
#include <array>
#include <atomic>
#include <cstddef>
#include <span>

namespace Omega::DSP::Voices {

// Forward declarations
class IOscillator;
class IFilter;
class IEnvelope;
class ILfo;
class IFXModule;

// Aligned para SIMD, sin punteros a objetos de fuera
struct alignas(64) VoiceRuntime {
    // Estado de la voz (solo atomics y valores simples)
    struct State {
        std::atomic<bool> active{false};
        std::atomic<uint64_t> timestamp{0};
        std::atomic<int> midiNote{-1};
        std::atomic<float> velocity{0.0f};
        std::atomic<float> currentPitch{0.0f};  // Hz, con bend aplicado
        std::atomic<float> currentGain{0.0f};   // 0..1, para voice stealing fade
    } state;

    // Buffers pre-alocados (interleaved para cache-friendly)
    // Cada voz procesa en su propio buffer pequeño, luego se mezcla
    static constexpr int kMaxBlockSize = 256;
    alignas(32) std::array<float, kMaxBlockSize * 2> buffer;  // stereo interleaved
    
    // Cadena DSP: índices en arrays globales, no punteros a heap
    struct OscillatorSlot {
        uint16_t oscillatorIndex;  // Índice en pool global de osciladores
        uint16_t parameterOffset;  // Offset en tabla de parámetros atómicos
        bool enabled;
    };
    std::array<OscillatorSlot, 4> oscillators;
    
    struct FilterSlot {
        uint16_t filterIndex;
        uint16_t parameterOffset;
        uint8_t mode;  // 0=LP12, 1=LP24, 2=HP12, etc.
        bool enabled;
    };
    std::array<FilterSlot, 2> filters;
    
    struct EnvelopeSlot {
        uint16_t envelopeIndex;
        uint16_t outputIndex;  // Índice en array de salidas de modulación
        uint8_t stage;         // 0=idle, 1=attack, 2=decay, 3=sustain, 4=release
    };
    std::array<EnvelopeSlot, 4> envelopes;
    
    struct LfoSlot {
        uint16_t lfoIndex;
        uint16_t outputIndex;
    };
    std::array<LfoSlot, 4> lfos;
    
    struct FXSlot {
        uint16_t fxIndex;
        uint16_t parameterOffset;
        bool enabled;
    };
    std::array<FXSlot, 4> voiceFX;  // FX por voz, no master

    // Routing: índices en buffer de conexiones
    // Ejemplo: oscillators[0] → filterInput[0], filterOutput[0] → ampInput
    std::array<uint8_t, 8> routing;  // Compacto, pre-calculado
    
    // No hay: punteros a objetos externos, strings, allocation
};

// Pool de voces pre-alocadas
class VoicePool {
public:
    static constexpr int kMaxVoices = 32;
    
    void prepare(double sampleRate, int maxBlockSize);
    
    // Obtener voz por índice (nunca alloc)
    VoiceRuntime& getVoice(int index) noexcept { return voices[index]; }
    const VoiceRuntime& getVoice(int index) const noexcept { return voices[index]; }
    
    // Reset de todas las voces (llamado en cambio de preset)
    void resetAll() noexcept;
    
private:
    alignas(64) std::array<VoiceRuntime, kMaxVoices> voices;
    double sampleRate = 48000.0;
    int maxBlockSize = 256;
};

} // namespace Omega::DSP::Voices
2. ModulationRuntime (grafo compilado para audio thread)
cpp
Copy
// Source/DSP/Modulation/ModulationRuntime.h
#pragma once
#include <array>
#include <atomic>
#include <cstdint>

namespace Omega::DSP::Modulation {

// Tipos de señal como en tu diseño
enum class SignalType : uint8_t {
    Control,    // 0-1, lento, por bloque
    Audio,      // -1..1, audio-rate, por sample
    Trigger,    // edge events
    Pitch,      // semitones
    Phase       // 0-2π
};

// Nodo compilado: solo índices y funciones de proceso
struct ModNodeRuntime {
    uint16_t sourceIndex;      // Índice en array de fuentes
    uint16_t destParameter;    // Índice en tabla de parámetros atómicos
    float amount;
    uint8_t curveType;         // 0=linear, 1=exp, 2=log, 3=s-curve, etc.
    bool bipolar;
    SignalType type;
    
    // Curva precalculada como LUT para no computar en audio thread
    // o puntero a función inline si es simple
};

// Fuente de modulación: valor actual (escrito por generadores, leído por rutas)
struct ModSourceValue {
    std::atomic<float> current;      // Valor actual
    std::atomic<float> previous;     // Para detección de cambio (triggers)
    SignalType type;
};

// Tabla de parámetros modulables: cada destino tiene su valor base + modulado
struct ModulatedParameter {
    std::atomic<float> baseValue;      // Valor del parámetro (desde UI/preset)
    std::atomic<float> modulated;      // Valor final (base + suma de mods)
    float min, max;                    // Rango para clamp
    bool modulatable;                  // Si acepta modulación externa
};

class ModulationRuntime {
public:
    static constexpr int kMaxSources = 64;      // ENV1-4, LFO1-4, ModWheel, etc.
    static constexpr int kMaxDestinations = 256; // Parámetros de todos los componentes
    static constexpr int kMaxRoutes = 128;       // Conexiones source→dest
    
    void prepare(double sampleRate, int blockSize);
    
    // Llamado al inicio de cada bloque: actualiza todas las fuentes
    // Las fuentes "externas" (MIDI) ya están escritas por OmegaInput
    void updateSources(AudioBlock& block, const VoiceRuntime& voice) noexcept;
    
    // Aplica todas las rutas: suma modulación a parámetros destino
    void applyModulation() noexcept;
    
    // Acceso a parámetro modulado por índice (O(1))
    float getModulatedParameter(uint16_t index) const noexcept {
        return parameters[index].modulated.load(std::memory_order_relaxed);
    }
    
    // Escritura desde UI (message thread) vía atomic
    void setBaseParameter(uint16_t index, float value) noexcept {
        parameters[index].baseValue.store(value, std::memory_order_relaxed);
    }
    
    // Escritura desde fuentes de modulación (MIDI, etc.)
    void setSourceValue(uint16_t index, float value) noexcept {
        sources[index].current.store(value, std::memory_order_relaxed);
    }
    
    // Construcción (solo desde message thread)
    void compileFromGraph(const class ModulationGraph& graph, 
                          const class VoiceArchitecture& arch);
    
private:
    // Arrays fijos, pre-alocados
    std::array<ModSourceValue, kMaxSources> sources;
    std::array<ModulatedParameter, kMaxDestinations> parameters;
    std::array<ModNodeRuntime, kMaxRoutes> routes;
    uint16_t activeRouteCount = 0;
    
    double sampleRate;
    int blockSize;
    
    // LUTs de curvas precalculadas (evitan sqrt/pow en audio thread)
    alignas(64) std::array<float, 256> expCurveLUT;
    alignas(64) std::array<float, 256> logCurveLUT;
    alignas(64) std::array<float, 256> sCurveLUT;
    
    float applyCurve(float value, uint8_t curveType) const noexcept;
};

// Bloque de audio para procesamiento (vista no-propietaria)
struct AudioBlock {
    float* const left;
    float* const right;
    const int numSamples;
    const double sampleRate;
    
    // Acceso interleaved si es necesario
    float* interleaved() const { 
        // Asume buffer interleaved stereo
        return left; // left apunta al inicio del buffer interleaved
    }
};

} // namespace Omega::DSP::Modulation
3. EngineConfig (snapshot global para audio thread)
cpp
Copy
// Source/Core/EngineConfig.h
#pragma once
#include <array>
#include <atomic>
#include <cstdint>
#include <memory>

namespace Omega::DSP::Voices { class VoicePool; }
namespace Omega::DSP::Modulation { class ModulationRuntime; }
namespace Omega::DSP::Engines { class IEngine; }
namespace Omega::DSP::FX { class IFXModule; }

namespace Omega::Core {

// Configuración inmutable para una capa (layer)
struct LayerRuntime {
    uint8_t layerId;           // 'A', 'B', etc.
    uint16_t voiceStartIndex;    // Índice inicial en VoicePool
    uint16_t voiceCount;         // Número de voces para esta capa
    float levelDb;
    float pan;
    bool enabled;
    
    // Cada layer puede tener engine diferente (VA, Spectral, etc.)
    // Índice en array de engines, no puntero directo
    uint8_t engineIndex;
    
    // ModulationRuntime específico de esta layer (o compartido si es igual)
    uint16_t modulationRuntimeIndex;
};

// Configuración global del audio thread
// Se construye en background y se swappea atómicamente
struct alignas(64) EngineConfig {
    // Versión para detectar cambios (ABA-safe con seqlock o similar)
    std::atomic<uint64_t> version{0};
    
    // Estado global
    float masterGainDb = 0.0f;
    uint8_t activeLayerCount = 0;
    
    // Layers (máximo 4 en MVP)
    std::array<LayerRuntime, 4> layers;
    
    // Índices en pools globales (no punteros a objetos de fuera)
    // Los objetos reales viven en el AudioProcessor y son stable
    uint16_t voicePoolIndex;           // Qué VoicePool usar
    uint16_t masterFXRackIndex;        // FX master
    
    // Parámetros de engine por índice (para engines que comparten config)
    std::array<float, 16> engineGlobalParams;
    
    // No hay: punteros a heap, strings, objetos JUCE, etc.
};

// Gestión del swap atómico
class EngineConfigManager {
public:
    // Llamado desde message thread para preparar nuevo config
    void prepareNextConfig(std::unique_ptr<EngineConfig> newConfig);
    
    // Llamado desde audio thread para obtener config actual
    // Usa memory_order_acquire
    const EngineConfig* getCurrentConfig() const noexcept {
        return currentConfig.load(std::memory_order_acquire);
    }
    
    // Llamado desde message thread cuando es seguro (audio no corriendo o en sync point)
    // Retorna config anterior para destrucción deferred
    std::unique_ptr<EngineConfig> commitConfig() noexcept;
    
    // Para destrucción segura (deferred deletion)
    void cleanupOldConfigs();
    
private:
    // Triple buffering: current, next, pending cleanup
    std::atomic<EngineConfig*> currentConfig{nullptr};
    EngineConfig* nextConfig = nullptr;
    std::vector<std::unique_ptr<EngineConfig>> oldConfigs;  // Para delete deferred
};

} // namespace Omega::Core
🔧 IMPLEMENTACIÓN DEL AUDIO THREAD
4. OmegaAudioProcessor::processBlock (el centro de todo)
cpp
Copy
// Source/Plugin/Processor.cpp (extracto del audio thread)

void OmegaAudioProcessor::processBlock(juce::AudioBuffer<float>& buffer, 
                                          juce::MidiBuffer& midiMessages)
{
    // 1. OBTENER CONFIG ATÓMICAMENTE (lock-free)
    const auto* config = configManager.getCurrentConfig();
    if (config == nullptr) [[unlikely]] {
        buffer.clear();  // Silencio si no hay config
        return;
    }
    
    // 2. PROCESAR MIDI DE ENTRADA (adaptadores escriben a OmegaInput)
    // Esto actualiza fuentes de modulación en ModulationRuntime vía atomics
    midiInputAdapter.processBlock(midiMessages, *inputState);
    
    // 3. APLICAR ENTRADA A TODAS LAS FUENTES DE MODULACIÓN
    // Por cada layer, por cada voz activa
    for (int li = 0; li < config->activeLayerCount; ++li) {
        const auto& layer = config->layers[li];
        if (!layer.enabled) continue;
        
        auto& voicePool = voicePools[layer.voicePoolIndex];
        auto& modRuntime = modulationRuntimes[layer.modulationRuntimeIndex];
        
        // Aplicar fuentes globales de MIDI a este layer
        applyGlobalModulation(*inputState, modRuntime, layer.layerId);
        
        // 4. RENDERIZAR VOCES
        for (int vi = 0; vi < layer.voiceCount; ++vi) {
            int voiceIdx = layer.voiceStartIndex + vi;
            auto& voice = voicePool.getVoice(voiceIdx);
            
            if (!voice.state.active.load(std::memory_order_relaxed)) 
                continue;
            
            // 4a. ACTUALIZAR FUENTES DE MODULACIÓN DE ESTA VOZ
            // Envelopes, LFOs internos, etc.
            modRuntime.updateSourcesForVoice(voice, voiceIdx);
            
            // 4b. APLICAR MODULACIÓN A PARÁMETROS
            modRuntime.applyModulationForVoice(voiceIdx);
            
            // 4c. PROCESAR CADENA DSP DE LA VOZ
            processVoice(voice, modRuntime, buffer.getNumSamples());
        }
    }
    
    // 5. MEZCLAR LAYERS Y APLICAR FX MASTER
    mixLayers(*config, buffer);
    applyMasterFX(*config, buffer);
    
    // 6. OUTPUT (posiblemente con soft-clip/saturación)
    sanitizeOutput(buffer);
}

void OmegaAudioProcessor::processVoice(VoiceRuntime& voice,
                                        ModulationRuntime& mod,
                                        int numSamples)
{
    // Buffer temporal de esta voz (pre-alocado en VoiceRuntime)
    float* voiceBuffer = voice.buffer.data();
    
    // 1. OSCILADORES
    for (const auto& osc : voice.oscillators) {
        if (!osc.enabled) continue;
        
        // Obtener parámetros modulados O(1)
        float pitch = mod.getModulatedParameter(osc.parameterOffset + 0);  // tune
        float shape = mod.getModulatedParameter(osc.parameterOffset + 1);  // shape/pw
        
        // Índice a oscilador real en pool global
        auto& oscillator = oscillatorPool.get(osc.oscillatorIndex);
        
        // Procesar al buffer temporal
        oscillator.process(voiceBuffer, numSamples, pitch, shape);
    }
    
    // 2. FILTROS (con routing desde osciladores)
    for (const auto& flt : voice.filters) {
        if (!flt.enabled) continue;
        
        float cutoff = mod.getModulatedParameter(flt.parameterOffset + 0);
        float resonance = mod.getModulatedParameter(flt.parameterOffset + 1);
        float drive = mod.getModulatedParameter(flt.parameterOffset + 2);
        
        auto& filter = filterPool.get(flt.filterIndex);
        
        // Modo seleccionado por índice (LP12, LP24, HP+LP, etc.)
        filter.process(voiceBuffer, numSamples, cutoff, resonance, drive, flt.mode);
    }
    
    // 3. AMPLIFICADOR/ENVOLVENTE
    float ampEnv = mod.getModulatedParameter(voice.envelopes[0].outputIndex);
    applyGain(voiceBuffer, numSamples, ampEnv * voice.state.currentGain.load());
    
    // 4. FX POR VOZ (si hay)
    for (const auto& fx : voice.voiceFX) {
        if (!fx.enabled) continue;
        auto& effect = fxPool.get(fx.fxIndex);
        effect.process(voiceBuffer, numSamples);
    }
    
    // 5. MEZCLAR A OUTPUT PRINCIPAL (con pan y level de layer)
    // Esto se hace en mixLayers, aquí solo preparamos
}
5. VoiceManager (gestión de notas, lock-free)
cpp
Copy
// Source/DSP/Voices/VoiceManager.h
#pragma once
#include <array>
#include <atomic>
#include <cstdint>

namespace Omega::DSP::Voices {

class VoiceManager {
public:
    static constexpr int kMaxVoices = 32;
    
    // Estructura de estado compartida (solo atomics)
    struct alignas(64) VoiceSlot {
        std::atomic<bool> active{false};
        std::atomic<uint64_t> timestamp{0};
        std::atomic<int> noteNumber{-1};
        std::atomic<float> velocity{0.0f};
        std::atomic<int> channel{0};
        std::atomic<uint32_t> voiceId{0};  // ID único global para tracking
    };
    
    void prepare(int numVoices, double sampleRate);
    
    // Llamado desde message thread (o MIDI thread con lock-free queue)
    // Encola comando, no toca audio directamente
    void noteOn(int note, float velocity, int channel, uint32_t timestamp) noexcept;
    void noteOff(int note, int channel, uint32_t timestamp) noexcept;
    void allNotesOff() noexcept;
    
    // Llamado desde audio thread: aplica comandos encolados
    void processPendingCommands(VoicePool& pool, 
                                std::atomic<uint32_t>& globalVoiceCounter) noexcept;
    
    // Voice stealing: estrategia por timestamp (más musical)
    int findVoiceToSteal() const noexcept;
    
    // Estado para UI/visualización (solo lectura, relaxed)
    int getActiveVoiceCount() const noexcept;
    void getVoiceStates(std::span<VoiceSlot> outStates) const;
    
private:
    // Lock-free queue de comandos (SPSC: MIDI thread → audio thread)
    struct Command {
        enum Type { NoteOn, NoteOff, AllOff } type;
        int note;
        float velocity;
        int channel;
        uint32_t timestamp;
    };
    
    static constexpr int kCommandQueueSize = 64;
    alignas(64) std::array<Command, kCommandQueueSize> commandBuffer;
    std::atomic<uint32_t> writeIndex{0};
    std::atomic<uint32_t> readIndex{0};
    
    std::array<VoiceSlot, kMaxVoices> slots;
    int configuredVoices = 16;
    
    // Helper para SPSC queue
    bool pushCommand(const Command& cmd) noexcept;
    bool popCommand(Command& cmd) noexcept;
};

} // namespace Omega::DSP::Voices
6. OmegaInput (capa de expresión neutral)
cpp
Copy
// Source/Core/Input/OmegaInput.h
#pragma once
#include <array>
#include <atomic>
#include <cstdint>

namespace Omega::Core::Input {

// Fuentes de expresión por voz (MPE/MIDI 2.0)
struct PerNoteExpression {
    std::atomic<float> pitchBend{0.0f};      // semitones, ±range
    std::atomic<float> pressure{0.0f};       // 0..1
    std::atomic<float> timbre{0.0f};         // 0..1 (CC74 en MPE)
    std::atomic<float> brightness{0.0f};      // extensión MIDI 2.0
};

// Fuentes de expresión por canal/layer
struct ChannelExpression {
    std::atomic<float> modWheel{0.0f};      // 0..1
    std::atomic<float> pitchBend{0.0f};      // semitones (global)
    std::atomic<float> channelPressure{0.0f}; // 0..1
    std::atomic<float> expression{0.0f};      // CC11, 0..1
    std::atomic<float> sustain{0.0f};         // 0/1, con hysteresis
    std::atomic<float> macros[8];            // Performance knobs
};

// Estado global de entrada (escrito por adaptadores MIDI, leído por audio thread)
class InputState {
public:
    static constexpr int kMaxNotes = 128;      // MIDI note range
    static constexpr int kMaxChannels = 16;  // MIDI channels
    
    // Por nota activa (indexada por noteId interno, no MIDI note)
    std::array<PerNoteExpression, kMaxNotes> perNote;
    
    // Por canal MIDI
    std::array<ChannelExpression, kMaxChannels> perChannel;
    
    // Global
    std::atomic<float> masterPitchBend{0.0f};
    
    // Mapeo noteId → índice en perNote (gestionado por VoiceManager)
    void mapNoteToIndex(uint32_t voiceId, int noteIndex) noexcept;
    void unmapNote(uint32_t voiceId) noexcept;
    
    // Acceso rápido para audio thread
    PerNoteExpression& getForVoice(uint32_t voiceId) noexcept;
};

// Adaptador base (MIDI 1.0, MPE, MIDI 2.0 heredan de esto)
class IInputAdapter {
public:
    virtual ~IInputAdapter() = default;
    
    // Procesa MIDI y escribe a InputState (llamado desde processBlock)
    virtual void processBlock(const juce::MidiBuffer& midi,
                              InputState& state) = 0;
    
    // Configuración de mapeo (CC → ModSource, etc.)
    virtual void setMapping(const class MidiMapping& mapping) = 0;
};

} // namespace Omega::Core::Input
🔄 FLUJO COMPLETO: CARGA DE PRESET A AUDIO
plain
Copy
┌─────────────────────────────────────────────────────────────────┐
│  1. USUARIO CARGA PRESET "Hybrid MS20+Juno"                    │
│     (desde UI, desde archivo, desde Git checkout)              │
├─────────────────────────────────────────────────────────────────┤
│  2. MESSAGE THREAD                                               │
│     ├── OmegaPreset::fromYaml() → ValueTree                     │
│     ├── AceValidator::validateAndRepair()                       │
│     │   ├── Reemplaza componentes deprecated                    │
│     │   ├── Aplica fallbacks si faltan                          │
│     │   └── Marca DEGRADED si hubo cambios                      │
│     │                                                           │
│     ├── VoiceFactory::createRuntime()                           │
│     │   ├── Para cada layer:                                    │
│     │   │   ├── Lee VoiceArchitecture (component_ids)           │
│     │   │   ├── Consulta AceCatalog → model_ids                 │
│     │   │   ├── Reserva índices en pools globales               │
│     │   │   └── Construye VoiceRuntime (índices, no punteros)    │
│     │   │                                                       │
│     │   └── ModulationGraph::compile()                          │
│     │       ├── Resuelve nombres → índices                      │
│     │       ├── Detecta ciclos, ordena topológicamente          │
│     │       └── Crea ModulationRuntime (arrays fijos)            │
│     │                                                           │
│     ├── EngineConfig::buildFromLayers()                          │
│     │   ├── LayerRuntime A: engine=VA, voices=0-15              │
│     │   ├── LayerRuntime B: engine=VA, voices=16-31             │
│     │   └── Referencias a índices de pools                      │
│     │                                                           │
│     └── configManager.prepareNextConfig(config)                 │
│         └── Guarda puntero en nextConfig                        │
├─────────────────────────────────────────────────────────────────┤
│  3. SYNC POINT (entre bloques de audio)                          │
│     ├── Audio thread detecta flag de nuevo config               │
│     ├── Termina bloque actual limpiamente                      │
│     └── configManager.commitConfig()                            │
│         └── atomic_store(currentConfig, nextConfig)              │
├─────────────────────────────────────────────────────────────────┤
│  4. AUDIO THREAD (siguiente processBlock)                        │
│     ├── config = getCurrentConfig() // ve nueva config           │
│     ├── Procesa con nuevas voces, nuevos componentes           │
│     └── Sin glitches, sin allocation, sin locks                  │
├─────────────────────────────────────────────────────────────────┤
│  5. CLEANUP (message thread posterior)                          │
│     └── configManager.cleanupOldConfigs()                        │
│         └── delete config anterior de forma segura               │
└─────────────────────────────────────────────────────────────────┘
