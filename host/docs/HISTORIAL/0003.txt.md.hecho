-- Source/Scripting/LuaBindings.cpp

-- Ejemplo de patch algorítmico en Lua
local omega = require("omega")

-- Crear grafo de modulación
local graph = omega.ModulationGraph.new()

-- Nodos
local lfo = graph:addLFO{
    name = "Vibrato",
    shape = "sine",
    rate = omega.BPM.sync(1, 4),  -- 1/4 note
    phase = 0
}

local env = graph:addEnvelope{
    name = "Filter Env",
    attack = 10,
    decay = 200,
    sustain = 0.3,
    release = 400,
    curve = "exponential"
}

-- Conexiones (sintaxis fluida)
lfo:output("signal"):to(omega.VOICE_PITCH)
    :withAmount(0.3)
    :withCurve("sine")  -- Curva de modulación, no forma de onda
    :connect()

env:output("level"):to(omega.LAYER_A.Filter1.cutoff)
    :withAmount(0.7)
    :withRange(200, 8000)
    :connect()

-- Secuenciador que modula parámetros
local seq = omega.Seq.new()
    :euclidean(16, 5)
    :mutate(function(evt, step)
        if step % 4 == 0 then
            -- Modificar LFO rate en tiempo real
            lfo:setParameter("rate", 10.0)  -- Rápido en beats fuertes
        else
            lfo:setParameter("rate", 2.0)   -- Lento en beats débiles
        end
        return evt
    end)

-- Aplicar a patch
omega.patch:setModulationGraph(graph)
