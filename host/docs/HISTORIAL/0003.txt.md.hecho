1. ModulationGraphAPI.h - API pública
cpp
Copy
// Source/Core/Modulation/ModulationGraphAPI.h
#pragma once
#include "ModulationGraphTypes.h"
#include <memory>
#include <optional>
#include <expected>

namespace Omega::Core::Modulation::API {

// Forward declarations
class ModulationGraph;
class NodeHandle;
class PortRef;
class ConnectionBuilder;
class GraphTransaction;

// ============================================================
// RESULTADOS DE OPERACIONES (C++23 std::expected, o equivalente)
// ============================================================

enum class GraphError {
    // Errores de nodo
    NodeNotFound,
    NodeTypeNotAvailable,
    MaxNodesReached,           // 32 nodos máximo
    
    // Errores de puerto
    PortNotFound,
    PortAlreadyConnected,      // Input ya tiene conexión (a menos que sea multi)
    PortTypeMismatch,        // Audio → Control sin conversión explícita
    InvalidPortIndex,
    
    // Errores de conexión
    SelfConnection,            // Nodo conectado a sí mismo
    WouldCreateCycle,          // Sin nodos de feedback intermedios
    MaxConnectionsReached,     // 64 conexiones máximo
    
    // Errores de compilación
    UnconnectedRequiredInput,
    UnresolvedFeedbackPath,    // Ciclo sin Delay1 explícito
    GraphTooComplex,
    
    // Errores de estado
    GraphAlreadyCompiled,      // No se puede editar grafo compilado
    GraphNotCompiled,          // No se puede usar sin compilar
    
    // OK
    Success
};

template<typename T>
using GraphResult = std::expected<T, GraphError>;

// ============================================================
// TIPOS DE PUERTO (strong typing para APIs)
// ============================================================

enum class PortDirection { Input, Output };
enum class PortMultiplicity { Single, Multiple };  // Input: single vs multi

// Descriptor de puerto para UI/introspección
struct PortInfo {
    juce::String id;           // "pitch", "rate", "signal"
    juce::String displayName;  // "Pitch (semitones)"
    SignalType signalType;
    PortDirection direction;
    PortMultiplicity multiplicity;
    bool isModulatable;        // Puede recibir conexión externa
    float defaultValue;        // Para inputs no conectados
    std::optional<juce::Range<float>> range;  // Rango válido
};

// ============================================================
// NODE HANDLE (referencia a nodo existente)
// ============================================================

class NodeHandle {
public:
    // Identidad
    NodeId id() const noexcept { return nodeId_; }
    juce::String name() const;
    NodeType type() const noexcept;
    
    // Introspección de puertos
    std::vector<PortInfo> inputs() const;
    std::vector<PortInfo> outputs() const;
    
    // Acceso a puerto específico (para fluent API)
    PortRef input(const juce::String& portId) const;
    PortRef output(const juce::String& portId) const;
    PortRef operator[](const juce::String& portId) const;  // input o output según contexto
    
    // Parámetros del nodo (para UI de configuración)
    GraphResult<void> setParameter(const juce::String& paramId, float value);
    GraphResult<void> setParameter(const juce::String& paramId, int value);
    GraphResult<void> setParameter(const juce::String& paramId, const juce::String& value);
    
    float getFloatParameter(const juce::String& paramId) const;
    int getIntParameter(const juce::String& paramId) const;
    juce::String getStringParameter(const juce::String& paramId) const;
    
    // Estado de conexiones
    bool isInputConnected(const juce::String& portId) const;
    std::vector<NodeHandle> getConnectedSources(const juce::String& inputPortId) const;
    std::vector<NodeHandle> getConnectedDestinations(const juce::String& outputPortId) const;
    
    // Posición en UI (persistente)
    juce::Point<float> uiPosition() const;
    void setUiPosition(juce::Point<float> pos);
    
    // Comparación
    bool operator==(const NodeHandle& other) const noexcept {
        return nodeId_ == other.nodeId_;
    }
    bool operator!=(const NodeHandle& other) const noexcept {
        return !(*this == other);
    }
    
private:
    friend class ModulationGraph;
    friend class PortRef;
    
    NodeHandle(ModulationGraph* graph, NodeId id) 
        : graph_(graph), nodeId_(id) {}
    
    ModulationGraph* graph_;
    NodeId nodeId_;
};

// ============================================================
// PORT REF (referencia a puerto específico para fluent API)
// ============================================================

class PortRef {
public:
    // Construcción de conexión (fluent)
    ConnectionBuilder to(PortRef destination);
    ConnectionBuilder operator>>(PortRef destination);  // Sintaxis: src >> dest
    
    // Info
    PortInfo info() const;
    bool isConnected() const;
    
    // Acceso al nodo padre
    NodeHandle node() const;
    
private:
    friend class NodeHandle;
    friend class ModulationGraph;
    
    PortRef(ModulationGraph* graph, NodeId nodeId, 
            PortDirection dir, uint8_t portIndex)
        : graph_(graph), nodeId_(nodeId), 
          direction_(dir), portIndex_(portIndex) {}
    
    ModulationGraph* graph_;
    NodeId nodeId_;
    PortDirection direction_;
    uint8_t portIndex_;
};

// ============================================================
// CONNECTION BUILDER (configuración de conexión)
// ============================================================

class ConnectionBuilder {
public:
    // Configuración de amount
    ConnectionBuilder& withAmount(float amount);
    ConnectionBuilder& withAmountDb(float db);  // Para ganancias
    ConnectionBuilder& bipolar(bool isBipolar = true);
    
    // Curva de modulación
    ConnectionBuilder& withCurve(CurveType type);
    ConnectionBuilder& withCurve(const juce::String& curveName);
    
    // Rangos de modulación (clamp)
    ConnectionBuilder& withRange(float min, float max);
    
    // Condiciones
    ConnectionBuilder& when(const juce::String& condition);  // "voice.active", "env.stage==2"
    
    // Ejecutar conexión
    GraphResult<ConnectionId> connect();
    
    // Operador de conversión implícita (para sintaxis fluida)
    operator GraphResult<ConnectionId>() { return connect(); }
    
private:
    friend class PortRef;
    
    ConnectionBuilder(ModulationGraph* graph, PortRef source, PortRef dest)
        : graph_(graph), source_(source), dest_(dest) {}
    
    ModulationGraph* graph_;
    PortRef source_;
    PortRef dest_;
    float amount_ = 1.0f;
    bool bipolar_ = false;
    uint8_t curveType_ = 0;  // Linear
    float rangeMin_ = -1.0f, rangeMax_ = 1.0f;
};

// ============================================================
// GRAPH TRANSACTION (cambios atómicos)
// ============================================================

class GraphTransaction {
public:
    explicit GraphTransaction(ModulationGraph& graph);
    ~GraphTransaction();
    
    // No copiable
    GraphTransaction(const GraphTransaction&) = delete;
    GraphTransaction& operator=(const GraphTransaction&) = delete;
    
    // Movable
    GraphTransaction(GraphTransaction&&) noexcept;
    GraphTransaction& operator=(GraphTransaction&&) noexcept;
    
    // Operaciones (se acumulan, se aplican en commit)
    GraphResult<NodeHandle> addNode(NodeType type, const juce::String& name = {});
    GraphResult<void> removeNode(NodeHandle node);
    
    GraphResult<ConnectionId> connect(PortRef source, PortRef dest, 
                                       float amount = 1.0f);
    GraphResult<void> disconnect(ConnectionId id);
    GraphResult<void> disconnect(PortRef source, PortRef dest);
    
    // Commit o rollback
    bool commit();  // true si todo aplicado, false si hubo errores
    void rollback();  // Descarta todos los cambios
    
    // Estado
    bool isValid() const;  // Hay cambios pendientes sin error
    
private:
    ModulationGraph& graph_;
    std::vector<std::function<GraphResult<void>()>> operations_;
    std::vector<std::function<void()>> undoOperations_;
    bool committed_ = false;
};

// ============================================================
// MODULATION GRAPH (contenedor principal)
// ============================================================

class ModulationGraph {
public:
    ModulationGraph();
    ~ModulationGraph();
    
    // No copiable, movable
    ModulationGraph(const ModulationGraph&) = delete;
    ModulationGraph& operator=(const ModulationGraph&) = delete;
    ModulationGraph(ModulationGraph&&) noexcept;
    ModulationGraph& operator=(ModulationGraph&&) noexcept;
    
    // ========================================================
    // CONSTRUCCIÓN DE NODOS
    // ========================================================
    
    // Crear nodo básico
    GraphResult<NodeHandle> addNode(NodeType type, 
                                     const juce::String& name = {});
    
    // Factory methods tipados (más seguros)
    GraphResult<NodeHandle> addLFO(const juce::String& name = {},
                                    LFOShape shape = LFOShape::Sine,
                                    float rateHz = 1.0f);
    
    GraphResult<NodeHandle> addEnvelope(const juce::String& name = {},
                                         float attackMs = 10.0f,
                                         float decayMs = 100.0f,
                                         float sustain = 0.5f,
                                         float releaseMs = 200.0f);
    
    GraphResult<NodeHandle> addMix(const juce::String& name = {},
                                    int numInputs = 2);
    
    GraphResult<NodeHandle> addScale(const juce::String& name = {},
                                    float amount = 1.0f,
                                    float offset = 0.0f);
    
    GraphResult<NodeHandle> addDestination(NodeType destType,  // VoicePitch, FilterCutoff, etc.
                                            const juce::String& targetPath,
                                            const juce::String& name = {});
    
    // Nodos de feedback (para ciclos controlados)
    GraphResult<NodeHandle> addFeedbackInput(const juce::String& name = {});
    GraphResult<NodeHandle> addFeedbackOutput(const juce::String& name = {},
                                               float delaySamples = 1.0f);
    
    // ========================================================
    // CONSULTA Y NAVEGACIÓN
    // ========================================================
    
    NodeHandle getNode(NodeId id);
    std::optional<NodeHandle> findNode(const juce::String& name) const;
    std::vector<NodeHandle> getNodes() const;
    std::vector<NodeHandle> getNodesOfType(NodeType type) const;
    
    // Búsqueda por tag/patrón
    std::vector<NodeHandle> findNodes(const juce::String& namePattern) const;
    
    // ========================================================
    // CONEXIONES
    // ========================================================
    
    // API básica
    GraphResult<ConnectionId> connect(NodeHandle source, uint8_t sourceOutput,
                                       NodeHandle dest, uint8_t destInput,
                                       float amount = 1.0f);
    
    // API fluida (recomendada)
    ConnectionBuilder connect(PortRef source, PortRef dest);
    
    GraphResult<void> disconnect(ConnectionId id);
    GraphResult<void> disconnect(NodeHandle source, NodeHandle dest);
    void disconnectAll(NodeHandle node);  // Desconecta todos los puertos
    
    // Consulta de conexiones
    std::vector<ConnectionId> getConnections() const;
    std::vector<ConnectionId> getConnectionsFrom(NodeHandle source) const;
    std::vector<ConnectionId> getConnectionsTo(NodeHandle dest) const;
    
    // ========================================================
    // VALIDACIÓN Y COMPILACIÓN
    // ========================================================
    
    struct ValidationReport {
        bool isValid;
        std::vector<std::pair<NodeHandle, juce::String>> warnings;
        std::vector<std::pair<NodeHandle, juce::String>> errors;
    };
    
    ValidationReport validate() const;
    
    // Compilación a runtime
    GraphResult<std::unique_ptr<class ModulationRuntime>> compile(
        double sampleRate,
        int maxBlockSize);
    
    // Estado
    bool isCompiled() const;
    bool isModifiedSinceCompile() const;
    
    // ========================================================
    // SERIALIZACIÓN
    // ========================================================
    
    juce::ValueTree toValueTree() const;
    static GraphResult<std::unique_ptr<ModulationGraph>> fromValueTree(
        const juce::ValueTree& tree);
    
    // Para presets ACE
    void serializeToLayer(LayerModulation& layer) const;  // Estructura de preset
    GraphResult<void> deserializeFromLayer(const LayerModulation& layer);
    
    // ========================================================
    // UTILIDADES
    // ========================================================
    
    // Subgrafo: extraer, copiar, pegar
    std::unique_ptr<ModulationGraph> extractSubgraph(
        const std::vector<NodeHandle>& nodes);
    
    GraphResult<void> mergeSubgraph(std::unique_ptr<ModulationGraph> subgraph,
                                     juce::Point<float> positionOffset);
    
    // Análisis
    struct PathAnalysis {
        std::vector<NodeHandle> nodes;
        float totalLatency;
        bool hasFeedback;
    };
    std::vector<PathAnalysis> analyzePathsFrom(NodeHandle source) const;
    std::vector<PathAnalysis> analyzePathsTo(NodeHandle dest) const;
    
    // ========================================================
    // EVENTOS PARA UI (callbacks)
    // ========================================================
    
    using NodeAddedCallback = std::function<void(NodeHandle)>;
    using NodeRemovedCallback = std::function<void(NodeId)>;  // ID porque handle inválido
    using ConnectionAddedCallback = std::function<void(ConnectionId, NodeHandle, NodeHandle)>;
    using ConnectionRemovedCallback = std::function<void(ConnectionId)>;
    using GraphModifiedCallback = std::function<void()>;
    
    void onNodeAdded(NodeAddedCallback cb);
    void onNodeRemoved(NodeRemovedCallback cb);
    void onConnectionAdded(ConnectionAddedCallback cb);
    void onConnectionRemoved(ConnectionRemovedCallback cb);
    void onModified(GraphModifiedCallback cb);  // Cualquier cambio
    
private:
    friend class NodeHandle;
    friend class PortRef;
    friend class ConnectionBuilder;
    friend class GraphTransaction;
    
    class Impl;
    std::unique_ptr<Impl> pImpl_;  // PIMPL para estabilidad de ABI
};

// ============================================================
// SINTAXIS FLUIDA GLOBAL (helpers)
// ============================================================

// Conexión en línea: lfo >> scale >> pitch
inline ConnectionBuilder operator>>(NodeHandle source, NodeHandle dest) {
    return source.output("signal") >> dest.input("signal");
}

// Conexión con amount: lfo * 0.5 >> pitch
inline ConnectionBuilder operator*(NodeHandle source, float amount) {
    return source.output("signal").to(dest.input("signal")).withAmount(amount);
}

// Conexión con curva: lfo >> Curve::Exp >> pitch
// (implementado via nodo intermedio o config de conexión)

} // namespace Omega::Core::Modulation::API
🎨 EJEMPLOS DE USO
Ejemplo 1: Vibrato básico (C++)
cpp
Copy
using namespace Omega::Core::Modulation::API;

// Crear grafo
auto graph = std::make_unique<ModulationGraph>();

// Crear nodos
auto lfo = graph->addLFO("Vibrato LFO", LFOShape::Sine, 5.0f)
    .value();  // GraphResult<NodeHandle> -> NodeHandle

auto scale = graph->addScale("Vibrato Depth", 0.5f, 0.0f).value();
auto pitchDest = graph->addDestination(NodeType::VoicePitch, 
                                        "LayerA.Osc1.pitch",
                                        "Pitch Mod").value();

// Conectar: API fluida
lfo.output("signal") >> scale.input("signal");
scale.output("signal") >> pitchDest.input("pitch");

// O en una línea:
// lfo >> scale >> pitchDest;

// Compilar
auto runtime = graph->compile(48000.0, 256).value();
Ejemplo 2: Envelope a filter con rango (C++)
cpp
Copy
auto env = graph->addEnvelope("Filter Env", 10.0f, 200.0f, 0.3f, 400.0f).value();
auto filterDest = graph->addDestination(NodeType::FilterCutoff,
                                         "LayerA.Filter1.cutoff",
                                         "Filter Mod").value();

// Conexión con configuración explícita
env.output("level")
    .to(filterDest.input("cutoff"))
    .withAmount(0.8f)           // 80% de modulación
    .withCurve(CurveType::Exponential)
    .withRange(200.0f, 8000.0f)  // Filter cutoff range
    .connect();
Ejemplo 3: Feedback delay (C++)
cpp
Copy
auto osc = graph->addNode(NodeType::Oscillator, "Main Osc").value();
auto filter = graph->addNode(NodeType::StateVariableFilter, "Resonant Filter").value();
auto fbIn = graph->addFeedbackInput("Feedback In").value();
auto fbOut = graph->addFeedbackOutput("Feedback Out", 1.0f).value();  // 1 sample delay
auto mix = graph->addMix("Osc+Feedback", 2).value();

// Grafo: osc + fbIn -> mix -> filter -> fbOut -> (ciclo a fbIn)
//                        ↓
//                      output

osc.output("signal") >> mix.input(0);
fbIn.output("signal") >> mix.input(1);
mix.output("mixed") >> filter.input("signal");
filter.output("lowpass") >> fbOut.input("signal");

// El fbOut está conectado internamente a fbIn (ciclo explícito)
// Esto rompe el grafo para toposort: fbIn es "fuente", fbOut es "sink" del ciclo

// Conexión del ciclo (marcada explícitamente)
graph->connectFeedback(fbOut, fbIn);  // Método especial para ciclos
Ejemplo 4: Transacción atómica (C++)
cpp
Copy
// Cambios múltiples que deben aplicarse juntos (o ninguno)
GraphTransaction tx(*graph);

auto lfo1 = tx.addNode(NodeType::LFO, "LFO 1").value();
auto lfo2 = tx.addNode(NodeType::LFO, "LFO 2").value();
auto mix = tx.addMix("LFO Mix", 2).value();

// Si cualquiera falla, todo se descarta
tx.connect(lfo1.output("signal"), mix.input(0), 0.5f);
tx.connect(lfo2.output("signal"), mix.input(1), 0.5f);

if (tx.commit()) {
    // Éxito: ambos LFOs conectados
} else {
    // Fallo: grafo sin cambios
}
Ejemplo 5: Introspección para UI (C++)
cpp
Copy
// Poblar menú de nodos disponibles
for (auto type : getAvailableNodeTypes()) {
    auto descriptor = getNodeDescriptor(type);
    menu.addItem(descriptor.displayName, [this, type]() {
        auto result = graph->addNode(type);
        if (result) {
            selectedNode = result.value();
            repaint();
        } else {
            showError(result.error());
        }
    });
}

// Mostrar puertos de nodo seleccionado
void paintNode(NodeHandle node, Graphics& g) {
    auto pos = node.uiPosition();
    
    // Inputs a la izquierda
    float y = pos.y;
    for (auto& input : node.inputs()) {
        bool connected = node.isInputConnected(input.id);
        g.setColour(connected ? Colours::green : Colours::grey);
        g.fillEllipse(pos.x - 5, y, 10, 10);
        
        g.setColour(Colours::white);
        g.drawText(input.displayName, pos.x + 10, y, 100, 20, Justification::left);
        y += 25;
    }
    
    // Outputs a la derecha
    y = pos.y;
    for (auto& output : node.outputs()) {
        auto dests = node.getConnectedDestinations(output.id);
        g.setColour(!dests.empty() ? Colours::cyan : Colours::grey);
        g.fillEllipse(pos.x + nodeWidth - 5, y, 10, 10);
        y += 25;
    }
}

// Drag de conexión
void mouseDrag(const MouseEvent& e) {
    if (draggingFromPort) {
        // Validación en tiempo real
        auto target = findPortAt(e.position);
        if (target) {
            bool canConnect = validateConnection(draggingFromPort, target);
            drawPreviewLine(e.position, canConnect ? Colours::green : Colours::red);
        }
    }
}
