// Source/Core/Modulation/ModulationGraphImpl.h
// Header privado, NO incluir en API pública

#pragma once
#include "ModulationGraphAPI.h"
#include "SignalTypes.h"
#include <juce_core/juce_core.h>
#include <memory>
#include <vector>
#include <array>
#include <map>
#include <set>

namespace Omega::Core::Modulation::API {

// ============================================================
// ESTRUCTURAS INTERNAS (no expuestas en API pública)
// ============================================================

struct InternalNode {
    NodeId id;
    NodeType type;
    SignalType outputType;
    juce::String name;
    juce::Point<float> uiPosition;
    
    // Configuración específica del tipo
    NodeConfig config;
    
    // Puertos: índices en arrays globales del grafo
    std::vector<PortInfo> inputPorts;
    std::vector<PortInfo> outputPorts;
    
    // Conexiones: índices en array global de conexiones
    std::vector<uint16_t> incomingConnections;  // IDs de conexiones que entran
    std::vector<uint16_t> outgoingConnections;  // IDs de conexiones que salen
    
    // Estado de compilación
    int32_t computedOrder = -1;           // -1 = no compilado
    bool isInFeedbackPath = false;
    int32_t latencyCompensation = 0;
    
    // Para detección de ciclos (DFS)
    mutable bool dfsVisited = false;
    mutable bool dfsInStack = false;
};

struct InternalConnection {
    uint16_t id;                          // ID único en el grafo
    
    NodeId sourceNode;
    uint8_t sourcePortIndex;
    
    NodeId destNode;
    uint8_t destPortIndex;
    
    // Configuración
    float amount = 1.0f;
    bool bipolar = false;
    uint8_t curveType = 0;                // 0=linear, 1=exp, 2=log, 3=s-curve
    float rangeMin = -1.0f;
    float rangeMax = 1.0f;
    
    // Validación
    bool isFeedbackConnection = false;    // Parte de ciclo explícito
};

// ============================================================
// IMPLEMENTACIÓN PIMPL
// ============================================================

class ModulationGraph::Impl {
public:
    Impl();
    ~Impl();
    
    // No copiable
    Impl(const Impl&) = delete;
    Impl& operator=(const Impl&) = delete;
    
    // ========================================================
    // GESTIÓN DE NODOS
    // ========================================================
    
    GraphResult<NodeHandle> addNode(NodeType type, 
                                     const juce::String& name,
                                     const NodeConfig* config = nullptr);
    
    GraphResult<void> removeNode(NodeId id);
    
    InternalNode* findNode(NodeId id);
    const InternalNode* findNode(NodeId id) const;
    
    // ========================================================
    // GESTIÓN DE CONEXIONES
    // ========================================================
    
    GraphResult<uint16_t> addConnection(NodeId src, uint8_t srcPort,
                                         NodeId dst, uint8_t dstPort,
                                         float amount,
                                         bool isFeedback = false);
    
    GraphResult<void> removeConnection(uint16_t connId);
    void removeAllConnections(NodeId nodeId);
    
    InternalConnection* findConnection(uint16_t id);
    
    // ========================================================
    // VALIDACIÓN Y COMPILACIÓN
    // ========================================================
    
    struct CompileData {
        // Orden topológico (fuentes primero, sinks al final)
        std::vector<NodeId> topoOrder;
        
        // Nodos de feedback (procesan con 1-sample delay)
        std::set<NodeId> feedbackNodes;
        
        // Conexiones de feedback
        std::set<uint16_t> feedbackConnections;
        
        // Latencias acumuladas por nodo
        std::map<NodeId, int> nodeLatencies;
        
        // Errores encontrados
        std::vector<std::pair<NodeId, juce::String>> errors;
        std::vector<std::pair<NodeId, juce::String>> warnings;
    };
    
    GraphResult<CompileData> compileGraph();
    
    // ========================================================
    // SERIALIZACIÓN
    // ========================================================
    
    juce::ValueTree toValueTree() const;
    GraphResult<void> fromValueTree(const juce::ValueTree& tree);
    
    // ========================================================
    // UTILIDADES
    // ========================================================
    
    void clear();
    bool isEmpty() const;
    
    // Generador de IDs
    NodeId generateNodeId();
    uint16_t generateConnectionId();
    
    // Validación
    bool validatePortExists(NodeId nodeId, PortDirection dir, uint8_t index) const;
    bool validateTypesCompatible(SignalType src, SignalType dst) const;
    bool wouldCreateCycle(NodeId src, NodeId dst) const;
    
    // Introspección de tipos de nodo
    std::vector<PortInfo> getDefaultPortsForType(NodeType type, PortDirection dir);
    
    // ========================================================
    // ESTADO
    // ========================================================
    
    // Callbacks
    std::vector<ModulationGraph::NodeAddedCallback> onNodeAdded;
    std::vector<ModulationGraph::NodeRemovedCallback> onNodeRemoved;
    std::vector<ModulationGraph::ConnectionAddedCallback> onConnectionAdded;
    std::vector<ModulationGraph::ConnectionRemovedCallback> onConnectionRemoved;
    std::vector<ModulationGraph::GraphModifiedCallback> onModified;
    
    void notifyModified();
    
    // Contenedores principales (arrays fijos con gestión de slots libres)
    std::array<std::optional<InternalNode>, 32> nodes;
    std::array<std::optional<InternalConnection>, 64> connections;
    
    // Índices libres para reutilización
    std::vector<uint8_t> freeNodeSlots;
    std::vector<uint16_t> freeConnectionSlots;
    
    // Contadores para IDs únicos
    uint64_t nextNodeIdHigh = 1;
    uint64_t nextNodeIdLow = 0;
    uint16_t nextConnectionId = 0;
    
    // Estado de compilación
    bool isCompiled = false;
    bool isModified = true;
    std::optional<CompileData> lastCompileData;
    
    // Sample rate cacheado para validaciones
    double cachedSampleRate = 48000.0;
};

} // namespace Omega::Core::Modulation::API
