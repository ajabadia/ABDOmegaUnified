                                               └─────────────────┘
                                                        │
                                                        ▼
                                               ┌─────────────────┐
                                               │  Procesamiento  │
                                               │  sample a sample│
                                               │  (SIMD-friendly)│
                                               └─────────────────┘
Clave: Todos los objetos DSP viven en pools globales estables. VoiceRuntime solo tiene índices, no punteros a objetos que puedan moverse o destruirse.
⚡ REGLAS CRÍTICAS DEL AUDIO THREAD (checklist)
Table
Regla	Implementación	Verificación
Zero allocation	Pools pre-alocados, arrays fijos	static_assert de tamaños, no std::vector
Zero locks	Solo std::atomic con memory_order_relaxed/acquire/release	No mutex, no CriticalSection, no juce::ScopedLock
No exceptions	Todo noexcept, errores = clamp/silencio	Compilar con -fno-exceptions
No virtual calls en inner loop	CRTP o function pointers, o switch por índice	processVoice usa switch en modo, no vtable
No strings	Solo índices, enums, floats	No juce::String, no std::string
No I/O	Todo I/O en message thread	No file, no network, no logging
No ValueTree/APVTS lookup	Parámetros en atomics cacheados	Constructor cachea std::atomic<float>*
SIMD alignment	alignas(64) en estructuras críticas	static_assert(alignof(VoiceRuntime) == 64)
Cache-friendly	Datos contiguos, acceso secuencial	std::array, no listas enlazadas








Voy a diseñar el ModulationGraph en profundidad, validando que cumple con todos los requisitos: grafo dirigido, tipos de señal, compilación topológica, ciclos con compensación, y audio-rate processing.
🎯 REQUISITOS DEL MODULATIONGRAPH
Basándome en tu diseño original, estos son los must-have:
Table
Requisito	Solución propuesta
Grafo dirigido	Nodos con inputs[] y outputs[] de UUIDs
Tipos de señal	SignalType: Control, Audio, Trigger, Pitch, Phase
Compilación topológica	Kahn's algorithm + detección de ciclos
Ciclos permitidos	1-sample delay compensation en feedback paths
Audio-rate	Procesamiento por sample para señales Audio y Phase
Control-rate	Por bloque para eficiencia, interpolación lineal
32x32 nodos	Arrays fijos, no allocation dinámica
Sin locks en audio	Compilación en message thread, runtime inmutable
🏗️ DISEÑO COMPLETO: 3 CAPAS
plain
Copy
┌─────────────────────────────────────────────────────────────┐
│  CAPA 3: MODULATIONGRAPH (Message Thread)                   │
│  ├── Construcción dinámica: addNode(), connect()            │
│  ├── Validación: tipos compatibles, ciclos detectables        │
│  ├── Compilación: orden topológico, detección de feedback     │
│  └── Serialización: to/from ValueTree/YAML                    │
├─────────────────────────────────────────────────────────────┤
│  CAPA 2: MODULATIONRUNTIME (Audio Thread)                   │
│  ├── Arrays fijos: sources[32], nodes[32], routes[N]         │
│  ├── Procesamiento: updateSources() → processNodes()          │
│  ├── Tipos de señal: Control (por bloque), Audio (por sample)│
│  └── Feedback: 1-sample delay en ciclos                      │
├─────────────────────────────────────────────────────────────┤
│  CAPA 1: SIGNAL BUFFERS (Audio Thread)                        │
│  ├── ControlBuffer: float[numSamples] con rampa lineal        │
│  ├── AudioBuffer: float[numSamples] por canal                 │
│  └── PhaseBuffer: float[numSamples] wrap 0-2π                 │
└─────────────────────────────────────────────────────────────┘
📐 ESTRUCTURAS DE DATOS
1. Tipos de señal y sus propiedades
cpp
Copy
// Source/DSP/Modulation/SignalTypes.h
#pragma once
#include <cstdint>

namespace Omega::DSP::Modulation {

enum class SignalType : uint8_t {
    Control  = 0,  // 0-1, lento, por bloque, rampa lineal entre valores
    Audio    = 1,  // -1..1, audio-rate, por sample, no interpolación
    Trigger  = 2,  // Edge events (0→1), por sample, detección de flanco
    Pitch    = 3,  // Semitonos, por bloque, exponencial
    Phase    = 4   // 0-2π, audio-rate, por sample, wrap automático
};

struct SignalTypeTraits {
    static constexpr bool isPerSample(SignalType t) {
        return t == SignalType::Audio || t == SignalType::Phase || t == SignalType::Trigger;
    }
    static constexpr bool isPerBlock(SignalType t) {
        return t == SignalType::Control || t == SignalType::Pitch;
    }
    static constexpr bool needsWrap(SignalType t) {
        return t == SignalType::Phase;
    }
    static constexpr bool needsEdgeDetect(SignalType t) {
        return t == SignalType::Trigger;
    }
};

// Unión de valores para paso entre nodos
union SignalValue {
    float control;   // Valor único para bloque (Control, Pitch)
    float* audio;    // Puntero a buffer (Audio, Phase, Trigger)
};

// Descriptor de conexión tipada
struct TypedConnection {
    uint8_t sourceNode;      // Índice en array de nodos (255 = desconectado)
    uint8_t destNode;        // Índice en array de nodos
    uint8_t sourceOutput;    // Índice de output del nodo origen
    uint8_t destInput;       // Índice de input del nodo destino
    SignalType type;         // Tipo verificado en compile-time
    float amount;            // -1.0 .. 1.0
    uint8_t curveType;       // 0=linear, 1=exp, 2=log, 3=s-curve, 4=step
};

} // namespace Omega::DSP::Modulation
2. Nodos del grafo (Capa 3 - editable)
cpp
Copy
// Source/DSP/Modulation/ModulationGraph.h
#pragma once
#include "SignalTypes.h"
#include <array>
#include <vector>
#include <functional>
#include <memory>
#include <juce_core/juce_core.h>

namespace Omega::DSP::Modulation {

// UUID compacto para nodos (16 bytes vs 36 de string)
struct NodeId {
    uint64_t high, low;
    bool operator==(const NodeId& other) const noexcept {
        return high == other.high && low == other.low;
    }
    bool operator<(const NodeId& other) const noexcept {
        return high < other.high || (high == other.high && low < other.low);
    }
};

// Tipos de nodo disponibles
enum class NodeType : uint8_t {
    // Fuentes (no tienen inputs)
    LFO,
    Envelope,
    Random,
    Noise,
    KeyTrack,
    Velocity,
    ModWheel,
    PitchBend,
    Aftertouch,
    Expression,
    Sustain,
    Macro1, Macro2, Macro3, Macro4,
    
    // Procesadores (tienen inputs y outputs)
    Mix,           // Mezcla 2+ señales
    Scale,         // Multiplica por amount + offset
    Curve,         // Aplica función de transferencia
    Quantize,      // Cuantiza a escala musical
    Delay1,        // Delay de 1 sample (para feedback)
    SampleAndHold, // Captura en trigger
    
    // Destinos (no tienen outputs, solo side-effect)
    Parameter,     // Escribe a parámetro de componente
    VoicePitch,    // Suma a pitch de voz
    VoiceGain,     // Multiplica gain de voz
    
    // Feedback auxiliares
    FeedbackInput,  // Entrada de ciclo de feedback
    FeedbackOutput  // Salida de ciclo de feedback
};

// Configuración de nodo (parámetros específicos)
struct NodeConfig {
    // LFO
    struct LFOParams {
        uint8_t shape;      // 0=sine, 1=tri, 2=saw, 3=square, 4=random
        float rate;         // Hz o BPM-sync
        bool bpmSync;
        float phase;        // Offset inicial
    };
    
    // Envelope
    struct EnvelopeParams {
        float attack, decay, sustain, release;  // ms o 0-1
        uint8_t curve;      // 0=linear, 1=exp, 2=log
    };
    
    // Mix
    struct MixParams {
        uint8_t numInputs;
        std::array<float, 4> weights;  // Mezcla ponderada
    };
    
    // Unión de todas las configs posibles
    union {
        LFOParams lfo;
        EnvelopeParams envelope;
        MixParams mix;
        // ... etc
    };
};

// Nodo en el grafo editable
struct ModNode {
    NodeId id;
    NodeType type;
    SignalType outputType;
    NodeConfig config;
    
    // Conexiones: índices en array de conexiones del grafo
    std::vector<uint16_t> inputConnections;   // Conexiones que entran aquí
    std::vector<uint16_t> outputConnections;  // Conexiones que salen de aquí
    
    // Metadatos para compilación
    bool isFeedbackPath = false;     // Marcado si parte de ciclo
    int latencyCompensation = 0;       // Samples de compensación
    int computedOrder = -1;            // Orden topológico (-1 = no compilado)
    
    // Para debug/UI
    juce::String name;
    juce::Point<float> uiPosition;     // Coordenadas en editor de grafo
};

// El grafo completo (Capa 3)
class ModulationGraph {
public:
    static constexpr int kMaxNodes = 32;
    static constexpr int kMaxConnections = 64;
    
    ModulationGraph();
    
    // Construcción
    NodeId addNode(NodeType type, SignalType outputType, 
                   const juce::String& name = {});
    void removeNode(NodeId id);
    
    bool connect(NodeId source, uint8_t sourceOutput,
                 NodeId dest, uint8_t destInput,
                 float amount = 1.0f, uint8_t curve = 0);
    void disconnect(NodeId source, NodeId dest);
    
    // Validación y compilación
    struct CompileResult {
        bool success;
        juce::String errorMessage;
        std::vector<NodeId> cycleNodes;  // Si hay ciclo, qué nodos lo forman
    };
    
    CompileResult compile();  // Toposort + detección de ciclos + planificación
    
    // Serialización
    juce::ValueTree toValueTree() const;
    static std::unique_ptr<ModulationGraph> fromValueTree(const juce::ValueTree& tree);
    
    // Acceso para compilador
    const std::vector<std::unique_ptr<ModNode>>& getNodes() const { return nodes; }
    const std::vector<TypedConnection>& getConnections() const { return connections; }
    
private:
    std::vector<std::unique_ptr<ModNode>> nodes;
    std::vector<TypedConnection> connections;
    
    // Generador de UUIDs
    uint64_t nextIdHigh = 1, nextIdLow = 0;
    NodeId generateId();
    
    // Validación de tipos
    bool areTypesCompatible(SignalType source, SignalType dest);
    
    // Detección de ciclos (Tarjan o DFS simple)
    bool detectCycle(NodeId start, std::vector<NodeId>& cyclePath) const;
    
    // Planificación de feedback paths
    void identifyFeedbackPaths();
};

} // namespace Omega::DSP::Modulation
3. Runtime compilado (Capa 2 - audio thread)
cpp
Copy
// Source/DSP/Modulation/ModulationRuntime.h
#pragma once
#include "SignalTypes.h"
#include <array>
#include <atomic>
#include <cstdint>

namespace Omega::DSP::Modulation {

// Nodo en runtime: solo datos necesarios para procesamiento
struct alignas(32) RuntimeNode {
    // Tipo y función de proceso
    uint8_t nodeType;        // Índice en tabla de procesadores
    uint8_t outputType;      // SignalType como uint8
    
    // Inputs: índices a buffers de señal o constantes
    std::array<uint8_t, 4> inputIndices;   // 255 = no conectado
    std::array<float, 4> inputAmounts;     // Amount por input
    std::array<uint8_t, 4> inputCurves;    // Curva por input
    
    // Output: índice a buffer de señal
    uint8_t outputIndex;
    
    // Estado del nodo (para fuentes con memoria)
    union NodeState {
        // LFO
        struct { float phase; float phaseIncrement; } lfo;
        // Envelope
        struct { uint8_t stage; float level; float target; } env;
        // S&H
        struct { float heldValue; bool wasTriggered; } sAndH;
        // Delay1 (feedback)
        struct { float previous; } delay1;
        // ... otros
    } state;
    
    // Parámetros fijos (copia de NodeConfig)
    union {
        float params[8];  // Suficiente para todas las configs
    };
};

// Buffer de señales: todos los nodos escriben aquí, otros leen
// Índice 0 = "tierra" (silencio), 1-31 = salidas de nodos
struct SignalBufferBank {
    static constexpr int kMaxSignals = 64;  // 0 + 31 nodos + 32 extras
    
    // Para señales Control: valor único por bloque
    alignas(64) std::array<std::atomic<float>, kMaxSignals> controlValues;
    
    // Para señales Audio/Phase/Trigger: buffer por sample
    // Puntero a memoria pre-alocada en VoiceRuntime o global
    struct AudioBufferRef {
        float* data;
        int numSamples;
    };
    std::array<AudioBufferRef, kMaxSignals> audioBuffers;
    
    // Flag de tipo por señal
    std::array<SignalType, kMaxSignals> signalTypes;
};

// Runtime compilado (inmutable para audio thread)
class ModulationRuntime {
public:
    static constexpr int kMaxRuntimeNodes = 32;
    static constexpr int kMaxBlockSize = 256;
    
    ModulationRuntime();
    
    // Construcción (solo message thread)
    void compileFromGraph(const ModulationGraph& graph, double sampleRate);
    
    // Procesamiento (audio thread, llamado una vez por bloque por voz)
    void processBlock(int numSamples, 
                      const struct VoiceRuntime& voice,
                      float* voicePitch,      // Output: pitch final
                      float* voiceGain) noexcept;      // Output: gain final
    
    // Acceso a señal específica (para debug/visualización)
    float getSignalValue(uint8_t signalIndex, int sampleOffset = 0) const noexcept;
    
    // Estado global (para fuentes que no son por-voz, ej. mod wheel)
    void setGlobalSource(uint8_t sourceIndex, float value) noexcept;
    
private:
    // Nodos en orden topológico (ya resueltas dependencias)
    std::array<RuntimeNode, kMaxRuntimeNodes> nodes;
    uint8_t nodeCount = 0;
    
    // Índices de nodos de cada tipo para procesamiento eficiente
    std::array<uint8_t, kMaxRuntimeNodes> sourceIndices;      // Fuentes primero
    std::array<uint8_t, kMaxRuntimeNodes> processorIndices;   // Procesadores
    std::array<uint8_t, kMaxRuntimeNodes> sinkIndices;        // Destinos al final
    uint8_t numSources = 0, numProcessors = 0, numSinks = 0;
    
    // Buffers de señal para esta voz (apuntan a memoria de VoiceRuntime)
    SignalBufferBank buffers;
    
    // Sample rate para cálculos de frecuencia
    double sampleRate = 48000.0;
    
    // Procesadores específicos por tipo de nodo
    using ProcessFunc = void(*)(RuntimeNode&, SignalBufferBank&, int numSamples);
    static const std::array<ProcessFunc, 16> processFunctions;
    
    // Procesamiento por etapas
    void processSources(int numSamples) noexcept;
    void processProcessors(int numSamples) noexcept;
    void processSinks(int numSamples, float* voicePitch, float* voiceGain) noexcept;
    
    // Helpers
    float applyCurve(float value, uint8_t curveType) const noexcept;
    float wrapPhase(float phase) const noexcept;
};

} // namespace Omega::DSP::Modulation
🔧 ALGORITMOS CLAVE
4. Compilación: Toposort + detección de ciclos
cpp
Copy
// Source/DSP/Modulation/ModulationGraphCompile.cpp

ModulationGraph::CompileResult ModulationGraph::compile() {
    // Paso 1: Construir grafo de dependencias
    std::vector<std::vector<uint16_t>> adj(nodes.size());  // node -> sus dependientes
    std::vector<int> inDegree(nodes.size(), 0);
    
    for (size_t i = 0; i < connections.size(); ++i) {
        const auto& conn = connections[i];
        if (conn.sourceNode == 255 || conn.destNode == 255) continue;
        
        // dest depende de source
        adj[conn.sourceNode].push_back(conn.destNode);
        inDegree[conn.destNode]++;
    }
    
    // Paso 2: Kahn's algorithm para orden topológico
    std::vector<uint16_t> queue;  // Nodos con inDegree = 0 (fuentes)
    for (size_t i = 0; i < nodes.size(); ++i) {
        if (inDegree[i] == 0) queue.push_back(i);
    }
    
    std::vector<uint16_t> topoOrder;
    topoOrder.reserve(nodes.size());
    
    while (!queue.empty()) {
        uint16_t u = queue.back();
        queue.pop_back();
        topoOrder.push_back(u);
        
        for (uint16_t v : adj[u]) {
            if (--inDegree[v] == 0) {
                queue.push_back(v);
            }
        }
    }
    
    // Paso 3: Detectar ciclos (nodos no visitados)
    std::vector<uint16_t> cycleNodes;
    for (size_t i = 0; i < nodes.size(); ++i) {
        if (inDegree[i] > 0) {
            cycleNodes.push_back(i);
        }
    }
    
    if (!cycleNodes.empty()) {
        // Paso 4: Identificar ciclo específico para mensaje de error
        std::vector<NodeId> cyclePath;
        // DFS desde primer nodo del ciclo para encontrar el loop
        // ... (implementación estándar de detección de ciclo en grafo)
        
        return {false, "Cycle detected in modulation graph", cyclePath};
    }
    
    // Paso 5: Permitir ciclos explícitos con FeedbackInput/Output
    // Los ciclos "válidos" usan nodos especiales que rompen el grafo
    
    // Paso 6: Asignar orden a nodos
    for (size_t i = 0; i < topoOrder.size(); ++i) {
        nodes[topoOrder[i]]->computedOrder = i;
    }
    
    // Paso 7: Identificar paths de feedback (para compensación de latencia)
    identifyFeedbackPaths();
    
    return {true, {}, {}};
}

void ModulationGraph::identifyFeedbackPaths() {
    // Buscar conexiones que forman ciclos válidos (con FeedbackInput/Output)
    for (auto& node : nodes) {
        if (node->type == NodeType::FeedbackInput) {
            // Buscar el FeedbackOutput correspondiente
            // Marcar todo el path entre ellos como isFeedbackPath
            // Esto permite compensación de 1 sample
        }
    }
}
5. Procesamiento por tipos de señal
cpp
Copy
// Source/DSP/Modulation/ModulationRuntimeProcess.cpp

void ModulationRuntime::processBlock(int numSamples,
                                      const VoiceRuntime& voice,
                                      float* voicePitch,
                                      float* voiceGain) noexcept {
    // 1. INICIALIZAR BUFFERS
    // Control: copiar valores atómicos
    for (int i = 0; i < kMaxSignals; ++i) {
        if (buffers.signalTypes[i] == SignalType::Control) {
            // Los valores control ya están en controlValues, no hacer nada
        }
    }
    
    // 2. PROCESAR FUENTES (por bloque o por sample según tipo)
    for (int ni = 0; ni < numSources; ++ni) {
        auto& node = nodes[sourceIndices[ni]];
        
        switch (static_cast<NodeType>(node.nodeType)) {
            case NodeType::LFO: {
                // LFO: Audio-rate o Control-rate según config
                auto& state = node.state.lfo;
                float* out = buffers.audioBuffers[node.outputIndex].data;
                
                for (int s = 0; s < numSamples; ++s) {
                    // Generar forma de onda
                    float phase = state.phase;
                    float value = 0.0f;
                    
                    uint8_t shape = static_cast<uint8_t>(node.params[0]);
                    switch (shape) {
                        case 0: value = std::sin(phase * 2.0f * M_PI); break;  // Sine
                        case 1: value = 1.0f - 2.0f * std::abs(phase - 0.5f); break;  // Tri
                        case 2: value = 2.0f * phase - 1.0f; break;  // Saw
                        case 3: value = phase < 0.5f ? 1.0f : -1.0f; break;  // Square
                    }
                    
                    out[s] = value;
                    state.phase += state.phaseIncrement;
                    if (state.phase >= 1.0f) state.phase -= 1.0f;
                }
                break;
            }
            
            case NodeType::Envelope: {
                // Envelope: siempre Control-rate (pero con curva suave)
                auto& state = node.state.env;
                
                // Calcular target según stage
                float target = 0.0f;
                switch (state.stage) {
                    case 0: target = 0.0f; break;  // Idle
                    case 1: target = 1.0f; break;  // Attack
                    case 2: target = node.params[2]; break;  // Decay → Sustain
                    case 3: target = node.params[2]; break;  // Sustain
                    case 4: target = 0.0f; break;  // Release
                }
                
                // Interpolar exponencialmente hacia target
                // (simplificado: rampa lineal por bloque, exponencial por sample en realidad)
                float current = state.level;
                float step = (target - current) / numSamples;  // Simplificado
                
                float* out = buffers.audioBuffers[node.outputIndex].data;
                for (int s = 0; s < numSamples; ++s) {
                    current += step;  // En realidad: current = current + (target - current) * coef
                    out[s] = current;
                }
                state.level = current;
                break;
            }
            
            // ... otros casos
            
            default: break;
        }
    }
    
    // 3. PROCESAR NODOS INTERMEDIOS (Mix, Scale, Curve, etc.)
    for (int ni = 0; ni < numProcessors; ++ni) {
        auto& node = nodes[processorIndices[ni]];
        
        switch (static_cast<NodeType>(node.nodeType)) {
            case NodeType::Mix: {
                // Mezclar inputs
                float* out = buffers.audioBuffers[node.outputIndex].data;
                
                // Inicializar con silencio
                for (int s = 0; s < numSamples; ++s) out[s] = 0.0f;
                
                for (int i = 0; i < 4; ++i) {
                    uint8_t inIdx = node.inputIndices[i];
                    if (inIdx == 255) continue;
                    
                    float weight = node.inputAmounts[i];
                    float* in = buffers.audioBuffers[inIdx].data;
                    
                    for (int s = 0; s < numSamples; ++s) {
                        out[s] += in[s] * weight;
                    }
                }
                break;
            }
            
            case NodeType::Scale: {
                // out = in * amount + offset
                uint8_t inIdx = node.inputIndices[0];
                float* in = (inIdx == 255) ? nullptr : buffers.audioBuffers[inIdx].data;
                float* out = buffers.audioBuffers[node.outputIndex].data;
                
                float amount = node.params[0];
                float offset = node.params[1];
                
                for (int s = 0; s < numSamples; ++s) {
                    float val = in ? in[s] : 0.0f;
                    out[s] = val * amount + offset;
                }
                break;
            }
            
            case NodeType::Delay1: {
                // Delay de 1 sample para feedback paths
                uint8_t inIdx = node.inputIndices[0];
                float* in = buffers.audioBuffers[inIdx].data;
                float* out = buffers.audioBuffers[node.outputIndex].data;
                
                float prev = node.state.delay1.previous;
                for (int s = 0; s < numSamples; ++s) {
                    float current = in[s];
                    out[s] = prev;  // Output = sample anterior
                    prev = current;
                }
                node.state.delay1.previous = prev;
                break;
            }
            
            // ... otros
            
            default: break;
        }
    }
    
    // 4. PROCESAR SINKS (escribir a parámetros de voz)
    for (int ni = 0; ni < numSinks; ++ni) {
        auto& node = nodes[sinkIndices[ni]];
        
        switch (static_cast<NodeType>(node.nodeType)) {
            case NodeType::VoicePitch: {
                uint8_t inIdx = node.inputIndices[0];
                float* in = buffers.audioBuffers[inIdx].data;
                
                // Sumar a pitch base de la voz (el último valor del bloque)
                *voicePitch += in[numSamples - 1];
                break;
            }
            
            case NodeType::VoiceGain: {
                uint8_t inIdx = node.inputIndices[0];
                float* in = buffers.audioBuffers[inIdx].data;
                
                *voiceGain *= in[numSamples - 1];
                break;
            }
            
            // Parameter sinks: escribir a tabla de parámetros del componente
            // (esto requiere índice a parámetro específico)
            
            default: break;
        }
    }
}
🔄 EJEMPLO COMPLETO: Flujo de construcción
Escenario: "LFO modula pitch de oscilador"
yaml
Copy
# En el preset YAML
modulation:
  nodes:
    - id: "lfo1"
      type: "LFO"
      outputType: "Audio"  # Audio-rate para vibrato
      params:
        shape: 0  # Sine
        rate: 5.0  # Hz
        bpmSync: false
    
    - id: "scale1"
      type: "Scale"
      outputType: "Pitch"
      params:
        amount: 0.5  # ±0.5 semitones
        offset: 0.0
    
    - id: "voicePitch"
      type: "VoicePitch"
      outputType: "Pitch"
  
  connections:
    - source: "lfo1", output: 0
      dest: "scale1", input: 0
      amount: 1.0, curve: "linear"
    
    - source: "scale1", output: 0
      dest: "voicePitch", input: 0
      amount: 1.0, curve: "linear"
Compilación paso a paso:
plain
Copy
1. Construir grafo:
   lfo1 (LFO, Audio) → scale1 (Scale, Pitch) → voicePitch (Sink)

2. Validar tipos:
   Audio → Scale (input genérico, OK)
   Scale con amount en semitones → Pitch (OK)

3. Toposort:
   Orden: [lfo1, scale1, voicePitch]
   (lfo1 sin inputs, scale1 depende de lfo1, voicePitch depende de scale1)

4. Crear RuntimeNode:
   Node 0: LFO, outputIndex=1, state={phase=0, phaseIncrement=5/48000}
   Node 1: Scale, inputIndices={1}, outputIndex=2, params={0.5, 0.0}
   Node 2: VoicePitch, inputIndices={2}, sink

5. Asignar a arrays:
   sourceIndices = [0]        // lfo1
   processorIndices = [1]     // scale1
   sinkIndices = [2]          // voicePitch

6. En audio thread por bloque:
   - lfo1 genera senoidal de 5Hz en buffer[1]
   - scale1 multiplica por 0.5, escribe en buffer[2]
   - voicePitch suma buffer[2][last] a pitch de voz
⚡ VALIDACIÓN DEL DISEÑO
Checklist de requisitos vs implementación
Table
Requisito	¿Cumplido?	Cómo
Grafo dirigido	✅	adj, inDegree, conexiones source→dest
32 nodos máximo	✅	kMaxNodes = 32, arrays fijos
Tipos de señal	✅	SignalType enum, validación en connect()
Control-rate	✅	Fuentes lentes procesan por bloque, interpolan
Audio-rate	✅	LFO, Audio, Phase procesan por sample
Trigger	✅	Detección de flanco en Trigger type
Compilación topológica	✅	Kahn's algorithm en compile()
Ciclos detectados	✅	inDegree > 0 tras toposort = ciclo
Ciclos permitidos (feedback)	✅	Nodos FeedbackInput/Output + Delay1
1-sample delay	✅	Delay1 node guarda previous
Sin locks en audio	✅	Runtime inmutable, solo lectura en processBlock
Sin allocation	✅	Arrays fijos, buffers pre-alocados
Casos de uso soportados
Table
Caso	Configuración
Vibrato clásico	LFO (5Hz, sine) → Scale (±0.5 st) → VoicePitch
FM de audio	Oscillator (audio) → Oscillator pitch input
Envelope a filter	Envelope → Scale → Filter cutoff
Sample & Hold	Noise → S&H (triggered by LFO) → VoicePitch
Feedback delay	Output → Delay1 → Mix con input → Filter
Modulación polifónica	Por-voz: KeyTrack → Scale → Filter cutoff
🎯 DECISIONES PENDIENTES
Table
Decisión	Opciones	Recomendación
¿LFO siempre Audio-rate?	Sí / Configurable	Configurable: rate < 20Hz → Control-rate para eficiencia
¿Cuantización de curvas?	LUT 256 / Cálculo directo	LUT precalculada en prepare(), interpolación lineal
¿Feedback implícito o explícito?	Auto-detectar / Nodos especiales	Explícito: FeedbackInput/Output + Delay1 para control
¿Parámetros de componente como sinks?	Sí / Solo voice params	Sí: índice a tabla de parámetros del componente
¿Grafo global o por-layer?	Uno grande / Uno por layer	Por-layer: más flexibilidad, mejor cache









🎯 REQUISITOS DEL MODULATIONGRAPH
Basándome en tu diseño original, estos son los must-have:
Table
Requisito	Solución propuesta
Grafo dirigido	Nodos con inputs[] y outputs[] de UUIDs
Tipos de señal	SignalType: Control, Audio, Trigger, Pitch, Phase
Compilación topológica	Kahn's algorithm + detección de ciclos
Ciclos permitidos	1-sample delay compensation en feedback paths
Audio-rate	Procesamiento por sample para señales Audio y Phase
Control-rate	Por bloque para eficiencia, interpolación lineal
32x32 nodos	Arrays fijos, no allocation dinámica
Sin locks en audio	Compilación en message thread, runtime inmutable
🏗️ DISEÑO COMPLETO: 3 CAPAS
plain
Copy
┌─────────────────────────────────────────────────────────────┐
│  CAPA 3: MODULATIONGRAPH (Message Thread)                   │
│  ├── Construcción dinámica: addNode(), connect()            │
│  ├── Validación: tipos compatibles, ciclos detectables        │
│  ├── Compilación: orden topológico, detección de feedback     │
│  └── Serialización: to/from ValueTree/YAML                    │
├─────────────────────────────────────────────────────────────┤
│  CAPA 2: MODULATIONRUNTIME (Audio Thread)                   │
│  ├── Arrays fijos: sources[32], nodes[32], routes[N]         │
│  ├── Procesamiento: updateSources() → processNodes()          │
│  ├── Tipos de señal: Control (por bloque), Audio (por sample)│
│  └── Feedback: 1-sample delay en ciclos                      │
├─────────────────────────────────────────────────────────────┤
│  CAPA 1: SIGNAL BUFFERS (Audio Thread)                        │
│  ├── ControlBuffer: float[numSamples] con rampa lineal        │
│  ├── AudioBuffer: float[numSamples] por canal                 │
│  └── PhaseBuffer: float[numSamples] wrap 0-2π                 │
└─────────────────────────────────────────────────────────────┘
📐 ESTRUCTURAS DE DATOS
1. Tipos de señal y sus propiedades
cpp
Copy
// Source/DSP/Modulation/SignalTypes.h
#pragma once
#include <cstdint>

namespace Omega::DSP::Modulation {

enum class SignalType : uint8_t {
    Control  = 0,  // 0-1, lento, por bloque, rampa lineal entre valores
    Audio    = 1,  // -1..1, audio-rate, por sample, no interpolación
    Trigger  = 2,  // Edge events (0→1), por sample, detección de flanco
    Pitch    = 3,  // Semitonos, por bloque, exponencial
    Phase    = 4   // 0-2π, audio-rate, por sample, wrap automático
};

struct SignalTypeTraits {
    static constexpr bool isPerSample(SignalType t) {
        return t == SignalType::Audio || t == SignalType::Phase || t == SignalType::Trigger;
    }
    static constexpr bool isPerBlock(SignalType t) {
        return t == SignalType::Control || t == SignalType::Pitch;
    }
    static constexpr bool needsWrap(SignalType t) {
        return t == SignalType::Phase;
    }
    static constexpr bool needsEdgeDetect(SignalType t) {
        return t == SignalType::Trigger;
    }
};

// Unión de valores para paso entre nodos
union SignalValue {
    float control;   // Valor único para bloque (Control, Pitch)
    float* audio;    // Puntero a buffer (Audio, Phase, Trigger)
};

// Descriptor de conexión tipada
struct TypedConnection {
    uint8_t sourceNode;      // Índice en array de nodos (255 = desconectado)
    uint8_t destNode;        // Índice en array de nodos
    uint8_t sourceOutput;    // Índice de output del nodo origen
    uint8_t destInput;       // Índice de input del nodo destino
    SignalType type;         // Tipo verificado en compile-time
    float amount;            // -1.0 .. 1.0
    uint8_t curveType;       // 0=linear, 1=exp, 2=log, 3=s-curve, 4=step
};

} // namespace Omega::DSP::Modulation
2. Nodos del grafo (Capa 3 - editable)
cpp
Copy
// Source/DSP/Modulation/ModulationGraph.h
#pragma once
#include "SignalTypes.h"
#include <array>
#include <vector>
#include <functional>
#include <memory>
#include <juce_core/juce_core.h>

namespace Omega::DSP::Modulation {

// UUID compacto para nodos (16 bytes vs 36 de string)
struct NodeId {
    uint64_t high, low;
    bool operator==(const NodeId& other) const noexcept {
        return high == other.high && low == other.low;
    }
    bool operator<(const NodeId& other) const noexcept {
        return high < other.high || (high == other.high && low < other.low);
    }
};

// Tipos de nodo disponibles
enum class NodeType : uint8_t {
    // Fuentes (no tienen inputs)
    LFO,
    Envelope,
    Random,
    Noise,
    KeyTrack,
    Velocity,
    ModWheel,
    PitchBend,
    Aftertouch,
    Expression,
    Sustain,
    Macro1, Macro2, Macro3, Macro4,
    
    // Procesadores (tienen inputs y outputs)
    Mix,           // Mezcla 2+ señales
    Scale,         // Multiplica por amount + offset
    Curve,         // Aplica función de transferencia
    Quantize,      // Cuantiza a escala musical
    Delay1,        // Delay de 1 sample (para feedback)
    SampleAndHold, // Captura en trigger
    
    // Destinos (no tienen outputs, solo side-effect)
    Parameter,     // Escribe a parámetro de componente
    VoicePitch,    // Suma a pitch de voz
    VoiceGain,     // Multiplica gain de voz
    
    // Feedback auxiliares
    FeedbackInput,  // Entrada de ciclo de feedback
    FeedbackOutput  // Salida de ciclo de feedback
};

// Configuración de nodo (parámetros específicos)
struct NodeConfig {
    // LFO
    struct LFOParams {
        uint8_t shape;      // 0=sine, 1=tri, 2=saw, 3=square, 4=random
        float rate;         // Hz o BPM-sync
        bool bpmSync;
        float phase;        // Offset inicial
    };
    
    // Envelope
    struct EnvelopeParams {
        float attack, decay, sustain, release;  // ms o 0-1
        uint8_t curve;      // 0=linear, 1=exp, 2=log
    };
    
    // Mix
    struct MixParams {
        uint8_t numInputs;
        std::array<float, 4> weights;  // Mezcla ponderada
    };
    
    // Unión de todas las configs posibles
    union {
        LFOParams lfo;
        EnvelopeParams envelope;
        MixParams mix;
        // ... etc
    };
};

// Nodo en el grafo editable
struct ModNode {
    NodeId id;
    NodeType type;
    SignalType outputType;
    NodeConfig config;
    
    // Conexiones: índices en array de conexiones del grafo
    std::vector<uint16_t> inputConnections;   // Conexiones que entran aquí
    std::vector<uint16_t> outputConnections;  // Conexiones que salen de aquí
    
    // Metadatos para compilación
    bool isFeedbackPath = false;     // Marcado si parte de ciclo
    int latencyCompensation = 0;       // Samples de compensación
    int computedOrder = -1;            // Orden topológico (-1 = no compilado)
    
    // Para debug/UI
    juce::String name;
    juce::Point<float> uiPosition;     // Coordenadas en editor de grafo
};

// El grafo completo (Capa 3)
class ModulationGraph {
public:
    static constexpr int kMaxNodes = 32;
    static constexpr int kMaxConnections = 64;
    
    ModulationGraph();
    
    // Construcción
    NodeId addNode(NodeType type, SignalType outputType, 
                   const juce::String& name = {});
    void removeNode(NodeId id);
    
    bool connect(NodeId source, uint8_t sourceOutput,
                 NodeId dest, uint8_t destInput,
                 float amount = 1.0f, uint8_t curve = 0);
    void disconnect(NodeId source, NodeId dest);
    
    // Validación y compilación
    struct CompileResult {
        bool success;
        juce::String errorMessage;
        std::vector<NodeId> cycleNodes;  // Si hay ciclo, qué nodos lo forman
    };
    
    CompileResult compile();  // Toposort + detección de ciclos + planificación
    
    // Serialización
    juce::ValueTree toValueTree() const;
    static std::unique_ptr<ModulationGraph> fromValueTree(const juce::ValueTree& tree);
    
    // Acceso para compilador
    const std::vector<std::unique_ptr<ModNode>>& getNodes() const { return nodes; }
    const std::vector<TypedConnection>& getConnections() const { return connections; }
    
private:
    std::vector<std::unique_ptr<ModNode>> nodes;
    std::vector<TypedConnection> connections;
    
    // Generador de UUIDs
    uint64_t nextIdHigh = 1, nextIdLow = 0;
    NodeId generateId();
    
    // Validación de tipos
    bool areTypesCompatible(SignalType source, SignalType dest);
    
    // Detección de ciclos (Tarjan o DFS simple)
    bool detectCycle(NodeId start, std::vector<NodeId>& cyclePath) const;
    
    // Planificación de feedback paths
    void identifyFeedbackPaths();
};

} // namespace Omega::DSP::Modulation
3. Runtime compilado (Capa 2 - audio thread)
cpp
Copy
// Source/DSP/Modulation/ModulationRuntime.h
#pragma once
#include "SignalTypes.h"
#include <array>
#include <atomic>
#include <cstdint>

namespace Omega::DSP::Modulation {

// Nodo en runtime: solo datos necesarios para procesamiento
struct alignas(32) RuntimeNode {
    // Tipo y función de proceso
    uint8_t nodeType;        // Índice en tabla de procesadores
    uint8_t outputType;      // SignalType como uint8
    
    // Inputs: índices a buffers de señal o constantes
    std::array<uint8_t, 4> inputIndices;   // 255 = no conectado
    std::array<float, 4> inputAmounts;     // Amount por input
    std::array<uint8_t, 4> inputCurves;    // Curva por input
    
    // Output: índice a buffer de señal
    uint8_t outputIndex;
    
    // Estado del nodo (para fuentes con memoria)
    union NodeState {
        // LFO
        struct { float phase; float phaseIncrement; } lfo;
        // Envelope
        struct { uint8_t stage; float level; float target; } env;
        // S&H
        struct { float heldValue; bool wasTriggered; } sAndH;
        // Delay1 (feedback)
        struct { float previous; } delay1;
        // ... otros
    } state;
    
    // Parámetros fijos (copia de NodeConfig)
    union {
        float params[8];  // Suficiente para todas las configs
    };
};

// Buffer de señales: todos los nodos escriben aquí, otros leen
// Índice 0 = "tierra" (silencio), 1-31 = salidas de nodos
struct SignalBufferBank {
    static constexpr int kMaxSignals = 64;  // 0 + 31 nodos + 32 extras
    
    // Para señales Control: valor único por bloque
    alignas(64) std::array<std::atomic<float>, kMaxSignals> controlValues;
    
    // Para señales Audio/Phase/Trigger: buffer por sample
    // Puntero a memoria pre-alocada en VoiceRuntime o global
    struct AudioBufferRef {
        float* data;
        int numSamples;
    };
    std::array<AudioBufferRef, kMaxSignals> audioBuffers;
    
    // Flag de tipo por señal
    std::array<SignalType, kMaxSignals> signalTypes;
};

// Runtime compilado (inmutable para audio thread)
class ModulationRuntime {
public:
    static constexpr int kMaxRuntimeNodes = 32;
    static constexpr int kMaxBlockSize = 256;
    
    ModulationRuntime();
    
    // Construcción (solo message thread)
    void compileFromGraph(const ModulationGraph& graph, double sampleRate);
    
    // Procesamiento (audio thread, llamado una vez por bloque por voz)
    void processBlock(int numSamples, 
                      const struct VoiceRuntime& voice,
                      float* voicePitch,      // Output: pitch final
                      float* voiceGain) noexcept;      // Output: gain final
    
    // Acceso a señal específica (para debug/visualización)
    float getSignalValue(uint8_t signalIndex, int sampleOffset = 0) const noexcept;
    
    // Estado global (para fuentes que no son por-voz, ej. mod wheel)
    void setGlobalSource(uint8_t sourceIndex, float value) noexcept;
    
private:
    // Nodos en orden topológico (ya resueltas dependencias)
    std::array<RuntimeNode, kMaxRuntimeNodes> nodes;
    uint8_t nodeCount = 0;
    
    // Índices de nodos de cada tipo para procesamiento eficiente
    std::array<uint8_t, kMaxRuntimeNodes> sourceIndices;      // Fuentes primero
    std::array<uint8_t, kMaxRuntimeNodes> processorIndices;   // Procesadores
    std::array<uint8_t, kMaxRuntimeNodes> sinkIndices;        // Destinos al final
    uint8_t numSources = 0, numProcessors = 0, numSinks = 0;
    
    // Buffers de señal para esta voz (apuntan a memoria de VoiceRuntime)
    SignalBufferBank buffers;
    
    // Sample rate para cálculos de frecuencia
    double sampleRate = 48000.0;
    
    // Procesadores específicos por tipo de nodo
    using ProcessFunc = void(*)(RuntimeNode&, SignalBufferBank&, int numSamples);
    static const std::array<ProcessFunc, 16> processFunctions;
    
    // Procesamiento por etapas
    void processSources(int numSamples) noexcept;
    void processProcessors(int numSamples) noexcept;
    void processSinks(int numSamples, float* voicePitch, float* voiceGain) noexcept;
    
    // Helpers
    float applyCurve(float value, uint8_t curveType) const noexcept;
    float wrapPhase(float phase) const noexcept;
};

} // namespace Omega::DSP::Modulation
🔧 ALGORITMOS CLAVE
4. Compilación: Toposort + detección de ciclos
cpp
Copy
// Source/DSP/Modulation/ModulationGraphCompile.cpp

ModulationGraph::CompileResult ModulationGraph::compile() {
    // Paso 1: Construir grafo de dependencias
    std::vector<std::vector<uint16_t>> adj(nodes.size());  // node -> sus dependientes
    std::vector<int> inDegree(nodes.size(), 0);
    
    for (size_t i = 0; i < connections.size(); ++i) {
        const auto& conn = connections[i];
        if (conn.sourceNode == 255 || conn.destNode == 255) continue;
        
        // dest depende de source
        adj[conn.sourceNode].push_back(conn.destNode);
        inDegree[conn.destNode]++;
    }
    
    // Paso 2: Kahn's algorithm para orden topológico
    std::vector<uint16_t> queue;  // Nodos con inDegree = 0 (fuentes)
    for (size_t i = 0; i < nodes.size(); ++i) {
        if (inDegree[i] == 0) queue.push_back(i);
    }
    
    std::vector<uint16_t> topoOrder;
    topoOrder.reserve(nodes.size());
    
    while (!queue.empty()) {
        uint16_t u = queue.back();
        queue.pop_back();
        topoOrder.push_back(u);
        
        for (uint16_t v : adj[u]) {
            if (--inDegree[v] == 0) {
                queue.push_back(v);
            }
        }
    }
    
    // Paso 3: Detectar ciclos (nodos no visitados)
    std::vector<uint16_t> cycleNodes;
    for (size_t i = 0; i < nodes.size(); ++i) {
        if (inDegree[i] > 0) {
            cycleNodes.push_back(i);
        }
    }
    
    if (!cycleNodes.empty()) {
        // Paso 4: Identificar ciclo específico para mensaje de error
        std::vector<NodeId> cyclePath;
        // DFS desde primer nodo del ciclo para encontrar el loop
        // ... (implementación estándar de detección de ciclo en grafo)
        
        return {false, "Cycle detected in modulation graph", cyclePath};
    }
    
    // Paso 5: Permitir ciclos explícitos con FeedbackInput/Output
    // Los ciclos "válidos" usan nodos especiales que rompen el grafo
    
    // Paso 6: Asignar orden a nodos
    for (size_t i = 0; i < topoOrder.size(); ++i) {
        nodes[topoOrder[i]]->computedOrder = i;
    }
    
    // Paso 7: Identificar paths de feedback (para compensación de latencia)
    identifyFeedbackPaths();
    
    return {true, {}, {}};
}

void ModulationGraph::identifyFeedbackPaths() {
    // Buscar conexiones que forman ciclos válidos (con FeedbackInput/Output)
    for (auto& node : nodes) {
        if (node->type == NodeType::FeedbackInput) {
            // Buscar el FeedbackOutput correspondiente
            // Marcar todo el path entre ellos como isFeedbackPath
            // Esto permite compensación de 1 sample
        }
    }
}
5. Procesamiento por tipos de señal
cpp
Copy
// Source/DSP/Modulation/ModulationRuntimeProcess.cpp

void ModulationRuntime::processBlock(int numSamples,
                                      const VoiceRuntime& voice,
                                      float* voicePitch,
                                      float* voiceGain) noexcept {
    // 1. INICIALIZAR BUFFERS
    // Control: copiar valores atómicos
    for (int i = 0; i < kMaxSignals; ++i) {
        if (buffers.signalTypes[i] == SignalType::Control) {
            // Los valores control ya están en controlValues, no hacer nada
        }
    }
    
    // 2. PROCESAR FUENTES (por bloque o por sample según tipo)
    for (int ni = 0; ni < numSources; ++ni) {
        auto& node = nodes[sourceIndices[ni]];
        
        switch (static_cast<NodeType>(node.nodeType)) {
            case NodeType::LFO: {
                // LFO: Audio-rate o Control-rate según config
                auto& state = node.state.lfo;
                float* out = buffers.audioBuffers[node.outputIndex].data;
                
                for (int s = 0; s < numSamples; ++s) {
                    // Generar forma de onda
                    float phase = state.phase;
                    float value = 0.0f;
                    
                    uint8_t shape = static_cast<uint8_t>(node.params[0]);
                    switch (shape) {
                        case 0: value = std::sin(phase * 2.0f * M_PI); break;  // Sine
                        case 1: value = 1.0f - 2.0f * std::abs(phase - 0.5f); break;  // Tri
                        case 2: value = 2.0f * phase - 1.0f; break;  // Saw
                        case 3: value = phase < 0.5f ? 1.0f : -1.0f; break;  // Square
                    }
                    
                    out[s] = value;
                    state.phase += state.phaseIncrement;
                    if (state.phase >= 1.0f) state.phase -= 1.0f;
                }
                break;
            }
            
            case NodeType::Envelope: {
                // Envelope: siempre Control-rate (pero con curva suave)
                auto& state = node.state.env;
                
                // Calcular target según stage
                float target = 0.0f;
                switch (state.stage) {
                    case 0: target = 0.0f; break;  // Idle
                    case 1: target = 1.0f; break;  // Attack
                    case 2: target = node.params[2]; break;  // Decay → Sustain
                    case 3: target = node.params[2]; break;  // Sustain
                    case 4: target = 0.0f; break;  // Release
                }
                
                // Interpolar exponencialmente hacia target
                // (simplificado: rampa lineal por bloque, exponencial por sample en realidad)
                float current = state.level;
                float step = (target - current) / numSamples;  // Simplificado
                
                float* out = buffers.audioBuffers[node.outputIndex].data;
                for (int s = 0; s < numSamples; ++s) {
                    current += step;  // En realidad: current = current + (target - current) * coef
                    out[s] = current;
                }
                state.level = current;
                break;
            }
            
            // ... otros casos
            
            default: break;
        }
    }
    
    // 3. PROCESAR NODOS INTERMEDIOS (Mix, Scale, Curve, etc.)
    for (int ni = 0; ni < numProcessors; ++ni) {
        auto& node = nodes[processorIndices[ni]];
        
        switch (static_cast<NodeType>(node.nodeType)) {
            case NodeType::Mix: {
                // Mezclar inputs
                float* out = buffers.audioBuffers[node.outputIndex].data;
                
                // Inicializar con silencio
                for (int s = 0; s < numSamples; ++s) out[s] = 0.0f;
                
                for (int i = 0; i < 4; ++i) {
                    uint8_t inIdx = node.inputIndices[i];
                    if (inIdx == 255) continue;
                    
                    float weight = node.inputAmounts[i];
                    float* in = buffers.audioBuffers[inIdx].data;
                    
                    for (int s = 0; s < numSamples; ++s) {
                        out[s] += in[s] * weight;
                    }
                }
                break;
            }
            
            case NodeType::Scale: {
                // out = in * amount + offset
                uint8_t inIdx = node.inputIndices[0];
                float* in = (inIdx == 255) ? nullptr : buffers.audioBuffers[inIdx].data;
                float* out = buffers.audioBuffers[node.outputIndex].data;
                
                float amount = node.params[0];
                float offset = node.params[1];
                
                for (int s = 0; s < numSamples; ++s) {
                    float val = in ? in[s] : 0.0f;
                    out[s] = val * amount + offset;
                }
                break;
            }
            
            case NodeType::Delay1: {
                // Delay de 1 sample para feedback paths
                uint8_t inIdx = node.inputIndices[0];
                float* in = buffers.audioBuffers[inIdx].data;
                float* out = buffers.audioBuffers[node.outputIndex].data;
                
                float prev = node.state.delay1.previous;
                for (int s = 0; s < numSamples; ++s) {
                    float current = in[s];
                    out[s] = prev;  // Output = sample anterior
                    prev = current;
                }
                node.state.delay1.previous = prev;
                break;
            }
            
            // ... otros
            
            default: break;
        }
    }
    
    // 4. PROCESAR SINKS (escribir a parámetros de voz)
    for (int ni = 0; ni < numSinks; ++ni) {
        auto& node = nodes[sinkIndices[ni]];
        
        switch (static_cast<NodeType>(node.nodeType)) {
            case NodeType::VoicePitch: {
                uint8_t inIdx = node.inputIndices[0];
                float* in = buffers.audioBuffers[inIdx].data;
                
                // Sumar a pitch base de la voz (el último valor del bloque)
                *voicePitch += in[numSamples - 1];
                break;
            }
            
            case NodeType::VoiceGain: {
                uint8_t inIdx = node.inputIndices[0];
                float* in = buffers.audioBuffers[inIdx].data;
                
                *voiceGain *= in[numSamples - 1];
                break;
            }
            
            // Parameter sinks: escribir a tabla de parámetros del componente
            // (esto requiere índice a parámetro específico)
            
            default: break;
        }
    }
}
