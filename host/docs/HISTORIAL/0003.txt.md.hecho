// Source/UI/Components/ModulationGraphEditor.cpp

#include "ModulationGraphEditor.h"

namespace Omega::UI {

// ============================================================
// NODE COMPONENT
// ============================================================

NodeComponent::NodeComponent(Modulation::API::NodeHandle node,
                           ModulationGraphEditor& editor)
    : node_(node), editor_(editor)
{
    updateFromNode();
    setSize(120, calculateHeight());
}

void NodeComponent::paint(juce::Graphics& g) {
    // Fondo
    g.setColour(style_.bodyColor);
    g.fillRoundedRectangle(getLocalBounds().toFloat(), style_.cornerRadius);
    
    // Borde (más grueso si seleccionado)
    g.setColour(isSelected_ ? juce::Colours::white : style_.borderColor);
    g.drawRoundedRectangle(getLocalBounds().toFloat().reduced(0.5f), 
                           style_.cornerRadius, isSelected_ ? 2.0f : 1.0f);
    
    // Header
    juce::Rectangle<float> header(0, 0, getWidth(), style_.headerHeight);
    g.setGradientFill(juce::ColourGradient(
        style_.headerColor.brighter(0.2f), 0, 0,
        style_.headerColor.darker(0.1f), 0, style_.headerHeight, false));
    g.fillRoundedRectangle(header, style_.cornerRadius);
    
    // Texto del header
    g.setColour(juce::Colours::white);
    g.setFont(13.0f);
    g.drawText(node_.name(), header.reduced(4, 0), 
               juce::Justification::centredLeft, true);
    
    // Puertos de entrada (izquierda)
    for (int i = 0; i < inputs_.size(); ++i) {
        auto pos = getInputPortPosition(i);
        bool connected = node_.isInputConnected(inputs_[i].id);
        drawPort(g, pos, inputs_[i], connected);
    }
    
    // Puertos de salida (derecha)
    for (int i = 0; i < outputs_.size(); ++i) {
        auto pos = getOutputPortPosition(i);
        auto dests = node_.getConnectedDestinations(outputs_[i].id);
        drawPort(g, pos, outputs_[i], !dests.empty());
    }
}

void NodeComponent::drawPort(juce::Graphics& g, const juce::Point<float>& center,
                             const Modulation::API::PortInfo& info, 
                             bool isConnected) {
    // Color según tipo de señal
    juce::Colour portColor;
    switch (info.signalType) {
        case Modulation::SignalType::Control: portColor = juce::Colours::green; break;
        case Modulation::SignalType::Audio: portColor = juce::Colours::cyan; break;
        case Modulation::SignalType::Trigger: portColor = juce::Colours::red; break;
        case Modulation::SignalType::Pitch: portColor = juce::Colours::orange; break;
        case Modulation::SignalType::Phase: portColor = juce::Colours::purple; break;
    }
    
    // Brillo si conectado
    if (isConnected) portColor = portColor.brighter(0.3f);
    
    // Círculo con borde
    g.setColour(portColor);
    g.fillEllipse(center.x - style_.portDiameter/2, 
                  center.y - style_.portDiameter/2,
                  style_.portDiameter, style_.portDiameter);
    
    g.setColour(juce::Colours::black);
    g.drawEllipse(center.x - style_.portDiameter/2, 
                  center.y - style_.portDiameter/2,
                  style_.portDiameter, style_.portDiameter, 1.0f);
    
    // Tooltip en hover (implementado en mouseMove)
}

juce::Point<float> NodeComponent::getInputPortPosition(int index) const {
    float y = style_.headerHeight + 10 + index * style_.portSpacing;
    return { 0, y };  // Izquierda
}

juce::Point<float> NodeComponent::getOutputPortPosition(int index) const {
    float y = style_.headerHeight + 10 + index * style_.portSpacing;
    return { (float)getWidth(), y };  // Derecha
}

void NodeComponent::mouseDown(const juce::MouseEvent& e) {
    if (e.mods.isPopupMenu()) {
        // Menú contextual
        juce::PopupMenu menu;
        menu.addItem("Delete", [this]() {
            // Usar GraphTransaction para atomicidad
            editor_.getGraph()->removeNode(node_);
        });
        menu.addItem("Duplicate", [this]() {
            // Clonar nodo con misma config, posición offset
        });
        menu.showAt(e.getScreenPosition());
        return;
    }
    
    // Check si clic en puerto de salida
    for (int i = 0; i < outputs_.size(); ++i) {
        auto pos = getOutputPortPosition(i);
        if (e.getPosition().toFloat().getDistanceFrom(pos) < style_.portDiameter) {
            editor_.beginConnectionDrag(i, this);
            return;
        }
    }
    
    // Selección y drag de nodo
    editor_.selectNode(this, e.mods.isShiftDown());
    dragger_.startDraggingComponent(this, e);
}

void NodeComponent::mouseDrag(const juce::MouseEvent& e) {
    dragger_.dragComponent(this, e, nullptr);
    
    // Actualizar posición en modelo (con throttling)
    auto graphPos = editor_.screenToGraph(getBounds().getCentre().toFloat());
    node_.setUiPosition(graphPos);
}

// ============================================================
// EDITOR PRINCIPAL
// ============================================================

ModulationGraphEditor::ModulationGraphEditor(GraphPtr graph)
    : graph_(graph)
{
    // Registrar callback de cambios
    graph_->onModified(this);
    
    // Viewport con zoom
    viewport_ = std::make_unique<juce::Viewport>();
    addAndMakeVisible(viewport_.get());
    
    // Reconstruir componentes existentes
    rebuildNodeComponents();
}

void ModulationGraphEditor::paint(juce::Graphics& g) {
    // Fondo
    g.fillAll(juce::Colour(0xFF1a1a2e));
    
    // Grid
    drawGrid(g);
    
    // Conexiones existentes
    for (auto* node : nodeComponents_) {
        for (int i = 0; i < node->getNode().outputCount(); ++i) {
            auto dests = node->getNode().getConnectedDestinations(i);
            for (auto& dest : dests) {
                auto* destComp = findComponentForNode(dest.id());
                if (destComp) {
                    drawConnection(g, 
                        node->getOutputPortPosition(i),
                        destComp->getInputPortPosition(/* índice */),
                        /* tipo de señal */, 
                        /* es feedback */);
                }
            }
        }
    }
    
    // Feedback paths (destacados)
    drawFeedbackPaths(g);
    
    // Preview de conexión en drag
    if (dragMode_ == DragMode::CreateConnection) {
        drawConnectionPreview(g);
    }
}

void ModulationGraphEditor::drawConnection(juce::Graphics& g,
                                            juce::Point<float> start,
                                            juce::Point<float> end,
                                            Modulation::SignalType type,
                                            bool isFeedback) {
    juce::Path path;
    path.startNewSubPath(start);
    
    // Curva de Bezier con control points
    float midX = (start.x + end.x) * 0.5f;
    path.cubicTo(midX, start.y, midX, end.y, end.x, end.y);
    
    // Color según tipo
    juce::Colour color;
    switch (type) {
        case Modulation::SignalType::Control: color = juce::Colours::green; break;
        case Modulation::SignalType::Audio: color = juce::Colours::cyan; break;
        default: color = juce::Colours::white;
    }
    
    if (isFeedback) {
        // Línea punteada animada
        float dashPhase = (juce::Time::getMillisecondCounter() / 50.0f);
        float dashLengths[2] = { 5.0f, 5.0f };
        g.setColour(color.withAlpha(0.7f));
        g.drawDashedLine(path, dashLengths, 2, 2.0f, dashPhase);
    } else {
        g.setColour(color);
        g.strokePath(path, juce::PathStrokeType(2.0f));
    }
}

void ModulationGraphEditor::beginConnectionDrag(int outputPort, 
                                                  NodeComponent* sourceNode) {
    dragMode_ = DragMode::CreateConnection;
    connectionDrag_.sourceNode = sourceNode;
    connectionDrag_.sourcePort = outputPort;
    connectionDrag_.startPos = sourceNode->getOutputPortPosition(outputPort);
    connectionDrag_.currentPos = connectionDrag_.startPos;
    
    // Cambiar cursor
    setMouseCursor(juce::MouseCursor::CrosshairCursor);
}

void ModulationGraphEditor::mouseDrag(const juce::MouseEvent& e) {
    if (dragMode_ == DragMode::CreateConnection) {
        connectionDrag_.currentPos = e.getPosition().toFloat();
        repaint();
        
        // Highlight de puertos válidos bajo el cursor
        for (auto* node : nodeComponents_) {
            for (int i = 0; i < node->inputCount(); ++i) {
                auto pos = node->getInputPortPosition(i);
                if (e.getPosition().toFloat().getDistanceFrom(pos) < 15.0f) {
                    // Validar tipos
                    auto sourceType = connectionDrag_.sourceNode
                        ->getNode().getOutputType(connectionDrag_.sourcePort);
                    auto destType = node->getNode().getInputType(i);
                    
                    if (graph_->canConnectTypes(sourceType, destType)) {
                        // Highlight verde
                    } else {
                        // Highlight rojo
                    }
                }
            }
        }
    }
}

void ModulationGraphEditor::endConnectionDrag(int inputPort, 
                                              NodeComponent* destNode) {
    if (dragMode_ != DragMode::CreateConnection) return;
    
    // Crear conexión via API
    auto result = graph_->connect(
        connectionDrag_.sourceNode->getNode().output(connectionDrag_.sourcePort),
        destNode->getNode().input(inputPort)
    );
    
    if (!result) {
        // Mostrar error (tooltip temporal)
        showErrorToast("Cannot connect: " + errorToString(result.error()));
    }
    
    dragMode_
