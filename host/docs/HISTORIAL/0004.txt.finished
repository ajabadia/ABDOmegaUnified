cpp
// OmegaMainEditor.cpp
#include "OmegaMainEditor.h"
#include "OmegaAudioProcessor.h"

OmegaMainEditor::OmegaMainEditor (OmegaAudioProcessor& proc,
                                  juce::AudioProcessorValueTreeState& apvts)
    : juce::AudioProcessorEditor (&proc)
    , mProcessor (proc)
    , mApvts (apvts)
{
    setSize (900, 600);

    addAndMakeVisible (mWebView); // Web UI manda

    // Slider nativo simple para MASTER_GAIN_DB
    mMasterGainSlider.setSliderStyle (juce::Slider::LinearHorizontal);
    mMasterGainSlider.setTextBoxStyle (juce::Slider::TextBoxRight, false, 60, 18);
    addAndMakeVisible (mMasterGainSlider);

    mMasterGainAtt = std::make_unique<SliderAtt> (mApvts, "MASTER_GAIN_DB", mMasterGainSlider);
}

void OmegaMainEditor::paint (juce::Graphics& g)
{
    g.fillAll (juce::Colours::black);
}

void OmegaMainEditor::resized()
{
    auto area = getLocalBounds();
    auto bottom = area.removeFromBottom (40);
    mMasterGainSlider.setBounds (bottom.reduced (10));
    mWebView.setBounds (area);
}
Dev vs release (fuente de HTML/JS)
En debug: goToURL("http://localhost:3000") y trabajas con React/Vite/Webpack con hot‑reload.
​

En release: empaquetas tu frontend en BinaryData y usas un withResourceProvider para servir index.html, JS y CSS desde C++; el demo WebViewPluginDemo hace justo esto.
​



Perfecto: vamos a fijar un OmegaUiBridge claro y un JSON v1 minimalista para que el Web UI pueda controlar todo sin acoplarse a JUCE.

Rol de OmegaUiBridge
Responsabilidades:

Exponer al Web UI:

Estado de preset (nombre, engine, layers, parámetros macro importantes).
​

Lista de componentes ACE disponibles (para dropdowns de osc/filtro/env).
​

Recibir del Web UI:

Cambios de parámetros (macro y ACE).
​

Cambios de preset (load/save, rename).

Se implementa como una clase C++ que:

Se engancha al WebBrowserComponent (u otro canal) y procesa mensajes JSON entrantes.

Emite mensajes JSON de vuelta al JS cuando cambian cosas en el ValueTree/APVTS.

Firma conceptual:

cpp
class OmegaUiBridge
{
public:
    OmegaUiBridge (OmegaPreset&, OmegaAce::AceCatalog&, juce::AudioProcessorValueTreeState&);

    // Llamado por el WebView cuando llega un JSON desde JS
    void handleMessageFromUi (const juce::String& json);

    // Callback para mandar mensajes al WebView (inyectado desde el editor)
    std::function<void (const juce::String& json)> sendToUi;

private:
    OmegaPreset& mPreset;
    OmegaAce::AceCatalog& mCatalog;
    juce::AudioProcessorValueTreeState& mApvts;

    void handleGetState (const juce::var& msg);
    void handleSetParam (const juce::var& msg);
    void handleLoadPreset (const juce::var& msg);
    void handleSavePreset (const juce::var& msg);
    void handleListAceComponents (const juce::var& msg);
};
JSON v1: mensajes UI → Core
Formato base:

json
{
  "type": "setParam",
  "requestId": "abc123",
  "payload": { ... }
}
Tipos clave (MVP):

getState

json
{ "type": "getState", "requestId": "1" }
setParam

Para parámetros macro de APVTS (ej. master gain, cutoff principal layer A).
​

json
{
  "type": "setParam",
  "requestId": "2",
  "payload": {
    "paramId": "LAYER_A_MAIN_CUTOFF",
    "value": 1800.0
  }
}
setAceParam

Para parámetros de componentes ACE (no expuestos directamente como APVTS).

json
{
  "type": "setAceParam",
  "requestId": "3",
  "payload": {
    "layerId": "A",
    "slotType": "Filter",
    "slotIndex": 1,
    "paramName": "cutoff",
    "value": 2000.0
  }
}
setAceComponent

Cambiar, por ejemplo, de IR3109 a KORG35 en un slot.
​

json
{
  "type": "setAceComponent",
  "requestId": "4",
  "payload": {
    "layerId": "A",
    "slotType": "Filter",
    "slotIndex": 1,
    "componentId": "FLT-VA-003"
  }
}
loadPreset / savePreset

json
{
  "type": "loadPreset",
  "requestId": "5",
  "payload": { "presetId": "Hybrid-MS20-JP-Pad" }
}
json
{
  "type": "savePreset",
  "requestId": "6",
  "payload": {
    "name": "My New Pad",
    "tags": ["pad","va","juno"]
  }
}
listAceComponents

json
{
  "type": "listAceComponents",
  "requestId": "7",
  "payload": { "family": "Filter", "engine": "VirtualAnalog" }
}
JSON v1: mensajes Core → UI
Formato base:

json
{
  "type": "state",
  "requestId": "1",
  "payload": { ... }
}
Snapshot de estado (state)

Devuelto a getState y también push incremental si quieres.

json
