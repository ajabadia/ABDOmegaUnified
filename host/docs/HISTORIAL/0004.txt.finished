    mUiBridge.sendToUi = [this] (const juce::String& json)
    {
        mWebView.getBrowser().executeJavascript (
            "window.OmegaCore && OmegaCore.onMessage(" + json + ");");
    };
}

// Cuando JS llama a window.OmegaCore.sendMessage(jsonString)
void OmegaMainEditor::pageAboutToLoad (const juce::String& newUrl)
{
