    sustain = 0.5
    release = 700.0
LFO:

text
Lfos
  └─ Lfo1
Lfo1:

text
Lfo1
  properties:
    slot = 1
    componentId = "LFO-001"
    rate = 0.2
    shape = "sine"
    delay = 0.0
FX:

text
Fx
  └─ Fx1
Fx1:

text
Fx1
  properties:
    slot = 1
    componentId = "FX-CH-001"
    enabled = true
    mix = 0.8
    mode = "I+II"
LayerB.Modulation:

text
LocalRoutes
  ├─ Route0
  └─ Route1
Route0 (LFO1 → detune supersaw):

text
Route0
  properties:
    source = "LFO1"
    destination = "LayerB.Osc1.detune"
    amount = 0.1
    curve = "s-curve"
    bipolar = true
Route1 (ENV2 → cutoff):

text
Route1
  properties:
    source = "ENV2"
    destination = "LayerB.Filter1.cutoff"
    amount = 0.4
    curve = "exponential"
    bipolar = false
LayerB.LayerParams:

