    enabled = true
    tune = 0.0
    pulse_width = 0.5
    sub_level = 0.5
Filtro:

text
Filters
  └─ Filter1
Filter1 (IR3109 LP24):

text
Filter1
  properties:
    slot = 1
    componentId = "FLT-VA-001"
    enabled = true
    mode = "LP24"
    cutoff = 3500.0
    resonance = 0.2
    drive = 0.0
Envelopes:

text
Envelopes
  ├─ Env1
  └─ Env2
Env1 (amp):

text
Env1
  properties:
    slot = 1
    componentId = "ENV-ADSR-GEN"
    role = "amp"
    attack = 80.0
    decay = 400.0
    sustain = 0.8
