Y el copy_resources que ya fijamos para que Resources/ace aparezca junto a los binarios.

3. AceCatalog leyendo YAML real
En AceCatalog.cpp:

cpp
#include "AceCatalog.h"
#include <yaml-cpp/yaml.h>

namespace OmegaAce
{
    // getAceRoot() como definimos antes
    static juce::File getAceRoot()
    {
        auto exeDir   = juce::File::getSpecialLocation(juce::File::currentExecutableFile)
                            .getParentDirectory();
        auto aceRoot1 = exeDir.getChildFile("Resources").getChildFile("ace");
        if (aceRoot1.isDirectory())
            return aceRoot1;

        auto cwd      = juce::File::getCurrentWorkingDirectory();
        auto aceRoot2 = cwd.getChildFile("Resources").getChildFile("ace");
        if (aceRoot2.isDirectory())
            return aceRoot2;

        return aceRoot1;
    }

    static juce::String makeFallbackKey (const juce::String& family,
                                         const juce::String& engine)
    {
        return family + "|" + engine;
    }

    std::unique_ptr<AceCatalog> AceCatalog::createFromResources()
    {
        auto catalog = std::make_unique<AceCatalog>();

        auto aceRoot   = getAceRoot();
        auto indexFile = aceRoot.getChildFile("aceindex.yaml");
        if (! indexFile.existsAsFile())
            return catalog;

        auto indexDoc  = YAML::LoadFile(indexFile.getFullPathName().toStdString());
        auto filesNode = indexDoc["files"];
        if (! filesNode || ! filesNode.IsSequence())
            return catalog;

        for (const auto& fileNode : filesNode)
        {
            auto relName = fileNode.as<std::string>();
            auto yamlFile = aceRoot.getChildFile(relName);
            if (! yamlFile.existsAsFile())
                continue;

            auto doc   = YAML::LoadFile(yamlFile.getFullPathName().toStdString());
            auto comps = doc["components"];
            if (! comps || ! comps.IsSequence())
                continue;

            for (const auto& c : comps)
            {
                ComponentInfo info;
                info.id      = c["id"].as<std::string>();
                info.name    = c["name"].as<std::string>();
                info.family  = c["family"].as<std::string>();
                info.engine  = c["engine"].as<std::string>();
                info.modelId = c["modelId"].as<std::string>();
                info.origin  = c["origin"].as<std::string>();
                info.status  = c["status"].as<std::string>();
                info.version = c["version"].as<int>();

                if (auto tags = c["tags"]; tags && tags.IsSequence())
                    for (const auto& t : tags)
                        info.tags.add(t.as<std::string>());

                if (auto params = c["parameters"]; params && params.IsSequence())
                {
                    for (const auto& p : params)
                    {
                        ParameterDef def;
                        def.id           = p["id"].as<std::string>();
                        def.label        = p["label"].as<std::string>();
                        def.unit         = p["unit"].as<std::string>();
                        def.min          = p["min"].as<float>();
                        def.max          = p["max"].as<float>();
                        def.defaultValue = p["default"].as<float>();
                        info.parameters.add(def);
                    }
                }

                if (auto mts = c["modulationTargets"]; mts && mts.IsSequence())
                {
                    for (const auto& m : mts)
                    {
                        ModTarget t;
                        t.id    = m["id"].as<std::string>();
                        t.label = m["label"].as<std::string>();
                        t.unit  = m["unit"].as<std::string>();
                        info.modulationTargets.add(t);
                    }
                }

                catalog->addComponent(std::move(info));
            }
        }

        catalog->buildFallbacks();
        return catalog;
    }
}
Tu test TestAceCatalog tal como lo escribimos antes debería pasar sin tocarlo, siempre que copy_resources haya copiado Resources/ace al lado de omegatests.




Añade un segundo test que valide la presencia del resto de componentes del MVP.
​

Test AceCatalog para todos los IDs
Tests/TestAceCatalog_AllComponents.cpp:

cpp
#include <catch2/catch_test_macros.hpp>
#include "Core/Ace/AceCatalog.h"

using namespace OmegaAce;

TEST_CASE("AceCatalog loads all MVP components", "[ace][catalog]")
{
    auto catalog = AceCatalog::createFromResources();
    REQUIRE(catalog != nullptr);

    const char* ids[] = {
        "OSC-VA-001",
        "FLT-VA-001",
        "ENV-ADSR-GEN",
        "LFO-001",
        "FX-CH-001"
    };

    for (auto id : ids)
    {
        const auto* c = catalog->getComponent(id);
        REQUIRE(c != nullptr);
        REQUIRE(c->id == id);
        REQUIRE_FALSE(c->name.isEmpty());
        REQUIRE_FALSE(c->family.isEmpty());
        REQUIRE_FALSE(c->engine.isEmpty());
    }

    // Un chequeo extra rápido de familia/engine para VA
    auto oscVa = catalog->listByFamilyAndEngine("Oscillator", "VirtualAnalog");
    REQUIRE(oscVa.size() >= 1);
}
Con esto tendrás dos tests:

Uno específico para OSC-VA-001 con checks de nombre/campos.

Otro que asegura que todos los IDs clave del MVP están presentes en el catálogo.


Para los parámetros clave, lo ideal es un test que verifique id, rango y valor por defecto de cada uno.
​
​

Test de rangos de parámetros ACE
Tests/TestAceCatalog_ParameterRanges.cpp:

cpp
#include <catch2/catch_test_macros.hpp>
#include "Core/Ace/AceCatalog.h"

using namespace OmegaAce;

TEST_CASE("AceCatalog loads parameter ranges correctly", "[ace][catalog][params]")
{
    auto catalog = AceCatalog::createFromResources();
    REQUIRE(catalog != nullptr);

    // OSC-VA-001: tune, pulsewidth
    {
        const auto* osc = catalog->getComponent("OSC-VA-001");
        REQUIRE(osc != nullptr);

        bool foundTune = false, foundPW = false;

        for (const auto& p : osc->parameters)
        {
            if (p.id == "tune")
            {
                foundTune = true;
                REQUIRE(p.min == Approx(-24.0f));
                REQUIRE(p.max == Approx(24.0f));
                REQUIRE(p.defaultValue == Approx(0.0f));
            }
            else if (p.id == "pulsewidth")
            {
                foundPW = true;
                REQUIRE(p.min == Approx(0.0f));
                REQUIRE(p.max == Approx(1.0f));
                REQUIRE(p.defaultValue == Approx(0.5f));
            }
        }

        REQUIRE(foundTune);
        REQUIRE(foundPW);
    }

    // FLT-VA-001: cutoff, resonance
    {
        const auto* flt = catalog->getComponent("FLT-VA-001");
        REQUIRE(flt != nullptr);

        bool foundCutoff = false, foundRes = false;

        for (const auto& p : flt->parameters)
        {
            if (p.id == "cutoff")
            {
                foundCutoff = true;
                REQUIRE(p.min == Approx(20.0f));
                REQUIRE(p.max == Approx(20000.0f));
                REQUIRE(p.defaultValue == Approx(2000.0f));
            }
            else if (p.id == "resonance")
            {
                foundRes = true;
                REQUIRE(p.min == Approx(0.0f));
                REQUIRE(p.max == Approx(1.0f));
                REQUIRE(p.defaultValue == Approx(0.2f));
            }
        }

        REQUIRE(foundCutoff);
        REQUIRE(foundRes);
    }

    // ENV-ADSR-GEN: attack, decay, sustain, release
    {
        const auto* env = catalog->getComponent("ENV-ADSR-GEN");
        REQUIRE(env != nullptr);

        bool foundA = false, foundD = false, foundS = false, foundR = false;

        for (const auto& p : env->parameters)
        {
            if (p.id == "attack")
            {
                foundA = true;
                REQUIRE(p.min == Approx(0.1f));
                REQUIRE(p.max == Approx(5000.0f));
                REQUIRE(p.defaultValue == Approx(10.0f));
            }
            else if (p.id == "decay")
            {
                foundD = true;
                REQUIRE(p.min == Approx(0.1f));
                REQUIRE(p.max == Approx(5000.0f));
                REQUIRE(p.defaultValue == Approx(120.0f));
            }
            else if (p.id == "sustain")
            {
                foundS = true;
                REQUIRE(p.min == Approx(0.0f));
                REQUIRE(p.max == Approx(1.0f));
                REQUIRE(p.defaultValue == Approx(0.8f));
            }
            else if (p.id == "release")
            {
                foundR = true;
                REQUIRE(p.min == Approx(1.0f));
                REQUIRE(p.max == Approx(8000.0f));
                REQUIRE(p.defaultValue == Approx(600.0f));
            }
        }

        REQUIRE(foundA);
        REQUIRE(foundD);
        REQUIRE(foundS);
        REQUIRE(foundR);
    }

    // LFO-001: rate
    {
        const auto* lfo = catalog->getComponent("LFO-001");
        REQUIRE(lfo != nullptr);

        bool foundRate = false;

        for (const auto& p : lfo->parameters)
        {
            if (p.id == "rate")
            {
                foundRate = true;
                REQUIRE(p.min == Approx(0.1f));
                REQUIRE(p.max == Approx(10.0f));
                REQUIRE(p.defaultValue == Approx(1.0f));
            }
        }

        REQUIRE(foundRate);
    }

    // FX-CH-001: mix
    {
        const auto* fx = catalog->getComponent("FX-CH-001");
        REQUIRE(fx != nullptr);

        bool foundMix = false;

        for (const auto& p : fx->parameters)
        {
            if (p.id == "mix")
            {
                foundMix = true;
                REQUIRE(p.min == Approx(0.0f));
                REQUIRE(p.max == Approx(1.0f));
                REQUIRE(p.defaultValue == Approx(0.7f));
            }
        }

        REQUIRE(foundMix);
    }
}
Este test te garantiza que tu YAML y el parseo mantienen intactos los rangos y defaults críticos para el MVP VA tipo Juno.
​
​Vamos directos al preset Juno mínimo y a OmegaPreset::fromYaml/toYaml.

1. YAML del preset Juno mínimo
Crea algo así en Resources/presets/ace_juno_basic_pad.yaml (ruta exacta la puedes ajustar luego):

text
omegapresetVersion: 1
id: ACE-JUNO-BASIC-PAD
name: ACE Juno Basic Pad
author: abdeneurolab
engine: VirtualAnalog

global:
  masterGainDb: 0.0
  masterBypass: 0

layers:
  - id: A
    name: Juno Basic
    engine: VirtualAnalog
    polyphony: 8

    layerParams:
      levelDb: 0.0
      pan: 0.0
      mainCutoffHz: 2000.0
      mainResonance: 0.2
      envAmount: 0.5
      lfoRateHz: 1.0
      lfoDepthSemis: 0.3
      ampAttackMs: 10.0
      ampDecayMs: 120.0
      ampSustain: 0.8
      ampReleaseMs: 600.0

    voiceArchitecture:
      oscillators:
        - slot: 1
          componentId: OSC-VA-001
          enabled: true
          params:
            tune: 0.0
            pulsewidth: 0.5
            sublevel: 0.3

      filters:
        - slot: 1
          componentId: FLT-VA-001
          enabled: true
          mode: LP24
          params:
            cutoff: 2000.0
            resonance: 0.2
            drive: 0.0

      envelopes:
        - slot: 1
          componentId: ENV-ADSR-GEN
          role: amp
          params:
            attack: 10.0
            decay: 120.0
            sustain: 0.8
            release: 600.0

      lfos:
        - slot: 1
          componentId: LFO-001
          params:
            rate: 1.0
            shape: sine
