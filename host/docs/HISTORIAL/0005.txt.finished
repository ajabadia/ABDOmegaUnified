Implementación C++ mínima:

cpp
// Source/Core/Preset/FavoriteStore.h

#pragma once
#include <juce_core/juce_core.h>

namespace Omega::Preset {

class FavoriteStore
{
public:
    explicit FavoriteStore(const juce::File& jsonFile);

    bool isFavorite(const juce::String& presetId) const;
    int  getRating(const juce::String& presetId) const;

    void setFavorite(const juce::String& presetId, bool favorite);
    void setRating(const juce::String& presetId, int rating1to5);

    void touchLastUsed(const juce::String& presetId);

    void save() const;

private:
    juce::File file;
    juce::var  root;    // objeto JSON cargado en memoria

    void load();
    juce::DynamicObject* getOrCreateItem(const juce::String& presetId);
};

} // namespace Omega::Preset
cpp
// Source/Core/Preset/FavoriteStore.cpp

#include "FavoriteStore.h"

namespace Omega::Preset {

FavoriteStore::FavoriteStore(const juce::File& jsonFile)
    : file(jsonFile)
{
    load();
}

void FavoriteStore::load()
{
    if (!file.existsAsFile())
    {
        juce::DynamicObject* obj = new juce::DynamicObject();
        obj->setProperty("version", 1);
        obj->setProperty("items", juce::var(new juce::DynamicObject()));
        root = juce::var(obj);
        return;
    }

    auto text = file.loadFileAsString();
    juce::String error;
    root = juce::JSON::parse(text, error);
    if (!root.isObject())
    {
        juce::DynamicObject* obj = new juce::DynamicObject();
        obj->setProperty("version", 1);
        obj->setProperty("items", juce::var(new juce::DynamicObject()));
        root = juce::var(obj);
    }
}

juce::DynamicObject* FavoriteStore::getOrCreateItem(const juce::String& presetId)
{
    auto* rootObj = root.getDynamicObject();
    auto itemsVar = rootObj->getProperty("items");
    auto* itemsObj = itemsVar.getDynamicObject();
    if (!itemsObj)
    {
        itemsObj = new juce::DynamicObject();
        rootObj->setProperty("items", juce::var(itemsObj));
    }

    auto v = itemsObj->getProperty(presetId);
    if (auto* existing = v.getDynamicObject())
        return existing;

    auto* obj = new juce::DynamicObject();
    itemsObj->setProperty(presetId, juce::var(obj));
    return obj;
}

bool FavoriteStore::isFavorite(const juce::String& presetId) const
{
    if (!root.isObject())
        return false;

    auto* rootObj = root.getDynamicObject();
    auto itemsVar  = rootObj->getProperty("items");
    auto* itemsObj = itemsVar.getDynamicObject();
    if (!itemsObj)
        return false;

    auto v = itemsObj->getProperty(presetId);
    if (auto* o = v.getDynamicObject())
        return o->getProperty("favorite");
    return false;
}

int FavoriteStore::getRating(const juce::String& presetId) const
{
    if (!root.isObject())
        return 0;
    auto* rootObj = root.getDynamicObject();
    auto itemsVar  = rootObj->getProperty("items");
    auto* itemsObj = itemsVar.getDynamicObject();
    if (!itemsObj)
        return 0;

    auto v = itemsObj->getProperty(presetId);
    if (auto* o = v.getDynamicObject())
        return int(o->getProperty("rating1to5"));
    return 0;
}

void FavoriteStore::setFavorite(const juce::String& presetId, bool favorite)
{
    auto* item = getOrCreateItem(presetId);
    item->setProperty("favorite", favorite);
}

void FavoriteStore::setRating(const juce::String& presetId, int rating1to5)
{
    auto* item = getOrCreateItem(presetId);
    item->setProperty("rating1to5", rating1to5);
}

void FavoriteStore::touchLastUsed(const juce::String& presetId)
{
    auto* item = getOrCreateItem(presetId);
    item->setProperty("lastUsed", juce::Time::getCurrentTime().toISO8601(true));
}

void FavoriteStore::save() const
{
    if (!root.isObject())
        return;
    auto json = juce::JSON::toString(root, true);
    file.replaceWithText(json);
}

} // namespace Omega::Preset
Integración en FileSystemPresetRepository:

Miembro:

cpp
FavoriteStore mFavorites;
En constructor:

cpp
FileSystemPresetRepository::FileSystemPresetRepository(const juce::File& rootDir,
                                                       std::shared_ptr<Omega::Ace::AceCatalog> aceCatalog)
    : root(rootDir),
      mAce(std::move(aceCatalog)),
      mFavorites(rootDir.getChildFile(".omega").getChildFile("favorites.json"))
{}
En buildSummaryFromPresetFile:

