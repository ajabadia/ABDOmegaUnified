      routes:
        - source: LFO1
          destination: LayerA.Osc1.pitch
          amount: 0.1
          curve: sine
          bipolar: true
Es el mismo esquema conceptual que ya tenías descrito, pero en YAML listo para parsear.
​

2. Firma mínima de OmegaPreset::fromYaml / toYaml
Extiende tu OmegaPreset para soportar YAML usando yaml-cpp (igual que con AceCatalog).

En OmegaPreset.h añade:

cpp
namespace OmegaPreset
{
    class OmegaPreset
    {
    public:
        // ya existentes...
        static OmegaPreset fromYaml (const juce::String& yamlText);
        juce::String toYaml() const;

        // para el test Juno
        juce::String getId() const;
        void setId (const juce::String& id);

        // helpers de layer A (MVP)
        float getLayerMainCutoff (const juce::String& layerId) const;
        void  setLayerMainCutoff (const juce::String& layerId, float v);
        // (similar para mainResonance, envAmount, etc., cuando los necesites)
    };
}
Implementación muy directa en OmegaPreset.cpp (sin cubrir todavía todo el esquema, solo lo necesario para el Juno MVP):

cpp
#include <yaml-cpp/yaml.h>
#include "OmegaPreset.h"

namespace
{
    constexpr const char* kPropId      = "id";
    constexpr const char* kPropEngine  = "engine";
    constexpr const char* kPropLayers  = "layers";
    constexpr const char* kTypePreset  = "OMEGAPRESET";
    constexpr const char* kTypeLayer   = "LAYER";
    constexpr const char* kTypeLayerParams = "LAYERPARAMS";
}

namespace OmegaPreset
{
    OmegaPreset OmegaPreset::fromYaml (const juce::String& yamlText)
    {
        auto doc = YAML::Load (yamlText.toStdString());

        juce::ValueTree rootVT (kTypePreset);
        rootVT.setProperty (kPropId,     juce::String (doc["id"].as<std::string>()), nullptr);
        rootVT.setProperty (kPropEngine, juce::String (doc["engine"].as<std::string>()), nullptr);
        rootVT.setProperty ("name",      juce::String (doc["name"].as<std::string>()), nullptr);

        auto layersNode = doc["layers"];
        if (layersNode && layersNode.IsSequence())
        {
            for (const auto& l : layersNode)
            {
                juce::ValueTree vtLayer (kTypeLayer);
                vtLayer.setProperty ("id",   juce::String (l["id"].as<std::string>()),   nullptr);
                vtLayer.setProperty ("name", juce::String (l["name"].as<std::string>()), nullptr);
                vtLayer.setProperty ("engine", juce::String (l["engine"].as<std::string>()), nullptr);
                vtLayer.setProperty ("polyphony", l["polyphony"].as<int>(), nullptr);

                if (auto lp = l["layerParams"])
                {
                    juce::ValueTree vtLP (kTypeLayerParams);
                    vtLP.setProperty ("levelDb",       lp["levelDb"].as<float>(), nullptr);
                    vtLP.setProperty ("pan",           lp["pan"].as<float>(), nullptr);
                    vtLP.setProperty ("mainCutoffHz",  lp["mainCutoffHz"].as<float>(), nullptr);
                    vtLP.setProperty ("mainResonance", lp["mainResonance"].as<float>(), nullptr);
                    vtLP.setProperty ("envAmount",     lp["envAmount"].as<float>(), nullptr);
                    vtLayer.addChild (vtLP, -1, nullptr);
                }

                rootVT.addChild (vtLayer, -1, nullptr);
            }
        }

        return OmegaPreset { rootVT };
    }

    juce::String OmegaPreset::toYaml() const
    {
        YAML::Emitter out;

        out << YAML::BeginMap;
        out << YAML::Key << "omegapresetVersion" << YAML::Value << 1;
        out << YAML::Key << "id"     << YAML::Value << getId().toStdString();
        out << YAML::Key << "name"   << YAML::Value << getName().toStdString();
        out << YAML::Key << "engine" << YAML::Value << getEngine().toStdString();

        out << YAML::Key << "layers" << YAML::Value << YAML::BeginSeq;

        auto layers = getLayers();
        for (const auto& l : layers)
        {
            out << YAML::BeginMap;
            out << YAML::Key << "id"       << YAML::Value << l.id.toStdString();
            out << YAML::Key << "name"     << YAML::Value << l.name.toStdString();
            out << YAML::Key << "engine"   << YAML::Value << "VirtualAnalog";
            out << YAML::Key << "polyphony"<< YAML::Value << 8;

            // Solo layerParams básicos por ahora
            out << YAML::Key << "layerParams" << YAML::Value << YAML::BeginMap;
            out << YAML::Key << "levelDb"       << YAML::Value << l.levelDb;
            out << YAML::Key << "pan"           << YAML::Value << l.pan;
            // aquí podrías leer del ValueTree concreto para cutoff/res, etc.
            out << YAML::EndMap; // layerParams

            out << YAML::EndMap; // layer
        }

        out << YAML::EndSeq; // layers
        out << YAML::EndMap;

        return juce::String (out.c_str());
    }

    juce::String OmegaPreset::getId() const
    {
        return root.getProperty (kPropId).toString();
    }

    void OmegaPreset::setId (const juce::String& id)
    {
        root.setProperty (kPropId, id, nullptr);
    }

    float OmegaPreset::getLayerMainCutoff (const juce::String& layerId) const
    {
        for (int i = 0; i < root.getNumChildren(); ++i)
        {
            auto layer = root.getChild (i);
            if (layer.getType() == juce::Identifier (kTypeLayer)
                && layer.getProperty ("id").toString() == layerId)
            {
                auto lp = layer.getChildWithName (juce::Identifier (kTypeLayerParams));
                if (lp.isValid())
                    return (float) lp.getProperty ("mainCutoffHz", 2000.0f);
            }
        }
        return 2000.0f;
    }

    void OmegaPreset::setLayerMainCutoff (const juce::String& layerId, float v)
    {
        for (int i = 0; i < root.getNumChildren(); ++i)
        {
            auto layer = root.getChild (i);
            if (layer.getType() == juce::Identifier (kTypeLayer)
                && layer.getProperty ("id").toString() == layerId)
            {
                auto lp = layer.getChildWithName (juce::Identifier (kTypeLayerParams));
                if (! lp.isValid())
                {
                    lp = juce::ValueTree (kTypeLayerParams);
                    layer.addChild (lp, -1, nullptr);
                }
                lp.setProperty ("mainCutoffHz", v, nullptr);
            }
        }
    }
}
Es un MVP para el preset Juno; luego amplías a arquitectura completa y modulation según lo que ya tienes diseñado.

3. Test de roundtrip YAML del preset Juno
Tests/TestOmegaPreset_JunoYaml.cpp:

cpp
#include <catch2/catch_test_macros.hpp>
#include "Core/Preset/OmegaPreset.h"

using namespace OmegaPreset;

static const char* kJunoYaml = R"YAML(
omegapresetVersion: 1
id: ACE-JUNO-BASIC-PAD
name: ACE Juno Basic Pad
author: abdeneurolab
engine: VirtualAnalog
layers:
  - id: A
    name: Juno Basic
    engine: VirtualAnalog
    polyphony: 8
    layerParams:
      levelDb: 0.0
      pan: 0.0
      mainCutoffHz: 2000.0
      mainResonance: 0.2
      envAmount: 0.5
      lfoRateHz: 1.0
      lfoDepthSemis: 0.3
      ampAttackMs: 10.0
      ampDecayMs: 120.0
      ampSustain: 0.8
      ampReleaseMs: 600.0
)YAML";

TEST_CASE("OmegaPreset Juno YAML roundtrip", "[preset][yaml]")
{
    auto preset = OmegaPreset::fromYaml (kJunoYaml);

    REQUIRE(preset.getId() == "ACE-JUNO-BASIC-PAD");
    REQUIRE(preset.getName() == "ACE Juno Basic Pad");
    REQUIRE(preset.getEngine() == "VirtualAnalog");

    auto layers = preset.getLayers();
    REQUIRE(layers.size() == 1);
    REQUIRE(layers[0].id == "A");
    REQUIRE(layers[0].name == "Juno Basic");

    auto cutoff = preset.getLayerMainCutoff ("A");
    REQUIRE(cutoff == Approx(2000.0f));

    auto yamlOut = preset.toYaml();
    auto preset2 = OmegaPreset::fromYaml (yamlOut);

    REQUIRE(preset2.getId() == preset.getId());
    REQUIRE(preset2.getName() == preset.getName());
    REQUIRE(preset2.getEngine() == preset.getEngine());
    REQUIRE(preset2.getLayerMainCutoff("A") == Approx(2000.0f));
}
Con esto tendrás:

Un preset Juno mínimo en YAML.

OmegaPreset::fromYaml/toYaml funcionando para el MVP.

Un test de roundtrip que asegura que el esquema básico se mantiene.


Lo más sólido es: primero extender OmegaPreset para cubrir slots de voz completos, y luego enganchar AceValidator + VoiceFactory sobre ese modelo.

1. OmegaPreset: slots de voz para el preset Juno
Amplía OmegaPreset con estructuras mínimas que reflejen el YAML actual.
​

En OmegaPreset.h:

cpp
namespace OmegaPreset
{
    struct OscillatorSlot
    {
        int slotIndex = 1;
        juce::String componentId;
        bool enabled = true;
        std::map<juce::String, float> params;
    };

    struct FilterSlot
    {
        int slotIndex = 1;
        juce::String componentId;
        bool enabled = true;
        juce::String mode;
        std::map<juce::String, float> params;
    };

    struct EnvelopeSlot
    {
        int slotIndex = 1;
        juce::String componentId;
        juce::String role; // amp, mod, etc.
        bool enabled = true;
        std::map<juce::String, float> params;
    };

    struct LfoSlot
    {
        int slotIndex = 1;
        juce::String componentId;
        bool enabled = true;
        std::map<juce::String, float> params;
    };

    struct FxSlot
    {
        int slotIndex = 1;
        juce::String componentId;
        bool enabled = true;
        std::map<juce::String, float> params;
    };

    struct VoiceArchitecture
    {
        juce::Array<OscillatorSlot> oscillators;
        juce::Array<FilterSlot>     filters;
        juce::Array<EnvelopeSlot>   envelopes;
        juce::Array<LfoSlot>        lfos;
        juce::Array<FxSlot>         fx;
    };

    struct Layer
    {
        juce::String id;
        juce::String name;
        float levelDb = 0.0f;
        float pan = 0.0f;
        int polyphony = 8;
        VoiceArchitecture voiceArch;
    };

    class OmegaPreset
    {
    public:
        // ...

        juce::Array<Layer> getLayers() const;
        void addLayer (const Layer& layer);

        static OmegaPreset fromYaml (const juce::String& yamlText);
        juce::String toYaml() const;

    private:
        juce::ValueTree root;
    };
}
En OmegaPreset::fromYaml, parsea también voiceArchitecture para la layer A (MVP):
​

cpp
// Dentro del bucle de layersNode
auto va = l["voiceArchitecture"];
if (va)
{
    juce::ValueTree vtVA ("VOICEARCH");

    // oscillators
    if (auto oscs = va["oscillators"]; oscs && oscs.IsSequence())
        for (const auto& o : oscs)
        {
            juce::ValueTree vtOsc ("OSC");
            vtOsc.setProperty ("slot",        o["slot"].as<int>(), nullptr);
            vtOsc.setProperty ("componentId", juce::String (o["componentId"].as<std::string>()), nullptr);
            vtOsc.setProperty ("enabled",     o["enabled"].as<bool>(), nullptr);

            if (auto p = o["params"]; p && p.IsMap())
                for (auto it = p.begin(); it != p.end(); ++it)
                    vtOsc.setProperty (it->first.as<std::string>(),
                                       it->second.as<float>(), nullptr);

            vtVA.addChild (vtOsc, -1, nullptr);
        }

    // filters
    if (auto flts = va["filters"]; flts && flts.IsSequence())
        for (const auto& f : flts)
        {
            juce::ValueTree vtFlt ("FLT");
            vtFlt.setProperty ("slot",        f["slot"].as<int>(), nullptr);
            vtFlt.setProperty ("componentId", juce::String (f["componentId"].as<std::string>()), nullptr);
            vtFlt.setProperty ("enabled",     f["enabled"].as<bool>(), nullptr);
            vtFlt.setProperty ("mode",        juce::String (f["mode"].as<std::string>()), nullptr);

            if (auto p = f["params"]; p && p.IsMap())
                for (auto it = p.begin(); it != p.end(); ++it)
                    vtFlt.setProperty (it->first.as<std::string>(),
                                       it->second.as<float>(), nullptr);

            vtVA.addChild (vtFlt, -1, nullptr);
        }

    // envelopes
    if (auto envs = va["envelopes"]; envs && envs.IsSequence())
        for (const auto& e : envs)
        {
            juce::ValueTree vtEnv ("ENV");
            vtEnv.setProperty ("slot",        e["slot"].as<int>(), nullptr);
            vtEnv.setProperty ("componentId", juce::String (e["componentId"].as<std::string>()), nullptr);
            vtEnv.setProperty ("role",        juce::String (e["role"].as<std::string>()), nullptr);
            vtEnv.setProperty ("enabled",     true, nullptr);

            if (auto p = e["params"]; p && p.IsMap())
                for (auto it = p.begin(); it != p.end(); ++it)
                    vtEnv.setProperty (it->first.as<std::string>(),
                                       it->second.as<float>(), nullptr);

            vtVA.addChild (vtEnv, -1, nullptr);
        }

    // lfos
    if (auto lfos = va["lfos"]; lfos && lfos.IsSequence())
        for (const auto& lf : lfos)
        {
            juce::ValueTree vtLfo ("LFO");
            vtLfo.setProperty ("slot",        lf["slot"].as<int>(), nullptr);
            vtLfo.setProperty ("componentId", juce::String (lf["componentId"].as<std::string>()), nullptr);
            vtLfo.setProperty ("enabled",     true, nullptr);

            if (auto p = lf["params"]; p && p.IsMap())
                for (auto it = p.begin(); it != p.end(); ++it)
                    vtLfo.setProperty (it->first.as<std::string>(),
                                       it->second.as<float>(), nullptr);

            vtVA.addChild (vtLfo, -1, nullptr);
        }

    // fx
    if (auto fxs = va["fx"]; fxs && fxs.IsSequence())
        for (const auto& fx : fxs)
        {
            juce::ValueTree vtFx ("FX");
            vtFx.setProperty ("slot",        fx["slot"].as<int>(), nullptr);
            vtFx.setProperty ("componentId", juce::String (fx["componentId"].as<std::string>()), nullptr);
            vtFx.setProperty ("enabled",     fx["enabled"].as<bool>(), nullptr);

            if (auto p = fx["params"]; p && p.IsMap())
                for (auto it = p.begin(); it != p.end(); ++it)
                    vtFx.setProperty (it->first.as<std::string>(),
                                      it->second.as<float>(), nullptr);

            vtVA.addChild (vtFx, -1, nullptr);
        }

    vtLayer.addChild (vtVA, -1, nullptr);
}
Y getLayers() reconstruye las arrays desde ese ValueTree para tu uso en VoiceFactory.

2. AceValidator básico para el preset Juno
Con AceCatalog cargando los componentes del MVP, puedes crear un validador mínimo que:

Comprueba que cada componentId existe.

Si no, sustituye por un fallback por family/engine.

Devuelve un ValidationReport Ok/Degraded.

Esqueleto reducido AceValidator.h:
​

cpp
namespace OmegaAce
{
    enum class ValidationStatus { Ok, Degraded, Invalid };

    struct ValidationIssue
    {
        ValidationStatus severity;
        juce::String scope; // "LayerA.Osc1", etc.
        juce::String code;  // "UnknownComponent"
        juce::String message;
    };

    struct ValidationReport
    {
        ValidationStatus status = ValidationStatus::Ok;
        std::vector<ValidationIssue> issues;
    };

    class AceValidator
    {
    public:
        explicit AceValidator (const AceCatalog& catalog);

        ValidationReport validateAndRepairPreset (OmegaPreset::OmegaPreset& preset);

    private:
        const AceCatalog& catalog;

        void validateLayer (OmegaPreset::Layer& layer, ValidationReport& report) const;
    };
}
Implementación MVP en AceValidator.cpp:

cpp
ValidationReport AceValidator::validateAndRepairPreset (OmegaPreset::OmegaPreset& preset)
{
    ValidationReport report;

    auto layers = preset.getLayers();
    for (auto& layer : layers)
        validateLayer (layer, report);

    // En MVP no reescribimos el ValueTree aún; eso puede venir después.

    return report;
}

void AceValidator::validateLayer (OmegaPreset::Layer& layer, ValidationReport& report) const
{
    auto checkComponent = [&] (const juce::String& scope,
                               juce::String& componentId,
                               const juce::String& family,
                               const juce::String& engine)
    {
        if (catalog.getComponent (componentId) != nullptr)
            return;

        auto fb = catalog.getFallbackId (family, engine);
        ValidationIssue issue;
        issue.scope   = scope;
        issue.code    = "UnknownComponent";
        issue.message = "Component " + componentId + " not found, using fallback " + fb;

        if (fb.isNotEmpty())
        {
            issue.severity = ValidationStatus::Degraded;
            componentId = fb;
            report.status = ValidationStatus::Degraded;
        }
        else
        {
            issue.severity = ValidationStatus::Invalid;
            report.status  = ValidationStatus::Invalid;
        }

        report.issues.push_back (issue);
    };

    // Para el Juno MVP: asumir siempre engine = "VirtualAnalog"
    const juce::String engine = "VirtualAnalog";

    for (auto& osc : layer.voiceArch.oscillators)
        checkComponent ("Layer" + layer.id + ".Osc" + juce::String (osc.slotIndex),
                        osc.componentId, "Oscillator", engine);

    for (auto& flt : layer.voiceArch.filters)
        checkComponent ("Layer" + layer.id + ".Filter" + juce::String (flt.slotIndex),
                        flt.componentId, "Filter", engine);

    for (auto& env : layer.voiceArch.envelopes)
        checkComponent ("Layer" + layer.id + ".Env" + juce::String (env.slotIndex),
                        env.componentId, "Envelope", engine);

    for (auto& lfo : layer.voiceArch.lfos)
        checkComponent ("Layer" + layer.id + ".Lfo" + juce::String (lfo.slotIndex),
                        lfo.componentId, "LFO", engine);

    for (auto& fx : layer.voiceArch.fx)
        checkComponent ("Layer" + layer.id + ".Fx" + juce::String (fx.slotIndex),
                        fx.componentId, "FX", engine);
}
Luego ya decides si quieres que el validador actualice el ValueTree dentro de OmegaPreset para que VoiceFactory siempre vea IDs válidos.
​

3. VoiceFactory MVP para el preset Juno
Define una VoiceArchitectureRuntime mínima que soporte exactamente:

1 osc (OSC-VA-001).

1 filtro (FLT-VA-001).

1 env amp (ENV-ADSR-GEN).

1 lfo (LFO-001).

1 fx chorus stub (FX-CH-001).

Ejemplo simplificado:

cpp
namespace OmegaDSPVoices
{
    struct VoiceRuntimeVA
    {
        // índices a pools concretos
        uint16_t oscIndex = 0;
        uint16_t fltIndex = 0;
        uint16_t envIndex = 0;
        uint16_t lfoIndex = 0;
        uint16_t fxIndex  = 0;
        bool oscEnabled   = true;
        bool fltEnabled   = true;
        bool fxEnabled    = true;
        // etc...
    };

    struct VoiceArchitectureRuntime
    {
        VoiceRuntimeVA voices[8]; // polyphony fija para MVP
        int numVoices = 8;
    };
}
Y una VoiceFactory que mapea desde OmegaPreset::Layer + AceCatalog a esta arquitectura:
​

cpp
namespace OmegaDSPVoices
{
    class VoiceFactory
    {
    public:
        static VoiceArchitectureRuntime createRuntimeFromPresetLayer (const OmegaPreset::Layer& layer,
                                                                      const OmegaAce::AceCatalog& catalog)
        {
            VoiceArchitectureRuntime rt;
            rt.numVoices = layer.polyphony;

            // MVP: asignaciones fijas
            // en realidad aquí mirarías componentId para decidir qué índice de pool usar.

            for (int v = 0; v < rt.numVoices; ++v)
            {
                auto& voice = rt.voices[v];

                if (! layer.voiceArch.oscillators.isEmpty())
                {
                    const auto& osc = layer.voiceArch.oscillators[0];
                    voice.oscEnabled = osc.enabled;
                    voice.oscIndex   = 0; // índice en tu OscillatorPool VA Juno
                }

                if (! layer.voiceArch.filters.isEmpty())
                {
                    const auto& flt = layer.voiceArch.filters[0];
                    voice.fltEnabled = flt.enabled;
                    voice.fltIndex   = 0;
                }

                if (! layer.voiceArch.fx.isEmpty())
                {
                    const auto& fx = layer.voiceArch.fx[0];
                    voice.fxEnabled = fx.enabled;
                    voice.fxIndex   = 0;
                }

                // envIndex, lfoIndex idem...
            }

            return rt;
        }
    };
}
Con esto ya puedes:

Cargar el YAML del preset Juno en OmegaPreset.

Pasarlo por AceValidator.

Construir un VoiceArchitectureRuntime con VoiceFactory.

Conectar ese runtime con tu VirtualAnalogEngine para sonar.


Un test de flujo completo te va a dar mucha confianza antes de tocar audio.

Test de flujo YAML → OmegaPreset → AceValidator → VoiceFactory
Tests/TestFlow_JunoPreset_ValidationAndVoiceFactory.cpp:

cpp
#include <catch2/catch_test_macros.hpp>
#include "Core/Ace/AceCatalog.h"
#include "Core/Ace/AceValidator.h"
#include "Core/Preset/OmegaPreset.h"
#include "DSP/Voices/VoiceFactory.h"

using namespace OmegaAce;
using namespace OmegaPreset;
using namespace OmegaDSPVoices;

static const char* kJunoYaml = R"YAML(
omegapresetVersion: 1
id: ACE-JUNO-BASIC-PAD
name: ACE Juno Basic Pad
author: abdeneurolab
engine: VirtualAnalog
layers:
  - id: A
    name: Juno Basic
    engine: VirtualAnalog
    polyphony: 8
    layerParams:
      levelDb: 0.0
      pan: 0.0
      mainCutoffHz: 2000.0
      mainResonance: 0.2
      envAmount: 0.5
      lfoRateHz: 1.0
      lfoDepthSemis: 0.3
      ampAttackMs: 10.0
      ampDecayMs: 120.0
      ampSustain: 0.8
      ampReleaseMs: 600.0
    voiceArchitecture:
      oscillators:
        - slot: 1
          componentId: OSC-VA-001
          enabled: true
          params:
            tune: 0.0
            pulsewidth: 0.5
            sublevel: 0.3
      filters:
        - slot: 1
          componentId: FLT-VA-001
          enabled: true
          mode: LP24
          params:
            cutoff: 2000.0
            resonance: 0.2
            drive: 0.0
      envelopes:
        - slot: 1
          componentId: ENV-ADSR-GEN
          role: amp
          params:
            attack: 10.0
            decay: 120.0
            sustain: 0.8
            release: 600.0
      lfos:
        - slot: 1
          componentId: LFO-001
          params:
            rate: 1.0
            shape: sine
            delay: 0.0
      fx:
        - slot: 1
          componentId: FX-CH-001
          enabled: true
          params:
            mix: 0.7
            mode: III
)YAML";

TEST_CASE("Full Juno preset flow: YAML -> OmegaPreset -> AceValidator -> VoiceFactory",
          "[flow][juno][ace]")
{
    // 1) AceCatalog desde Resources/ace
    auto catalog = AceCatalog::createFromResources();
    REQUIRE(catalog != nullptr);
    REQUIRE(catalog->getComponent("OSC-VA-001") != nullptr);
    REQUIRE(catalog->getComponent("FLT-VA-001") != nullptr);
    REQUIRE(catalog->getComponent("ENV-ADSR-GEN") != nullptr);
    REQUIRE(catalog->getComponent("LFO-001") != nullptr);
    REQUIRE(catalog->getComponent("FX-CH-001") != nullptr);

    // 2) OmegaPreset desde YAML
    auto preset = OmegaPreset::fromYaml (kJunoYaml);
    REQUIRE(preset.getId() == "ACE-JUNO-BASIC-PAD");
    auto layers = preset.getLayers();
    REQUIRE(layers.size() == 1);
    auto layerA = layers[0];
    REQUIRE(layerA.id == "A");
    REQUIRE(layerA.voiceArch.oscillators.size() == 1);
    REQUIRE(layerA.voiceArch.filters.size() == 1);
    REQUIRE(layerA.voiceArch.envelopes.size() == 1);
    REQUIRE(layerA.voiceArch.lfos.size() == 1);
    REQUIRE(layerA.voiceArch.fx.size() == 1);

    // 3) Validación ACE
    AceValidator validator (*catalog);
    auto report = validator.validateAndRepairPreset (preset);
    REQUIRE(report.status == ValidationStatus::Ok); // todos los IDs existen

    // 4) VoiceFactory: runtime para engine VA
    layers = preset.getLayers();       // volver a leer por si AceValidator muta
    layerA = layers[0];

    auto vaRuntime = VoiceFactory::createRuntimeFromPresetLayer (layerA, *catalog);

    REQUIRE(vaRuntime.numVoices == layerA.polyphony);
    for (int v = 0; v < vaRuntime.numVoices; ++v)
    {
        const auto& voice = vaRuntime.voices[v];
        REQUIRE(voice.oscEnabled);
        REQUIRE(voice.fltEnabled);
        REQUIRE(voice.fxEnabled);
        // índices 0 en pools VA para MVP
        REQUIRE(voice.oscIndex == 0);
        REQUIRE(voice.fltIndex == 0);
        REQUIRE(voice.fxIndex  == 0);
    }
}
Cuando este test pase, sabrás que:

El preset Juno en YAML se parsea bien a OmegaPreset.

AceCatalog contiene todos los componentes y AceValidator no encuentra fallos.

VoiceFactory genera una arquitectura de voces coherente lista para que el engine VA la use.





Entonces fijamos esta regla: la polyphony viene del preset, pero la arquitectura tiene un máximo fijo (por ejemplo 32 voces) y clamp a ese máximo; por defecto, tus presets Juno usarán 8.

Cuando retomemos el engine, te lo preparo así:

VoiceRuntimeVA y VoicePoolVA con kMaxVoices (p.ej. 32) y campo numVoices.

OmegaPreset::Layer.polyphony se respeta pero se clampa a kMaxVoices.

VoiceFactory::createRuntimeFromPresetLayer rellena numVoices = clamp(layer.polyphony, 1, kMaxVoices).

VirtualAnalogEngine::renderNextBlock itera for (int v = 0; v < runtime.numVoices; ++v).




Te dejo las tres piezas mínimas: VoiceRuntimeVA, VoicePoolVA y el esqueleto de VirtualAnalogEngine::renderNextBlock respetando kMaxVoices = 32 y polyphony desde preset.

1. VoiceRuntimeVA y VoicePoolVA
Source/DSP/Voices/VoiceRuntimeVA.h:

cpp
#pragma once

#include <array>
#include <atomic>
#include <cstdint>

namespace OmegaDSPVoices
{
    // Máximo de voces del engine VA
    inline constexpr int kMaxVoicesVA = 32;
    inline constexpr int kMaxBlockSizeVA = 256;

    struct alignas(64) VoiceRuntimeVA
    {
        struct State
        {
            std::atomic<bool> active { false };
            std::atomic<int>  midiNote { -1 };
            std::atomic<float> velocity { 0.0f };
            std::atomic<float> currentGain { 0.0f };
        };

        State state;

        // buffer temporal por voz (stereo interleaved)
        alignas(32) std::array<float, kMaxBlockSizeVA * 2> buffer {};

        // índices a pools concretos
        uint16_t oscIndex = 0;
        uint16_t fltIndex = 0;
        uint16_t envIndex = 0;
        uint16_t lfoIndex = 0;
        uint16_t fxIndex  = 0;

        bool oscEnabled = true;
        bool fltEnabled = true;
        bool fxEnabled  = true;
    };

    class VoicePoolVA
    {
    public:
        void prepare (double /*sampleRate*/, int maxBlockSize)
        {
            // Para MVP asumimos que maxBlockSize <= kMaxBlockSizeVA
            jassert (maxBlockSize <= kMaxBlockSizeVA);
            blockSize = maxBlockSize;
        }

        static constexpr int getMaxVoices() noexcept { return kMaxVoicesVA; }

        VoiceRuntimeVA& getVoice (int index) noexcept
        {
            jassert (index >= 0 && index < kMaxVoicesVA);
            return voices[(size_t) index];
        }

        const VoiceRuntimeVA& getVoice (int index) const noexcept
        {
            jassert (index >= 0 && index < kMaxVoicesVA);
            return voices[(size_t) index];
        }

        void resetAll() noexcept
        {
            for (auto& v : voices)
            {
                v.state.active.store (false, std::memory_order_relaxed);
                v.state.midiNote.store (-1, std::memory_order_relaxed);
                v.state.velocity.store (0.0f, std::memory_order_relaxed);
                v.state.currentGain.store (0.0f, std::memory_order_relaxed);
                std::fill (v.buffer.begin(), v.buffer.end(), 0.0f);
            }
        }

        int getBlockSize() const noexcept { return blockSize; }

    private:
        std::array<VoiceRuntimeVA, kMaxVoicesVA> voices;
        int blockSize = kMaxBlockSizeVA;
    };
}
2. Datos de runtime de arquitectura (numVoices clamped)
Source/DSP/Voices/VoiceArchitectureRuntimeVA.h:

cpp
#pragma once

#include <cstdint>

namespace OmegaDSPVoices
{
    struct VoiceArchitectureRuntimeVA
    {
        int numVoices = 8; // se setea desde VoiceFactory, clamp 1..kMaxVoicesVA
        // aquí puedes añadir cualquier dato inmutable de arquitectura por voz
    };
}
Tu VoiceFactory::createRuntimeFromPresetLayer debe hacer algo así al final:
​

cpp
VoiceArchitectureRuntimeVA VoiceFactory::createRuntimeFromPresetLayer(...)
{
    VoiceArchitectureRuntimeVA rt;
    auto requested = layer.polyphony;
    if (requested < 1)  requested = 1;
    if (requested > kMaxVoicesVA) requested = kMaxVoicesVA;
    rt.numVoices = requested;

    // rellenar índices oscIndex/fltIndex/etc. en cada VoiceRuntimeVA del pool
    // ...

    return rt;
}
3. Esqueleto de VirtualAnalogEngine::renderNextBlock
Source/DSP/Engines/VirtualAnalogEngine.h (extracto):

cpp
#pragma once

#include <juce_audio_basics/juce_audio_basics.h>
#include "DSP/Voices/VoiceRuntimeVA.h"
#include "DSP/Voices/VoiceArchitectureRuntimeVA.h"

namespace OmegaDSPEngines
{
    class VirtualAnalogEngine
    {
    public:
        VirtualAnalogEngine() = default;

        void prepare (double sampleRate, int samplesPerBlock)
        {
            mSampleRate = sampleRate;
            mBlockSize  = samplesPerBlock;
            mVoicePool.prepare (sampleRate, samplesPerBlock);
        }

        void reset()
        {
            mVoicePool.resetAll();
        }

        void setVoiceArchitecture (const OmegaDSPVoices::VoiceArchitectureRuntimeVA& arch)
        {
            mVoiceArch = arch;
        }

        void renderNextBlock (juce::AudioBuffer<float>& buffer,
                              const juce::MidiBuffer& midi) noexcept;

    private:
        double mSampleRate = 44100.0;
        int    mBlockSize  = 256;

        OmegaDSPVoices::VoicePoolVA              mVoicePool;
        OmegaDSPVoices::VoiceArchitectureRuntimeVA mVoiceArch;

        // pools concretos de componentes irán aquí (DCO, filtro, chorus)
    };
}
Source/DSP/Engines/VirtualAnalogEngine.cpp (bucle básico de mezcla por voz):
​
​

cpp
#include "VirtualAnalogEngine.h"

using namespace OmegaDSPVoices;

namespace OmegaDSPEngines
{
    void VirtualAnalogEngine::renderNextBlock (juce::AudioBuffer<float>& buffer,
                                               const juce::MidiBuffer& midi) noexcept
    {
        juce::ignoreUnused (midi); // MIDI aún no procesado en este MVP

        const int numSamples = buffer.getNumSamples();
        jassert (numSamples <= mVoicePool.getBlockSize());

        // limpiar salida
        buffer.clear();

        const int numVoices = mVoiceArch.numVoices;
        jassert (numVoices >= 1 && numVoices <= kMaxVoicesVA);

        // Por cada voz activa: generar en su buffer temporal y mezclar al principal
        for (int v = 0; v < numVoices; ++v)
        {
            auto& voice = mVoicePool.getVoice (v);

            if (! voice.state.active.load (std::memory_order_relaxed))
                continue;

            float* voiceBuf = voice.buffer.data();

            // 1) limpiar buffer temporal de la voz
            std::fill (voiceBuf, voiceBuf + numSamples * 2, 0.0f);

            // 2) procesar cadena DSP fija de esta voz:
            //    DCO -> Filtro -> AmpEnv -> Chorus (stub)
            //
            //    Aquí irán llamadas tipo:
            //    oscPool.process (voice.oscIndex, voiceBuf, numSamples, ...);
            //    filterPool.process (voice.fltIndex, voiceBuf, numSamples, ...);
            //    envPool.applyAmp (voice.envIndex, voiceBuf, numSamples, ...);
            //    chorusPool.process (voice.fxIndex, voiceBuf, numSamples, ...);

            // 3) mezclar buffer de voz al buffer principal
            auto* outL = buffer.getWritePointer (0);
            auto* outR = buffer.getNumChannels() > 1
                       ? buffer.getWritePointer (1)
                       : nullptr;

            for (int i = 0; i < numSamples; ++i)
            {
                const float sL = voiceBuf[i * 2 + 0];
                const float sR = voiceBuf[i * 2 + 1];

                outL[i] += sL;

                if (outR != nullptr)
                    outR[i] += sR;
            }
        }
    }
}
Este esqueleto cumple:

Máximo 32 voces (kMaxVoicesVA), pero usa mVoiceArch.numVoices venido del preset clamped.

No hace allocs en audio thread, usa buffers prealocados por voz.
​

Deja los huecos claros para integrar tus pools reales de DCO, IR3109 y chorus stub.





Para eso necesitas tres capas: atomics de parámetros por layer, pools simples y lectura de esos atomics en el bucle de voces.
​
​

1. LayerASettings: cutoff/res/envAmount
Source/Core/Settings/LayerASettings.h:

cpp
#pragma once
#include <atomic>

struct LayerASettings
{
    std::atomic<float> levelDb      { 0.0f };
    std::atomic<float> pan          { 0.0f };
    std::atomic<float> cutoffHz     { 2000.0f };
    std::atomic<float> resonance    { 0.2f };
    std::atomic<float> envAmount    { 0.5f };
    std::atomic<float> ampAttackMs  { 10.0f };
    std::atomic<float> ampDecayMs   { 120.0f };
    std::atomic<float> ampSustain   { 0.8f };
    std::atomic<float> ampReleaseMs { 600.0f };
};
En tu AudioProcessor, en parameterChanged, escribes ahí desde APVTS (como ya habíamos comentado: cutoffHz.store(newValue, relaxed), etc.).

2. Pools mínimos (firmas)
Interfaces muy simples, sin implementación DSP todavía:

cpp
// OscillatorPoolJunoDco.h
#pragma once
