Implementación inicial puede ser noop o muy simple; lo importante aquí es el wiring.
​

3. VirtualAnalogEngine leyendo LayerASettings
En VirtualAnalogEngine.h, añade:

cpp
#include "Core/Settings/LayerASettings.h"
#include "DSP/VA/OscillatorPoolJunoDco.h"
#include "DSP/VA/FilterPoolJunoIR3109.h"
#include "DSP/VA/ChorusPoolJunoStub.h"

namespace OmegaDSPEngines
{
    class VirtualAnalogEngine
    {
    public:
        void setLayerSettings (const LayerASettings* s) { layerSettings = s; }
        // ...

    private:
        const LayerASettings* layerSettings = nullptr;

        OmegaDSPVA::OscillatorPoolJunoDco  oscPool;
        OmegaDSPVA::FilterPoolJunoIR3109   filterPool;
        OmegaDSPVA::ChorusPoolJunoStub     chorusPool;
    };
}
En prepare:

cpp
void VirtualAnalogEngine::prepare (double sampleRate, int samplesPerBlock)
{
    mSampleRate = sampleRate;
    mBlockSize  = samplesPerBlock;
    mVoicePool.prepare (sampleRate, samplesPerBlock);

    oscPool.prepare (sampleRate);
    filterPool.prepare (sampleRate);
    chorusPool.prepare (sampleRate);
}
4. Bucle renderNextBlock con cutoff/res/envAmount
Dentro de renderNextBlock (sustituye el comentario de la cadena DSP):
​
​

cpp
void VirtualAnalogEngine::renderNextBlock (juce::AudioBuffer<float>& buffer,
                                           const juce::MidiBuffer& midi) noexcept
{
    juce::ignoreUnused (midi);
    const int numSamples = buffer.getNumSamples();
    buffer.clear();

    const int numVoices = mVoiceArch.numVoices;
    if (layerSettings == nullptr)
        return;

    // leer macros layer A una vez por bloque
    const float cutoff   = layerSettings->cutoffHz.load (std::memory_order_relaxed);
    const float res      = layerSettings->resonance.load (std::memory_order_relaxed);
    const float envAmt   = layerSettings->envAmount.load (std::memory_order_relaxed);

    for (int v = 0; v < numVoices; ++v)
    {
        auto& voice = mVoicePool.getVoice (v);
        if (! voice.state.active.load (std::memory_order_relaxed))
            continue;

        float* voiceBuf = voice.buffer.data();
        std::fill (voiceBuf, voiceBuf + numSamples * 2, 0.0f);

        // 1) DCO: usar midiNote + velocity del estado
        const int   midiNote = voice.state.midiNote.load (std::memory_order_relaxed);
        const float baseHz   = 440.0f * std::pow (2.0f, (midiNote - 69) / 12.0f);

        if (voice.oscEnabled)
        {
            oscPool.process (voice.oscIndex,
                             voiceBuf,
                             numSamples,
                             baseHz,
                             /*pw*/ 0.5f);
        }

        // 2) Envelope amp (placeholder: ganancia fija por envAmt)
        const float envValue = envAmt; // luego vendrá de un generador de envolvente
        for (int i = 0; i < numSamples; ++i)
        {
            voiceBuf[i * 2 + 0] *= envValue;
            voiceBuf[i * 2 + 1] *= envValue;
        }

        // 3) Filtro IR3109 con cutoff/res
        if (voice.fltEnabled)
        {
            const float drive = 0.0f;
            filterPool.process (voice.fltIndex,
                                voiceBuf,
                                numSamples,
                                cutoff,
                                res,
                                drive);
        }

        // 4) Chorus stub mix fijo
        if (voice.fxEnabled)
        {
            chorusPool.process (voice.fxIndex,
                                voiceBuf,
                                numSamples,
                                /*mix*/ 0.7f);
        }

        // 5) Mezcla en buffer principal
        auto* outL = buffer.getWritePointer (0);
        auto* outR = buffer.getNumChannels() > 1
                   ? buffer.getWritePointer (1)
                   : nullptr;

        for (int i = 0; i < numSamples; ++i)
        {
            const float sL = voiceBuf[i * 2 + 0];
            const float sR = voiceBuf[i * 2 + 1];

            outL[i] += sL;
            if (outR != nullptr)
                outR[i] += sR;
        }
    }
}
Aquí ya estás leyendo cutoff, resonance y envAmount desde LayerASettings, que a su vez se rellenan desde OmegaPreset/APVTS.




El wiring es directo: APVTS notifica, copias a LayerASettings, el engine lee esos atomics.
​

1. Definir los parámetros en APVTS
En tu OmegaAudioProcessor (constructor), define el layout con los IDs que ya fijaste:
​

cpp
juce::AudioProcessorValueTreeState::ParameterLayout
OmegaAudioProcessor::createParameterLayout()
{
    using Param = juce::AudioParameterFloat;
    std::vector<std::unique_ptr<juce::RangedAudioParameter>> params;

    // Grupo master
    params.push_back (std::make_unique<Param>(
        "MASTERGAINDB", "Master Gain",
        juce::NormalisableRange<float> (-24.0f, 12.0f),
        0.0f));

    // Layer A filtro
    params.push_back (std::make_unique<Param>(
        "LAYERAMAINCUTOFF", "Layer A Cutoff",
        juce::NormalisableRange<float> (20.0f, 20000.0f, 0.0f, 0.5f),
        2000.0f));
    params.push_back (std::make_unique<Param>(
        "LAYERAMAINRES", "Layer A Resonance",
        juce::NormalisableRange<float> (0.0f, 1.0f),
        0.2f));
    params.push_back (std::make_unique<Param>(
        "LAYERAENVAMT", "Layer A Env Amt",
        juce::NormalisableRange<float> (-1.0f, 1.0f),
        0.5f));

    // (añades LAYERALEVELDB, LAYERAPAN, etc. igual que en el doc)

    return { params.begin(), params.end() };
}
2. APVTS → LayerASettings (parameterChanged)
En el processor, guarda una instancia de LayerASettings y añade listeners:
​

cpp
class OmegaAudioProcessor : public juce::AudioProcessor,
                            public juce::AudioProcessorValueTreeState::Listener
{
public:
    OmegaAudioProcessor()
      : mApvts (*this, nullptr, "PARAMS", createParameterLayout())
    {
        mApvts.addParameterListener ("LAYERAMAINCUTOFF", this);
        mApvts.addParameterListener ("LAYERAMAINRES",    this);
        mApvts.addParameterListener ("LAYERAENVAMT",     this);
        // etc...
    }

    ~OmegaAudioProcessor() override
    {
        mApvts.removeParameterListener ("LAYERAMAINCUTOFF", this);
        mApvts.removeParameterListener ("LAYERAMAINRES",    this);
        mApvts.removeParameterListener ("LAYERAENVAMT",     this);
    }

    void parameterChanged (const juce::String& id, float newValue) override
    {
        if      (id == "LAYERAMAINCUTOFF")
            mLayerASettings.cutoffHz.store (newValue, std::memory_order_relaxed);
        else if (id == "LAYERAMAINRES")
            mLayerASettings.resonance.store (newValue, std::memory_order_relaxed);
        else if (id == "LAYERAENVAMT")
            mLayerASettings.envAmount.store (newValue, std::memory_order_relaxed);
        // resto de IDs...
    }

private:
    juce::AudioProcessorValueTreeState mApvts;
    LayerASettings                     mLayerASettings;
};
Nunca lees APVTS en el audio thread; solo los atomics.
​

3. LayerASettings → engine
En tu processor, al inicializar el engine VA:

cpp
void OmegaAudioProcessor::prepareToPlay (double sampleRate, int samplesPerBlock)
{
    mEngine.prepare (sampleRate, samplesPerBlock);
    mEngine.setLayerSettings (&mLayerASettings);
}
Y en VirtualAnalogEngine::renderNextBlock ya estás leyendo:
​

cpp
const float cutoff = layerSettings->cutoffHz.load (std::memory_order_relaxed);
const float res    = layerSettings->resonance.load (std::memory_order_relaxed);
const float envAmt = layerSettings->envAmount.load (std::memory_order_relaxed);
Con esto cierras el circuito:

UI/host cambian LAYERAMAINCUTOFF, LAYERAMAINRES, LAYERAENVAMT vía APVTS.

parameterChanged los copia a LayerASettings.

El engine VA lee esos atomics cada bloque y los aplica a filtro y envAmount.
​

¿Quieres que el siguiente paso sea el camino inverso preset → APVTS (cargar un YAML y volcar sus macros a estos parámetros)?


Para preset → APVTS, haces un único punto de sincronización en el processor que lea OmegaPreset y rellene parámetros macro.
​

1. Helper en el processor: applyPresetToApvts
En OmegaAudioProcessor:

cpp
void OmegaAudioProcessor::applyPresetToApvts (const OmegaPreset::OmegaPreset& preset)
{
    // MVP: solo layer A
    auto layers = preset.getLayers();
    if (layers.isEmpty())
        return;

    const auto& layerA = layers[0];

    auto setParam = [this] (const juce::String& id, float value)
    {
        if (auto* p = mApvts.getParameter (id))
        {
            auto& range = p->getNormalisableRange();
            const float norm = range.convertTo0to1 (value);
            p->setValueNotifyingHost (norm);
        }
    };

    // Master (si lo tienes en el preset, si no, usa defaults)
    // setParam ("MASTERGAINDB", preset.getMasterGainDb());

    // Layer A macros desde Layer.layerParams o helpers
    setParam ("LAYERAMAINCUTOFF", layerA.mainCutoffHz);
    setParam ("LAYERAMAINRES",    layerA.mainResonance);
    setParam ("LAYERAENVAMT",     layerA.envAmount);
    // idem para LAYERALEVELDB, LAYERAPAN, etc.
}
layerA.mainCutoffHz/mainResonance/envAmount salen de tu parseo de YAML a Layer (o de helpers tipo getLayerMainCutoff("A")).
​

2. Uso al cargar preset YAML
Cuando cargues un preset (desde archivo, menú, etc.):

cpp
void OmegaAudioProcessor::loadPresetFromYaml (const juce::String& yamlText)
{
    auto preset = OmegaPreset::OmegaPreset::fromYaml (yamlText);

    // Validar y reparar
    OmegaAce::AceValidator validator (*mAceCatalog);
    auto report = validator.validateAndRepairPreset (preset);
    juce::ignoreUnused (report);

    // Actualizar APVTS macros
    applyPresetToApvts (preset);

    // Construir VoiceArchitectureRuntime y actualizar engine/config
    // ...
}
Así, al cambiar de preset:

Vuelcas macros del YAML a APVTS.

parameterChanged actualiza LayerASettings.

El engine lee esos atomics y la UI (sliders) se sincroniza sola.
​

¿Quieres que a continuación te deje también el esqueleto de preset → APVTS → LayerASettings → engine empaquetado en un solo método tipo applyPresetToEngine(preset) para tener un único entrypoint?


Puedes encapsular todo el camino preset → APVTS → engine en un único método del processor.
​

applyPresetToEngine(preset)
En OmegaAudioProcessor:

cpp
void OmegaAudioProcessor::applyPresetToEngine (OmegaPreset::OmegaPreset& preset)
{
    // 1) Validar/reparar ACE
    OmegaAce::AceValidator validator (*mAceCatalog);
    auto report = validator.validateAndRepairPreset (preset);
    juce::ignoreUnused (report); // puedes loguear DEGRADED si quieres

    // 2) Volcar macros del preset a APVTS (esto a su vez actualizará LayerASettings)
    applyPresetToApvts (preset);

    // 3) Construir runtime de voces a partir del preset
    auto layers = preset.getLayers();
    if (layers.isEmpty())
        return;

    auto layerA = layers[0];

    auto vaRuntime = OmegaDSPVoices::VoiceFactory::createRuntimeFromPresetLayer (layerA, *mAceCatalog);

    // 4) Decirle al engine VA cuántas voces usar y arquitectura
    mEngine.setVoiceArchitecture (vaRuntime);

    // 5) (más adelante) reconstruir EngineConfig completo si usas router multi-layer
}
Uso típico al cargar preset YAML:

cpp
void OmegaAudioProcessor::loadPresetFromYaml (const juce::String& yamlText)
{
    auto preset = OmegaPreset::OmegaPreset::fromYaml (yamlText);
    applyPresetToEngine (preset);
    mCurrentPreset = std::move (preset); // si quieres guardarlo
}
Así tienes una sola puerta de entrada donde:

Validar ACE.

Actualizar macros (APVTS + LayerASettings).

Construir arquitectura de voces para el engine.
​

¿Te interesa que el próximo paso lo enfoquemos en el camino inverso APVTS → preset (para guardar tweaks de cutoff/res/envAmount en el YAML)?

Para APVTS → preset solo necesitas leer los parámetros macro y volcarlos a OmegaPreset::Layer antes de serializar.
​

1. Helper APVTS → Layer (macros Layer A)
En OmegaAudioProcessor:

cpp
void OmegaAudioProcessor::applyApvtsToLayer (OmegaPreset::Layer& layerA)
{
    auto get = [this] (const juce::String& id, float defaultValue)
    {
        if (auto* p = mApvts.getParameter (id))
        {
            auto& range = p->getNormalisableRange();
            const float norm = p->getValue();
            return range.convertFrom0to1 (norm);
        }
        return defaultValue;
    };

    layerA.mainCutoffHz   = get ("LAYERAMAINCUTOFF", 2000.0f);
    layerA.mainResonance  = get ("LAYERAMAINRES",    0.2f);
    layerA.envAmount      = get ("LAYERAENVAMT",     0.5f);
    layerA.levelDb        = get ("LAYERALEVELDB",    0.0f);
    layerA.pan            = get ("LAYERAPAN",        0.0f);
    // idem para LAYERAAMPATTACKMS, etc., si los expones
}
Esto refleja el estado actual del host/UI en la estructura de preset.
​

2. APVTS → preset completo antes de guardar
Cuando quieras guardar el preset actual a YAML:

cpp
juce::String OmegaAudioProcessor::serializeCurrentPresetToYaml()
{
    // asumimos que mCurrentPreset contiene el ValueTree original
    auto preset = mCurrentPreset; // copia

    auto layers = preset.getLayers();
    if (! layers.isEmpty())
    {
        auto layerA = layers[0];

        // sobrescribir macros con lo que hay en APVTS
        applyApvtsToLayer (layerA);

        // volver a guardar la layer en el preset
        preset.replaceLayer ("A", layerA); // helper tuyo que actualice el ValueTree
    }

    return preset.toYaml();
}
La idea es:

mCurrentPreset mantiene la arquitectura ACE (osc, filtro, etc.).

Cuando guardas, solo sustituyes los valores de layerParams por lo que está en APVTS.

toYaml() ya serializa el ValueTree actualizado.
​

¿Quieres que el siguiente paso sea definir ese OmegaPreset::replaceLayer(id, layer) para que la escritura de vuelta al ValueTree quede clara?


replaceLayer es sencillo: localizas la layer en el ValueTree por id y actualizas sus propiedades/children.
​

OmegaPreset::replaceLayer
En OmegaPreset.h:

cpp
class OmegaPreset
{
public:
    // ...
    void replaceLayer (const juce::String& id, const Layer& layer);
private:
    juce::ValueTree root;
};
En OmegaPreset.cpp:
​

cpp
void OmegaPreset::replaceLayer (const juce::String& id, const Layer& layer)
{
    for (int i = 0; i < root.getNumChildren(); ++i)
    {
        auto vtLayer = root.getChild (i);
        if (vtLayer.getType() != juce::Identifier ("LAYER"))
            continue;

        if (vtLayer.getProperty ("id").toString() != id)
            continue;

        // actualizar propiedades básicas
        vtLayer.setProperty ("name", layer.name, nullptr);
        vtLayer.setProperty ("polyphony", layer.polyphony, nullptr);

        // layerParams
        auto vtLP = vtLayer.getChildWithName ("LAYERPARAMS");
        if (! vtLP.isValid())
        {
            vtLP = juce::ValueTree ("LAYERPARAMS");
            vtLayer.addChild (vtLP, -1, nullptr);
        }

        vtLP.setProperty ("levelDb",       layer.levelDb,       nullptr);
        vtLP.setProperty ("pan",           layer.pan,           nullptr);
        vtLP.setProperty ("mainCutoffHz",  layer.mainCutoffHz,  nullptr);
        vtLP.setProperty ("mainResonance", layer.mainResonance, nullptr);
        vtLP.setProperty ("envAmount",     layer.envAmount,     nullptr);
        // aquí puedes añadir attack/decay/etc. si los expones

        return; // encontrada y actualizada
    }

    // si no existía, opcionalmente podrías crear una layer nueva
}
Así, cuando hagas:

cpp
applyApvtsToLayer (layerA);
preset.replaceLayer ("A", layerA);
auto yaml = preset.toYaml();
el YAML reflejará los valores actuales de cutoff/res/envAmount que ven el host y la UI.
​


Para probar el pipeline basta un DCO naive (saw) por voz; luego ya le metes PolyBLEP/BLIT.

1. DCO mínimo por voz
Source/DSP/VA/JunoDco.h:

cpp
#pragma once
#include <cmath>

namespace OmegaDSPVA
{
    struct JunoDco
    {
        void prepare (double sampleRate)
        {
            sr = sampleRate;
            phase = 0.0f;
        }

        void setFrequency (float hz)
        {
            freq = hz;
            phaseInc = (float) (hz / sr);
        }

        // saw naïve [-1,1]
        float tick() noexcept
        {
            phase += phaseInc;
            if (phase >= 1.0f)
                phase -= 1.0f;

            return 2.0f * phase - 1.0f;
        }

    private:
        double sr   = 44100.0;
        float  freq = 440.0f;
        float  phase = 0.0f;
        float  phaseInc = 0.0f;
    };
}
2. OscillatorPoolJunoDco: un DCO por voz
Source/DSP/VA/OscillatorPoolJunoDco.h:

cpp
#pragma once
#include <array>
#include "JunoDco.h"
#include "DSP/Voices/VoiceRuntimeVA.h"

namespace OmegaDSPVA
{
    class OscillatorPoolJunoDco
    {
    public:
        void prepare (double sampleRate)
        {
            for (auto& osc : oscillators)
                osc.prepare (sampleRate);
        }

        void process (uint16_t voiceIndex,
                      float* interleavedStereo,
                      int numSamples,
                      float baseHz,
                      float /*pw*/) noexcept
        {
            auto& osc = oscillators[voiceIndex];

            osc.setFrequency (baseHz);

            for (int i = 0; i < numSamples; ++i)
            {
                const float s = osc.tick();
                interleavedStereo[i * 2 + 0] += s;
                interleavedStereo[i * 2 + 1] += s;
            }
        }

    private:
        std::array<JunoDco, OmegaDSPVoices::kMaxVoicesVA> oscillators;
    };
}
Así cada voz tiene su propia fase independiente.

3. Chorus y filtro como stubs por ahora
Para que suene ya:

