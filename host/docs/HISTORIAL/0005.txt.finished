Y botón:

tsx
<button onClick={saveSnapshot}>Save snapshot</button>
2. Handler en OmegaUiBridge
En handleMessageFromUi:

cpp
else if (type == "savePreset")
{
    handleSavePreset (msg, requestId);
}
Implementación (OmegaUiBridge tiene callback onSavePreset conectado al processor):

cpp
// en OmegaUiBridge.h
std::function<void (const juce::String& message)> onSavePreset;

// en OmegaUiBridge.cpp
void OmegaUiBridge::handleSavePreset (const juce::var& msg,
                                      const juce::String& requestId)
{
    auto* obj = msg.getDynamicObject();
    auto payload = obj->getProperty ("payload");
    auto* pObj = payload.getDynamicObject();
    if (pObj == nullptr) return;

    const juce::String message = pObj->getProperty ("message").toString();

    if (onSavePreset)
        onSavePreset (message);

    // opcional: devolver nuevo estado tras guardar
    if (sendToUi)
        sendToUi (buildStateJson (requestId));
}
3. Processor: saveCurrentPreset
En OmegaAudioProcessor:

cpp
void OmegaAudioProcessor::saveCurrentPreset (const juce::String& message)
{
    auto preset = mCurrentPreset;        // copia
    applyApvtsToLayerAndPreset (preset); // APVTS -> preset macros
    auto commit = mPresetRepo.saveCommit (preset, "abdeneurolab", message);
    mCurrentPreset = std::move (preset);

    // opcional: notificar a UI un history actualizado
}
Y en el editor:

cpp
mUiBridge.onSavePreset = [this] (const juce::String& msg)
{
    mProcessor.saveCurrentPreset (msg);
};
Con esto, pulsar “Save snapshot” en la Web UI crea un commit nuevo en Git for Sounds basado en el estado actual (APVTS + preset), y puedes verlo después en listHistory y hacer checkout cuando quieras.

¿Quieres parar aquí para ir integrando todo esto, o te interesa que después entremos en ideas para diffs de presets (qué parámetros cambiaron entre dos commits)?



Puedes empezar con un diff puramente de parámetros (macros + ACE) comparando dos YAML/ValueTree y sacando “paramId → (old, new)”.

1. Diff lógico a nivel de OmegaPreset
Define una estructura simple:

cpp
struct ParamDiff
{
    juce::String path;   // p.ej. "LayerA.mainCutoffHz" o "LayerA.Osc1.pulsewidth"
    float oldValue = 0.0f;
    float newValue = 0.0f;
};

struct PresetDiff
{
    juce::String fromCommitId;
    juce::String toCommitId;
    juce::Array<ParamDiff> params;
};
Y un helper en PresetRepository o en un PresetDiffUtil:

cpp
PresetDiff diffPresets (const OmegaPreset::OmegaPreset& a,
                        const OmegaPreset::OmegaPreset& b,
                        const juce::String& fromId,
                        const juce::String& toId)
{
    PresetDiff d;
    d.fromCommitId = fromId;
    d.toCommitId   = toId;

    // 1) macros layerParams layer A (MVP)
    auto la = a.getLayers()[0];
    auto lb = b.getLayers()[0];

    auto addIfChanged = [&d] (const juce::String& path, float va, float vb)
    {
        if (std::abs (va - vb) > 1.0e-6f)
        {
            ParamDiff pd;
            pd.path     = path;
            pd.oldValue = va;
            pd.newValue = vb;
            d.params.add (pd);
        }
    };

    addIfChanged ("LayerA.levelDb",       la.levelDb,        lb.levelDb);
    addIfChanged ("LayerA.pan",           la.pan,            lb.pan);
    addIfChanged ("LayerA.mainCutoffHz",  la.mainCutoffHz,   lb.mainCutoffHz);
    addIfChanged ("LayerA.mainResonance", la.mainResonance,  lb.mainResonance);
    addIfChanged ("LayerA.envAmount",     la.envAmount,      lb.envAmount);
    addIfChanged ("LayerA.lfoRateHz",     la.lfoRateHz,      lb.lfoRateHz);
    addIfChanged ("LayerA.lfoDepthSemis", la.lfoDepthSemis,  lb.lfoDepthSemis);

    // 2) parámetros ACE de slots (MVP: primer osc/filtro)
    auto& oa = la.voiceArch.oscillators[0];
    auto& ob = lb.voiceArch.oscillators[0];

    for (auto& [name, va] : oa.params)
    {
        auto it = ob.params.find (name);
        if (it != ob.params.end())
        {
            auto vb = it->second;
            addIfChanged ("LayerA.Osc1." + name, va, vb);
        }
    }

    // similar para filtro, env, LFO...

    return d;
}
Esto te da un diff semántico, no de texto, fácil de consumir desde la Web UI.

2. Exponer el diff a la Web UI
Añade mensaje diffPreset en OmegaUiBridge:

Solicitud:

json
{
  "type": "diffPreset",
  "requestId": "diff-1",
  "payload": { "fromCommitId": "...", "toCommitId": "..." }
}
Respuesta:

json
