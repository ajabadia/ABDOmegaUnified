s.isFavorite = mFavorites.isFavorite(s.id);
s.rating1to5 = mFavorites.getRating(s.id);
En toggleFavorite:

cpp
void FileSystemPresetRepository::toggleFavorite(const PresetId& id, bool isFavorite)
{
    const juce::ScopedLock sl(cacheLock);

    mFavorites.setFavorite(id, isFavorite);
    mFavorites.save();

    if (auto* ptr = summaryCache.getPointer(id))
        ptr->isFavorite = isFavorite;
}
Esto te da un mecanismo muy similar a otros browsers: star icon, filtro “Favorites”, sin tocar presets factory.

2. OmegaUiBridge::handleListPresets + toggleFavorite
Supongamos que OmegaUiBridge ya tiene:

Referencia a PresetRepository: mPresetRepo.

Callback sendToUi(juce::String json) que usa WebView para llamar a window.OmegaCore.onMessage(json).
​

cpp
// Source/Core/UI/OmegaUiBridge.h

class OmegaUiBridge
{
public:
    OmegaUiBridge(Preset::PresetRepository& repo,
                  juce::AudioProcessorValueTreeState& apvts);

    void handleMessageFromUi(const juce::String& jsonText);

    std::function<void (const juce::String&)> sendToUi;

private:
    Preset::PresetRepository& mPresetRepo;
    juce::AudioProcessorValueTreeState& mApvts;

    void handleListPresets(const juce::var& msg);
    void handleSearchPresets(const juce::var& msg);
    void handleGetPresetHistory(const juce::var& msg);
    void handleToggleFavorite(const juce::var& msg);

    juce::String buildPresetListJson(const juce::String& requestId,
                                     const juce::Array<Preset::PresetSummary>& items,
                                     int total) const;

    juce::String buildPresetHistoryJson(const juce::String& requestId,
                                        const Preset::PresetHistory& hist) const;
};
cpp
// Source/Core/UI/OmegaUiBridge.cpp

void OmegaUiBridge::handleMessageFromUi(const juce::String& jsonText)
{
    juce::String error;
    auto msg = juce::JSON::parse(jsonText, error);
    if (!msg.isObject())
        return;

    auto* obj = msg.getDynamicObject();
    auto type      = obj->getProperty("type").toString();
    auto requestId = obj->getProperty("requestId").toString();

    if (type == "listPresets")
        handleListPresets(msg);
    else if (type == "searchPresets")
        handleSearchPresets(msg);
    else if (type == "getPresetHistory")
        handleGetPresetHistory(msg);
    else if (type == "toggleFavorite")
        handleToggleFavorite(msg);
}

static Preset::PresetFilter parseFilter(const juce::var& payload)
{
    Preset::PresetFilter f;

    if (payload.hasProperty("text"))
        f.text = payload["text"].toString();

    if (auto cats = payload.getProperty("categories", juce::var()); cats.isArray())
    {
        for (auto& c : *cats.getArray())
        {
            auto s = c.toString();
            if (s == "pad")        f.categories.add(Preset::PresetCategory::Pad);
            else if (s == "lead")  f.categories.add(Preset::PresetCategory::Lead);
            else if (s == "bass")  f.categories.add(Preset::PresetCategory::Bass);
            // ... resto
        }
    }

    if (auto engs = payload.getProperty("engines", juce::var()); engs.isArray())
        for (auto& e : *engs.getArray())
            f.engines.add(e.toString());

    if (auto tags = payload.getProperty("tags", juce::var()); tags.isArray())
        for (auto& t : *tags.getArray())
            f.tags.add(t.toString());

    if (auto packs = payload.getProperty("originPacks", juce::var()); packs.isArray())
        for (auto& p : *packs.getArray())
            f.originPacks.add(p.toString());

    f.onlyFavorites = bool(payload.getProperty("onlyFavorites", false));

    if (auto bpmRange = payload.getProperty("bpmRange", juce::var()); bpmRange.isObject())
    {
        f.hasBpmRange = true;
        f.minBpm = double(bpmRange.getProperty("min", 0.0));
        f.maxBpm = double(bpmRange.getProperty("max", 0.0));
    }

    return f;
}

static Preset::PresetSort parseSort(const juce::var& payload)
{
    Preset::PresetSort s;

    if (auto sort = payload.getProperty("sort", juce::var()); sort.isObject())
    {
        auto field = sort.getProperty("field", "name").toString();
        auto dir   = sort.getProperty("direction", "asc").toString();

        if (field == "name")         s.field = Preset::PresetSortField::Name;
        else if (field == "createdAt")  s.field = Preset::PresetSortField::CreatedAt;
        else if (field == "modifiedAt") s.field = Preset::PresetSortField::ModifiedAt;
        else if (field == "category")   s.field = Preset::PresetSortField::Category;
        else if (field == "engine")     s.field = Preset::PresetSortField::Engine;

        s.direction = (dir == "desc")
                      ? Preset::PresetSortDirection::Desc
                      : Preset::PresetSortDirection::Asc;
    }

    return s;
}

static Preset::Paging parsePaging(const juce::var& payload)
{
    Preset::Paging p;
    if (auto paging = payload.getProperty("paging", juce::var()); paging.isObject())
    {
        p.offset = int(paging.getProperty("offset", 0));
        p.limit  = int(paging.getProperty("limit", 64));
    }
    return p;
}

void OmegaUiBridge::handleListPresets(const juce::var& msg)
{
    auto* obj = msg.getDynamicObject();
    auto requestId = obj->getProperty("requestId").toString();
    auto payload   = obj->getProperty("payload");

    auto filter = parseFilter(payload);
    auto sort   = parseSort(payload);
    auto paging = parsePaging(payload);

    auto items = mPresetRepo.listPresets(filter, sort, paging);

    // TODO: total real si mantienes un índice; por ahora, items.size()
    auto json = buildPresetListJson(requestId, items, items.size());
    if (sendToUi)
        sendToUi(json);
}

void OmegaUiBridge::handleSearchPresets(const juce::var& msg)
{
    auto* obj = msg.getDynamicObject();
    auto requestId = obj->getProperty("requestId").toString();
    auto payload   = obj->getProperty("payload");

    auto text   = payload.getProperty("text", juce::String()).toString();
    auto paging = parsePaging(payload);

    Preset::PresetFilter baseFilter; // vacío por ahora
    auto items = mPresetRepo.searchPresets(text, baseFilter, paging);

    auto json = buildPresetListJson(requestId, items, items.size());
    if (sendToUi)
        sendToUi(json);
}

void OmegaUiBridge::handleGetPresetHistory(const juce::var& msg)
{
    auto* obj = msg.getDynamicObject();
    auto requestId = obj->getProperty("requestId").toString();
    auto payload   = obj->getProperty("payload");

    auto presetId  = payload.getProperty("presetId", juce::String()).toString();
    auto hist      = mPresetRepo.getHistory(presetId);

    auto json = buildPresetHistoryJson(requestId, hist);
    if (sendToUi)
        sendToUi(json);
}

void OmegaUiBridge::handleToggleFavorite(const juce::var& msg)
{
    auto* obj = msg.getDynamicObject();
    auto requestId = obj->getProperty("requestId").toString();
    auto payload   = obj->getProperty("payload");

    auto presetId   = payload.getProperty("presetId", juce::String()).toString();
    bool isFavorite = bool(payload.getProperty("isFavorite", false));

    mPresetRepo.toggleFavorite(presetId, isFavorite);

    // Ack simple
    juce::DynamicObject* root = new juce::DynamicObject();
    root->setProperty("type", "ack");
    root->setProperty("requestId", requestId);

    juce::DynamicObject* pl = new juce::DynamicObject();
    pl->setProperty("ok", true);
    root->setProperty("payload", juce::var(pl));

    if (sendToUi)
        sendToUi(juce::JSON::toString(juce::var(root)));
}
Serialización de la lista:

cpp
juce::String OmegaUiBridge::buildPresetListJson(
    const juce::String& requestId,
    const juce::Array<Preset::PresetSummary>& items,
    int total) const
{
    juce::DynamicObject* root = new juce::DynamicObject();
    root->setProperty("type", "presetList");
    root->setProperty("requestId", requestId);

    juce::DynamicObject* payload = new juce::DynamicObject();
    payload->setProperty("total", total);

    juce::Array<juce::var> arr;
    for (auto& s : items)
    {
        juce::DynamicObject* o = new juce::DynamicObject();
        o->setProperty("id", s.id);
        o->setProperty("name", s.name);
        o->setProperty("engine", s.engine);
        o->setProperty("mainLayerId", s.mainLayerId);

        juce::String cat = "unknown";
        switch (s.category)
        {
            case Preset::PresetCategory::Pad:       cat = "pad"; break;
            case Preset::PresetCategory::Lead:      cat = "lead"; break;
            case Preset::PresetCategory::Bass:      cat = "bass"; break;
            case Preset::PresetCategory::Keys:      cat = "keys"; break;
            case Preset::PresetCategory::Pluck:     cat = "pluck"; break;
            case Preset::PresetCategory::FX:        cat = "fx"; break;
            case Preset::PresetCategory::Perc:      cat = "perc"; break;
            case Preset::PresetCategory::Sequence:  cat = "sequence"; break;
            case Preset::PresetCategory::Drone:     cat = "drone"; break;
            default: break;
        }
        o->setProperty("category", cat);

        o->setProperty("author", s.author);
        o->setProperty("branch", s.branch);
        o->setProperty("headCommit", s.headCommit);

        // tags
        juce::Array<juce::var> tags;
        for (auto& t : s.tags)
            tags.add(t);
        o->setProperty("tags", juce::var(tags));

        // originPacks
        juce::Array<juce::var> packs;
        for (auto& p : s.originPacks)
            packs.add(p);
        o->setProperty("originPacks", juce::var(packs));

        o->setProperty("isFavorite", s.isFavorite);
        o->setProperty("rating1to5", s.rating1to5);
        o->setProperty("bpm", s.bpm);
        o->setProperty("key", s.musicalKey);

        o->setProperty("createdAt", s.createdAt.toISO8601(true));
        o->setProperty("modifiedAt", s.modifiedAt.toISO8601(true));

        juce::DynamicObject* flags = new juce::DynamicObject();
        flags->setProperty("usesAceRoland", s.usesAceRoland);
        flags->setProperty("usesAceKorg",   s.usesAceKorg);
        flags->setProperty("usesSupersaw",  s.usesSupersaw);
        o->setProperty("flags", juce::var(flags));

        arr.add(juce::var(o));
    }

    payload->setProperty("items", juce::var(arr));
    root->setProperty("payload", juce::var(payload));

    return juce::JSON::toString(juce::var(root));
}
buildPresetHistoryJson sería el análogo simple para entries con hash, date, author, message.

Con este bloque ya tienes:

Favoritos persistentes en un JSON separado, como hacen otros ecosistemas de presets.

Un OmegaUiBridge que expone listPresets/searchPresets/getPresetHistory/toggleFavorite al Web UI usando el modelo de datos de PresetRepository y tus heurísticas de clasificación.

¿Te gustaría que el siguiente paso sea un esqueleto de componente React (PresetBrowserPanel) que consuma estos mensajes (presetList, presetHistory, ack) usando el canal window.OmegaCore.sendMessage/onMessage, o prefieres que volvamos un momento al lado C++ para cerrar cómo se integra todo esto con el cambio de preset actual (selección en el browser → loadPreset ya existente)?



Te doy las dos cosas, muy compactas: esqueleto React + enganche C++ con loadPreset.

1. Esqueleto React PresetBrowserPanel
Asumiendo que ya tienes el hook useOmegaParams y window.OmegaCore.sendMessage/onMessage registrados, creamos un hook específico para presets.

1.1 Hook usePresetBrowser
tsx
// src/hooks/usePresetBrowser.ts
import { useCallback, useEffect, useState } from "react";

type PresetCategory =
  | "pad" | "lead" | "bass" | "keys" | "pluck"
  | "fx"  | "perc" | "sequence" | "drone" | "unknown";

export interface PresetListItem {
  id: string;
  name: string;
  engine: string;
  mainLayerId: string;
  category: PresetCategory;
  author: string;
  branch: string;
  headCommit: string;
  tags: string[];
  originPacks: string[];
  isFavorite: boolean;
  rating1to5: number;
  bpm: number;
  key: string;
  createdAt: string;
  modifiedAt: string;
  flags: {
    usesAceRoland: boolean;
    usesAceKorg: boolean;
    usesSupersaw: boolean;
  };
}

interface PresetHistoryEntry {
  hash: string;
  date: string;
  author: string;
  message: string;
}

interface PresetBrowserState {
  items: PresetListItem[];
  total: number;
  loading: boolean;
  selectedId: string | null;
  history: PresetHistoryEntry[];
}

let nextRequestId = 1;
const makeReqId = () => `pb-${nextRequestId++}`;

export function usePresetBrowser() {
  const [state, setState] = useState<PresetBrowserState>({
    items: [],
    total: 0,
    loading: false,
    selectedId: null,
    history: [],
  });

  const sendMessage = useCallback((msg: any) => {
    if ((window as any).OmegaCore?.sendMessage) {
      (window as any).OmegaCore.sendMessage(JSON.stringify(msg));
    }
  }, []);

  const requestList = useCallback(() => {
    const requestId = makeReqId();
    setState(prev => ({ ...prev, loading: true }));
    sendMessage({
      type: "listPresets",
      requestId,
      payload: {
        text: "",
        categories: [],
        engines: [],
        tags: [],
        originPacks: [],
        onlyFavorites: false,
        bpmRange: { min: 0, max: 0 },
        sort: { field: "name", direction: "asc" },
        paging: { offset: 0, limit: 64 }
      }
    });
  }, [sendMessage]);

  const loadHistory = useCallback((presetId: string) => {
    const requestId = makeReqId();
    sendMessage({
      type: "getPresetHistory",
      requestId,
      payload: { presetId }
    });
  }, [sendMessage]);

  const toggleFavorite = useCallback((presetId: string, isFavorite: boolean) => {
    const requestId = makeReqId();
    sendMessage({
      type: "toggleFavorite",
      requestId,
      payload: { presetId, isFavorite }
    });
    // Optimistic UI
    setState(prev => ({
      ...prev,
      items: prev.items.map(it =>
        it.id === presetId ? { ...it, isFavorite } : it
      )
    }));
  }, [sendMessage]);

  const loadPreset = useCallback((presetId: string) => {
    const requestId = makeReqId();
    sendMessage({
      type: "loadPreset",
      requestId,
      payload: { presetId }
    });
    setState(prev => ({ ...prev, selectedId: presetId }));
  }, [sendMessage]);

  useEffect(() => {
    const handler = (jsonText: string) => {
      let msg: any;
      try {
        msg = JSON.parse(jsonText);
      } catch {
        return;
      }
      if (msg.type === "presetList") {
        setState(prev => ({
          ...prev,
          loading: false,
          items: msg.payload.items,
          total: msg.payload.total
        }));
      } else if (msg.type === "presetHistory") {
        setState(prev => ({
          ...prev,
          history: msg.payload.entries
        }));
      }
      // ack de toggleFavorite/loadPreset no hace falta tocar state
    };

    const core = (window as any).OmegaCore || ((window as any).OmegaCore = {});
    const prevHandler = core.onMessage;
    core.onMessage = (json: string) => {
      handler(json);
      if (typeof prevHandler === "function") prevHandler(json);
    };

    requestList();

    return () => {
      if ((window as any).OmegaCore?.onMessage === handler) {
        (window as any).OmegaCore.onMessage = prevHandler;
      }
    };
  }, [requestList]);

  return {
    ...state,
    refresh: requestList,
    loadPreset,
    toggleFavorite,
    loadHistory,
  };
}
1.2 Componente PresetBrowserPanel
tsx
// src/components/PresetBrowserPanel.tsx
import React from "react";
import { usePresetBrowser } from "../hooks/usePresetBrowser";

export const PresetBrowserPanel: React.FC = () => {
  const {
    items,
    loading,
    selectedId,
    history,
    refresh,
    loadPreset,
    toggleFavorite,
    loadHistory,
  } = usePresetBrowser();

  return (
    <div className="preset-browser">
      <div className="header">
        <span>Presets ({items.length})</span>
        <button onClick={refresh}>Refresh</button>
      </div>

      {loading && <div className="loading">Loading presets…</div>}

      <div className="content">
        <div className="list">
          {items.map(p => (
            <div
              key={p.id}
              className={
                "preset-row" + (p.id === selectedId ? " selected" : "")
              }
              onClick={() => {
                loadPreset(p.id);
                loadHistory(p.id);
              }}
            >
              <button
                className={"fav" + (p.isFavorite ? " active" : "")}
                onClick={e => {
                  e.stopPropagation();
                  toggleFavorite(p.id, !p.isFavorite);
                }}
              >
                ★
              </button>
              <div className="main">
                <div className="name">{p.name}</div>
                <div className="meta">
                  <span>{p.category}</span>
                  <span>{p.engine}</span>
                  <span>{p.author}</span>
                  {p.flags.usesSupersaw && <span>supersaw</span>}
                  {p.flags.usesAceRoland && <span>roland</span>}
                  {p.flags.usesAceKorg && <span>korg</span>}
                </div>
              </div>
            </div>
          ))}
        </div>

        <div className="history">
          <h4>History</h4>
          {history.map(h => (
            <div key={h.hash} className="history-row">
              <div>{h.date}</div>
              <div>{h.author}</div>
              <div>{h.message}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
};
Con esto ya tienes un browser funcional hablando con listPresets, getPresetHistory, toggleFavorite, loadPreset vía window.OmegaCore.
​

2. Integración C++: selección → loadPreset existente
Ya tienes el mensaje JSON conceptual para loadPreset en tu puente (lo usamos antes). Solo falta el handler.

2.1 OmegaUiBridge::handleLoadPreset
Añade en OmegaUiBridge.h:

cpp
void handleLoadPreset(const juce::var& msg);
En el router:

cpp
if (type == "loadPreset")
    handleLoadPreset(msg);
Implementación:

cpp
void OmegaUiBridge::handleLoadPreset(const juce::var& msg)
{
    auto* obj = msg.getDynamicObject();
    auto requestId = obj->getProperty("requestId").toString();
    auto payload   = obj->getProperty("payload");

    auto presetId  = payload.getProperty("presetId", juce::String()).toString();
    bool ok = false;

    // Aquí llamas a tu capa de presets real
    // p.ej. el AudioProcessor tiene un método loadPresetById
    try
    {
        // pseudocódigo: adapta a tu procesador real
        // mProcessor.loadPresetById(presetId);
        ok = true;
    }
    catch (...)
    {
        ok = false;
    }

    // Ack
    juce::DynamicObject* root = new juce::DynamicObject();
    root->setProperty("type", "ack");
    root->setProperty("requestId", requestId);

    juce::DynamicObject* pl = new juce::DynamicObject();
    pl->setProperty("ok", ok);
    pl->setProperty("action", "loadPreset");
    pl->setProperty("presetId", presetId);
    root->setProperty("payload", juce::var(pl));

    if (sendToUi)
        sendToUi(juce::JSON::toString(juce::var(root)));

    // Opcional: enviar nuevo snapshot de estado (preset + params)
    // para que la Web UI se refresque.
    // if (ok && sendToUi)
    //     sendToUi(buildStateJson("state-after-load"));
}
Donde mProcessor.loadPresetById internamente:

Usa PresetRepository para encontrar y cargar el YAML.

OmegaPresetSerializer → OmegaPreset.

AceValidator → validación/fallback.

Reconstruye EngineConfig + VoiceArchitectureRuntime.

Aplica valores macro a APVTS (ya lo tenías definido).

Con esto el flujo queda:

React PresetBrowserPanel → loadPreset (JSON) → OmegaUiBridge::handleLoadPreset → procesador/engine → audio.

PresetBrowserPanel recibe también presetChanged/state si quieres, vía el mismo canal, para actualizar la UI.
​

¿Quieres que en la próxima iteración aterricemos ese mProcessor.loadPresetById (firma, path resolution, integración con PresetRepository y OmegaPresetSerializer), o te interesa más empezar a definir el layout UX del browser (sidebar de filtros vs. lista central, quick‑filters, etc.)?


Te dejo los dos frentes, pero muy al grano: loadPresetById bien encajado en tu core, y un layout UX razonable para el browser.

1. loadPresetById en el procesador / core
1.1 Firma en el AudioProcessor (o engine core)
cpp
// Source/Plugin/OmegaAudioProcessor.h

class OmegaAudioProcessor : public juce::AudioProcessor,
                            private juce::AudioProcessorValueTreeState::Listener
{
public:
    // ...
    void loadPresetById(const Omega::Preset::PresetId& id);

    Omega::Preset::PresetRepository& getPresetRepository() noexcept { return *mPresetRepo; }

private:
    std::unique_ptr<Omega::Preset::PresetRepository> mPresetRepo;
    Omega::Ace::AceCatalog                           mAceCatalog;
    Omega::Core::EngineConfigManager                 mEngineConfigManager;
    Omega::Core::OmegaPreset                         mCurrentPreset;

    // settings/atomics ya definidos
};
1.2 Implementación de loadPresetById
cpp
// Source/Plugin/OmegaAudioProcessor.cpp

#include "OmegaAudioProcessor.h"
#include "OmegaPresetSerializer.h"
#include "AceValidator.h"
#include "VoiceFactory.h"

void OmegaAudioProcessor::loadPresetById(const Omega::Preset::PresetId& id)
{
    // 1. Pedir resumen al repositorio para saber de dónde cargarlo
    auto summaryOpt = mPresetRepo->getPresetSummary(id);
    if (!summaryOpt)
        return; // o lanzar excepción controlada

    // 2. Resolver ruta a archivo (puede ser responsabilidad del repo)
    auto file = dynamic_cast<Omega::Preset::FileSystemPresetRepository*>(mPresetRepo.get())
                    ->resolvePresetFile(id);
    if (!file.existsAsFile())
        return;

    // 3. Leer YAML → OmegaPreset
    auto yaml = file.loadFileAsString();
    Omega::Core::Preset::OmegaPresetSerializer serializer;
    Omega::Core::Preset::OmegaPreset newPreset;
    auto res = serializer.fromYaml(newPreset, yaml, mAceCatalog);
    if (!res.success)
        return;

    // 4. Validar con ACE (componentId, fallbacks, rutas mod, etc.)
    Omega::Ace::AceValidator validator(mAceCatalog);
    auto report = validator.validateAndRepairPreset(newPreset);
    if (report.status == Omega::Ace::ValidationStatus::Invalid)
        return;
    // Opcional: loggear DEGRADED

    // 5. Aplicar macros del preset a APVTS (cutoff, level, etc.)
    //    Esto actualiza tus structs atomics vía callbacks de parameterChanged
    auto applyParam = [this](const char* id, float value) {
        if (auto* p = mApvts.getParameter(id))
            p->setValueNotifyingHost(p->getNormalisableRange().convertTo0to1(value));
    };
    applyParam("MASTERGAINDB",       newPreset.getMasterGainDb());
    applyParam("LAYERALEVELDB",      newPreset.getLayerLevelDb("A"));
    applyParam("LAYERAMAINCUTOFF",   newPreset.getLayerMainCutoffHz("A"));
    applyParam("LAYERAMAINRES",      newPreset.getLayerMainResonance("A"));
    applyParam("LAYERAENVAMT",       newPreset.getLayerEnvAmount("A"));
    // ... resto de macros que ya definiste

    // 6. Construir EngineConfig/VoiceArchitectureRuntime en background
    Omega::Core::EngineConfigBuilder builder(mAceCatalog);
    auto engineConfig = builder.buildFromPreset(newPreset);
    if (!engineConfig)
        return;

    // 7. Swap atómico del config para el audio thread
    mEngineConfigManager.prepareNextConfig(std::move(engineConfig));
    mEngineConfigManager.commitNextConfig(); // hace el swap seguro

    // 8. Actualizar preset actual (para guardar, UI, etc.)
    mCurrentPreset = std::move(newPreset);

    // 9. (Opcional) notificar a UI vía bridge (presetChanged/state)
    //   Esto ya lo tienes previsto en OmegaUiBridge.buildStateJson(...)
}
resolvePresetFile(id) en el repositorio puede ser simplemente:

cpp
juce::File FileSystemPresetRepository::resolvePresetFile(const PresetId& id) const
{
    // id es ruta relativa sin extensión, ej. "factory/ACE-JUNO-BASIC-PAD"
    return root.getChildFile(id + ".omegapreset.yaml");
}
Así cierras el circuito completo: UI → loadPreset JSON → OmegaUiBridge::handleLoadPreset → processor.loadPresetById → audio.

2. Layout UX del navegador de presets
Sobre lo que ya has definido (categorías, tags, favoritos, history) y patrones vistos en otros browsers (Kontakt, Massive X, UAD, etc.):

2.1 Estructura general
Yo lo organizaría en tres columnas:

Izquierda: filtros rápidos (sidebar).

Centro: lista de presets.

Derecha: detalles + history.

Esquema:

Sidebar:

Buscador texto (Search...).

Sección “Category” con checkboxes: Pad, Lead, Bass, etc.

Sección “Engine”: VirtualAnalog, Wavetable, etc.

Sección “Tags” más usados (chips clickable): warm, dark, supersaw, juno, ms20…

Toggle “Favorites only”.

Centro (lista):

Cada fila:

Estrella de favorito.

Nombre.

Pequeño subtítulo: Pad • VirtualAnalog • Roland Juno.

Badges: supersaw, mpe, complex-mod según flags.

Encabezado con orden: Name / Category / Engine / Date.

Derecha:

Nombre grande + categoría.

Botón “Load” (aunque ya cargues al hacer click).

Lista de tags (chips).

Info ACE: “Roland Juno DCO + IR3109 LP24 + Juno Chorus”.

History (commits Git for Sounds) como lista cronológica.
​

2.2 Interacción básica
Click en fila:

Carga preset (loadPreset).

Carga history (getPresetHistory).

Click en estrella:

Llama a toggleFavorite (optimistic UI, ya lo tienes).

Cambios en filtros:

Actualizan estado local (React) y disparan listPresets con el filtro correspondiente.

Buscador:

Debounce 200–300 ms y envías searchPresets con texto + filtros.
​

2.3 Estados especiales
“Empty”:

Mensaje “No presets match this filter” + botón “Clear filters”.

“Degraded” (si quieres usar el ValidationReport):

Badge “Degraded” en la fila (p.ej. componente ACE faltante pero con fallback).

“Factory vs User”:

Filter rápido “Factory / User / All” (puedes derivarlo de ruta o originPacks).
​
​

Con lo que ya tienes (API de PresetRepository, tagger automático, favorites.json y OmegaUiBridge), implementar este layout es sobre todo trabajo de React/TS y CSS; el backend ya soporta las operaciones clave.

¿Te interesa que el próximo paso lo enfoquemos en un pequeño “contrato visual” para la lista (por ejemplo, qué campos mostrar y cómo mapear PresetSummary → filas concretas de UI), o prefieres que volvamos un momento a afinar las heurísticas de OmegaPresetTagger (por ejemplo, diferenciar mejor Bass vs Lead usando previewNotes o rango de pitch)?


Para la lista, te propongo un contrato visual muy concreto: qué enseñar por fila y cómo derivarlo de PresetSummary.

1. Campos mínimos por fila
Cada fila debería mostrar:

Estado / acciones

Estrella de favorito (on/off) → isFavorite.

Icono de categoría (pad/lead/bass/…) → category.

Pequeño “badge” de engine → engine (VA, WT, etc.).

Título principal

name (texto grande).

Si hay conflicto de nombres, podrías añadir un sufijo corto [factory] vs [user] derivado de originPacks o del path.
​

Subtítulo / línea secundaria
Combina en una sola línea, por orden:

category (texto: “Pad”, “Bass”, etc.).

engine (abreviado: “VA”, “WT”).

author.

Origen ACE: “Juno”, “MS‑20”, “Supersaw” a partir de flags/tags (usesAceRoland, usesAceKorg, usesSupersaw).

Badges de contenido
Pequeños chips, 0–3 para no saturar:

mpe si está en tags.

complex-mod si está en tags.

warm/bright/dark según tags.

trance/ambient/techno si se encuentran en tags (solo uno, el más relevante).
​

Metadatos compactos a la derecha

BPM (si > 0) → bpm.

Key (si no vacío) → key.

“⭐xN” si rating1to5 > 0.

Última modificación (fecha corta) → modifiedAt.

2. Mapeo directo PresetSummary → UI (JS)
Esquema de cómo derivar cosas:

ts
function categoryIcon(category: PresetCategory): string {
  switch (category) {
    case "pad": return "🎹";      // placeholder, luego iconos propios
    case "lead": return "🎼";
    case "bass": return "🎸";
    case "keys": return "🎹";
    case "pluck": return "✨";
    case "fx": return "🌀";
    case "perc": return "🥁";
    case "sequence": return "⏱";
    case "drone": return "🌫";
    default: return "•";
  }
}

function engineLabel(engine: string): string {
  if (engine === "VirtualAnalog") return "VA";
  if (engine === "Wavetable")     return "WT";
  if (engine === "Granular")      return "GR";
  return engine;
}

function aceLabel(flags: PresetSummary["flags"], tags: string[]): string | null {
  if (flags.usesSupersaw) return "Supersaw";
  if (flags.usesAceRoland) return "Juno";
  if (flags.usesAceKorg) return "MS-20";
  if (tags.includes("fm")) return "FM";
  return null;
}

function moodTag(tags: string[]): string | null {
  const order = ["warm","bright","dark","aggressive","soft","noisy","clean"];
  return order.find(t => tags.includes(t)) ?? null;
}

function genreTag(tags: string[]): string | null {
  const order = ["trance","techno","synthwave","dnb","ambient","cinematic","lofi","house"];
  return order.find(t => tags.includes(t)) ?? null;
}
Y en la fila:

tsx
<div className="preset-row">
  <button className={"fav" + (p.isFavorite ? " active" : "")}>★</button>
  <div className="category-icon">{categoryIcon(p.category)}</div>

  <div className="main">
    <div className="title">
      <span className="name">{p.name}</span>
      <span className="engine-pill">{engineLabel(p.engine)}</span>
    </div>

    <div className="subtitle">
      <span>{p.category}</span>
      <span>· {engineLabel(p.engine)}</span>
      {p.author && <span>· {p.author}</span>}
      {aceLabel(p.flags, p.tags) && <span>· {aceLabel(p.flags, p.tags)}</span>}
    </div>

    <div className="badges">
      {p.tags.includes("mpe") && <span className="badge">MPE</span>}
      {p.tags.includes("complex-mod") && <span className="badge">Complex mod</span>}
      {moodTag(p.tags) && <span className="badge">{moodTag(p.tags)}</span>}
      {genreTag(p.tags) && <span className="badge">{genreTag(p.tags)}</span>}
    </div>
  </div>

  <div className="meta-right">
    {p.bpm > 0 && <span>{Math.round(p.bpm)} BPM</span>}
    {p.key && <span>{p.key}</span>}
    {p.rating1to5 > 0 && <span>{"★".repeat(p.rating1to5)}</span>}
    <span className="date">{p.modifiedAt.slice(0, 10)}</span>
  </div>
</div>
Esto respeta:

Que la información clave (nombre, tipo, engine, favorito) entre en un vistazo.

Que lo ACE‑específico (Juno, MS‑20, Supersaw) sea visible pero no abrumador.

Que PresetSummary sea la única fuente de verdad para la lista: no necesitas reabrir el preset para pintar filas.

¿Quieres que en la siguiente iteración te proponga una pequeña tabla de estilos (clases CSS/BEM y tamaños) para asegurar que esto cabe bien en 900–1000 px de ancho, o prefieres volver a la parte de heurísticas para mejorar cómo rellenar category, moodTag y genreTag automáticamente desde OmegaPreset (por ejemplo usando previewNotes y ranges)?
Te propongo una tabla de estilos (clases + función) pensada para ~900–1000 px de ancho.

1. Clases CSS principales
Bloque / elemento	Clase CSS	Función visual
Contenedor general	.preset-browser	Layout flex horizontal (filtros + lista + panel).
Cabecera del browser	.preset-browser__header	Título + botón Refresh.
Zona central	.preset-browser__content	Flex: lista + panel lateral.
Lista de presets	.preset-list	Columna scrollable.
Fila de preset	.preset-row	Item clicable, hover highlight.
Fila seleccionada	.preset-row--selected	Fondo/acento distinto.
Zona estrella	.preset-row__fav	Botón estrella, sin borde.
Icono categoría	.preset-row__category	Pequeño icono/círculo a la izquierda.
Bloque central (texto)	.preset-row__main	Nombre + subtítulo + badges.
Título	.preset-row__title	Name + pill de engine.
Nombre	.preset-row__name	Texto principal, truncado si largo.
Pill de engine	.preset-row__engine-pill	Chip pequeño “VA/WT”.
Subtítulo	.preset-row__subtitle	Categoria · engine · author · ACE label.
Contenedor badges	.preset-row__badges	Fila de chips pequeños.
Badge individual	.preset-row__badge	Chip de color suave.
Columna derecha meta	.preset-row__meta	BPM, key, rating, fecha.
Texto fecha	.preset-row__date	Fecha en gris claro.
2. Esqueleto CSS (resumen)
css
.preset-browser {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #111;
  color: #eee;
  font-family: system-ui, sans-serif;
  font-size: 13px;
}

.preset-browser__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 8px;
  border-bottom: 1px solid #333;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.preset-browser__content {
  display: flex;
  flex: 1;
  min-height: 0;
}

/* Lista */

.preset-list {
  flex: 2;
  min-width: 0;
  border-right: 1px solid #222;
  overflow-y: auto;
}

.preset-row {
  display: flex;
  align-items: center;
  padding: 4px 8px;
  gap: 6px;
  cursor: pointer;
  border-bottom: 1px solid rgba(255,255,255,0.03);
}

.preset-row:hover {
  background: rgba(255,255,255,0.04);
}

.preset-row--selected {
  background: rgba(255,255,255,0.08);
}

.preset-row__fav {
  width: 18px;
  height: 18px;
  border: none;
  background: transparent;
  color: #666;
  cursor: pointer;
  padding: 0;
}

.preset-row__fav.active {
  color: #ffcc33;
}

.preset-row__category {
  width: 18px;
  text-align: center;
  font-size: 12px;
  opacity: 0.8;
}

/* Texto central */

.preset-row__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.preset-row__title {
  display: flex;
  align-items: center;
  gap: 6px;
}

.preset-row__name {
  font-size: 13px;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preset-row__engine-pill {
  font-size: 10px;
  text-transform: uppercase;
  padding: 1px 5px;
  border-radius: 999px;
  background: #222;
  color: #aaa;
}

.preset-row__subtitle {
  font-size: 11px;
  color: #aaa;
  display: flex;
  gap: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Badges */

.preset-row__badges {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
  margin-top: 1px;
}

.preset-row__badge {
  font-size: 10px;
  padding: 1px 4px;
  border-radius: 999px;
  background: rgba(255,255,255,0.05);
  color: #ccc;
}

/* Meta derecha */

.preset-row__meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
  min-width: 80px;
  font-size: 10px;
  color: #aaa;
}

.preset-row__meta span {
  white-space: nowrap;
}

.preset-row__date {
  color: #666;
}
Con este contrato de clases, tu componente React solo tiene que asignarlas como ya veníamos haciendo.

¿Quieres que la próxima vez ajustemos las heurísticas de OmegaPresetTagger para rellenar bien mood/genre y que esos badges (warm/bright/trance/etc.) sean fiables desde el primer día?



Para que los badges “warm/bright/dark” y las categorías Bass/Lead sean fiables, puedes usar heurísticas muy simples basadas en cutoff, envolventes y rango de notas.

1. Mood: warm / bright / dark / aggressive / soft
1.1 A partir de cutoff y resonancia
Basado en cómo el filtro afecta a la “brillantez” percibida de un patch (cutoff alto → brillante, bajo → cálido/oscuro).

Supongamos que tienes helpers en OmegaPreset:

getLayerMainCutoffHz(layerId)

getLayerMainResonance(layerId)

getLayerDrive(layerId) (si procede)

Heurística (en OmegaPresetTagger::autoTagSummary):

cpp
const auto cutoff = p.getLayerMainCutoffHz("A");
const auto res    = p.getLayerMainResonance("A");
const auto drive  = p.getLayerDrive("A");

// Bright
if (cutoff >= 4000.0f && res < 0.5f)
    s.tags.addIfNotAlreadyThere("bright");

// Dark / warm
else if (cutoff <= 1000.0f)
{
    s.tags.addIfNotAlreadyThere("dark");
    s.tags.addIfNotAlreadyThere("warm");
}

// Neutro (no tag de tono)
Luego “aggressive”:

cpp
if (res >= 0.7f || drive >= 6.0f)        // resonancia alta / mucha saturación
    s.tags.addIfNotAlreadyThere("aggressive");
Y “soft”:

cpp
const float atk = estimateMainAttackMs(p);
if (atk >= 80.0f && cutoff <= 4000.0f)
    s.tags.addIfNotAlreadyThere("soft"); // ataque lento + no muy brillante
1.2 Coherencia: evitar tags contradictorios
Al final de autoTagSummary puedes limpiar:

cpp
auto has = [&](const char* t){ return s.tags.contains(t); };

if (has("bright") && has("dark"))
{
    // Prioriza el que case mejor con cutoff
    if (cutoff >= 4000.0f)
        s.tags.removeString("dark");
    else
        s.tags.removeString("bright");
}

if (has("aggressive") && has("soft"))
{
    // Si hay drive/resonancia alta, quita "soft"
    if (res >= 0.7f || drive >= 6.0f)
        s.tags.removeString("soft");
}
2. Género: trance / ambient / techno / …
Aquí las heurísticas son más débiles, pero puedes sacar primeros hints sin prometer milagros:

Si supersaw + BPM 125–145 → trance.

Si cutoff bajo + “dark/warm” + BPM < 110 → ambient.

Si bass + BPM 120–130 → puedes marcar house como sugerencia.
​
​

Ejemplo:

cpp
const auto bpm = s.bpm;

if (s.usesSupersaw && bpm >= 125.0 && bpm <= 145.0)
    s.tags.addIfNotAlreadyThere("trance");
else if (s.tags.contains("dark") && bpm > 0.0 && bpm <= 110.0)
    s.tags.addIfNotAlreadyThere("ambient");
else if (s.category == PresetCategory::Bass && bpm >= 118.0 && bpm <= 132.0)
    s.tags.addIfNotAlreadyThere("house");
La idea es que estos tags son sugeridos; el usuario puede editarlos si quiere.

3. Bass vs Lead usando rango / previewNotes
Si en OmegaPreset guardas previewNotes (ya lo tienes en el esquema), puedes derivar el rango medio del patch.
​

Supongamos:

p.getPreviewNotes() devuelve un std::vector<int> de notas MIDI.

Si está vacío, no decides nada más y te quedas con la heurística de poly/ADSR.

Heurística:

cpp
int OmegaPresetTagger::estimateMedianNote(const OmegaPreset& p) const
{
    auto notes = p.getPreviewNotes(); // vector<int>
    if (notes.empty())
        return -1;

    std::sort(notes.begin(), notes.end());
    return notes[notes.size() / 2];
}
En inferCategory:

cpp
int medianNote = estimateMedianNote(p);

if (poly <= 2 && atk <= 20.0f && rel <= 300.0f)
{
    if (medianNote >= 60)          // C4 o más
        return PresetCategory::Lead;
    if (medianNote >= 36 && medianNote < 60) // C2..B3
        return PresetCategory::Bass;
}
Si no hay previewNotes, dejas Lead por defecto y permites override manual.

4. Secuencias vs plucks vs pads
Con lo que ya tienes en el preset:

Envolvente amp:

Ataque corto + release corto → candidato a Pluck.

Ataque medio-largo + release largo → Pad.

ModGraph:

Si hay fuentes tipo Seq1, Arp1, o rutas clock‑sync → Sequence.

Ejemplo extra en inferCategory:

cpp
if (atk <= 10.0f && rel <= 200.0f && poly >= 3)
    return PresetCategory::Pluck;

// Si detectas fuentes de tipo secuenciador en el ModGraph
if (p.usesSequencerSources())
    return PresetCategory::Sequence;
Con estos ajustes en OmegaPresetTagger:

Los badges de mood (warm/bright/dark/soft/aggressive) salen de cutoff, res, drive y ataque.

La distinción Bass vs Lead mejora gracias a previewNotes y rango de notas.

Los tags de género son “soft hints” basados en BPM + tipo de componente.

¿Quieres que lo siguiente sea un código consolidado de OmegaPresetTagger con todas estas reglas ya integradas, para poder pegarlo casi tal cual en tu proyecto?


Te dejo un OmegaPresetTagger consolidado con todas las heurísticas que hemos ido definiendo, listo para adaptar/pegar.

Asumo que OmegaPreset expone helpers tipo getLayerIds(), getVoiceArchitecture(layerId), getLayerMainCutoffHz(layerId), getLayerMainResonance(layerId), getLayerDrive(layerId), getLayerPolyphony(layerId), getPreviewNotes(), usesMpeSources(), getModulationRouteCount(layerId).

cpp
// OmegaPresetTagger.h
#pragma once
#include "OmegaPreset.h"
#include "AceCatalog.h"
#include "PresetRepository.h"

namespace Omega::Preset {

class OmegaPresetTagger
{
public:
    explicit OmegaPresetTagger(const Ace::AceCatalog& aceCatalog)
        : mAce(aceCatalog) {}

    PresetCategory inferCategory(const OmegaPreset& p) const;
    void autoTagSummary(PresetSummary& s, const OmegaPreset& p) const;

private:
    const Ace::AceCatalog& mAce;

    // Component helpers
    bool usesComponentPrefix(const OmegaPreset& p,
                             const juce::String& prefix) const;
    bool hasFilterWithIdPrefix(const OmegaPreset& p,
                               const juce::String& prefix) const;

    // Envelope / polyphony / pitch heuristics
    float estimateMainAttackMs(const OmegaPreset& p) const;
    float estimateMainReleaseMs(const OmegaPreset& p) const;
    int   estimatePolyphony(const OmegaPreset& p) const;
    int   estimateMedianNote(const OmegaPreset& p) const;

    // Mood / genre helpers
    void addToneTags(PresetSummary& s, const OmegaPreset& p) const;
    void addGenreTags(PresetSummary& s, const OmegaPreset& p) const;

    // Cleanup helpers
    void normalizeContradictoryTags(PresetSummary& s,
                                    float cutoff,
                                    float res,
                                    float drive) const;
};

} // namespace Omega::Preset
cpp
// OmegaPresetTagger.cpp
#include "OmegaPresetTagger.h"

namespace Omega::Preset {

static bool startsWith(const juce::String& id, const juce::String& prefix)
{
    return id.startsWithIgnoreCase(prefix);
}

/*** Component helpers ***/

bool OmegaPresetTagger::usesComponentPrefix(const OmegaPreset& p,
                                            const juce::String& prefix) const
{
    for (auto layerId : p.getLayerIds())
    {
        auto arch = p.getVoiceArchitecture(layerId);
        for (auto& osc : arch.oscillators)
            if (startsWith(osc.componentId, prefix))
                return true;
        for (auto& flt : arch.filters)
            if (startsWith(flt.componentId, prefix))
                return true;
        for (auto& fx : arch.fx)
            if (startsWith(fx.componentId, prefix))
                return true;
    }
    return false;
}

bool OmegaPresetTagger::hasFilterWithIdPrefix(const OmegaPreset& p,
                                              const juce::String& prefix) const
{
    for (auto layerId : p.getLayerIds())
    {
        auto arch = p.getVoiceArchitecture(layerId);
        for (auto& flt : arch.filters)
            if (startsWith(flt.componentId, prefix))
                return true;
    }
    return false;
}

/*** Envelope / polyphony / pitch ***/

float OmegaPresetTagger::estimateMainAttackMs(const OmegaPreset& p) const
{
    float best = 0.0f;
    bool found = false;

    for (auto layerId : p.getLayerIds())
    {
        auto arch = p.getVoiceArchitecture(layerId);
        for (auto& env : arch.envelopes)
        {
            if (env.role == "amp")
            {
                auto it = env.parameters.find("attack");
                if (it != env.parameters.end())
                {
                    best = it->second;
                    found = true;
                }
            }
        }
    }
    return found ? best : 0.0f;
}

float OmegaPresetTagger::estimateMainReleaseMs(const OmegaPreset& p) const
{
    float best = 0.0f;
    bool found = false;

    for (auto layerId : p.getLayerIds())
    {
        auto arch = p.getVoiceArchitecture(layerId);
        for (auto& env : arch.envelopes)
        {
            if (env.role == "amp")
            {
                auto it = env.parameters.find("release");
                if (it != env.parameters.end())
                {
                    best = it->second;
                    found = true;
                }
            }
        }
    }
    return found ? best : 0.0f;
}

int OmegaPresetTagger::estimatePolyphony(const OmegaPreset& p) const
{
    int maxPoly = 0;
    for (auto layerId : p.getLayerIds())
        maxPoly = std::max(maxPoly, p.getLayerPolyphony(layerId));
    return maxPoly;
}

int OmegaPresetTagger::estimateMedianNote(const OmegaPreset& p) const
{
    auto notes = p.getPreviewNotes(); // std::vector<int>
    if (notes.empty())
        return -1;

    std::sort(notes.begin(), notes.end());
    return notes[notes.size() / 2];
}

/*** Categoria principal ***/

PresetCategory OmegaPresetTagger::inferCategory(const OmegaPreset& p) const
{
    const int   poly = estimatePolyphony(p);
    const float atk  = estimateMainAttackMs(p);
    const float rel  = estimateMainReleaseMs(p);
    const int   medNote = estimateMedianNote(p);

    // Pads: polifónicos, ataque y release largos
    if (poly >= 4 && atk >= 80.0f && rel >= 600.0f)
        return PresetCategory::Pad;

    // Plucks: polifónicos, ataque muy rápido, release corto
    if (poly >= 3 && atk <= 10.0f && rel <= 200.0f)
        return PresetCategory::Pluck;

    // Bass/Lead: pocos voices, env rápida
    if (poly <= 2 && atk <= 20.0f && rel <= 300.0f)
    {
        if (medNote >= 60)          // C4+
            return PresetCategory::Lead;
        if (medNote >= 36 && medNote < 60) // C2..B3
            return PresetCategory::Bass;
        // sin previewNotes → lead por defecto
        return PresetCategory::Lead;
    }

    // Supersaw → lead por defecto
    if (usesComponentPrefix(p, "OSC-VA-004"))
        return PresetCategory::Lead;

    // Secuencias (si tienes esta API)
    if (p.usesSequencerSources())
        return PresetCategory::Sequence;

    return PresetCategory::Unknown;
}

/*** Mood / tone tags ***/

void OmegaPresetTagger::addToneTags(PresetSummary& s, const OmegaPreset& p) const
{
    const auto cutoff = p.getLayerMainCutoffHz("A");
    const auto res    = p.getLayerMainResonance("A");
    const auto drive  = p.getLayerDrive("A");
    const float atk   = estimateMainAttackMs(p);

    // bright / dark / warm
    if (cutoff >= 4000.0f && res < 0.5f)
        s.tags.addIfNotAlreadyThere("bright");
    else if (cutoff <= 1000.0f)
    {
        s.tags.addIfNotAlreadyThere("dark");
        s.tags.addIfNotAlreadyThere("warm");
    }

    // aggressive
    if (res >= 0.7f || drive >= 6.0f)
        s.tags.addIfNotAlreadyThere("aggressive");

    // soft
    if (atk >= 80.0f && cutoff <= 4000.0f)
        s.tags.addIfNotAlreadyThere("soft");

    normalizeContradictoryTags(s, cutoff, res, drive);
}

/*** Género (heurísticas suaves) ***/

void OmegaPresetTagger::addGenreTags(PresetSummary& s, const OmegaPreset& p) const
{
    const double bpm = s.bpm;

    // Supersaw + BPM alto → trance
    if (s.usesSupersaw && bpm >= 125.0 && bpm <= 145.0)
    {
        s.tags.addIfNotAlreadyThere("trance");
        return;
    }

    // Oscuro + lento → ambient
    if (s.tags.contains("dark") && bpm > 0.0 && bpm <= 110.0)
    {
        s.tags.addIfNotAlreadyThere("ambient");
        return;
    }

    // Bass + 120–132 BPM → house
    if (s.category == PresetCategory::Bass &&
        bpm >= 118.0 && bpm <= 132.0)
    {
        s.tags.addIfNotAlreadyThere("house");
    }
}

/*** Cleanup contradictorios ***/

void OmegaPresetTagger::normalizeContradictoryTags(
    PresetSummary& s,
    float cutoff,
    float res,
    float drive) const
{
    auto has = [&](const char* t){ return s.tags.contains(t); };

    if (has("bright") && has("dark"))
    {
        if (cutoff >= 4000.0f)
            s.tags.removeString("dark");
        else
            s.tags.removeString("bright");
    }

    if (has("aggressive") && has("soft"))
    {
        if (res >= 0.7f || drive >= 6.0f)
            s.tags.removeString("soft");
    }
}

/*** Auto‑tag summary completo ***/

void OmegaPresetTagger::autoTagSummary(PresetSummary& s,
                                       const OmegaPreset& p) const
{
    // Engine → tags básicos
    auto engine = p.getEngine();
    if (engine == "VirtualAnalog")
        s.tags.addIfNotAlreadyThere("analog");
    else if (engine == "Wavetable")
        s.tags.addIfNotAlreadyThere("wavetable");
    else if (engine == "Granular")
        s.tags.addIfNotAlreadyThere("granular");

    // ACE familias
    if (usesComponentPrefix(p, "OSC-VA-001") ||
        hasFilterWithIdPrefix(p, "FLT-VA-001"))
    {
        s.tags.addIfNotAlreadyThere("roland");
        s.tags.addIfNotAlreadyThere("juno");
        s.usesAceRoland = true;
    }

    if (usesComponentPrefix(p, "OSC-VA-002") ||
        hasFilterWithIdPrefix(p, "FLT-VA-003"))
    {
        s.tags.addIfNotAlreadyThere("korg");
        s.tags.addIfNotAlreadyThere("ms20");
        s.tags.addIfNotAlreadyThere("aggressive");
        s.usesAceKorg = true;
    }

    if (usesComponentPrefix(p, "OSC-VA-004"))
    {
        s.tags.addIfNotAlreadyThere("supersaw");
        s.tags.addIfNotAlreadyThere("jp8000");
        s.usesSupersaw = true;
    }

    // Tonalidad / mood
    addToneTags(s, p);

    // MPE / mod complejo
    if (p.usesMpeSources())
        s.tags.addIfNotAlreadyThere("mpe");

    if (p.getModulationRouteCount("A") > 8)
        s.tags.addIfNotAlreadyThere("complex-mod");

    // Categoría principal
    s.category = inferCategory(p);

    // Género (heurísticas suaves)
    addGenreTags(s, p);
}

} // namespace Omega::Preset
Encajando esto en buildSummaryFromPresetFile, solo tendrías que:

cpp
OmegaPresetTagger tagger(*mAce);
tagger.autoTagSummary(s, preset);
y tu browser recibirá ya category + tags razonables desde el primer escaneo.

Lo siguiente más rentable para el navegador avanzado serían tres cosas:

Escaneo inicial e invalidación de caché

Implementar un comando interno tipo rescanPresets() que:

Vacia summaryCache.

Relee todos los .omegapreset.yaml.

Vuelve a llamar a OmegaPresetTagger para actualizar categorías/tags.

Ligar esto a un mensaje JSON type: "rescanPresets" desde la Web UI y a un botón “Rescan” en el browser.

Soporte de bancos / colecciones

Añadir a PresetSummary algo como library y/o path (ej. factory, user, user/my-pack-01).
​

En UI: filtro rápido “Factory / User / All” y agrupación por “folder” lógica (puedes derivarla del path).

En el repositorio: exponer un campo folder que salga directo de la ruta relativa.

Operaciones extra de UX que ya soporta tu modelo

duplicatePreset (crear copia en carpeta user).

renamePreset (solo en user).

saveCurrentAsPreset que serializa mCurrentPreset + estado APVTS a un nuevo archivo en user/… y refresca el browser.
​

Todos ellos encajados como mensajes JSON (savePreset, renamePreset, duplicatePreset) encima de PresetRepository y OmegaPresetSerializer.

Si quieres seguir por aquí, puedo proponerte las firmas y mensajes JSON para savePreset/renamePreset/duplicatePreset y cómo integrar esos comandos en el mismo flujo repo + Git for Sounds.



Te propongo directamente contratos y firmas para savePreset, renamePreset, duplicatePreset y rescanPresets.

1. Extender PresetRepository
cpp
class PresetRepository {
public:
    virtual ~PresetRepository() = default;

    // Existentes
    virtual juce::Array<PresetSummary> listPresets(
        const PresetFilter&, const PresetSort&, const Paging&) const = 0;
    virtual std::optional<PresetSummary> getPresetSummary(const PresetId&) const = 0;
    virtual juce::Array<PresetSummary> searchPresets(
        const juce::String& text, const PresetFilter&, const Paging&) const = 0;
    virtual PresetHistory getHistory(const PresetId&) const = 0;
    virtual void toggleFavorite(const PresetId&, bool isFavorite) = 0;

    // Nuevos
    virtual PresetId saveNewPreset(const OmegaPreset& preset,
                                   const juce::String& suggestedName,
                                   const juce::StringArray& tags) = 0;

    virtual bool renamePreset(const PresetId& id,
                              const juce::String& newName) = 0;

    virtual std::optional<PresetId> duplicatePreset(const PresetId& sourceId,
                                                    const juce::String& newName) = 0;

    virtual void rescan() = 0;
};
Implementación base FileSystemPresetRepository:

saveNewPreset:

Genera slug user/<slug-name>.omegapreset.yaml.

Serializa OmegaPreset + metadata (tags, category…) a YAML.

Commit Git for Sounds “Add preset X”.
​

Actualiza summaryCache usando buildSummaryFromPresetFile.

renamePreset:

Solo si está bajo user/.

Renombra archivo, actualiza id en cache y, si quieres, escribe nuevo nombre en YAML.

Commit Git “Rename preset…”.

duplicatePreset:

Copia archivo source a nueva ruta en user/, ajusta id y name en YAML.

Devuelve nuevo PresetId.

rescan:

Limpia summaryCache y llama a ensureCacheLoaded() de nuevo.

2. Mensajes JSON Web UI → Core
2.1 Guardar nuevo preset
text
{
  "type": "savePreset",
  "requestId": "req-201",
  "payload": {
    "name": "My New Pad",
    "tags": ["pad","warm","juno"],
    "category": "pad"  // opcional override
  }
}
Respuesta:

text
{
  "type": "presetSaved",
  "requestId": "req-201",
  "payload": {
    "presetId": "user/my-new-pad",
    "summary": { /* PresetSummary serializado igual que en presetList */ }
  }
}
2.2 Renombrar
text
{
  "type": "renamePreset",
  "requestId": "req-202",
  "payload": {
    "presetId": "user/my-old-name",
    "newName": "My Renamed Pad"
  }
}
Respuesta:

text
{
  "type": "ack",
  "requestId": "req-202",
  "payload": {
    "ok": true,
    "action": "renamePreset",
    "presetId": "user/my-renamed-pad"
  }
}
2.3 Duplicar
text
{
  "type": "duplicatePreset",
  "requestId": "req-203",
  "payload": {
    "sourceId": "factory/ace-juno-basic-pad",
    "newName": "My Juno Variation"
  }
}
Respuesta:

text
{
  "type": "presetDuplicated",
  "requestId": "req-203",
  "payload": {
    "presetId": "user/my-juno-variation",
    "summary": { /* nuevo PresetSummary */ }
  }
}
2.4 Rescan
text
{
  "type": "rescanPresets",
  "requestId": "req-204",
  "payload": {}
}
Respuesta (puedes devolver lista completa de una vez):

