      <section className="audio-diff-body">
        <div className="audio-diff-chart">
          {/* Aquí meterías tu bar chart de 16 bandas */}
          <BandDiffBarChart bandDiffDb={bandDiffDb} />
        </div>
        <div className="audio-diff-phrases">
          <h4>Cambios por banda</h4>
          {phrases.bands.length === 0 ? (
            <p>No hay cambios significativos por banda.</p>
          ) : (
            <ul>
              {phrases.bands.map((t, idx) => (
                <li key={idx}>{t}</li>
              ))}
            </ul>
          )}
        </div>
      </section>
    </div>
  );
};
