PresetTable con filtro de texto, engine y tags
tsx
// PresetTable.tsx
import React, { useCallback, useState } from 'react';
import {
  usePresetBrowser,
  PresetListItem,
} from './usePresetBrowser';
import { useCurrentPresetId } from './useCurrentPresetId';

type OmegaCoreBridge = {
  sendMessage?: (msg: any) => void;
};

declare global {
  interface Window {
    OmegaCore?: OmegaCoreBridge;
  }
}

function sendLoadPresetFromBrowser(id: string) {
  if (!window.OmegaCore || typeof window.OmegaCore.sendMessage !== 'function') {
    return;
  }

  window.OmegaCore.sendMessage({
    type: 'loadPresetFromBrowser',
    requestId: `loadPresetFromBrowser-${Date.now()}-${Math.floor(
      Math.random() * 1e6,
    )}`,
    payload: { presetId: id },
  });
}

export const PresetTable: React.FC = () => {
  const {
    items,
    total,
    offset,
    limit,
    loading,
    error,
    setPage,
    applyFilters,
    state,
  } = usePresetBrowser(25);
  const currentPresetId = useCurrentPresetId();

  const [textFilter, setTextFilter] = useState(state.filters.text ?? '');
  const [engineFilter, setEngineFilter] = useState(state.filters.engine ?? '');

  const currentPage = Math.floor(offset / limit) + 1;
  const totalPages = Math.max(1, Math.ceil(total / limit));

  const handleRowDoubleClick = useCallback((preset: PresetListItem) => {
    sendLoadPresetFromBrowser(preset.id);
  }, []);

  const handlePrevPage = useCallback(() => {
    const newOffset = Math.max(0, offset - limit);
    setPage(newOffset);
  }, [offset, limit, setPage]);

  const handleNextPage = useCallback(() => {
    const newOffset = Math.min(Math.max(0, total - limit), offset + limit);
    setPage(newOffset);
  }, [offset, limit, total, setPage]);

  const pushFilters = useCallback(
    (nextText: string, nextEngine: string) => {
      applyFilters({
        ...state.filters,
        text: nextText || undefined,
        engine: nextEngine || undefined,
      });
    },
    [applyFilters, state.filters],
  );

  const handleTextFilterChange = useCallback(
    (e: React.ChangeEvent<HTMLInputElement>) => {
      const value = e.target.value;
      setTextFilter(value);
      pushFilters(value, engineFilter);
    },
    [engineFilter, pushFilters],
  );

  const handleEngineFilterChange = useCallback(
    (e: React.ChangeEvent<HTMLSelectElement>) => {
      const value = e.target.value;
      setEngineFilter(value);
      pushFilters(textFilter, value);
    },
    [textFilter, pushFilters],
  );

  return (
    <div className="preset-table">
      <div className="preset-table-header">
        <h2>Presets</h2>
        <div className="preset-table-meta" style={{ display: 'flex', gap: 8 }}>
          <input
            type="text"
            placeholder="Search presets…"
            value={textFilter}
            onChange={handleTextFilterChange}
            style={{ minWidth: 180 }}
          />
          <select
            value={engineFilter}
            onChange={handleEngineFilterChange}
            style={{ minWidth: 120 }}
          >
            <option value="">All engines</option>
            <option value="VirtualAnalog">VirtualAnalog</option>
            <option value="Spectral">Spectral</option>
            <option value="Wavetable">Wavetable</option>
          </select>
          <span>
            {loading ? 'Loading…' : `${total} presets`}
          </span>
          {error && <span className="preset-table-error">{error}</span>}
        </div>
      </div>

      <table className="preset-table-grid">
        <thead>
          <tr>
            <th>Loaded</th>
            <th>Name</th>
            <th>Author</th>
            <th>Engine</th>
            <th>Tags</th>
          </tr>
        </thead>
        <tbody>
          {items.length === 0 && !loading && (
            <tr>
              <td colSpan={5} style={{ textAlign: 'center', opacity: 0.7 }}>
                No presets found
              </td>
            </tr>
          )}

          {items.map((preset) => {
            const isCurrent = currentPresetId === preset.id;
            return (
              <tr
                key={preset.id}
                onDoubleClick={() => handleRowDoubleClick(preset)}
                className={isCurrent ? 'preset-row-current' : undefined}
                style={{
                  cursor: 'pointer',
                  backgroundColor: isCurrent
                    ? 'rgba(0, 200, 255, 0.12)'
                    : undefined,
                }}
              >
                <td style={{ textAlign: 'center' }}>
                  {isCurrent ? '●' : ''}
                </td>
                <td>{preset.name}</td>
                <td>{preset.author}</td>
                <td>{preset.engine}</td>
                <td>{preset.tags.join(', ')}</td>
              </tr>
            );
          })}
        </tbody>
      </table>

      <div className="preset-table-footer">
        <button
          type="button"
          onClick={handlePrevPage}
          disabled={loading || currentPage <= 1}
        >
          ‹ Prev
        </button>
        <span>
          Page {currentPage} / {totalPages}
        </span>
        <button
          type="button"
          onClick={handleNextPage}
          disabled={loading || currentPage >= totalPages}
        >
          Next ›
        </button>
      </div>
    </div>
  );
};
Ahora:

Texto y engine se combinan en un único applyFilters({ text, engine }).

El select de engine usa las opciones fijas VirtualAnalog, Spectral y Wavetable tal y como salen de engine.
​

La nueva columna muestra tags separados por comas a partir del payload de listPresets.
​

¿Quieres que el siguiente paso sea añadir un pequeño “favorite toggle” por fila que mande un mensaje setPresetFavorite al bridge para probar edición desde la tabla?


Te añado el toggle de favorito con estrella textual, sin interferir con el doble clic de carga.
​

Toggle favorite en la tabla
tsx
// PresetTable.tsx
import React, { useCallback, useState } from 'react';
import {
  usePresetBrowser,
  PresetListItem,
} from './usePresetBrowser';
import { useCurrentPresetId } from './useCurrentPresetId';

type OmegaCoreBridge = {
  sendMessage?: (msg: any) => void;
};

declare global {
  interface Window {
    OmegaCore?: OmegaCoreBridge;
  }
}

function sendLoadPresetFromBrowser(id: string) {
  if (!window.OmegaCore || typeof window.OmegaCore.sendMessage !== 'function') {
    return;
  }

  window.OmegaCore.sendMessage({
    type: 'loadPresetFromBrowser',
    requestId: `loadPresetFromBrowser-${Date.now()}-${Math.floor(
      Math.random() * 1e6,
    )}`,
    payload: { presetId: id },
  });
}

function sendToggleFavorite(id: string, nextFavorite: boolean) {
  if (!window.OmegaCore || typeof window.OmegaCore.sendMessage !== 'function') {
    return;
  }

  window.OmegaCore.sendMessage({
    type: 'setPresetFavorite',
    requestId: `setPresetFavorite-${Date.now()}-${Math.floor(
      Math.random() * 1e6,
    )}`,
    payload: {
      presetId: id,
      favorite: nextFavorite,
    },
  });
}

export const PresetTable: React.FC = () => {
  const {
    items,
    total,
    offset,
    limit,
    loading,
    error,
    setPage,
    applyFilters,
    state,
    reload,
  } = usePresetBrowser(25);
  const currentPresetId = useCurrentPresetId();

  const [textFilter, setTextFilter] = useState(state.filters.text ?? '');
  const [engineFilter, setEngineFilter] = useState(state.filters.engine ?? '');

  const currentPage = Math.floor(offset / limit) + 1;
  const totalPages = Math.max(1, Math.ceil(total / limit));

  const handleRowDoubleClick = useCallback((preset: PresetListItem) => {
    sendLoadPresetFromBrowser(preset.id);
  }, []);

  const handlePrevPage = useCallback(() => {
    const newOffset = Math.max(0, offset - limit);
    setPage(newOffset);
  }, [offset, limit, setPage]);

  const handleNextPage = useCallback(() => {
    const newOffset = Math.min(Math.max(0, total - limit), offset + limit);
    setPage(newOffset);
  }, [offset, limit, total, setPage]);

  const pushFilters = useCallback(
    (nextText: string, nextEngine: string) => {
      applyFilters({
        ...state.filters,
        text: nextText || undefined,
        engine: nextEngine || undefined,
      });
    },
    [applyFilters, state.filters],
  );

  const handleTextFilterChange = useCallback(
    (e: React.ChangeEvent<HTMLInputElement>) => {
      const value = e.target.value;
      setTextFilter(value);
      pushFilters(value, engineFilter);
    },
    [engineFilter, pushFilters],
  );

  const handleEngineFilterChange = useCallback(
    (e: React.ChangeEvent<HTMLSelectElement>) => {
      const value = e.target.value;
      setEngineFilter(value);
      pushFilters(textFilter, value);
    },
    [textFilter, pushFilters],
  );

  const handleFavoriteClick = useCallback(
    (e: React.MouseEvent, preset: PresetListItem) => {
      e.stopPropagation(); // evita que el click llegue al <tr>
      const next = !preset.favorite;
      sendToggleFavorite(preset.id, next);
      // Opcional: feedback optimista
      // O simplemente recargar lista tras un breve tiempo o cuando llegue ack
      reload();
    },
    [reload],
  );

  return (
    <div className="preset-table">
      <div className="preset-table-header">
        <h2>Presets</h2>
        <div className="preset-table-meta" style={{ display: 'flex', gap: 8 }}>
          <input
            type="text"
            placeholder="Search presets…"
            value={textFilter}
            onChange={handleTextFilterChange}
            style={{ minWidth: 180 }}
          />
          <select
            value={engineFilter}
            onChange={handleEngineFilterChange}
            style={{ minWidth: 120 }}
          >
            <option value="">All engines</option>
            <option value="VirtualAnalog">VirtualAnalog</option>
            <option value="Spectral">Spectral</option>
            <option value="Wavetable">Wavetable</option>
          </select>
          <span>
            {loading ? 'Loading…' : `${total} presets`}
          </span>
          {error && <span className="preset-table-error">{error}</span>}
        </div>
      </div>

      <table className="preset-table-grid">
        <thead>
          <tr>
            <th>Loaded</th>
            <th>Fav</th>
            <th>Name</th>
            <th>Author</th>
            <th>Engine</th>
            <th>Tags</th>
          </tr>
        </thead>
        <tbody>
          {items.length === 0 && !loading && (
            <tr>
              <td colSpan={6} style={{ textAlign: 'center', opacity: 0.7 }}>
                No presets found
              </td>
            </tr>
          )}

          {items.map((preset) => {
            const isCurrent = currentPresetId === preset.id;
            const star = preset.favorite ? '★' : '☆';
            return (
              <tr
                key={preset.id}
                onDoubleClick={() => handleRowDoubleClick(preset)}
                className={isCurrent ? 'preset-row-current' : undefined}
                style={{
                  cursor: 'pointer',
                  backgroundColor: isCurrent
                    ? 'rgba(0, 200, 255, 0.12)'
                    : undefined,
                }}
              >
                <td style={{ textAlign: 'center' }}>
                  {isCurrent ? '●' : ''}
                </td>
                <td style={{ textAlign: 'center' }}>
                  <button
                    type="button"
                    onClick={(e) => handleFavoriteClick(e, preset)}
                    style={{
                      border: 'none',
                      background: 'transparent',
                      cursor: 'pointer',
                      padding: 0,
                    }}
                    title={preset.favorite ? 'Unfavorite' : 'Favorite'}
                  >
                    {star}
                  </button>
                </td>
                <td>{preset.name}</td>
                <td>{preset.author}</td>
                <td>{preset.engine}</td>
                <td>{preset.tags.join(', ')}</td>
              </tr>
            );
          })}
        </tbody>
      </table>

      <div className="preset-table-footer">
        <button
          type="button"
          onClick={handlePrevPage}
          disabled={loading || currentPage <= 1}
        >
          ‹ Prev
        </button>
        <span>
          Page {currentPage} / {totalPages}
        </span>
        <button
          type="button"
          onClick={handleNextPage}
          disabled={loading || currentPage >= totalPages}
        >
          Next ›
        </button>
      </div>
    </div>
  );
};
La estrella usa caracteres ★ / ☆ y un <button> que hace stopPropagation para no disparar el doble clic del <tr>.
​

El mensaje setPresetFavorite queda para que lo implementes en OmegaUiBridge y actualices el repositorio; luego reload() vuelve a pedir la página.
​

¿Quieres que el próximo paso sea esbozar la rama C++ de OmegaUiBridge::handleSetPresetFavorite y cómo actualizar PresetRepository para devolver favorite ya actualizado a la WebUI?


Te dejo la rama C++ mínima que encaja con lo que ya tienes en la WebUI.
​

handleSetPresetFavorite en OmegaUiBridge
cpp
// OmegaUiBridge.h
#pragma once
#include <juce_core/juce_core.h>

class PresetRepository;

class OmegaUiBridge
{
public:
    OmegaUiBridge(PresetRepository& repo);

    // llamado desde el WebView / host
    void handleMessageFromUi(const juce::String& jsonText);

    // inyectado por el editor para mandar mensajes a JS
    std::function<void (const juce::String& jsonText)> sendToUi;

private:
    PresetRepository& presetRepo;

    void handleSetPresetFavorite(const juce::var& msg);

    juce::String buildAck(const juce::String& requestId,
                          bool ok,
                          const juce::String& code = {},
                          const juce::String& message = {},
                          juce::var payload = juce::var());
};
cpp
// OmegaUiBridge.cpp
#include "OmegaUiBridge.h"
#include "PresetRepository.h"

OmegaUiBridge::OmegaUiBridge(PresetRepository& repo)
    : presetRepo(repo)
{
}

void OmegaUiBridge::handleMessageFromUi(const juce::String& jsonText)
{
    juce::var msg = juce::JSON::parse(jsonText);
    if (! msg.isObject())
        return;

    auto* obj = msg.getDynamicObject();
    const auto type      = obj->getProperty("type").toString();
    const auto requestId = obj->getProperty("requestId").toString();

    if (type == "setPresetFavorite")
    {
        handleSetPresetFavorite(msg);
        // el propio handler envía el ack
        return;
    }

    // resto de tipos...
}

void OmegaUiBridge::handleSetPresetFavorite(const juce::var& msg)
{
    auto* obj     = msg.getDynamicObject();
    auto  payload = obj->getProperty("payload");

    juce::String requestId = obj->getProperty("requestId").toString();
    if (! payload.isObject())
    {
        if (sendToUi)
            sendToUi(buildAck(requestId, false, "BAD_PAYLOAD", "Payload must be object"));
        return;
    }

    auto* pObj    = payload.getDynamicObject();
    juce::String presetId = pObj->getProperty("presetId").toString();
    bool favorite         = (bool) pObj->getProperty("favorite");

    bool ok = presetRepo.setFavorite(presetId, favorite);

    juce::DynamicObject::Ptr payloadOut (new juce::DynamicObject());
    payloadOut->setProperty("presetId", presetId);
    payloadOut->setProperty("favorite", favorite);

    if (sendToUi)
        sendToUi(buildAck(requestId, ok,
                          ok ? juce::String() : "NOT_FOUND",
                          ok ? juce::String() : "Preset not found",
                          juce::var(payloadOut.get())));
}

juce::String OmegaUiBridge::buildAck(const juce::String& requestId,
                                     bool ok,
                                     const juce::String& code,
                                     const juce::String& message,
                                     juce::var payload)
{
    juce::DynamicObject::Ptr root (new juce::DynamicObject());
    root->setProperty("type", ok ? "ack" : "error");
    root->setProperty("requestId", requestId);

    if (ok)
    {
        if (! payload.isVoid())
            root->setProperty("payload", payload);
    }
    else
    {
        juce::DynamicObject::Ptr err (new juce::DynamicObject());
        err->setProperty("code", code);
        err->setProperty("message", message);
        if (! payload.isVoid())
            err->setProperty("payload", payload);
        root->setProperty("payload", juce::var(err.get()));
    }

    return juce::JSON::toString(juce::var(root.get()));
}
Firma sugerida en PresetRepository
cpp
// PresetRepository.h
#pragma once
#include <juce_core/juce_core.h>

struct PresetListItem
{
    juce::String id;
    juce::String name;
    juce::String author;
    juce::String engine;
    juce::StringArray tags;
    bool favorite = false;
    // ... otros campos
};

class PresetRepository
{
public:
    // marca o desmarca favorito, devuelve false si el id no existe
    bool setFavorite(const juce::String& presetId, bool favorite);

    // usado por el browser para listar con el flag actualizado
    juce::Array<PresetListItem> listPresets(/* filtros, paginación... */) const;

    // opcional: API de lectura individual
    bool getPreset(const juce::String& id, PresetListItem& outItem) const;

    // ...
};
Con esto el flujo queda:

WebUI envía type: "setPresetFavorite" con presetId y favorite.

OmegaUiBridge::handleSetPresetFavorite llama a PresetRepository::setFavorite.

Se devuelve un ack con el nuevo valor para que, si quieres, puedas hacer update optimista en React en vez de llamar a reload() siempre.
​

¿Quieres que te escriba también el formato JSON de ese ack para engancharlo a tu hook React y dejar de depender de reload() tras cada click?



Para el toggle de favorito, cerramos tres cosas: JSON del ack, manejo en React y persistencia en el repo.
​

JSON exacto del ack
Cuando JS envía:

json
{
  "type": "setPresetFavorite",
  "requestId": "fav-123",
  "payload": {
    "presetId": "abcd-1234",
    "favorite": true
  }
}
La respuesta de éxito desde C sería:

json
{
  "type": "ack",
  "requestId": "fav-123",
  "payload": {
    "presetId": "abcd-1234",
    "favorite": true
  }
}
Si falla (id inexistente):

json
{
  "type": "error",
  "requestId": "fav-123",
  "payload": {
    "code": "NOT_FOUND",
    "message": "Preset not found",
    "payload": {
      "presetId": "abcd-1234",
      "favorite": true
    }
  }
}
Esto encaja con el patrón de ack/error que ya usas para otros mensajes del bridge.
​

Uso en React sin reload()
Extiende tu handler global de mensajes para capturar ese ack:

ts
// dentro de tu bootstrap / hook central tipo useOmegaPresetsBrowser

function handleMessage(jsonText: string) {
  let msg: any;
  try { msg = JSON.parse(jsonText); } catch { return; }

  if (msg.type === 'presetList') {
    // caso ya existente...
    return;
  }

  if (msg.type === 'ack' && msg.payload?.presetId) {
    const { presetId, favorite } = msg.payload;
    setState(prev => ({
      ...prev,
      items: prev.items.map(p =>
        p.id === presetId ? { ...p, favorite } : p
      ),
    }));
    return;
  }

  if (msg.type === 'error' && msg.payload?.code === 'NOT_FOUND') {
    // opcional: mostrar toast
    return;
  }

  // otros tipos...
}
Y en el click de la estrella te puedes quedar solo con el envío:

ts
const handleFavoriteClick = useCallback(
  (e: React.MouseEvent, preset: PresetListItem) => {
    e.stopPropagation();
    const next = !preset.favorite;
    window.OmegaCore?.sendMessage?.({
      type: 'setPresetFavorite',
      requestId: `fav-${preset.id}-${Date.now()}`,
      payload: { presetId: preset.id, favorite: next },
    });
    // no hace falta reload(); el ack actualiza el estado local
  },
  [],
);
Con esto ya no dependes de volver a pedir la página tras cada click; el browser se mantiene consistente con el repo vía ack.
​

Persistencia en disco en el repositorio
Firma y sketch interno del repo, suponiendo que cada preset tiene un metadato favorite en el ValueTree/YAML:
​

cpp
// PresetRepository.h
class PresetRepository
{
public:
    // true si se ha podido actualizar y persistir
    bool setFavorite(const juce::String& presetId, bool favorite);

private:
    // helpers
    bool loadPresetTree(const juce::String& id, juce::ValueTree& outTree);
    bool savePresetTree(const juce::String& id, const juce::ValueTree& tree);
};
cpp
// PresetRepository.cpp
#include "PresetRepository.h"

bool PresetRepository::setFavorite(const juce::String& presetId, bool favorite)
{
    juce::ValueTree presetTree;
    if (! loadPresetTree(presetId, presetTree))
        return false;

    auto metadata = presetTree.getChildWithName("Metadata");
    if (! metadata.isValid())
        metadata = presetTree.getOrCreateChildWithName("Metadata", nullptr);

    metadata.setProperty("favorite", favorite, nullptr);

    return savePresetTree(presetId, presetTree);
}
En el lado YAML, eso se reflejaría como algo así dentro de metadata:

text
metadata:
  name: ACE Juno Basic Pad
  author: abdeneurolab
  favorite: true
  # resto de campos...
De esta forma:

El flag viaja con el preset en disco.

listPresets puede leer favorite del ValueTree/YAML al construir cada PresetListItem.

WebUI y JUCE ven siempre el mismo estado favorito/no.
​

¿Prefieres que el repo guarde favoritos en un índice separado (p.ej. favorites.json) para no tocar el YAML del preset, o te encaja mejor el campo favorite dentro de metadata como arriba?


Si quieres favoritos por usuario sin tocar el YAML de los presets, introduce un índice externo tipo favorites.json y añade el userId a la clave.
​

Estructura de favorites.json
Por banco (o por instancia), un archivo:

json
{
  "version": 1,
  "items": [
    { "userId": "default", "presetId": "abcd-1234", "favorite": true },
    { "userId": "default", "presetId": "efgh-5678", "favorite": false },
    { "userId": "user-foo", "presetId": "abcd-1234", "favorite": true }
  ]
}
Reglas:

Sin entrada → favorite = false para ese usuario.

Múltiples usuarios pueden marcar el mismo preset independientemente.

API del repositorio
cpp
// PresetRepository.h
class PresetRepository
{
public:
    bool setFavorite(const juce::String& userId,
                     const juce::String& presetId,
                     bool favorite);

    bool isFavorite(const juce::String& userId,
                    const juce::String& presetId) const;

    juce::Array<PresetListItem> listPresetsForUser(const juce::String& userId,
                                                   /* filtros... */) const;

private:
    struct FavoriteKey
    {
        juce::String userId;
        juce::String presetId;

        bool operator==(const FavoriteKey& o) const noexcept
        { return userId == o.userId && presetId == o.presetId; }
    };

    struct FavoriteKeyHash
    {
        size_t operator()(const FavoriteKey& k) const noexcept
        {
            return (size_t) k.userId.hashCode64() ^ (size_t) k.presetId.hashCode64();
        }
    };

    std::unordered_map<FavoriteKey, bool, FavoriteKeyHash> favorites;
    juce::File favoritesFile;

    void loadFavoritesFromDisk();
    void saveFavoritesToDisk() const;
};
Implementación sketch:

cpp
bool PresetRepository::setFavorite(const juce::String& userId,
                                   const juce::String& presetId,
                                   bool favoriteFlag)
{
    FavoriteKey key{ userId, presetId };
    favorites[key] = favoriteFlag;
    saveFavoritesToDisk();
    return true; // si quieres, puedes comprobar que presetId existe primero
}

bool PresetRepository::isFavorite(const juce::String& userId,
                                  const juce::String& presetId) const
{
    FavoriteKey key{ userId, presetId };
    auto it = favorites.find(key);
    return it != favorites.end() && it->second;
}
listPresetsForUser simplemente rellena PresetListItem.favorite usando isFavorite(userId, item.id).
​

Integración con OmegaUiBridge
Añade userId al payload del mensaje, o deriva un userId fijo de momento ("default").

Cambia la llamada:

cpp
bool ok = presetRepo.setFavorite(userId, presetId, favorite);
El ack JSON no necesita cambiar de forma; para el browser basta con presetId y favorite, porque ya está en el contexto del usuario actual.
​

¿Te interesa que el favorites.json pueda vivir por banco (p.ej. un archivo por carpeta de presets) o prefieres uno global con bankId adicional en la clave?


Para filtrar por favoritos en el browser, apóyate en el estado ya local y en el índice de favorites.json por banco.
​

Modelo para favorites por banco
favorites.json en cada carpeta de banco:

json
{
  "version": 1,
  "items": [
    { "userId": "default", "presetId": "abcd-1234", "favorite": true }
  ]
}
Firma del repo:

cpp
class PresetRepository
{
public:
    juce::Array<PresetListItem> listPresetsForUser(
        const juce::String& bankId,
        const juce::String& userId,
        bool onlyFavorites) const;
};
Implementación esquemática:

cpp
juce::Array<PresetListItem> PresetRepository::listPresetsForUser(
    const juce::String& bankId,
    const juce::String& userId,
    bool onlyFavorites) const
{
    juce::Array<PresetListItem> all = listPresets(bankId);
    juce::Array<PresetListItem> out;

    for (auto& p : all)
    {
        const bool fav = isFavorite(bankId, userId, p.id);
        if (!onlyFavorites || fav)
        {
            p.favorite = fav;
            out.add(p);
        }
    }
    return out;
}
Mensaje JSON para filtro en WebUI
Añade filtro en el payload:

json
{
  "type": "listPresets",
  "requestId": "list-1",
  "payload": {
    "bankId": "factory",
    "onlyFavorites": true
  }
}
Respuesta:

json
{
  "type": "presetList",
  "requestId": "list-1",
  "payload": {
    "items": [
      { "id": "abcd-1234", "name": "Pad 1", "favorite": true }
    ]
  }
}
Hook React con toggle “solo favoritos”
ts
type BrowserState = {
  items: PresetListItem[];
  onlyFavorites: boolean;
};

const [state, setState] = useState<BrowserState>({
  items: [],
  onlyFavorites: false,
});

const reload = useCallback(() => {
  window.OmegaCore?.sendMessage?.({
    type: 'listPresets',
    requestId: `list-${Date.now()}`,
    payload: {
      bankId: 'factory',
      onlyFavorites: state.onlyFavorites,
    },
