                  "shape": "sine",
                  "delay": 0.0
                }
              }
            ],
            "fx": [
              {
                "slot": 1,
                "componentId": "FX-CH-001",
                "enabled": true,
                "params": {
                  "mix": 0.7,
                  "mode": "III"
                }
              }
            ]
          },
          "modulation": {
