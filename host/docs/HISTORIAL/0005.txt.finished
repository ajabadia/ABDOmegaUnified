¿Quieres que dejemos toda esta infraestructura de WebUI/diagnostics así y volvamos al lado C++ (por ejemplo, a cerrar el MVP del engine VA / Juno con el flujo de presets que ya tenemos)?


ara cerrar el flujo del MVP VA/Juno con lo que ya tienes, el esquema es:

Un solo preset Juno pad en YAML.

Ese preset se carga en OmegaPreset.

OmegaAudioProcessor sincroniza OmegaPreset → APVTS → atomics → VirtualAnalogEngine.

Tu WebUI maneja presets, macros y errores con el contrato JSON que acabamos de fijar.
​

Si quieres, en el siguiente mensaje vamos directamente a: firma concreta de VirtualAnalogEngine + VoiceRuntimeVA mínima para ese preset (1 DCO Juno, 1 IR3109, 1 env amp, 1 LFO vibrato) y cómo leer los atomics LayerASettings dentro del render.


Firma y esqueleto mínimo de engine y voz para ese Juno VA.
​

VirtualAnalogEngine mínima
cpp
// VirtualAnalogEngine.h
#pragma once
#include <juce_audio_basics/juce_audio_basics.h>

namespace OmegaDSP { namespace Engines {

struct LayerASettings
{
    std::atomic<float> levelDb         { 0.0f };
    std::atomic<float> pan             { 0.0f };
    std::atomic<float> cutoffHz        { 2000.0f };
    std::atomic<float> resonance       { 0.2f };
    std::atomic<float> envAmount       { 0.5f };
    std::atomic<float> lfoRateHz       { 1.0f };
    std::atomic<float> lfoDepthSemis   { 0.3f };
    std::atomic<float> ampAttackMs     { 40.0f };
    std::atomic<float> ampDecayMs      { 160.0f };
    std::atomic<float> ampSustain      { 0.8f };
    std::atomic<float> ampReleaseMs    { 600.0f };
};

class VoiceRuntimeVA;

class VirtualAnalogEngine
{
public:
    VirtualAnalogEngine() = default;

    void prepare(double sampleRate, int samplesPerBlock, int maxVoices);
    void reset() noexcept;

    void setLayerSettings(const LayerASettings* settings) noexcept
    {
        layerSettings = settings;
    }

    // OmegaPreset ya validado, solo para este preset Juno MVP
    void setPreset(const OmegaPreset& preset);

    void renderNextBlock(juce::AudioBuffer<float>& buffer,
                         const juce::MidiBuffer& midi) noexcept;

private:
    double sampleRate  { 44100.0 };
    int    blockSize   { 512 };

    const LayerASettings* layerSettings { nullptr };

    std::unique_ptr<VoiceRuntimeVA[]> voices;
    int maxVoices { 0 };

    float globalPitchBendSemis { 0.0f };

    void handleMidi(const juce::MidiBuffer& midi);
};

}} // namespace
VoiceRuntimeVA mínima (1 osc, 1 filtro, 1 env, 1 LFO, 1 chorus stub)
cpp
// VoiceRuntimeVA.h
#pragma once
#include <array>
#include <atomic>

namespace OmegaDSP { namespace Voices {

struct alignas(64) VoiceRuntimeVA
{
    struct State
    {
        std::atomic<bool>  active   { false };
        std::atomic<int>   midiNote { -1 };
        std::atomic<float> velocity { 0.0f };
    } state;

    static constexpr int kMaxBlockSize = 256;
    alignas(32) std::array<float, kMaxBlockSize> bufferL {};
    alignas(32) std::array<float, kMaxBlockSize> bufferR {};

    // índices/punteros a pools concretos en engine (JUNO DCO, IR3109, env, LFO, chorus)
    uint16_t oscIndex   { 0 };
    uint16_t filtIndex  { 0 };
    uint16_t envIndex   { 0 };
    uint16_t lfoIndex   { 0 };
    uint16_t chorusIndex{ 0 };

    void noteOn(int midiNote, float vel) noexcept
    {
        state.midiNote.store(midiNote, std::memory_order_relaxed);
        state.velocity.store(vel, std::memory_order_relaxed);
        state.active.store(true, std::memory_order_release);
        // reset env, phase, etc. (en implementación)
    }

    void noteOff() noexcept
    {
        // marcar release en env; active pasará a false cuando acabe
    }

    bool isActive() const noexcept
    {
        return state.active.load(std::memory_order_acquire);
    }

    // punto de entrada por bloque desde el engine
    void process(float* outL, float* outR, int numSamples,
                 double sampleRate,
                 const LayerASettings& settings) noexcept;
};

}} // namespace
Uso de LayerASettings dentro del render
Dentro de VoiceRuntimeVA::process (pseudo):

cpp
void VoiceRuntimeVA::process(float* outL, float* outR, int numSamples,
                             double sampleRate,
                             const LayerASettings& settings) noexcept
{
    if (! isActive())
        return;

    const float cutoff   = settings.cutoffHz.load(std::memory_order_relaxed);
    const float res      = settings.resonance.load(std::memory_order_relaxed);
    const float envAmt   = settings.envAmount.load(std::memory_order_relaxed);
    const float lfoRate  = settings.lfoRateHz.load(std::memory_order_relaxed);
    const float lfoDepth = settings.lfoDepthSemis.load(std::memory_order_relaxed);
    const float levelDb  = settings.levelDb.load(std::memory_order_relaxed);

    // 1) generar DCO Juno en bufferL/bufferR
    // 2) aplicar LFO al pitch (usando lfoRate/lfoDepth)
    // 3) aplicar env amp (usando attack/decay/sustain/release)
    // 4) pasar por filtro IR3109 usando cutoff+envAmt*env, res
    // 5) chorus stub (passthrough o simple mix)
    // 6) mezclar en outL/outR aplicando levelDb y pan
}
VirtualAnalogEngine::renderNextBlock
cpp
void VirtualAnalogEngine::renderNextBlock(juce::AudioBuffer<float>& buffer,
                                          const juce::MidiBuffer& midi) noexcept
{
    buffer.clear();

    handleMidi(midi); // asignar noteOn/noteOff a voces

    if (layerSettings == nullptr)
        return;

    const int numSamples = buffer.getNumSamples();
    auto* outL = buffer.getWritePointer(0);
    auto* outR = buffer.getNumChannels() > 1 ? buffer.getWritePointer(1)
                                            : buffer.getWritePointer(0);

    const LayerASettings& settings = *layerSettings;

    for (int v = 0; v < maxVoices; ++v)
    {
        auto& voice = voices[v];
        if (! voice.isActive())
            continue;

        voice.process(outL, outR, numSamples, sampleRate, settings);
    }
}
Con esto tienes:

Hook claro para conectar el preset Juno MVP (via setPreset) y los macros APVTS (via LayerASettings).

Un engine VA muy recortado, pero coherente con tu diseño global de OMEGA.
​

¿Quieres que en el siguiente paso escriba el handleMidi mínimo (note on/off, voice stealing básica) para completar el loop?


Te propongo un handleMidi muy mínimo pero bien alineado con MIDI 1.0: Note On/Off (incluyendo Note On vel 0), All Notes Off (CC 123), All Sound Off (CC 120) y pitch bend global por canal.

Asumo:

Solo usas un canal MIDI (p.ej. 1) en el MVP.

Un pool fijo de voces voices[0..maxVoices-1].

Voice stealing FIFO (steal la voz más antigua activa).

Firma de ayuda en VoiceRuntimeVA
Añade timestamp para stealing y helpers:

cpp
// VoiceRuntimeVA.h (añadidos)
struct alignas(64) VoiceRuntimeVA
{
    struct State
    {
        std::atomic<bool>  active   { false };
        std::atomic<int>   midiNote { -1 };
        std::atomic<float> velocity { 0.0f };
        std::atomic<uint64_t> startTime { 0 }; // para voice stealing
    } state;

    void noteOn(int midiNote, float vel, uint64_t time) noexcept
    {
        state.midiNote.store(midiNote, std::memory_order_relaxed);
        state.velocity.store(vel, std::memory_order_relaxed);
        state.startTime.store(time, std::memory_order_relaxed);
        state.active.store(true, std::memory_order_release);
        // reset env, fases...
    }

    void noteOff() noexcept
    {
        // cambia a fase de release; active false cuando termine
    }

    int getMidiNote() const noexcept
    {
        return state.midiNote.load(std::memory_order_relaxed);
    }

    uint64_t getStartTime() const noexcept
    {
        return state.startTime.load(std::memory_order_relaxed);
    }

    // ... resto igual
};
Estado en VirtualAnalogEngine
cpp
// VirtualAnalogEngine.h (añadidos)
class VirtualAnalogEngine
{
public:
    // ...

    void setMidiChannel(int ch) noexcept { midiChannel = juce::jlimit(1, 16, ch); }

private:
    int midiChannel { 1 }; // 1–16

    uint64_t noteCounter { 0 }; // timestamp monotonico para voice stealing

    void handleMidi(const juce::MidiBuffer& midi);
    void allNotesOff() noexcept;
    void allSoundOff() noexcept;
    VoiceRuntimeVA* findFreeVoice() noexcept;
    VoiceRuntimeVA* findVoiceForNote(int midiNote) noexcept;
};
Implementación de handleMidi
cpp
void VirtualAnalogEngine::handleMidi(const juce::MidiBuffer& midi)
{
    for (const auto metadata : midi)
    {
        const auto msg  = metadata.getMessage();
        const int  chan = msg.getChannel(); // 1–16

        if (chan != midiChannel)
            continue;

        if (msg.isNoteOn())
        {
            const int   note = msg.getNoteNumber();
            const float vel  = msg.getFloatVelocity(); // 0..1

            // MIDI estándar: Note On vel=0 = Note Off
            if (vel <= 0.0f)
            {
                if (auto* v = findVoiceForNote(note))
                    v->noteOff();
            }
            else
            {
                ++noteCounter;
                if (auto* v = findVoiceForNote(note))
                {
                    v->noteOn(note, vel, noteCounter);
                }
                else
                {
                    auto* voice = findFreeVoice();
                    if (voice == nullptr)
                    {
                        // voice stealing FIFO: roba la voz activa más antigua
                        uint64_t oldestTime = std::numeric_limits<uint64_t>::max();
                        VoiceRuntimeVA* oldest = nullptr;

                        for (int i = 0; i < maxVoices; ++i)
                        {
                            auto& cand = voices[i];
                            if (! cand.isActive())
                                continue;

                            const auto t = cand.getStartTime();
                            if (t < oldestTime)
                            {
                                oldestTime = t;
                                oldest = &cand;
                            }
                        }
                        voice = oldest;
                    }

                    if (voice != nullptr)
                        voice->noteOn(note, vel, noteCounter);
                }
            }
        }
        else if (msg.isNoteOff())
        {
            const int note = msg.getNoteNumber();
            if (auto* v = findVoiceForNote(note))
                v->noteOff();
        }
        else if (msg.isAllNotesOff())
        {
            allNotesOff();
        }
        else if (msg.isAllSoundOff())
        {
            allSoundOff();
        }
        else if (msg.isPitchWheel())
        {
            const int value14 = msg.getPitchWheelValue(); // 0..16383
            // centro 8192 → 0 semitonos, rango ±2 semis típico
            constexpr float rangeSemis = 2.0f;
            const float norm = (value14 - 8192) / 8192.0f; // -1..+1
            globalPitchBendSemis = juce::jlimit(-rangeSemis, rangeSemis, norm * rangeSemis);
        }
        // (Opcional futuro: CC1 ModWheel → LFO depth, CC64 Hold, etc.)
    }
}
Helpers de voces
cpp
VoiceRuntimeVA* VirtualAnalogEngine::findFreeVoice() noexcept
{
    for (int i = 0; i < maxVoices; ++i)
        if (! voices[i].isActive())
            return &voices[i];
    return nullptr;
}

VoiceRuntimeVA* VirtualAnalogEngine::findVoiceForNote(int midiNote) noexcept
{
    for (int i = 0; i < maxVoices; ++i)
    {
        auto& v = voices[i];
        if (v.isActive() && v.getMidiNote() == midiNote)
            return &v;
    }
    return nullptr;
}

void VirtualAnalogEngine::allNotesOff() noexcept
{
    for (int i = 0; i < maxVoices; ++i)
        voices[i].noteOff(); // pasa a release; respeta tiempos de release
}

void VirtualAnalogEngine::allSoundOff() noexcept
{
    for (int i = 0; i < maxVoices; ++i)
    {
        voices[i].state.active.store(false, std::memory_order_release);
        // opcional: limpiar buffers internos / env al instante
    }
}
En VoiceRuntimeVA::process, cuando calcules la frecuencia del DCO, aplicas globalPitchBendSemis además de midiNote y posibles modulaciones.

Con esto:

Cumples Note On/Off estándar, incluida la convención de Note On vel=0.
​

Respondes a All Notes Off y All Sound Off según MIDI 1.0.

Tienes voice stealing FIFO razonable para un poly synth clásico.
​

¿Quieres que el siguiente ajuste sea integrar globalPitchBendSemis y LFO (rate/depth de LayerASettings) en el cálculo de pitch dentro de VoiceRuntimeVA::process?


Para el MVP Juno VA, el pitch final de cada voz puede ser:

f
