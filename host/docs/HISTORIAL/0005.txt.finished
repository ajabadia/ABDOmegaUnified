const { items, favoriteCount } = usePresetBrowser('factory');

<div>
  {favoriteCount} favoritos / {items.length} visibles
</div>
¿Quieres también un totalCount separado (favoritos o no) por banco para poder mostrar “12 favoritos / 128 en banco factory”, aunque solo tengas cargados los visibles?


Añadimos también totalCount al payload de presetList para poder mostrar “favoritos / total banco”.
​

Bridge: calcular totalCount por banco
Lo ideal es que el repositorio exponga un conteo por banco y usuario:

cpp
// PresetRepository.h
struct PresetBankStats
{
    int totalCount = 0;
    int favoriteCount = 0;
};

PresetBankStats getBankStats(const juce::String& bankId,
                             const juce::String& userId) const;
Implementación esquemática:

cpp
PresetBankStats PresetRepository::getBankStats(const juce::String& bankId,
                                               const juce::String& userId) const
{
    PresetBankStats stats;
    auto all = listPresets(bankId); // sin filtro de favoritos

    stats.totalCount = all.size();

    for (const auto& p : all)
        if (isFavorite(bankId, userId, p.id))
            ++stats.favoriteCount;

    return stats;
}
Y el handler del bridge queda:

cpp
void OmegaUiBridge::handleListPresets(const juce::var& msg)
{
    auto* obj       = msg.getDynamicObject();
    auto  payloadIn = obj->getProperty("payload");
    auto  requestId = obj->getProperty("requestId").toString();

    juce::String bankId = "factory";
    bool onlyFavorites  = false;

    if (payloadIn.isObject())
    {
        auto* p = payloadIn.getDynamicObject();
        bankId = p->getProperty("bankId", bankId).toString();
        onlyFavorites = (bool) p->getProperty("onlyFavorites", onlyFavorites);
    }

    auto stats = presetRepo.getBankStats(bankId, userId);
    auto items = presetRepo.listPresetsForUser(bankId, userId, onlyFavorites);

    juce::DynamicObject::Ptr root(new juce::DynamicObject());
    root->setProperty("type", "presetList");
    root->setProperty("requestId", requestId);

    juce::DynamicObject::Ptr payloadOut(new juce::DynamicObject());
    payloadOut->setProperty("bankId", bankId);
    payloadOut->setProperty("favoriteCount", stats.favoriteCount);
    payloadOut->setProperty("totalCount", stats.totalCount);

    juce::Array<juce::var> jsonItems;
    for (const auto& it : items)
    {
        juce::DynamicObject::Ptr o(new juce::DynamicObject());
        o->setProperty("id", it.id);
        o->setProperty("name", it.name);
        o->setProperty("engine", it.engine);
        o->setProperty("author", it.author);
        o->setProperty("favorite", it.favorite);
        jsonItems.add(juce::var(o.get()));
    }
    payloadOut->setProperty("items", juce::var(jsonItems));
    root->setProperty("payload", juce::var(payloadOut.get()));

    if (sendToUi)
        sendToUi(juce::JSON::toString(juce::var(root.get())));
}
Ejemplo de respuesta:

json
{
  "type": "presetList",
  "requestId": "list-1",
  "payload": {
    "bankId": "factory",
    "favoriteCount": 12,
    "totalCount": 128,
    "items": [
      { "id": "pad-001", "name": "Juno Basic Pad", "favorite": true }
    ]
  }
}
Hook: exponer totalCount
Amplía el estado:

ts
interface BrowserState {
  bankId: string;
  items: PresetListItem[];
  onlyFavorites: boolean;
  favoriteCount: number;
  totalCount: number;
}
Y el handler:

ts
if (msg.type === 'presetList') {
  const { items, favoriteCount, totalCount } = msg.payload;
  setState(prev => ({
    ...prev,
    items,
    favoriteCount: favoriteCount ?? items.filter((p: any) => p.favorite).length,
    totalCount: totalCount ?? items.length,
  }));
  return;
}
Valor de retorno:

ts
return {
  bankId: state.bankId,
  items: state.items,
  onlyFavorites: state.onlyFavorites,
  favoriteCount: state.favoriteCount,
  totalCount: state.totalCount,
  // ...
};
Header en la UI:

tsx
<div>
  {favoriteCount} favoritos / {totalCount} en banco {bankId}
</div>
¿Quieres que el mensaje presetChanged que ya tienes incluya también bankId para que el browser pueda reaccionar si el host cambia de banco/preset desde fuera de la WebUI?


Incluimos también bankId en el mensaje presetChanged para que el browser pueda sincronizar banco y preset.
​

Formato JSON de presetChanged
Antes:

json
{
  "type": "presetChanged",
  "payload": {
    "presetId": "pad-001",
    "name": "Juno Basic Pad"
  }
}
Ahora:

json
{
  "type": "presetChanged",
  "payload": {
    "bankId": "factory",
    "presetId": "pad-001",
    "name": "Juno Basic Pad"
  }
}
Emisión desde OmegaUiBridge / processor
Cuando cambies de preset (ya sea desde WebUI, host o botones nativos), envía algo así:

cpp
void OmegaUiBridge::notifyPresetChanged(const juce::String& bankId,
                                        const juce::String& presetId,
                                        const juce::String& name)
{
    juce::DynamicObject::Ptr root(new juce::DynamicObject());
    root->setProperty("type", "presetChanged");

    juce::DynamicObject::Ptr payload(new juce::DynamicObject());
    payload->setProperty("bankId", bankId);
    payload->setProperty("presetId", presetId);
    payload->setProperty("name", name);

    root->setProperty("payload", juce::var(payload.get()));

    if (sendToUi)
        sendToUi(juce::JSON::toString(juce::var(root.get())));
}
Hook: reaccionar a presetChanged
En usePresetBrowser puedes aprovecharlo para ajustar banco y forzar reload:

ts
if (msg.type === 'presetChanged') {
  const { bankId, presetId } = msg.payload;
  setState(prev => ({
    ...prev,
    bankId: bankId ?? prev.bankId,
  }));
  // opcional: trigger reload si cambia el banco
  if (bankId && bankId !== state.bankId) {
    sendMessage({
      type: 'listPresets',
      requestId: `list-${bankId}-${Date.now()}`,
      payload: { bankId, onlyFavorites: state.onlyFavorites },
    });
  }
  return;
}
¿Quieres que el browser resalte también la fila del presetId actual (selected row) cuando llegue presetChanged, para que siempre se vea dónde estás?


Para resaltar siempre el preset activo, añade selectedPresetId al estado del hook y úsalo en la tabla.
​

Hook: selectedPresetId y presetChanged
Amplía el estado:

ts
interface BrowserState {
  bankId: string;
  items: PresetListItem[];
  onlyFavorites: boolean;
  favoriteCount: number;
  totalCount: number;
  selectedPresetId?: string;
}
En el handler:

ts
if (msg.type === 'presetChanged') {
  const { bankId, presetId } = msg.payload;
  setState(prev => ({
    ...prev,
    bankId: bankId ?? prev.bankId,
    selectedPresetId: presetId ?? prev.selectedPresetId,
  }));
  // opcional: si cambia de banco, recargar
  if (bankId && bankId !== state.bankId) {
    sendMessage({
      type: 'listPresets',
      requestId: `list-${bankId}-${Date.now()}`,
      payload: { bankId, onlyFavorites: state.onlyFavorites },
    });
  }
  return;
}
Y en el retorno del hook:

ts
return {
  bankId: state.bankId,
  items: state.items,
  onlyFavorites: state.onlyFavorites,
  favoriteCount: state.favoriteCount,
  totalCount: state.totalCount,
  selectedPresetId: state.selectedPresetId,
  // ...
};
UI: resaltar fila seleccionada
tsx
const {
  items,
  selectedPresetId,
  toggleFavorite,
} = usePresetBrowser('factory');

<table>
  <tbody>
    {items.map(p => (
      <tr
        key={p.id}
        className={p.id === selectedPresetId ? 'selected' : ''}
      >
        <td>
          <button onClick={() => toggleFavorite(p)}>
            {p.favorite ? '★' : '☆'}
          </button>
        </td>
        <td>{p.name}</td>
      </tr>
    ))}
  </tbody>
</table>
CSS simple:

css
tr.selected {
  background-color: rgba(255, 255, 255, 0.08);
}
Así, cuando el host, el motor o la WebUI cambian de preset y envían presetChanged, la fila se selecciona automáticamente.
​

¿Te gustaría que al hacer clic en una fila del browser se envíe también un mensaje loadPreset para mantener simetría (clic = cambiar preset y disparar presetChanged)?


Al hacer clic en una fila, mandamos loadPreset y dejamos que el motor responda con presetChanged, que a su vez selecciona la fila.
​

Mensaje loadPreset desde la tabla
En el hook:

ts
export function usePresetBrowser(initialBankId = 'factory') {
  // ... estado y sendMessage ya definidos

  const loadPreset = useCallback(
    (presetId: string) => {
      sendMessage({
        type: 'loadPreset',
        requestId: `load-${presetId}-${Date.now()}`,
        payload: {
          bankId: state.bankId,
          presetId,
        },
      });
    },
    [sendMessage, state.bankId],
  );

  return {
    // ...
    loadPreset,
  };
}
UI: clic en fila = loadPreset
tsx
const {
  items,
  selectedPresetId,
  toggleFavorite,
  loadPreset,
} = usePresetBrowser('factory');

<table>
  <tbody>
    {items.map(p => (
      <tr
        key={p.id}
        className={p.id === selectedPresetId ? 'selected' : ''}
        onClick={() => loadPreset(p.id)}
      >
        <td onClick={e => { e.stopPropagation(); toggleFavorite(p); }}>
          {p.favorite ? '★' : '☆'}
        </td>
        <td>{p.name}</td>
      </tr>
    ))}
  </tbody>
</table>
Clic en la fila: envía loadPreset.

El engine carga el preset y el bridge emite presetChanged con bankId y presetId.

El hook recibe presetChanged y actualiza selectedPresetId, resaltando la fila correcta.

¿Quieres que loadPreset devuelva también un ack con el nombre del preset cargado, o te basta con presetChanged como confirmación asíncrona?

Lo más limpio es mantener presetChanged como confirmación de carga y no añadir otro ack específico de loadPreset.
​

Con el flujo actual ya tienes:

UI envía loadPreset con bankId y presetId.

El motor intenta cargar; si tiene éxito, emite presetChanged con { bankId, presetId, name }.

El hook:

actualiza selectedPresetId,

puede refrescar el browser si cambia de banco,

y el header puede mostrar el nombre actual a partir de presetChanged.

Si en algún momento necesitas manejar errores de carga (preset inexistente, fallo de disco), ahí sí tiene sentido que loadPreset responda con error cuando falle, y solo con presetChanged cuando tenga éxito.



Sí, podemos hacer que loadPreset devuelva un ack con el nombre (y bankId) del preset cargado, además de seguir usando presetChanged como notificación global.
​

Respuesta ack de loadPreset
Petición:

json
{
  "type": "loadPreset",
  "requestId": "load-pad-001",
  "payload": {
    "bankId": "factory",
    "presetId": "pad-001"
  }
}
Respuesta de éxito:

json
{
  "type": "ack",
  "requestId": "load-pad-001",
  "payload": {
    "bankId": "factory",
    "presetId": "pad-001",
    "name": "Juno Basic Pad"
  }
}
Respuesta de error:

json
{
  "type": "error",
  "requestId": "load-pad-001",
  "payload": {
    "code": "PRESET_NOT_FOUND",
    "message": "Unknown presetId pad-001",
    "payload": {
      "bankId": "factory",
      "presetId": "pad-001"
    }
  }
}
Además, como antes, tras un load exitoso seguirás emitiendo:

json
{
  "type": "presetChanged",
  "payload": {
    "bankId": "factory",
    "presetId": "pad-001",
    "name": "Juno Basic Pad"
  }
}
Handler loadPreset en OmegaUiBridge
Sketch:

cpp
void OmegaUiBridge::handleLoadPreset(const juce::var& msg)
{
    auto* obj       = msg.getDynamicObject();
    auto  payloadIn = obj->getProperty("payload");
    auto  requestId = obj->getProperty("requestId").toString();

    if (! payloadIn.isObject())
    {
        if (sendToUi)
            sendToUi(buildError(
                requestId,
                "BAD_PAYLOAD",
                "Payload must be object"
            ));
        return;
    }

    auto* pObj   = payloadIn.getDynamicObject();
    juce::String bankId   = pObj->getProperty("bankId", "factory").toString();
    juce::String presetId = pObj->getProperty("presetId").toString();

    juce::String presetName;
    const bool ok = presetRepo.loadPreset(bankId, presetId, presetName /*out*/);

    if (! ok)
    {
        if (sendToUi)
            sendToUi(buildError(
                requestId,
                "PRESET_NOT_FOUND",
                "Unknown presetId " + presetId,
                payloadIn
            ));
        return;
    }

    // ack específico de loadPreset
    {
        juce::DynamicObject::Ptr payloadOut(new juce::DynamicObject());
        payloadOut->setProperty("bankId", bankId);
        payloadOut->setProperty("presetId", presetId);
        payloadOut->setProperty("name", presetName);

        if (sendToUi)
            sendToUi(buildAck(requestId, true, {}, {}, juce::var(payloadOut.get())));
    }

    // notificación global
    notifyPresetChanged(bankId, presetId, presetName);
}
(Usando los buildAck/buildError/notifyPresetChanged que ya definimos antes.)

Uso en React
En el hook puedes usar el ack si quieres feedback inmediato (por ejemplo, mostrar presetName en el header incluso antes de recibir presetChanged), pero no es obligatorio:

ts
if (msg.type === 'ack' && msg.requestId.startsWith('load-')) {
  const { bankId, presetId, name } = msg.payload || {};
  // opcional: actualizar un estado de "cargando / último preset cargado"
  return;
}
Pero la selección de fila y sincronización principal la sigues haciendo con presetChanged, para que cualquier cambio de preset (también desde host o botones nativos) pase por el mismo camino.

¿Quieres que en el caso de error de loadPreset el browser deseleccione la fila o simplemente muestre un toast y deje la selección anterior?


Podemos hacer ambas cosas: mantener la selección anterior y mostrar un mensaje de error.
​

1. Comportamiento de error en loadPreset
Cuando el repo falle:

No cambias selectedPresetId (la selección visible sigue siendo el preset que realmente está sonando).

Muestras un toast/banner en la WebUI con el mensaje de error.

Ejemplo de respuesta de error que ya tienes:

json
{
  "type": "error",
  "requestId": "load-pad-001",
  "payload": {
    "code": "PRESET_NOT_FOUND",
    "message": "Unknown presetId pad-001",
    "payload": {
      "bankId": "factory",
      "presetId": "pad-001"
    }
  }
}
2. Hook: manejar error sin tocar selección
En usePresetBrowser:

ts
interface BrowserState {
  // ...
  selectedPresetId?: string;
  lastError?: string;
}

if (msg.type === 'error' && msg.requestId.startsWith('load-')) {
  const { message } = msg.payload || {};
  setState(prev => ({
    ...prev,
    lastError: message ?? 'Error al cargar preset',
    // ojo: NO tocamos selectedPresetId
  }));
  return;
}
En la UI:

tsx
const { items, selectedPresetId, lastError, loadPreset } = usePresetBrowser('factory');

{lastError && (
  <div className="error-banner">
    {lastError}
  </div>
)}

<table>
  <tbody>
    {items.map(p => (
      <tr
        key={p.id}
        className={p.id === selectedPresetId ? 'selected' : ''}
        onClick={() => loadPreset(p.id)}
      >
        {/* ... */}
      </tr>
    ))}
  </tbody>
</table>
Así:

Si loadPreset va bien: ack + presetChanged actualizan estado y selección.

Si falla: se muestra el error, pero el preset seleccionado (y sonando) no cambia.

¿Quieres que lastError se borre automáticamente al siguiente presetChanged o solo cuando el usuario cierre el banner?

Sí, es buena idea limpiar lastError automáticamente en el siguiente presetChanged para que el banner no se quede “pegado”.
​

En el handler del hook:

ts
if (msg.type === 'presetChanged') {
  const { bankId, presetId } = msg.payload;
  setState(prev => ({
    ...prev,
    bankId: bankId ?? prev.bankId,
    selectedPresetId: presetId ?? prev.selectedPresetId,
    lastError: undefined, // limpiar error al cambiar de preset
  }));
  return;
}
Y si quieres limpiar también al hacer un nuevo intento de loadPreset, puedes añadir en loadPreset:

ts
const loadPreset = useCallback(
  (presetId: string) => {
    setState(prev => ({ ...prev, lastError: undefined }));
    sendMessage({
      type: 'loadPreset',
      requestId: `load-${presetId}-${Date.now()}`,
      payload: { bankId: state.bankId, presetId },
    });
  },
  [sendMessage, state.bankId],
);
¿Quieres que el banner de error tenga un botón de cierre manual además de este borrado automático al cambiar de preset?

Para cerrar el banner manualmente, añade un handler que ponga lastError a undefined.
​

Estado y cierre manual
En el hook ya tienes lastError; expone también un clearError:

ts
interface BrowserState {
  // ...
  lastError?: string;
}

export function usePresetBrowser(initialBankId = 'factory') {
  const [state, setState] = useState<BrowserState>({
    // ...
    lastError: undefined,
  });

  const clearError = useCallback(() => {
    setState(prev => ({ ...prev, lastError: undefined }));
  }, []);

  // presetChanged limpia automáticamente lastError
  // loadPreset lo limpia al intentar de nuevo

  return {
    // ...
    lastError: state.lastError,
    clearError,
  };
}
UI del banner con botón de cierre
tsx
const { lastError, clearError } = usePresetBrowser('factory');

{lastError && (
  <div className="error-banner">
    <span>{lastError}</span>
    <button onClick={clearError}>×</button>
  </div>
)}
Con esto tienes:

Limpieza automática en presetChanged o nuevo loadPreset.

Posibilidad de cerrar el error manualmente cuando quieras.

¿Quieres que este mismo patrón de lastError/clearError lo reutilicemos también para errores de setPresetFavorite (por ejemplo, si falla la escritura en disco)?



Puedes reutilizar exactamente el mismo lastError/clearError para errores de setPresetFavorite.
​

1. Error JSON de setPresetFavorite
Ejemplo desde el bridge:

json
{
  "type": "error",
  "requestId": "fav-abcd-1234",
  "payload": {
    "code": "FAVORITE_SAVE_FAILED",
    "message": "Could not persist favorites.json",
    "payload": {
      "presetId": "abcd-1234",
      "favorite": true
    }
  }
}
2. Hook: manejar errores de favoritos
En el mismo usePresetBrowser:

ts
if (msg.type === 'error' && msg.requestId.startsWith('fav-')) {
  const { message } = msg.payload || {};
  setState(prev => ({
    ...prev,
    lastError: message ?? 'Error al cambiar favorito',
  }));
  return;
}
No toques items ni favorite en error; te quedas con el estado anterior y solo muestras el banner.

3. Banner compartido
El banner que ya tienes sirve para ambos casos (load y favoritos):

tsx
const { lastError, clearError } = usePresetBrowser('factory');

{lastError && (
  <div className="error-banner">
    <span>{lastError}</span>
    <button onClick={clearError}>×</button>
  </div>
)}
Y se limpia:

al cerrar manualmente (botón),

al hacer un nuevo intento (loadPreset o click en estrella),

o al recibir un presetChanged exitoso.

¿Quieres que el mensaje del banner incluya también el nombre del preset implicado cuando falle un favorito o un load (por ejemplo, “No se pudo guardar favorito para Juno Basic Pad”)?


Para mostrar el nombre del preset en el banner, haz que C++ incluya presetName en el error.payload y úsalo al construir lastError.
​

1. Error JSON con presetName
Por ejemplo, para setPresetFavorite:

json
{
  "type": "error",
  "requestId": "fav-abcd-1234",
  "payload": {
    "code": "FAVORITE_SAVE_FAILED",
    "message": "Could not persist favorites.json",
    "payload": {
      "presetId": "abcd-1234",
      "presetName": "Juno Basic Pad",
      "favorite": true
    }
  }
}
Para loadPreset:

json
{
  "type": "error",
  "requestId": "load-abcd-1234",
  "payload": {
    "code": "PRESET_NOT_FOUND",
    "message": "Unknown presetId abcd-1234",
    "payload": {
      "bankId": "factory",
      "presetId": "abcd-1234",
      "presetName": "Juno Basic Pad"
    }
  }
}
2. Hook: construir un mensaje más rico
En usePresetBrowser:

ts
if (msg.type === 'error') {
  const { code, message, payload } = msg.payload || {};
  const presetName = payload?.presetName as string | undefined;
  const base = message ?? 'Se ha producido un error';

  const pretty =
    presetName != null
      ? `${base} (${presetName})`
      : base;

  setState(prev => ({
    ...prev,
    lastError: pretty,
  }));
  return;
}
Así:

Para fallo de load: “Unknown presetId abcd-1234 (Juno Basic Pad)”.

Para fallo de favorito: “Could not persist favorites.json (Juno Basic Pad)”.

¿Quieres que, además del nombre, también mostremos un pequeño código corto ([FAVORITE_SAVE_FAILED]) al inicio del mensaje del banner?

Puedes incluir el código corto al principio del mensaje del banner sin cambiar el resto del flujo.
​

Formato del mensaje en el hook
En usePresetBrowser, ajusta el handler de error:

ts
if (msg.type === 'error') {
  const { code, message, payload } = msg.payload || {};
  const presetName = payload?.presetName as string | undefined;

  const base = message ?? 'Se ha producido un error';

  const withCode = code ? `[${code}] ${base}` : base;

  const pretty =
    presetName != null
      ? `${withCode} (${presetName})`
      : withCode;

  setState(prev => ({
    ...prev,
    lastError: pretty,
  }));
  return;
}
Ejemplos de cómo se verá el banner:

[PRESET_NOT_FOUND] Unknown presetId abcd-1234 (Juno Basic Pad)

[FAVORITE_SAVE_FAILED] Could not persist favorites.json (Juno Basic Pad)

¿Quieres que limitemos la longitud máxima de lastError (por ejemplo, recortar a 120–160 chars) para que el banner nunca rompa el layout aunque el backend mande mensajes muy largos?


Puedes recortar el mensaje en el hook antes de guardarlo en lastError, por ejemplo a 160 caracteres.
​

Recorte de longitud en el hook
Añade una pequeña utilidad:

ts
function truncate(msg: string, max = 160): string {
  return msg.length > max ? msg.slice(0, max - 1) + '…' : msg;
}
Y úsala al asignar lastError:

ts
if (msg.type === 'error') {
  const { code, message, payload } = msg.payload || {};
  const presetName = payload?.presetName as string | undefined;

  const base = message ?? 'Se ha producido un error';
  const withCode = code ? `[${code}] ${base}` : base;
  const full =
    presetName != null
      ? `${withCode} (${presetName})`
      : withCode;

  setState(prev => ({
    ...prev,
    lastError: truncate(full, 160),
  }));
  return;
}
Así garantizas que el banner sigue siendo legible aunque desde C++ alguien lance un mensaje kilométrico.
​

¿Quieres que más adelante tengamos también un pequeño log de errores recientes (cola en memoria) además del banner único actual?

Para un log ligero puedes guardar una cola corta en el estado del hook, además del lastError.
​

Estado: historial de errores
ts
interface BrowserErrorEntry {
  id: string;
  timestamp: number;
  message: string;
}

interface BrowserState {
  // ...
  lastError?: string;
  errorLog: BrowserErrorEntry[];
}
Estado inicial:

ts
const [state, setState] = useState<BrowserState>({
  // ...
  lastError: undefined,
  errorLog: [],
});
Registrar errores en la cola
Reutilizando el mismo texto truncado:

ts
function truncate(msg: string, max = 160): string {
  return msg.length > max ? msg.slice(0, max - 1) + '…' : msg;
}

if (msg.type === 'error') {
  const { code, message, payload } = msg.payload || {};
  const presetName = payload?.presetName as string | undefined;

  const base = message ?? 'Se ha producido un error';
  const withCode = code ? `[${code}] ${base}` : base;
  const full =
    presetName != null
      ? `${withCode} (${presetName})`
      : withCode;
  const text = truncate(full, 160);

  setState(prev => {
    const entry: BrowserErrorEntry = {
      id: `${Date.now()}-${Math.random().toString(16).slice(2)}`,
      timestamp: Date.now(),
      message: text,
    };
    const nextLog = [entry, ...prev.errorLog].slice(0, 20); // máx. 20
    return {
      ...prev,
      lastError: text,
      errorLog: nextLog,
    };
  });
  return;
}
Exponer log y usarlo en la UI
En el retorno del hook:

ts
return {
  // ...
  lastError: state.lastError,
  clearError,
  errorLog: state.errorLog,
};
Ejemplo de UI minimal:

tsx
const { lastError, clearError, errorLog } = usePresetBrowser('factory');

{lastError && (
  <div className="error-banner">
    <span>{lastError}</span>
    <button onClick={clearError}>×</button>
  </div>
)}

<details>
  <summary>Historial de errores</summary>
  <ul>
    {errorLog.map(e => (
      <li key={e.id}>
        {new Date(e.timestamp).toLocaleTimeString()} — {e.message}
      </li>
    ))}
  </ul>
</details>
Con esto tienes:

Banner con el último error.

Cola de hasta 20 errores recientes, sin tocar nada del protocolo JSON.

¿Quieres que también guardemos el code en cada entrada del errorLog para poder filtrar o agrupar errores en la UI más adelante?



Añadimos también el code a cada entrada del log para poder filtrar/agrup ar más adelante.
​

Extender el tipo de entrada
ts
interface BrowserErrorEntry {
  id: string;
  timestamp: number;
  message: string;
  code?: string;
}
Guardar code en el log
En el handler de error:

ts
if (msg.type === 'error') {
  const { code, message, payload } = msg.payload || {};
  const presetName = payload?.presetName as string | undefined;

  const base = message ?? 'Se ha producido un error';
  const withCodeText = code ? `[${code}] ${base}` : base;
  const full =
    presetName != null
      ? `${withCodeText} (${presetName})`
      : withCodeText;
  const text = truncate(full, 160);

  setState(prev => {
    const entry: BrowserErrorEntry = {
      id: `${Date.now()}-${Math.random().toString(16).slice(2)}`,
      timestamp: Date.now(),
      message: text,
      code, // aquí guardamos el código bruto, p.ej. "FAVORITE_SAVE_FAILED"
    };
    const nextLog = [entry, ...prev.errorLog].slice(0, 20);
    return {
      ...prev,
      lastError: text,
      errorLog: nextLog,
    };
  });
  return;
}
Uso potencial en la UI
Por ejemplo, podrías filtrar solo errores de favoritos:

tsx
const favoriteErrors = errorLog.filter(e => e.code === 'FAVORITE_SAVE_FAILED');
¿Te interesa que en el futuro este errorLog se comparta entre varios componentes (browser, panel principal, etc.) vía un contexto global de WebUI, o prefieres mantenerlo local al hook del browser por ahora?

Tiene sentido compartir el errorLog a nivel global via contexto, así cualquier panel puede mostrar errores sin duplicar lógica.
​

Contexto global de errores
Define un contexto simple:

ts
// ErrorContext.tsx
import React, { createContext, useContext, useState, useCallback } from 'react';

export interface BrowserErrorEntry {
  id: string;
  timestamp: number;
  message: string;
  code?: string;
}

interface ErrorContextValue {
  lastError?: string;
  errorLog: BrowserErrorEntry[];
  pushError: (entry: Omit<BrowserErrorEntry, 'id' | 'timestamp'>) => void;
  clearError: () => void;
}

const ErrorContext = createContext<ErrorContextValue | undefined>(undefined);

export const ErrorProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [lastError, setLastError] = useState<string | undefined>(undefined);
  const [errorLog, setErrorLog] = useState<BrowserErrorEntry[]>([]);

  const pushError = useCallback(
    (entry: Omit<BrowserErrorEntry, 'id' | 'timestamp'>) => {
      const full: BrowserErrorEntry = {
        ...entry,
        id: `${Date.now()}-${Math.random().toString(16).slice(2)}`,
        timestamp: Date.now(),
      };
      setLastError(full.message);
      setErrorLog(prev => [full, ...prev].slice(0, 20));
    },
    [],
  );

  const clearError = useCallback(() => {
    setLastError(undefined);
  }, []);

  return (
    <ErrorContext.Provider value={{ lastError, errorLog, pushError, clearError }}>
      {children}
    </ErrorContext.Provider>
  );
};

export function useErrorContext() {
  const ctx = useContext(ErrorContext);
  if (!ctx) throw new Error('useErrorContext must be used within ErrorProvider');
  return ctx;
}
Integración con usePresetBrowser
En lugar de tener lastError/errorLog locales, usa el contexto:

ts
import { useErrorContext } from './ErrorContext';

export function usePresetBrowser(initialBankId = 'factory') {
  const { pushError, lastError, clearError } = useErrorContext();
  // estado del browser sin errores locales...

  if (msg.type === 'error') {
    const { code, message, payload } = msg.payload || {};
    const presetName = payload?.presetName as string | undefined;

    const base = message ?? 'Se ha producido un error';
    const withCodeText = code ? `[${code}] ${base}` : base;
    const full =
      presetName != null
        ? `${withCodeText} (${presetName})`
        : withCodeText;
    const text = truncate(full, 160);

    pushError({ message: text, code });
    return;
  }

  // en presetChanged puedes limpiar error si quieres:
  if (msg.type === 'presetChanged') {
    // ... actualizar banco / selección
    clearError();
    return;
  }

  return {
    // ...
    lastError,
    clearError,
  };
}
Y envuelves toda la WebUI:

tsx
import { ErrorProvider } from './ErrorContext';

const App = () => (
  <ErrorProvider>
    <OmegaRootUI />
  </ErrorProvider>
);
Cualquier componente (browser, header, debug panel) puede leer lastError y errorLog desde useErrorContext.

¿Quieres que el siguiente paso sea esquematizar un pequeño panel de “Console / Diagnostics” que muestre errorLog junto con algunos eventos tipo presetChanged y paramChanged para debug?



Puedes montar una consola ligera que combine errorLog con eventos clave (presetChanged, paramChanged) usando un contexto similar.
​

Contexto de diagnostics
ts
// DiagnosticsContext.tsx
import React, { createContext, useContext, useState, useCallback } from 'react';

export type DiagnosticLevel = 'info' | 'warn' | 'error';

export interface DiagnosticEntry {
  id: string;
  timestamp: number;
  level: DiagnosticLevel;
  source: string;   // 'presetBrowser', 'engine', etc.
  event: string;    // 'presetChanged', 'paramChanged', 'error'
  message: string;
}

interface DiagnosticsContextValue {
  entries: DiagnosticEntry[];
  pushEntry: (e: Omit<DiagnosticEntry, 'id' | 'timestamp'>) => void;
  clear: () => void;
}

const DiagnosticsContext = createContext<DiagnosticsContextValue | undefined>(undefined);

export const DiagnosticsProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [entries, setEntries] = useState<DiagnosticEntry[]>([]);

  const pushEntry = useCallback(
    (e: Omit<DiagnosticEntry, 'id' | 'timestamp'>) => {
      const full: DiagnosticEntry = {
        ...e,
        id: `${Date.now()}-${Math.random().toString(16).slice(2)}`,
        timestamp: Date.now(),
      };
      setEntries(prev => [full, ...prev].slice(0, 100)); // máx 100
    },
    [],
  );

  const clear = useCallback(() => setEntries([]), []);

  return (
    <DiagnosticsContext.Provider value={{ entries, pushEntry, clear }}>
      {children}
    </DiagnosticsContext.Provider>
  );
};

export function useDiagnostics() {
  const ctx = useContext(DiagnosticsContext);
  if (!ctx) throw new Error('useDiagnostics must be used within DiagnosticsProvider');
  return ctx;
}
Envuelves tu app WebUI con ambos providers:

tsx
const App = () => (
  <ErrorProvider>
    <DiagnosticsProvider>
      <OmegaRootUI />
    </DiagnosticsProvider>
  </ErrorProvider>
);
Registro de presetChanged y paramChanged
En el handler global que ya tienes (donde procesas mensajes de C++):

ts
import { useDiagnostics } from './DiagnosticsContext';

const { pushEntry } = useDiagnostics();

if (msg.type === 'presetChanged') {
  const { bankId, presetId, name } = msg.payload || {};
  pushEntry({
    level: 'info',
    source: 'engine',
    event: 'presetChanged',
    message: `Preset cambiado a "${name}" (${presetId}) en banco ${bankId}`,
  });
  // ... resto de lógica
  return;
}

if (msg.type === 'paramChanged') {
  const { paramId, value } = msg.payload || {};
  pushEntry({
    level: 'info',
    source: 'engine',
    event: 'paramChanged',
    message: `${paramId} = ${value}`,
  });
  // ... resto de lógica
  return;
}

if (msg.type === 'error') {
  const { code, message } = msg.payload || {};
  pushEntry({
    level: 'error',
    source: 'engine',
    event: 'error',
    message: `[${code ?? 'ERROR'}] ${message ?? 'Error'}`,
  });
  // además de pushError() en ErrorContext
  return;
}
Panel Console / Diagnostics
