2. AceCatalog.h/cpp mínimo
Source/Core/Ace/AceCatalog.h:
​

cpp
#pragma once

#include <juce_core/juce_core.h>

namespace OmegaAce
{
    struct ParameterDef
    {
        juce::String id;
        juce::String label;
        juce::String unit;
        float min = 0.0f;
        float max = 1.0f;
        float defaultValue = 0.0f;
    };

    struct ModTarget
    {
        juce::String id;
        juce::String label;
        juce::String unit;
    };

    struct ComponentInfo
    {
        juce::String id;
        juce::String name;
        juce::String family;   // Oscillator, Filter, Envelope, LFO, FX
        juce::String engine;   // VirtualAnalog, etc.
        juce::String modelId;
        juce::String origin;
        juce::String status;   // active, deprecated, experimental
        int version = 1;
        juce::StringArray tags;
        juce::Array<ParameterDef> parameters;
        juce::Array<ModTarget> modulationTargets;
    };

    class AceCatalog
    {
    public:
        static std::unique_ptr<AceCatalog> createFromResources();

        const ComponentInfo* getComponent (const juce::String& id) const noexcept;
        juce::Array<const ComponentInfo*> listByFamilyAndEngine (const juce::String& family,
                                                                 const juce::String& engine) const;
        juce::String getFallbackId (const juce::String& family,
                                    const juce::String& engine) const;

    private:
        juce::HashMap<juce::String, ComponentInfo> components;
        // para MVP, un fallback fijo por familia/engine
        juce::HashMap<juce::String, juce::String> fallbackByKey;

        void addComponent (ComponentInfo&& info);
        void buildFallbacks();
    };
} // namespace OmegaAce
Source/Core/Ace/AceCatalog.cpp (parser YAML súper simple usando juce::File & juce::JSON si quieres, pero para arrancar puedes hacer stub que cargue sólo OSC-VA-001 “hardcodeado” y luego cambiarlo a YAML):
​

cpp
#include "AceCatalog.h"

namespace OmegaAce
{
    static juce::String makeFallbackKey (const juce::String& family,
                                         const juce::String& engine)
    {
        return family + "|" + engine;
    }

    std::unique_ptr<AceCatalog> AceCatalog::createFromResources()
    {
        auto catalog = std::make_unique<AceCatalog>();

        // MVP: hardcodear 1 componente para que el test sea real
        ComponentInfo osc;
        osc.id      = "OSC-VA-001";
        osc.name    = "Roland DCO";
        osc.family  = "Oscillator";
        osc.engine  = "VirtualAnalog";
        osc.modelId = "RolandJunoDco";
        osc.origin  = "Roland Juno-106";
        osc.status  = "active";
        osc.version = 1;
        osc.tags.addArray ({ "va", "roland", "juno", "dco" });

        ParameterDef pTune;
        pTune.id = "tune"; pTune.label = "Tune"; pTune.unit = "semitones";
        pTune.min = -24.0f; pTune.max = 24.0f; pTune.defaultValue = 0.0f;
        osc.parameters.add (pTune);

        catalog->addComponent (std::move (osc));
        catalog->buildFallbacks();

        return catalog;
    }

    void AceCatalog::addComponent (ComponentInfo&& info)
    {
        components.set (info.id, std::move (info));
    }

    const ComponentInfo* AceCatalog::getComponent (const juce::String& id) const noexcept
    {
        if (auto* ptr = components.getPointer (id))
            return ptr;
        return nullptr;
    }

    juce::Array<const ComponentInfo*> AceCatalog::listByFamilyAndEngine (const juce::String& family,
                                                                         const juce::String& engine) const
    {
        juce::Array<const ComponentInfo*> result;
        for (auto it = components.begin(); it != components.end(); ++it)
        {
            const auto& c = it.getValue();
            if (c.family == family && c.engine == engine)
                result.add (&c);
        }
        return result;
    }

    juce::String AceCatalog::getFallbackId (const juce::String& family,
                                            const juce::String& engine) const
    {
        auto key = makeFallbackKey (family, engine);
        if (auto* id = fallbackByKey.getPointer (key))
            return *id;
        return {};
    }

    void AceCatalog::buildFallbacks()
    {
        // MVP: usar primer componente de cada familia/engine como fallback
        for (auto it = components.begin(); it != components.end(); ++it)
        {
            const auto& c = it.getValue();
            auto key = makeFallbackKey (c.family, c.engine);
            if (! fallbackByKey.contains (key))
                fallbackByKey.set (key, c.id);
        }
    }
} // namespace OmegaAce
Más adelante sustituyes el hardcodeo por lectura real de YAML usando el índice que ya has definido.
​

3. Test real de AceCatalog
Tests/TestAceCatalog.cpp:
​

cpp
#include <catch2/catch_test_macros.hpp>
#include "Core/Ace/AceCatalog.h"

using namespace OmegaAce;

TEST_CASE("AceCatalog loads Juno DCO", "[ace][catalog]")
{
    auto catalog = AceCatalog::createFromResources();
    REQUIRE(catalog != nullptr);

    const auto* osc = catalog->getComponent ("OSC-VA-001");
    REQUIRE(osc != nullptr);

    REQUIRE(osc->name == "Roland DCO");
    REQUIRE(osc->family == "Oscillator");
    REQUIRE(osc->engine == "VirtualAnalog");

    auto list = catalog->listByFamilyAndEngine ("Oscillator", "VirtualAnalog");
    REQUIRE(list.size() >= 1);
    REQUIRE(list[0]->id == "OSC-VA-001");

    auto fallback = catalog->getFallbackId ("Oscillator", "VirtualAnalog");
    REQUIRE_FALSE(fallback.isEmpty());
}
Con esto ya tienes: test real, clase AceCatalog funcional y camino claro para cambiar el hardcodeo por carga YAML en cuanto quieras.






Puedes hacer ambos, pero en orden muy corto: primero OmegaPreset mínimo + test, y luego cambiar AceCatalog::createFromResources() a leer YAML real.
​

1. OmegaPreset mínimo + test
OmegaPreset.h
Source/Core/Preset/OmegaPreset.h:
​

cpp
#pragma once

#include <juce_core/juce_core.h>

namespace OmegaPreset
{
    struct Layer
    {
        juce::String id;   // "A", "B", ...
        juce::String name;
        float levelDb = 0.0f;
        float pan = 0.0f;
    };

    class OmegaPreset
    {
    public:
        OmegaPreset();
        explicit OmegaPreset (juce::ValueTree rootVT);

        static OmegaPreset createEmpty (const juce::String& engine);
        static OmegaPreset fromValueTree (juce::ValueTree tree);

        juce::ValueTree toValueTree() const;

        // Metadata
        juce::String getName() const;
        void setName (const juce::String& name);

        juce::String getEngine() const;
        void setEngine (const juce::String& engine);

        juce::Array<Layer> getLayers() const;
        void addLayer (const Layer& layer);

    private:
        juce::ValueTree root; // type "OMEGAPRESET"

        JUCE_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR (OmegaPreset)
    };
} // namespace OmegaPreset
OmegaPreset.cpp
Source/Core/Preset/OmegaPreset.cpp:
​

cpp
#include "OmegaPreset.h"

namespace
{
    constexpr const char* kTypePreset = "OMEGAPRESET";
    constexpr const char* kPropName   = "name";
    constexpr const char* kPropEngine = "engine";
    constexpr const char* kTypeLayer  = "LAYER";
    constexpr const char* kPropLayerId   = "id";
    constexpr const char* kPropLayerName = "layerName";
    constexpr const char* kPropLevelDb   = "levelDb";
    constexpr const char* kPropPan       = "pan";
}

namespace OmegaPreset
{
    OmegaPreset::OmegaPreset()
        : root (juce::ValueTree (kTypePreset))
    {
        root.setProperty (kPropName,   "Init", nullptr);
        root.setProperty (kPropEngine, "VirtualAnalog", nullptr);
    }

    OmegaPreset::OmegaPreset (juce::ValueTree rootVT)
        : root (std::move (rootVT))
    {
        if (! root.isValid() || root.getType() != juce::Identifier (kTypePreset))
        {
            root = juce::ValueTree (kTypePreset);
            root.setProperty (kPropName,   "Init", nullptr);
            root.setProperty (kPropEngine, "VirtualAnalog", nullptr);
        }
    }

    OmegaPreset OmegaPreset::createEmpty (const juce::String& engine)
    {
        OmegaPreset p;
        p.setEngine (engine);
        return p;
    }

    OmegaPreset OmegaPreset::fromValueTree (juce::ValueTree tree)
    {
        return OmegaPreset (std::move (tree));
    }

    juce::ValueTree OmegaPreset::toValueTree() const
    {
        return root;
    }

    juce::String OmegaPreset::getName() const
    {
        return root.getProperty (kPropName).toString();
    }

    void OmegaPreset::setName (const juce::String& name)
    {
        root.setProperty (kPropName, name, nullptr);
    }

    juce::String OmegaPreset::getEngine() const
    {
        return root.getProperty (kPropEngine).toString();
    }

    void OmegaPreset::setEngine (const juce::String& engine)
    {
        root.setProperty (kPropEngine, engine, nullptr);
    }

    juce::Array<Layer> OmegaPreset::getLayers() const
    {
        juce::Array<Layer> layers;

        for (int i = 0; i < root.getNumChildren(); ++i)
        {
            auto child = root.getChild (i);
            if (child.getType() == juce::Identifier (kTypeLayer))
            {
                Layer l;
                l.id      = child.getProperty (kPropLayerId).toString();
                l.name    = child.getProperty (kPropLayerName).toString();
                l.levelDb = (float) child.getProperty (kPropLevelDb, 0.0f);
                l.pan     = (float) child.getProperty (kPropPan, 0.0f);
                layers.add (l);
            }
        }

        return layers;
    }

    void OmegaPreset::addLayer (const Layer& layer)
    {
        juce::ValueTree vtLayer (kTypeLayer);
        vtLayer.setProperty (kPropLayerId,   layer.id,   nullptr);
        vtLayer.setProperty (kPropLayerName, layer.name, nullptr);
        vtLayer.setProperty (kPropLevelDb,   layer.levelDb, nullptr);
        vtLayer.setProperty (kPropPan,       layer.pan, nullptr);
        root.addChild (vtLayer, -1, nullptr);
    }
} // namespace OmegaPreset
Test roundtrip OmegaPreset
Tests/TestOmegaPreset.cpp:
​

cpp
#include <catch2/catch_test_macros.hpp>
#include "Core/Preset/OmegaPreset.h"

using namespace OmegaPreset;

TEST_CASE("OmegaPreset roundtrip ValueTree", "[preset]")
{
    auto preset = OmegaPreset::createEmpty ("VirtualAnalog");
    preset.setName ("TestPreset");

    Layer layerA;
    layerA.id = "A";
    layerA.name = "Layer A";
    layerA.levelDb = 0.0f;
    layerA.pan = 0.0f;
    preset.addLayer (layerA);

    auto vt = preset.toValueTree();
    REQUIRE(vt.isValid());
    REQUIRE(vt.getType().toString() == "OMEGAPRESET");

    auto preset2 = OmegaPreset::fromValueTree (vt);

    REQUIRE(preset2.getName() == "TestPreset");
    REQUIRE(preset2.getEngine() == "VirtualAnalog");

    auto layers = preset2.getLayers();
    REQUIRE(layers.size() == 1);
    REQUIRE(layers[0].id == "A");
    REQUIRE(layers[0].name == "Layer A");
}
2. AceCatalog leyendo YAML real (simple)
Para no meter una dependencia nueva aún, podemos parsear YAML muy simple convirtiéndolo a JSON con una herramienta externa o usando un parser YAML ligero después; pero si quieres ya algo real, lo lógico es usar yaml-cpp. Aquí te marco el esqueleto (sin detallar integración de la librería para no alargar):

cpp
// Dentro de AceCatalog::createFromResources()

// 1) localizar carpeta Resources/ace desde juce::File::getSpecialLocation
// 2) leer aceindex.yaml, iterar files, cargar cada YAML y poblar ComponentInfo
Como esto sí implica decidir cómo integras yaml-cpp en CMake, es mejor hacerlo cuando tengas el repo montado y los tests de OmegaPreset/AceCatalog stub ya verdes.
​

Yo haría ahora:

Montar repo con lo que ya tienes (plugin vacío, Catch2, AceCatalog stub, OmegaPreset).

Ver que omegatests pasa y el plugin carga.

En el siguiente bloque, integrar yaml-cpp y sustituir el hardcodeo de AceCatalog::createFromResources() por lectura real de los YAML que ya hemos definido.




La jugada buena es: dejar AceCatalog funcionando con hardcodeo mínimo como hoy, y usar el siguiente bloque para meter yaml-cpp + lectura real de YAML.

Cómo integrar yaml-cpp con CMake
En la raíz, reutilizando FetchContent igual que con Catch2:

text
include(FetchContent)

# Catch2 ya lo tienes declarado aquí...

FetchContent_Declare(
    yaml-cpp
    GIT_REPOSITORY https://github.com/jbeder/yaml-cpp.git
    GIT_TAG        yaml-cpp-0.8.0  # o la tag estable que prefieras
)

FetchContent_MakeAvailable(yaml-cpp)
Y en Source/Core/CMakeLists.txt, enlazarlo con omega_core:

text
target_link_libraries(omega_core
    PUBLIC
        juce::juce_core
        yaml-cpp::yaml-cpp
)
Con eso ya puedes #include <yaml-cpp/yaml.h> desde AceCatalog.cpp.
​

Esqueleto de createFromResources leyendo aceindex.yaml
Versión simple: leer aceindex.yaml, iterar ficheros, cargar cada uno y poblar ComponentInfo.
​
​

cpp
#include "AceCatalog.h"
#include <yaml-cpp/yaml.h>

namespace OmegaAce
{
    static juce::File getAceRoot()
    {
        // Ajusta si quieres otro esquema; para ahora, relativo al binario:
        auto exe = juce::File::getSpecialLocation(juce::File::currentExecutableFile);
        return exe.getParentDirectory().getChildFile("Resources").getChildFile("ace");
    }

    static juce::String makeFallbackKey (const juce::String& family,
                                         const juce::String& engine)
    {
        return family + "|" + engine;
    }

    std::unique_ptr<AceCatalog> AceCatalog::createFromResources()
    {
        auto catalog = std::make_unique<AceCatalog>();

        auto aceRoot = getAceRoot();
        auto indexFile = aceRoot.getChildFile("aceindex.yaml");
        if (! indexFile.existsAsFile())
            return catalog;

        auto indexDoc = YAML::LoadFile(indexFile.getFullPathName().toStdString());
        auto filesNode = indexDoc["files"];
        if (! filesNode || ! filesNode.IsSequence())
            return catalog;

        for (const auto& fileNode : filesNode)
        {
            auto relName = fileNode.as<std::string>();
            auto yamlFile = aceRoot.getChildFile (relName);
            if (! yamlFile.existsAsFile())
                continue;

            auto doc = YAML::LoadFile (yamlFile.getFullPathName().toStdString());
            auto comps = doc["components"];
            if (! comps || ! comps.IsSequence())
                continue;

            for (const auto& c : comps)
            {
                ComponentInfo info;

                info.id      = c["id"].as<std::string>();
                info.name    = c["name"].as<std::string>();
                info.family  = c["family"].as<std::string>();
                info.engine  = c["engine"].as<std::string>();
                info.modelId = c["modelId"].as<std::string>();
                info.origin  = c["origin"].as<std::string>();
                info.status  = c["status"].as<std::string>();
                info.version = c["version"].as<int>();

                if (auto tags = c["tags"]; tags && tags.IsSequence())
                {
                    for (const auto& t : tags)
                        info.tags.add (t.as<std::string>());
                }

                if (auto params = c["parameters"]; params && params.IsSequence())
                {
                    for (const auto& p : params)
                    {
                        ParameterDef def;
                        def.id           = p["id"].as<std::string>();
                        def.label        = p["label"].as<std::string>();
                        def.unit         = p["unit"].as<std::string>();
                        def.min          = p["min"].as<float>();
                        def.max          = p["max"].as<float>();
                        def.defaultValue = p["default"].as<float>();
                        info.parameters.add (def);
                    }
                }

                if (auto mts = c["modulationTargets"]; mts && mts.IsSequence())
                {
                    for (const auto& m : mts)
                    {
                        ModTarget t;
                        t.id    = m["id"].as<std::string>();
                        t.label = m["label"].as<std::string>();
                        t.unit  = m["unit"].as<std::string>();
                        info.modulationTargets.add (t);
                    }
                }

                catalog->addComponent (std::move (info));
            }
        }

        catalog->buildFallbacks();
        return catalog;
    }
}
Con los YAML que ya definimos (OSC-VA-001, FLT-VA-001, ENV-ADSR-GEN, LFO-001, FX-CH-001), tu test TestAceCatalog debe seguir pasando sin tocarlo.





La clave es decidir una estrategia distinta para tests, debug y release, pero con una sola función getAceRoot() bien acotada.
​

Estrategia por entorno
Tests: leer Resources/ace desde el árbol de fuentes (relativo al binario de tests).
​

Plugin debug: leer Resources/ace como carpeta junto al ejecutable o en el bundle dev (según plataforma).
​

Plugin release: idealmente migrar a BinaryData (o similar) y dejar de tocar el disco para ACE, pero eso puede ser fase 2.
​

Implementación sugerida de getAceRoot
Define un helper en un .cpp de Core, usando macros de JUCE:

cpp
static juce::File getAceRoot()
{
   #if JUCE_UNIT_TESTS
       // Ejecutas tests desde la raíz del repo (ctest, etc.)
       auto working = juce::File::getCurrentWorkingDirectory();
       // Ajusta si tu layout es diferente
       return working.getChildFile("Resources").getChildFile("ace");
   #elif JUCE_MAC
       // Plugin/app en macOS: usar el bundle
       auto exe = juce::File::getSpecialLocation(juce::File::currentExecutableFile);
       auto contents = exe.getParentDirectory().getParentDirectory();
       return contents.getChildFile("Resources").getChildFile("ace");
   #elif JUCE_WINDOWS
       // VST3 / exe: carpeta Resources al lado del binario
       auto exeDir = juce::File::getSpecialLocation(juce::File::currentExecutableFile)
                         .getParentDirectory();
       return exeDir.getChildFile("Resources").getChildFile("ace");
   #else
       // Fallback genérico (Linux, etc.)
       auto exeDir = juce::File::getSpecialLocation(juce::File::currentExecutableFile)
                         .getParentDirectory();
       return exeDir.getChildFile("Resources").getChildFile("ace");
   #endif
}
Con eso AceCatalog::createFromResources() simplemente hace:

cpp
auto aceRoot   = getAceRoot();
auto indexFile = aceRoot.getChildFile("aceindex.yaml");
y funciona igual en tests, debug y plugin real, siempre que:

En tests tengas un Resources/ace en el cwd del runner o ajustes la ruta a ../Resources/ace según tu layout concreto.

En debug copies Resources/ace al lado del binario (o dentro del bundle en macOS) desde CMake.



Mejor define un layout único desde ya y lo respetas en todo: repo, tests y binarios.
​

Layout recomendado del repo
En la raíz del repo:

Source/ (todo el código)

Resources/ace/ (YAML de ACE)

Build/ (out-of-source builds)

Tests/ (código de tests)

Así tus YAML viven en $(repo-root)/Resources/ace/....
​

Cómo colocar Resources para cada entorno
Tests: ejecuta los tests con cwd = raíz del repo (p. ej. desde un script ./Build/omegatests lanzado desde raíz).

Binarios (debug/release): desde CMake copia Resources junto al ejecutable/plugin.

Ejemplo CMake muy simple:

text
# En CMakeLists.txt raíz o en uno común
add_custom_target(copy_resources ALL
    COMMAND ${CMAKE_COMMAND} -E copy_directory
            ${CMAKE_SOURCE_DIR}/Resources
            ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/Resources
)

# Asegura que se copien antes del plugin y de los tests
add_dependencies(omega_plugin copy_resources)
add_dependencies(omegatests copy_resources)
Así, tanto omegatests como el plugin ven Resources/ace al lado del binario.

getAceRoot unificado
Con ese layout, puedes simplificar:

cpp
static juce::File getAceRoot()
{
    // 1) Intentar Resources junto al binario (funciona para tests y plugin)
    auto exeDir   = juce::File::getSpecialLocation(juce::File::currentExecutableFile)
                        .getParentDirectory();
    auto aceRoot1 = exeDir.getChildFile("Resources").getChildFile("ace");
    if (aceRoot1.isDirectory())
        return aceRoot1;

    // 2) Fallback: ejecutar tests desde raíz del repo
    auto cwd      = juce::File::getCurrentWorkingDirectory();
    auto aceRoot2 = cwd.getChildFile("Resources").getChildFile("ace");
    if (aceRoot2.isDirectory())
        return aceRoot2;

    // 3) Último recurso: devolver algo aunque esté vacío
    return aceRoot1;
}
Con esto no tienes que decidir nada más: pon tus YAML en Resources/ace en el repo, deja que CMake los copie al lado de los binarios, y todo el código que use getAceRoot() funcionará igual en tests, debug y release.



Perfecto: entonces fijamos ya ese contrato y lo das por hecho en todo el código.
​

1. Layout definitivo
En la raíz del repo:

Source/...

Resources/ace/... ← aquí van todos los YAML de ACE

Tests/...

Build/... (out-of-source)

2. CMake: copiar Resources junto a binarios
En tu CMakeLists.txt raíz:

text
# Ruta común de salida de binarios
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)

add_custom_target(copy_resources ALL
    COMMAND ${CMAKE_COMMAND} -E copy_directory
            ${CMAKE_SOURCE_DIR}/Resources
            ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/Resources
)

# Supongamos que tus targets se llaman omegatests y omega_plugin
add_dependencies(omegatests copy_resources)
add_dependencies(omega_plugin copy_resources)
En macOS, si luego quieres meterlo en el bundle, puedes hacer otro paso más tarde; por ahora que esté junto al binario es suficiente.
​

3. getAceRoot unificado
En el .cpp donde tienes AceCatalog::createFromResources():

cpp
static juce::File getAceRoot()
{
    // 1) Resources junto al ejecutable / plugin
    auto exeDir   = juce::File::getSpecialLocation(juce::File::currentExecutableFile)
                        .getParentDirectory();
    auto aceRoot1 = exeDir.getChildFile("Resources").getChildFile("ace");
    if (aceRoot1.isDirectory())
        return aceRoot1;

    // 2) Fallback: raíz del repo (por si ejecutas tests desde ahí)
    auto cwd      = juce::File::getCurrentWorkingDirectory();
    auto aceRoot2 = cwd.getChildFile("Resources").getChildFile("ace");
    if (aceRoot2.isDirectory())
        return aceRoot2;

    // 3) Devuelve la primera opción aunque esté vacía (evitas nulls)
    return aceRoot1;
}
Y en AceCatalog::createFromResources():

cpp
auto aceRoot   = getAceRoot();
auto indexFile = aceRoot.getChildFile("aceindex.yaml");
Con esto ya puedes crear Resources/ace/aceindex.yaml y el resto de YAML, y todo funcionará igual en tests y plugin.
​



Te dejo el mínimo para que AceCatalog lea YAML real desde Resources/ace y tu test pase.
​

