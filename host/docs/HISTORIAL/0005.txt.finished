cpp
// Tests/TestOmegaPresetJunoYaml.cpp
#include <catch2/catch_test_macros.hpp>
#include "Preset/OmegaPreset.h"
#include "Preset/OmegaPresetSerializer.h" // si tienes helpers YAML
#include <juce_core/juce_core.h>

using namespace OmegaPreset;

namespace
{
    // YAML mínimo del ACE Juno Basic Pad según tu especificación
    const char* kJunoBasicPadYaml = R"yaml(
omegapresetversion: 1
name: "ACE Juno Basic Pad"
author: "abdeneurolab"
engine: "VirtualAnalog"
layers:
  - id: "A"
    name: "Juno Basic"
    polyphony: 8
    voicearchitecture:
      oscillators:
        - slot: 1
          componentid: "OSC-VA-001"
          enabled: true
          params:
            tune: 0.0
            pulsewidth: 0.5
            sublevel: 0.3
      filters:
        - slot: 1
          componentid: "FLT-VA-001"
          enabled: true
          mode: "LP24"
          params:
            cutoff: 2000.0
            resonance: 0.2
            drive: 0.0
      envelopes:
        - slot: 1
          componentid: "ENV-ADSR-GEN"
          role: "amp"
          params:
            attack: 10.0
            decay: 120.0
            sustain: 0.8
            release: 600.0
      lfos:
        - slot: 1
          componentid: "LFO-001"
          params:
            rate: 1.0
            shape: "sine"
            delay: 0.0
      fx:
        - slot: 1
          componentid: "FX-CH-001"
          enabled: true
          params:
            mix: 0.7
            mode: "III"
    layerparams:
      leveldb: 0.0
      pan: 0.0
      maincutoffhz: 2000.0
      mainresonance: 0.2
      envamount: 0.5
      lforatehz: 1.0
      lfodepthsemis: 0.3
      ampenv:
        attackms: 10.0
        decayms: 120.0
        sustain: 0.8
        releasems: 600.0
    modulationroutes:
      - source: "LFO1"
        destination: "LayerA.Osc1.pitch"
        amount: 0.3
        curve: "sine"
        bipolar: true
      - source: "ENV1"
        destination: "LayerA.Filter1.cutoff"
        amount: 0.5
        curve: "exponential"
        bipolar: false
)yaml";

    // Helper simple: crea preset desde YAML usando tu API
    inline OmegaPreset::OmegaPreset createPresetFromYaml()
    {
        juce::String yamlText { kJunoBasicPadYaml };
        return OmegaPreset::fromYaml (yamlText);
    }
}

TEST_CASE ("OmegaPreset Juno YAML roundtrip", "[OmegaPreset][YAML][JunoPad]")
{
    auto preset = createPresetFromYaml();

    SECTION ("Campos lógicos desde YAML")
    {
        REQUIRE (preset.getName()   == juce::String ("ACE Juno Basic Pad"));
        REQUIRE (preset.getEngine() == juce::String ("VirtualAnalog"));

        auto layers = preset.getLayers();
        REQUIRE (layers.size() == 1);
        const auto& layerA = layers.front();

        REQUIRE (layerA.id   == juce::String ("A"));
        REQUIRE (layerA.name == juce::String ("Juno Basic"));
        REQUIRE (layerA.voiceArch.polyphony == 8);

        REQUIRE (layerA.voiceArch.oscillators.size() == 1);
        const auto& osc1 = layerA.voiceArch.oscillators[0];
        REQUIRE (osc1.componentId == juce::String ("OSC-VA-001"));
        REQUIRE (osc1.enabled == true);
        REQUIRE (osc1.parameters.at ("tune")       == Approx (0.0f));
        REQUIRE (osc1.parameters.at ("pulsewidth") == Approx (0.5f));
        REQUIRE (osc1.parameters.at ("sublevel")   == Approx (0.3f));

        REQUIRE (layerA.voiceArch.filters.size() == 1);
        const auto& flt1 = layerA.voiceArch.filters[0];
        REQUIRE (flt1.componentId == juce::String ("FLT-VA-001"));
        REQUIRE (flt1.mode        == juce::String ("LP24"));
        REQUIRE (flt1.parameters.at ("cutoff")    == Approx (2000.0f));
        REQUIRE (flt1.parameters.at ("resonance") == Approx (0.2f));

        // Layer params clave
        REQUIRE (layerA.levelDb == Approx (0.0f));
        REQUIRE (layerA.pan     == Approx (0.0f));
        REQUIRE (layerA.mainCutoffHz   == Approx (2000.0f));
        REQUIRE (layerA.mainResonance  == Approx (0.2f));
        REQUIRE (layerA.envAmount      == Approx (0.5f));
        REQUIRE (layerA.lfoRateHz      == Approx (1.0f));
        REQUIRE (layerA.lfoDepthSemis  == Approx (0.3f));
    }

    SECTION ("YAML -> Preset -> YAML conserva semántica")
    {
        const juce::String yamlOut = preset.toYaml();

        // No comparamos texto exacto, pero sí que contenga señales fuertes
        REQUIRE (yamlOut.contains ("ACE Juno Basic Pad"));
        REQUIRE (yamlOut.contains ("engine: \"VirtualAnalog\""));
        REQUIRE (yamlOut.contains ("componentid: \"OSC-VA-001\""));
        REQUIRE (yamlOut.contains ("componentid: \"FLT-VA-001\""));
        REQUIRE (yamlOut.contains ("cutoff: 2000"));
        REQUIRE (yamlOut.contains ("resonance: 0.2"));

        // Opcional: volver a parsear y comprobar campos otra vez
        auto preset2 = OmegaPreset::fromYaml (yamlOut);
        REQUIRE (preset2.getName()   == preset.getName());
        REQUIRE (preset2.getEngine() == preset.getEngine());

        auto layers2 = preset2.getLayers();
        REQUIRE (layers2.size() == 1);
        const auto& layerA2 = layers2.front();
        REQUIRE (layerA2.voiceArch.oscillators.size() == 1);
        REQUIRE (layerA2.voiceArch.filters.size()     == 1);
        REQUIRE (layerA2.voiceArch.oscillators[0].componentId
                 == juce::String ("OSC-VA-001"));
        REQUIRE (layerA2.voiceArch.filters[0].componentId
                 == juce::String ("FLT-VA-001"));
    }
}
Esto te deja cubierto el camino YAML → OmegaPreset → YAML de forma robusta, centrándote en IDs ACE y parámetros críticos en lugar de formato textual exacto.

¿Tu implementación actual de OmegaPreset::fromYaml ya usa juce::var/juce::JSON + un parser YAML, o prefieres que te bosqueje también un OmegaPresetYamlCodec minimal que convierta entre YAML y juce::ValueTree?


Tiene sentido que no lo sepas; aquí la prioridad es no desviar foco del vertical Juno VA.
​

Para maximizar retorno ahora, haría esto:

Mantener OmegaPreset::fromYaml/toYaml lo más fino posible, delegando en fromValueTree/toValueTree y un codec muy simple YAML ↔ ValueTree solo para el esquema de Fase 1 (sin ModulationGraph completo).
​

Terminar primero los tests que ya tienes esbozados (OmegaPreset ValueTree + YAML roundtrip) y usarlos como contrato mientras implementas OmegaPreset::fromValueTree y toValueTree.

Dejar un OmegaPresetYamlCodec minimal “internal” (no genérico) que solo soporte:

1 engine (VirtualAnalog),

1 layer A,

bloques voicearchitecture, layerparams y modulationroutes tal como en el preset Juno, sin migraciones ni ModulationGraph.
​

Si quieres, en el siguiente mensaje te escribo directamente el .h/.cpp de ese OmegaPresetYamlCodec mínimo, limitado al MVP Juno (una capa, un engine), para que no se convierta en otro subproyecto infinito. ¿Te encaja que ese codec solo soporte el esquema Juno-Fase‑1 y haga jassertfalse si ve algo más?


Te dejo un OmegaPresetYamlCodec mínimo, pensado solo para el MVP Juno: un engine VirtualAnalog, una sola layer A, y el esquema de YAML que ya estás usando.

Header
cpp
// Source/Core/Preset/OmegaPresetYamlCodec.h
#pragma once

#include <juce_core/juce_core.h>
#include "OmegaPreset.h"

namespace OmegaPreset
{
    class OmegaPresetYamlCodec
    {
    public:
        // YAML -> OmegaPreset (solo esquema Juno Fase 1)
        static OmegaPreset fromYaml (const juce::String& yamlText);

        // OmegaPreset -> YAML (solo soporta 1 layer A VirtualAnalog)
        static juce::String toYaml (const OmegaPreset& preset);

    private:
        static OmegaPreset parseRoot (const juce::var& root);
        static void        writeRoot (juce::DynamicObject& out, const OmegaPreset& preset);
    };
} // namespace OmegaPreset
Implementación
cpp
// Source/Core/Preset/OmegaPresetYamlCodec.cpp
#include "OmegaPresetYamlCodec.h"

// Aquí usas tu parser YAML preferido; asumo una función externa:
// juce::var parseYamlToVar (const juce::String& text);
// juce::String writeVarToYaml (const juce::var& v);

namespace OmegaPreset
{
    using juce::var;
    using juce::DynamicObject;
    using juce::String;

    static var parseYamlToVar (const String& text);   // decls externas o stub
    static String writeVarToYaml (const var& v);

    OmegaPreset OmegaPresetYamlCodec::fromYaml (const String& yamlText)
    {
        const var root = parseYamlToVar (yamlText);
        jassert (root.isObject()); // MVP: fallar en debug si el YAML no encaja

        return parseRoot (root);
    }

    juce::String OmegaPresetYamlCodec::toYaml (const OmegaPreset& preset)
    {
        DynamicObject* obj = new DynamicObject();
        writeRoot (*obj, preset);
        var root { obj };

        return writeVarToYaml (root);
    }

    // --- helpers internos ---

    static float getFloat (const var& o, const char* key, float def = 0.0f)
    {
        if (! o.isObject()) return def;
        auto* d = o.getDynamicObject();
        if (! d) return def;
        return static_cast<float> (double (d->getProperty (key)));
    }

    static String getString (const var& o, const char* key, const char* def = "")
    {
        if (! o.isObject()) return def;
        auto* d = o.getDynamicObject();
        if (! d) return def;
        return d->getProperty (key).toString();
    }

    static var getObj (const var& o, const char* key)
    {
        if (! o.isObject()) return {};
        auto* d = o.getDynamicObject();
        if (! d) return {};
        return d->getProperty (key);
    }

    static var getIndex (const var& arr, int idx)
    {
        if (! arr.isArray()) return {};
        auto* a = arr.getArray();
        if (! a || idx < 0 || idx >= a->size()) return {};
        return (*a) [idx];
    }

    OmegaPreset OmegaPresetYamlCodec::parseRoot (const var& root)
    {
        OmegaPreset preset = OmegaPreset::createEmpty ("VirtualAnalog");

        const auto name   = getString (root, "name");
        const auto author = getString (root, "author");
        const auto engine = getString (root, "engine", "VirtualAnalog");

        preset.setName (name);
        preset.setEngine (engine);
        preset.setAuthor (author); // si tienes este accessor

        // Layers (solo 1 layer A)
        const var layersVar = getObj (root, "layers");
        jassert (layersVar.isArray());
        const var layerVar = getIndex (layersVar, 0);

        Layer layer;
        layer.id   = getString (layerVar, "id", "A");
        layer.name = getString (layerVar, "name", "Layer A");
        layer.voiceArch.engine    = engine;
        layer.voiceArch.polyphony = int (getFloat (layerVar, "polyphony", 8.0f));

        // voicearchitecture
        const var vaVar = getObj (layerVar, "voicearchitecture");

        // oscillators
        {
            const var oscsVar = getObj (vaVar, "oscillators");
            if (oscsVar.isArray())
            {
                auto* arr = oscsVar.getArray();
                for (auto& oscVar : *arr)
                {
                    OscillatorSlot osc;
                    osc.componentId = getString (oscVar, "componentid");
                    osc.enabled     = true;

                    const var paramsVar = getObj (oscVar, "params");
                    if (paramsVar.isObject())
                    {
                        auto* d = paramsVar.getDynamicObject();
                        for (auto& k : d->getProperties())
                            osc.parameters[k.name.toString()] = float (double (k.value));
                    }

                    layer.voiceArch.oscillators.push_back (std::move (osc));
                }
            }
        }

        // filters
        {
            const var fltsVar = getObj (vaVar, "filters");
            if (fltsVar.isArray())
            {
                auto* arr = fltsVar.getArray();
                for (auto& fltVar : *arr)
                {
                    FilterSlot flt;
                    flt.componentId = getString (fltVar, "componentid");
                    flt.enabled     = true;
                    flt.mode        = getString (fltVar, "mode", "LP24");

                    const var paramsVar = getObj (fltVar, "params");
                    if (paramsVar.isObject())
                    {
                        auto* d = paramsVar.getDynamicObject();
                        for (auto& k : d->getProperties())
                            flt.parameters[k.name.toString()] = float (double (k.value));
                    }

                    layer.voiceArch.filters.push_back (std::move (flt));
                }
            }
        }

        // envelopes
        {
            const var envsVar = getObj (vaVar, "envelopes");
            if (envsVar.isArray())
            {
                auto* arr = envsVar.getArray();
                for (auto& envVar : *arr)
                {
                    EnvelopeSlot env;
                    env.componentId = getString (envVar, "componentid");
                    env.role        = getString (envVar, "role", "amp");

                    const var paramsVar = getObj (envVar, "params");
                    if (paramsVar.isObject())
                    {
                        auto* d = paramsVar.getDynamicObject();
                        for (auto& k : d->getProperties())
                            env.parameters[k.name.toString()] = float (double (k.value));
                    }

                    layer.voiceArch.envelopes.push_back (std::move (env));
                }
            }
        }

        // lfos
        {
            const var lfosVar = getObj (vaVar, "lfos");
            if (lfosVar.isArray())
            {
                auto* arr = lfosVar.getArray();
                for (auto& lfoVar : *arr)
                {
                    LfoSlot lfo;
                    lfo.componentId = getString (lfoVar, "componentid");

                    const var paramsVar = getObj (lfoVar, "params");
                    if (paramsVar.isObject())
                    {
                        auto* d = paramsVar.getDynamicObject();
                        for (auto& k : d->getProperties())
                            lfo.parameters[k.name.toString()] = float (double (k.value));
                    }

                    layer.voiceArch.lfos.push_back (std::move (lfo));
                }
            }
        }

        // fx
        {
            const var fxVar = getObj (vaVar, "fx");
            if (fxVar.isArray())
            {
                auto* arr = fxVar.getArray();
                for (auto& fxSlotVar : *arr)
                {
                    FxSlot fx;
                    fx.componentId = getString (fxSlotVar, "componentid");
                    fx.enabled     = true;

                    const var paramsVar = getObj (fxSlotVar, "params");
                    if (paramsVar.isObject())
                    {
                        auto* d = paramsVar.getDynamicObject();
                        for (auto& k : d->getProperties())
                            fx.parameters[k.name.toString()] = float (double (k.value));
                    }

                    layer.voiceArch.fx.push_back (std::move (fx));
                }
            }
        }

        // layerparams
        {
            const var lpVar = getObj (layerVar, "layerparams");
            layer.levelDb       = getFloat (lpVar, "leveldb", 0.0f);
            layer.pan           = getFloat (lpVar, "pan", 0.0f);
            layer.mainCutoffHz  = getFloat (lpVar, "maincutoffhz", 2000.0f);
            layer.mainResonance = getFloat (lpVar, "mainresonance", 0.2f);
            layer.envAmount     = getFloat (lpVar, "envamount", 0.5f);
            layer.lfoRateHz     = getFloat (lpVar, "lforatehz", 1.0f);
            layer.lfoDepthSemis = getFloat (lpVar, "lfodepthsemis", 0.3f);
        }

        // modulationroutes
        {
            const var routesVar = getObj (layerVar, "modulationroutes");
            if (routesVar.isArray())
            {
                auto* arr = routesVar.getArray();
                for (auto& rVar : *arr)
                {
                    ModulationRoute r;
                    r.source      = getString (rVar, "source");
                    r.destination = getString (rVar, "destination");
                    r.amount      = getFloat  (rVar, "amount", 0.0f);
                    r.curve       = getString (rVar, "curve", "linear");
                    r.bipolar     = (getFloat (rVar, "bipolar", 0.0f) != 0.0f);

                    layer.modulation.push_back (std::move (r));
                }
            }
        }

        preset.addLayer (layer);
        return preset;
    }

    void OmegaPresetYamlCodec::writeRoot (DynamicObject& out, const OmegaPreset& preset)
    {
        out.setProperty ("omegapresetversion", 1);
        out.setProperty ("name",   preset.getName());
        out.setProperty ("author", preset.getAuthor());
        out.setProperty ("engine", preset.getEngine());

        var layersVar;
        layersVar.resizeArray (1);

        const auto layers = preset.getLayers();
        jassert (layers.size() == 1); // MVP Juno

        const auto& layer = layers.front();

        auto* layerObj = new DynamicObject();
        layerObj->setProperty ("id",        layer.id);
        layerObj->setProperty ("name",      layer.name);
        layerObj->setProperty ("polyphony", layer.voiceArch.polyphony);

        // voicearchitecture
        auto* vaObj = new DynamicObject();

        // oscillators
        {
            var oscs;
            oscs.resizeArray ((int) layer.voiceArch.oscillators.size());
            int i = 0;
            for (const auto& osc : layer.voiceArch.oscillators)
            {
                auto* o = new DynamicObject();
                o->setProperty ("slot",        1);
                o->setProperty ("componentid", osc.componentId);
                o->setProperty ("enabled",     true);

                auto* params = new DynamicObject();
                for (auto& kv : osc.parameters)
                    params->setProperty (kv.first, kv.second);

                o->setProperty ("params", var (params));
                oscs.getArray()->set (i++, var (o));
            }
            vaObj->setProperty ("oscillators", oscs);
        }

        // filters
        {
            var flts;
            flts.resizeArray ((int) layer.voiceArch.filters.size());
            int i = 0;
            for (const auto& flt : layer.voiceArch.filters)
            {
                auto* f = new DynamicObject();
                f->setProperty ("slot",        1);
                f->setProperty ("componentid", flt.componentId);
                f->setProperty ("enabled",     true);
                f->setProperty ("mode",        flt.mode);

                auto* params = new DynamicObject();
                for (auto& kv : flt.parameters)
                    params->setProperty (kv.first, kv.second);

                f->setProperty ("params", var (params));
                flts.getArray()->set (i++, var (f));
            }
            vaObj->setProperty ("filters", flts);
        }

        // envelopes, lfos, fx: análogo a lo anterior, mismo patrón.
        // Para no alargar, sigues el mismo esquema que en parseRoot.

        layerObj->setProperty ("voicearchitecture", var (vaObj));

        // layerparams
        {
            auto* lp = new DynamicObject();
            lp->setProperty ("leveldb",        layer.levelDb);
            lp->setProperty ("pan",            layer.pan);
            lp->setProperty ("maincutoffhz",   layer.mainCutoffHz);
            lp->setProperty ("mainresonance",  layer.mainResonance);
            lp->setProperty ("envamount",      layer.envAmount);
            lp->setProperty ("lforatehz",      layer.lfoRateHz);
            lp->setProperty ("lfodepthsemis",  layer.lfoDepthSemis);

            layerObj->setProperty ("layerparams", var (lp));
        }

        // modulationroutes
        {
            var routes;
            routes.resizeArray ((int) layer.modulation.size());
            int i = 0;
            for (const auto& r : layer.modulation)
            {
                auto* ro = new DynamicObject();
                ro->setProperty ("source",      r.source);
                ro->setProperty ("destination", r.destination);
                ro->setProperty ("amount",      r.amount);
                ro->setProperty ("curve",       r.curve);
                ro->setProperty ("bipolar",     r.bipolar ? 1 : 0);
                routes.getArray()->set (i++, var (ro));
            }
            layerObj->setProperty ("modulationroutes", routes);
        }

        layersVar.getArray()->set (0, var (layerObj));
        out.setProperty ("layers", layersVar);
    }
} // namespace OmegaPreset
Con esto:

OmegaPreset::fromYaml puede delegar en OmegaPresetYamlCodec::fromYaml.

OmegaPreset::toYaml puede delegar en OmegaPresetYamlCodec::toYaml.

El codec está explícitamente recortado al happy path Juno VA, 1 layer, que es justo tu Fase 1.

¿Te va bien que el siguiente paso sea rellenar las partes “análogas” que he dejado en comentario (envelopes/lfos/fx en writeRoot) directamente contra tu struct real de OmegaPreset::Layer para que el test de YAML que ya tienes compile sin tocarlo?

Completo writeRoot para envelopes, LFOs y FX siguiendo exactamente el patrón de lectura que ya definiste.

cpp
void OmegaPresetYamlCodec::writeRoot (DynamicObject& out, const OmegaPreset& preset)
{
    out.setProperty ("omegapresetversion", 1);
    out.setProperty ("name",   preset.getName());
    out.setProperty ("author", preset.getAuthor());
    out.setProperty ("engine", preset.getEngine());

    var layersVar;
    layersVar.resizeArray (1);

    const auto layers = preset.getLayers();
    jassert (layers.size() == 1); // MVP Juno

    const auto& layer = layers.front();

    auto* layerObj = new DynamicObject();
    layerObj->setProperty ("id",        layer.id);
    layerObj->setProperty ("name",      layer.name);
    layerObj->setProperty ("polyphony", layer.voiceArch.polyphony);

    // voicearchitecture
    auto* vaObj = new DynamicObject();

    // oscillators
    {
        var oscs;
        oscs.resizeArray ((int) layer.voiceArch.oscillators.size());
        int i = 0;
        for (const auto& osc : layer.voiceArch.oscillators)
        {
            auto* o = new DynamicObject();
            o->setProperty ("slot",        1);
            o->setProperty ("componentid", osc.componentId);
            o->setProperty ("enabled",     true);

            auto* params = new DynamicObject();
            for (auto& kv : osc.parameters)
                params->setProperty (kv.first, kv.second);

            o->setProperty ("params", var (params));
            oscs.getArray()->set (i++, var (o));
        }
        vaObj->setProperty ("oscillators", oscs);
    }

    // filters
    {
        var flts;
        flts.resizeArray ((int) layer.voiceArch.filters.size());
        int i = 0;
        for (const auto& flt : layer.voiceArch.filters)
        {
            auto* f = new DynamicObject();
            f->setProperty ("slot",        1);
            f->setProperty ("componentid", flt.componentId);
            f->setProperty ("enabled",     true);
            f->setProperty ("mode",        flt.mode);

            auto* params = new DynamicObject();
            for (auto& kv : flt.parameters)
                params->setProperty (kv.first, kv.second);

            f->setProperty ("params", var (params));
            flts.getArray()->set (i++, var (f));
        }
        vaObj->setProperty ("filters", flts);
    }

    // envelopes
    {
        var envs;
        envs.resizeArray ((int) layer.voiceArch.envelopes.size());
        int i = 0;
        for (const auto& env : layer.voiceArch.envelopes)
        {
            auto* e = new DynamicObject();
            e->setProperty ("slot",        1); // MVP: 1 env amp
            e->setProperty ("componentid", env.componentId);
            e->setProperty ("role",        env.role);

            auto* params = new DynamicObject();
            for (auto& kv : env.parameters)
                params->setProperty (kv.first, kv.second);

            e->setProperty ("params", var (params));
            envs.getArray()->set (i++, var (e));
        }
        vaObj->setProperty ("envelopes", envs);
    }

    // lfos
    {
        var lfos;
        lfos.resizeArray ((int) layer.voiceArch.lfos.size());
        int i = 0;
        for (const auto& lfo : layer.voiceArch.lfos)
        {
            auto* l = new DynamicObject();
            l->setProperty ("slot",        1); // MVP: 1 LFO principal
            l->setProperty ("componentid", lfo.componentId);

            auto* params = new DynamicObject();
            for (auto& kv : lfo.parameters)
                params->setProperty (kv.first, kv.second);

            l->setProperty ("params", var (params));
            lfos.getArray()->set (i++, var (l));
        }
        vaObj->setProperty ("lfos", lfos);
    }

    // fx
    {
        var fxs;
        fxs.resizeArray ((int) layer.voiceArch.fx.size());
        int i = 0;
        for (const auto& fx : layer.voiceArch.fx)
        {
            auto* fxObj = new DynamicObject();
            fxObj->setProperty ("slot",        1); // MVP: 1 chorus
            fxObj->setProperty ("componentid", fx.componentId);
            fxObj->setProperty ("enabled",     fx.enabled);

            auto* params = new DynamicObject();
            for (auto& kv : fx.parameters)
                params->setProperty (kv.first, kv.second);

            fxObj->setProperty ("params", var (params));
            fxs.getArray()->set (i++, var (fxObj));
        }
        vaObj->setProperty ("fx", fxs);
    }

    layerObj->setProperty ("voicearchitecture", var (vaObj));

    // layerparams
    {
        auto* lp = new DynamicObject();
        lp->setProperty ("leveldb",        layer.levelDb);
        lp->setProperty ("pan",            layer.pan);
        lp->setProperty ("maincutoffhz",   layer.mainCutoffHz);
        lp->setProperty ("mainresonance",  layer.mainResonance);
        lp->setProperty ("envamount",      layer.envAmount);
        lp->setProperty ("lforatehz",      layer.lfoRateHz);
        lp->setProperty ("lfodepthsemis",  layer.lfoDepthSemis);

        // ampenv: reflejo de la envolvente principal si quieres
        // o solo copias los macros si ya los tienes cacheados ahí.
        auto* ampEnv = new DynamicObject();
        ampEnv->setProperty ("attackms",  layer.ampEnvAttackMs);
        ampEnv->setProperty ("decayms",   layer.ampEnvDecayMs);
        ampEnv->setProperty ("sustain",   layer.ampEnvSustain);
        ampEnv->setProperty ("releasems", layer.ampEnvReleaseMs);
        lp->setProperty ("ampenv", var (ampEnv));

        layerObj->setProperty ("layerparams", var (lp));
    }

    // modulationroutes
    {
        var routes;
        routes.resizeArray ((int) layer.modulation.size());
        int i = 0;
        for (const auto& r : layer.modulation)
        {
            auto* ro = new DynamicObject();
            ro->setProperty ("source",      r.source);
            ro->setProperty ("destination", r.destination);
            ro->setProperty ("amount",      r.amount);
            ro->setProperty ("curve",       r.curve);
            ro->setProperty ("bipolar",     r.bipolar ? 1 : 0);
            routes.getArray()->set (i++, var (ro));
        }
        layerObj->setProperty ("modulationroutes", routes);
    }

    layersVar.getArray()->set (0, var (layerObj));
    out.setProperty ("layers", layersVar);
}
