}, [state.onlyFavorites]);

const toggleOnlyFavorites = useCallback(() => {
  setState(prev => ({ ...prev, onlyFavorites: !prev.onlyFavorites }));
}, []);
Y en el efecto:

ts
useEffect(() => {
  reload();
}, [state.onlyFavorites, reload]);
Así el botón “★ Only favs” solo cambia onlyFavorites; el hook pide de nuevo la lista ya filtrada desde el repo.
​

¿Vas a tener múltiples bankId visibles a la vez en el browser (p. ej. Factory, User, Expansion) o solo uno seleccionado en cada pestaña de la UI?


Perfecto, con un solo bankId seleccionado por pestaña podemos simplificar bastante el contrato.
​

1. Contrato JSON lado UI
El browser solo necesita enviar el bankId actual:

json
{
  "type": "listPresets",
  "requestId": "list-1",
  "payload": {
    "bankId": "factory",
    "onlyFavorites": false
  }
}
Respuesta:

json
{
  "type": "presetList",
  "requestId": "list-1",
  "payload": {
    "bankId": "factory",
    "items": [
      { "id": "pad-001", "name": "Juno Basic Pad", "favorite": true }
    ]
  }
}
El toggle “solo favoritos” en esa pestaña solo cambia onlyFavorites y vuelve a llamar a listPresets con el mismo bankId activo.

2. Repositorio y favoritos
Firma C++ mínima:

cpp
juce::Array<PresetListItem> listPresetsForUser(
    const juce::String& bankId,
    const juce::String& userId,
    bool onlyFavorites) const;
Cada pestaña te pasa su bankId actual y el repo ya devuelve:

solo presets de ese banco;

con favorite resuelto desde favorites.json del banco;

filtrados si onlyFavorites es true.
​

¿Quieres que el siguiente paso sea que te escriba el mensaje completo listPresets en OmegaUiBridge (handler C++) y el hook React usePresetBrowser ya adaptado a bankId único por pestaña?



Te dejo las dos piezas que faltaban: handler listPresets en el bridge y hook usePresetBrowser con bankId único.
​

Handler listPresets en OmegaUiBridge
cpp
// OmegaUiBridge.h
class PresetRepository;

class OmegaUiBridge
{
public:
    // ...

private:
    PresetRepository& presetRepo;
    juce::String userId; // "default" por ahora

    void handleListPresets(const juce::var& msg);
};
cpp
// OmegaUiBridge.cpp
void OmegaUiBridge::handleMessageFromUi(const juce::String& jsonText)
{
    juce::var msg = juce::JSON::parse(jsonText);
    if (! msg.isObject())
        return;

    auto* obj      = msg.getDynamicObject();
    const auto type      = obj->getProperty("type").toString();

    if (type == "listPresets")
    {
        handleListPresets(msg);
        return;
    }

    // resto...
}

void OmegaUiBridge::handleListPresets(const juce::var& msg)
{
    auto* obj     = msg.getDynamicObject();
    auto  payload = obj->getProperty("payload");
    auto  requestId = obj->getProperty("requestId").toString();

    juce::String bankId = "factory";
    bool onlyFavorites  = false;

    if (payload.isObject())
    {
        auto* p = payload.getDynamicObject();
        bankId = p->getProperty("bankId", bankId).toString();
        onlyFavorites = (bool) p->getProperty("onlyFavorites", onlyFavorites);
    }

    auto items = presetRepo.listPresetsForUser(bankId, userId, onlyFavorites);

    juce::DynamicObject::Ptr root(new juce::DynamicObject());
    root->setProperty("type", "presetList");
    root->setProperty("requestId", requestId);

    juce::DynamicObject::Ptr payloadOut(new juce::DynamicObject());
    payloadOut->setProperty("bankId", bankId);

    juce::Array<juce::var> jsonItems;
    for (const auto& it : items)
    {
        juce::DynamicObject::Ptr o(new juce::DynamicObject());
        o->setProperty("id", it.id);
        o->setProperty("name", it.name);
        o->setProperty("engine", it.engine);
        o->setProperty("author", it.author);
        o->setProperty("favorite", it.favorite);
        jsonItems.add(juce::var(o.get()));
    }
    payloadOut->setProperty("items", juce::var(jsonItems));
    root->setProperty("payload", juce::var(payloadOut.get()));

    if (sendToUi)
        sendToUi(juce::JSON::toString(juce::var(root.get())));
}
Hook React usePresetBrowser con bankId único
ts
// usePresetBrowser.ts
import { useCallback, useEffect, useState } from 'react';

export interface PresetListItem {
  id: string;
  name: string;
  author?: string;
  engine?: string;
  favorite: boolean;
}

interface BrowserState {
  bankId: string;
  items: PresetListItem[];
  onlyFavorites: boolean;
}

export function usePresetBrowser(initialBankId = 'factory') {
  const [state, setState] = useState<BrowserState>({
    bankId: initialBankId,
    items: [],
    onlyFavorites: false,
  });

  const sendMessage = useCallback((msg: any) => {
    (window as any).OmegaCore?.sendMessage?.(msg);
  }, []);

  const reload = useCallback(() => {
    sendMessage({
      type: 'listPresets',
      requestId: `list-${state.bankId}-${Date.now()}`,
      payload: {
        bankId: state.bankId,
        onlyFavorites: state.onlyFavorites,
      },
    });
  }, [sendMessage, state.bankId, state.onlyFavorites]);

  const setBankId = useCallback((bankId: string) => {
    setState(prev => ({ ...prev, bankId }));
  }, []);

  const toggleOnlyFavorites = useCallback(() => {
    setState(prev => ({ ...prev, onlyFavorites: !prev.onlyFavorites }));
  }, []);

  const handleFavoriteAck = useCallback((presetId: string, favorite: boolean) => {
    setState(prev => ({
      ...prev,
      items: prev.items.map(p =>
        p.id === presetId ? { ...p, favorite } : p,
      ),
    }));
  }, []);

  useEffect(() => {
    const handleMessage = (jsonText: string) => {
      let msg: any;
      try { msg = JSON.parse(jsonText); } catch { return; }

      if (msg.type === 'presetList') {
        const { items } = msg.payload;
        setState(prev => ({
          ...prev,
          items,
        }));
        return;
      }

      if (msg.type === 'ack' && msg.payload?.presetId) {
        const { presetId, favorite } = msg.payload;
        handleFavoriteAck(presetId, favorite);
        return;
      }
    };

    (window as any).OmegaCore = (window as any).OmegaCore || {};
    (window as any).OmegaCore.onMessage = handleMessage;

    reload();

    return () => {
      if ((window as any).OmegaCore?.onMessage === handleMessage) {
        (window as any).OmegaCore.onMessage = undefined;
      }
    };
  }, [reload, handleFavoriteAck]);

  const toggleFavorite = useCallback((preset: PresetListItem) => {
    const next = !preset.favorite;
    sendMessage({
      type: 'setPresetFavorite',
      requestId: `fav-${preset.id}-${Date.now()}`,
      payload: { presetId: preset.id, favorite: next },
    });
  }, [sendMessage]);

  return {
    bankId: state.bankId,
    items: state.items,
    onlyFavorites: state.onlyFavorites,
    setBankId,
    toggleOnlyFavorites,
    reload,
    toggleFavorite,
  };
}
Uso típico:

tsx
const Browser: React.FC = () => {
  const {
    bankId,
    items,
    onlyFavorites,
    setBankId,
    toggleOnlyFavorites,
    toggleFavorite,
  } = usePresetBrowser('factory');

  return (
    <>
      <select
        value={bankId}
        onChange={e => setBankId(e.target.value)}
      >
        <option value="factory">Factory</option>
        <option value="user">User</option>
      </select>

      <label>
        <input
          type="checkbox"
          checked={onlyFavorites}
          onChange={toggleOnlyFavorites}
        />
        Solo favoritos
      </label>

      <table>
        <tbody>
          {items.map(p => (
            <tr key={p.id}>
              <td>
                <button onClick={() => toggleFavorite(p)}>
                  {p.favorite ? '★' : '☆'}
                </button>
              </td>
              <td>{p.name}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  );
};
¿Quieres que el bridge también devuelva un contador de presets favoritos (favoriteCount) en la respuesta de presetList para poder mostrar algo tipo “12 favoritos / 128 presets” en el header del browser?

Añadimos favoriteCount al payload de presetList sin cambiar nada en el resto del flujo.
​

Bridge: presetList con favoriteCount
Solo hay que ajustar el handler:

cpp
void OmegaUiBridge::handleListPresets(const juce::var& msg)
{
    auto* obj       = msg.getDynamicObject();
    auto  payloadIn = obj->getProperty("payload");
    auto  requestId = obj->getProperty("requestId").toString();

    juce::String bankId = "factory";
    bool onlyFavorites  = false;

    if (payloadIn.isObject())
    {
        auto* p = payloadIn.getDynamicObject();
        bankId = p->getProperty("bankId", bankId).toString();
        onlyFavorites = (bool) p->getProperty("onlyFavorites", onlyFavorites);
    }

    auto items = presetRepo.listPresetsForUser(bankId, userId, onlyFavorites);

    int favoriteCount = 0;
    for (const auto& it : items)
        if (it.favorite)
            ++favoriteCount;

    juce::DynamicObject::Ptr root(new juce::DynamicObject());
    root->setProperty("type", "presetList");
    root->setProperty("requestId", requestId);

    juce::DynamicObject::Ptr payloadOut(new juce::DynamicObject());
    payloadOut->setProperty("bankId", bankId);
    payloadOut->setProperty("favoriteCount", favoriteCount);

    juce::Array<juce::var> jsonItems;
    for (const auto& it : items)
    {
        juce::DynamicObject::Ptr o(new juce::DynamicObject());
        o->setProperty("id", it.id);
        o->setProperty("name", it.name);
        o->setProperty("engine", it.engine);
        o->setProperty("author", it.author);
        o->setProperty("favorite", it.favorite);
        jsonItems.add(juce::var(o.get()));
    }
    payloadOut->setProperty("items", juce::var(jsonItems));
    root->setProperty("payload", juce::var(payloadOut.get()));

    if (sendToUi)
        sendToUi(juce::JSON::toString(juce::var(root.get())));
}
Ejemplo de JSON devuelto:

json
{
  "type": "presetList",
  "requestId": "list-1",
  "payload": {
    "bankId": "factory",
    "favoriteCount": 12,
    "items": [
      { "id": "pad-001", "name": "Juno Basic Pad", "favorite": true }
    ]
  }
}
Hook: exponer favoriteCount
Amplía el estado:

ts
interface BrowserState {
  bankId: string;
  items: PresetListItem[];
  onlyFavorites: boolean;
  favoriteCount: number;
}
En el handler:

ts
if (msg.type === 'presetList') {
  const { items, favoriteCount } = msg.payload;
  setState(prev => ({
    ...prev,
    items,
    favoriteCount: favoriteCount ?? items.filter((p: any) => p.favorite).length,
  }));
  return;
}
Y en el valor de retorno:

