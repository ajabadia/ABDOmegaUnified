Implementación minimalista (sin grafo completo)
1) Guardar ModWheel como factor
Añade un campo en ModulationRuntime:

cpp
class ModulationRuntime
{
public:
    float lfoDepthBase { 0.3f };    // p.ej. desde preset / APVTS
    std::atomic<float> modWheelFactor { 0.0f }; // 0..1

    // ...
};
En el engine, antes de applyModulation():

cpp
const float modWheel = mInputState.modWheel; // 0..1 desde MIDI
mModRuntime.modWheelFactor.store (modWheel, std::memory_order_relaxed);
2) Ruta única LFO → pitch
En lugar de dos rutas (LFO1→pitch y ModWheel→pitch), deja solo LFO1→pitch:

text
modulationroutes:
  - source: "LFO1"
    destination: "LayerA.Osc1.pitch"
    amount: 0.3        # depthBase
    curve: "sine"
    bipolar: true
3) Escalar por ModWheel en applyModulation
En applyModulation (solo para MD_Osc1Pitch):

cpp
void ModulationRuntime::applyModulation () noexcept
{
    // Inicializar base/modulated
    for (int i = 0; i < kMaxDestinations; ++i)
    {
        auto& p = parameters[i];
        const float base = p.baseValue.load (memory_order_relaxed);
        p.modulated.store (base, memory_order_relaxed);
    }

    const float mw = modWheelFactor.load (memory_order_relaxed); // 0..1

    for (uint16_t ri = 0; ri < activeRouteCount; ++ri)
    {
        const auto& route = routes[ri];

        if (route.destParameter >= kMaxDestinations ||
            route.sourceIndex  >= kMaxSources)
            continue;

        auto& dst  = parameters[route.destParameter];
        auto& src  = sources[route.sourceIndex];

        if (! dst.modulatable)
            continue;

        float srcVal = src.current.load (memory_order_relaxed);

        // Curva (linear)
        srcVal = applyCurveLinear (srcVal, route.curveType);

        float amount = route.amount;

        // Si es la ruta LFO→pitch, escalar por ModWheel
        if (route.destParameter == MD_Osc1Pitch &&
            route.sourceIndex == MS_Lfo1)
        {
            amount *= mw; // depthBase * ModWheel
        }

        const float delta = srcVal * amount;

        float current = dst.modulated.load (memory_order_relaxed);
        float updated = current + delta;

        if (updated < dst.min) updated = dst.min;
        if (updated > dst.max) updated = dst.max;

        dst.modulated.store (updated, memory_order_relaxed);
    }
}
Con esto:

ModWheel=0 → no hay vibrato (LFO se anula para pitch).

ModWheel=0.5 → vibrato a mitad de profundidad que amount.

ModWheel=1 → vibrato a profundidad máxima amount.

¿Quieres que te proponga un pequeño test de integración (sin audio, solo números) que verifique que con ModWheel=0 el pitch no cambia y con ModWheel=1 sí se aplica la modulación de LFO?


Un test muy pequeño te basta para validar el comportamiento de ModWheel con el LFO.

cpp
// Tests/TestModulationRuntime_ModWheel.cpp
#include <catch2/catch_test_macros.hpp>
#include "Modulation/ModulationRuntime.h"

using namespace OmegaDSPModulation;

TEST_CASE ("ModulationRuntime LFO pitch scaled by ModWheel", "[Modulation][ModWheel]")
{
    ModulationRuntime mod;
    mod.prepare (48000.0, 64);

    // Configurar destino pitch
    mod.parameters[MD_Osc1Pitch].baseValue.store (0.0f);
    mod.parameters[MD_Osc1Pitch].min = -2.0f;
    mod.parameters[MD_Osc1Pitch].max =  2.0f;
    mod.parameters[MD_Osc1Pitch].modulatable = true;

    // Ruta única LFO1 -> pitch con depthBase 0.3
    mod.routes[0].sourceIndex   = MS_Lfo1;
    mod.routes[0].destParameter = MD_Osc1Pitch;
    mod.routes[0].amount        = 0.3f;   // depthBase
    mod.routes[0].curveType     = 0;
    mod.routes[0].bipolar       = true;
    mod.activeRouteCount        = 1;

    // Caso 1: ModWheel = 0 -> no vibrato
    mod.modWheelFactor.store (0.0f);
    mod.sources[MS_Lfo1].current.store (1.0f); // LFO = 1.0 (pico)
    mod.applyModulation();

    float pitchMw0 = mod.getModulatedParameter (MD_Osc1Pitch);
    REQUIRE (pitchMw0 == Approx (0.0f)); // sin cambio de pitch

    // Caso 2: ModWheel = 1 -> vibrato máximo depthBase
    mod.modWheelFactor.store (1.0f);
    mod.sources[MS_Lfo1].current.store (1.0f); // mismo valor de LFO
    mod.applyModulation();

    float pitchMw1 = mod.getModulatedParameter (MD_Osc1Pitch);
    REQUIRE (pitchMw1 == Approx (0.3f)); // 1.0 * amount * 1.0

    // Caso 3: ModWheel = 0.5 -> vibrato mitad de profundidad
    mod.modWheelFactor.store (0.5f);
    mod.sources[MS_Lfo1].current.store (1.0f);
    mod.applyModulation();

    float pitchMw05 = mod.getModulatedParameter (MD_Osc1Pitch);
    REQUIRE (pitchMw05 == Approx (0.15f)); // 1.0 * 0.3 * 0.5
}
Este test confirma que tu lógica amount * ModWheel funciona linealmente y dentro de los límites de min/max del parámetro.

¿Te gustaría que en otro momento hagamos un test parecido pero usando también baseValue distinto de cero (por ejemplo, pitch base en +1 st más vibrato) para asegurarnos de que la suma base+modulación sigue siendo correcta?

En un test extra puedes verificar que baseValue se suma correctamente a la modulación escalada por ModWheel.

cpp
// Tests/TestModulationRuntime_ModWheel_BaseValue.cpp
#include <catch2/catch_test_macros.hpp>
#include "Modulation/ModulationRuntime.h"

using namespace OmegaDSPModulation;

TEST_CASE ("ModulationRuntime LFO pitch with baseValue and ModWheel", "[Modulation][ModWheel]")
{
    ModulationRuntime mod;
    mod.prepare (48000.0, 64);

    // Destino pitch: baseValue != 0
    mod.parameters[MD_Osc1Pitch].baseValue.store (1.0f); // +1 semitono base
    mod.parameters[MD_Osc1Pitch].min = -2.0f;
    mod.parameters[MD_Osc1Pitch].max =  2.0f;
    mod.parameters[MD_Osc1Pitch].modulatable = true;

    // Ruta LFO1 -> pitch, profundidad base 0.5 st
    mod.routes[0].sourceIndex   = MS_Lfo1;
    mod.routes[0].destParameter = MD_Osc1Pitch;
    mod.routes[0].amount        = 0.5f;
    mod.routes[0].curveType     = 0;
    mod.routes[0].bipolar       = true;
    mod.activeRouteCount        = 1;

    // LFO en pico positivo
    mod.sources[MS_Lfo1].current.store (1.0f);

    // Caso 1: ModWheel = 0 -> solo baseValue
    mod.modWheelFactor.store (0.0f);
    mod.applyModulation();
    float pitchMw0 = mod.getModulatedParameter (MD_Osc1Pitch);
    REQUIRE (pitchMw0 == Approx (1.0f)); // baseValue sin modulación

    // Caso 2: ModWheel = 1 -> base + 0.5 st
    mod.modWheelFactor.store (1.0f);
    mod.applyModulation();
    float pitchMw1 = mod.getModulatedParameter (MD_Osc1Pitch);
    REQUIRE (pitchMw1 == Approx (1.5f)); // 1.0 + (1.0 * 0.5 * 1.0)

    // Caso 3: ModWheel = 0.5 -> base + 0.25 st
    mod.modWheelFactor.store (0.5f);
    mod.applyModulation();
    float pitchMw05 = mod.getModulatedParameter (MD_Osc1Pitch);
    REQUIRE (pitchMw05 == Approx (1.25f)); // 1.0 + (1.0 * 0.5 * 0.5)
}
Este test garantiza que el flujo completo baseValue + LFO * amount * ModWheel se comporta como esperas para el pitch del Juno.

