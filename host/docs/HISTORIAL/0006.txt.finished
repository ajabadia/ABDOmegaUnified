AceCatalog + AceValidator + VoiceFactory para construir el runtime antes de llamar al engine.

Test de audio mínimo
Puedes escribir un test del estilo:

cpp
TEST_CASE("VirtualAnalogEngine renders a stable block with Juno preset", "[audio][va][juno]")
{
    // 1) Catálogo + preset + validación
    auto catalog = AceCatalog::createFromResources();
    REQUIRE(catalog != nullptr);

    OmegaPreset preset = OmegaPreset::fromYaml(juce::String{kJunoYaml});
    AceValidator validator{*catalog};
    auto report = validator.validateAndRepairPreset(preset);
    REQUIRE(report.status != ValidationStatus::Invalid);

    // 2) VoiceFactory -> runtime / config simple
    VoicePoolVA voicePool;
    voicePool.prepare(44100.0, 256);
    auto layerA = preset.getLayers()[0];
    auto rt = VoiceFactory::createRuntimeFromPresetLayer(layerA, *catalog, voicePool);

    VirtualAnalogEngine engine;
    engine.prepare(44100.0, 256);
    engine.setVoiceArchitecture(rt);

    // 3) Activar una voz a mano (nota 60)
    auto& voice0 = voicePool.getVoice(0);
    voice0.state.midiNote.store(60, std::memory_order_relaxed);
    voice0.state.velocity.store(1.0f, std::memory_order_relaxed);
    voice0.state.active.store(true, std::memory_order_release);

    // 4) Renderizar un bloque
    juce::AudioBuffer<float> buffer(2, 256);
    juce::MidiBuffer midi; // vacío; voz ya activada
    engine.renderNextBlock(buffer, midi);

    // 5) Comprobar que no es todo ceros ni NaN/inf
    bool anyNonZero = false;
    for (int ch = 0; ch < buffer.getNumChannels(); ++ch)
    {
        auto* d = buffer.getReadPointer(ch);
        for (int i = 0; i < buffer.getNumSamples(); ++i)
        {
            REQUIRE(std::isfinite(d[i]));
            if (std::abs(d[i]) > 1.0e-6f)
                anyNonZero = true;
        }
    }
    REQUIRE(anyNonZero);
}
Este test sólo exige: “suena algo estable con el preset Juno y no explota el engine”.
​

