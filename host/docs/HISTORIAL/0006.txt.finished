      filters:
        - slot: 1
          componentId: FLT-VA-001
          enabled: true
          mode: LP24
          params:
            cutoff: 2600.0      # vcfFreq 0x23 ≈ brillo medio
            resonance: 0.18     # resonance 0x0D
            drive: 0.0
      envelopes:
        - slot: 1
          componentId: ENV-ADSR-GEN
          role: amp
          params:
            attack: 8.0         # attack 0x03 → rápido
            decay: 210.0        # decay 0x31
            sustain: 0.70       # sustain 0x2D
            release: 260.0      # release 0x20
      lfos:
        - slot: 1
          componentId: LFO-001
          params:
            rate: 0.5
            shape: sine
            delay: 0.0
      fx:
        - slot: 1
          componentId: FX-CH-001
          enabled: true
          params:
            mix: 0.30
            mode: I
    layerparams:
      levelDb: 0.0
      pan: 0.0
      mainCutoffHz: 2600.0
      mainResonance: 0.18
      envAmount: 0.70        # envAmount 0x3A → brass con “bite”
      lfoRateHz: 0.5
      lfoDepthSemis: 0.0
      ampEnv:
        attackMs: 8.0
        decayMs: 210.0
        sustain: 0.70
        releaseMs: 260.0
modulationroutes:
  - source: ENV1
    destination: LayerA.Filter1.cutoff
    amount: 0.70
    curve: exponential
    bipolar: false
JN-BRASS-B55 (ensemble tipo B55)
Basado en B55 “Brass Ensemble”: más suave y pad‑brass.
​

text
omegapresetversion: 1
id: JN-BRASS-B55
name: JN Brass B55 Ensemble
author: abdeneurolab
engine: VirtualAnalog
tags: [brass,ensemble,juno,roland,va,pad-brass]
layers:
  - id: A
    name: Juno Brass B55
    polyphony: 6
    voicearchitecture:
      oscillators:
        - slot: 1
          componentId: OSC-VA-001
          enabled: true
          params:
            tune: 0.0
            pulsewidth: 0.5
            sublevel: 0.30
      filters:
        - slot: 1
          componentId: FLT-VA-001
          enabled: true
          mode: LP24
          params:
            cutoff: 2400.0      # vcfFreq más contenido que A11
            resonance: 0.16
            drive: 0.0
      envelopes:
        - slot: 1
          componentId: ENV-ADSR-GEN
          role: amp
          params:
            attack: 18.0        # algo más lento, brass/ensemble
            decay: 260.0
            sustain: 0.75
            release: 380.0
      lfos:
        - slot: 1
          componentId: LFO-001
          params:
            rate: 0.45
            shape: sine
            delay: 0.0
      fx:
        - slot: 1
          componentId: FX-CH-001
          enabled: true
          params:
            mix: 0.40           # más chorus, sensación ensemble
            mode: I
    layerparams:
      levelDb: 0.0
      pan: 0.0
      mainCutoffHz: 2400.0
      mainResonance: 0.16
      envAmount: 0.55        # menos agresivo que A11
      lfoRateHz: 0.45
      lfoDepthSemis: 0.0
