2) Clase DSP C++ para OSC‑VA‑001
Una implementación VA directa y limpia (PolyBLEP + PWM + sub), sin dependencias de JUCE:

cpp
// DSP/VA/OscillatorJunoDcoVA.h
#pragma once
#include <cmath>
#include <algorithm>

namespace OmegaDSP::VA
{
    class OscillatorJunoDcoVA
    {
    public:
        void prepare(double sampleRate) noexcept
        {
            sr = sampleRate > 0.0 ? sampleRate : 44100.0;
            phaseSaw = 0.0;
            phaseSub = 0.0;
        }

        // freqHz: frecuencia base ya con tune+LFO+bend aplicados
        // pulseWidth: 0..1 (se mapeará internamente a duty 0.50..0.95)
        // subLevel: 0..1
        void process(float* stereoInterleaved, int numSamples,
                     float freqHz, float pulseWidth, float subLevel) noexcept
        {
            if (!stereoInterleaved || numSamples <= 0)
                return;

            // Clamp mínimos para estabilidad
            const float f = std::max(freqHz, 0.1f);
            const float duty = 0.50f + 0.45f * std::clamp(pulseWidth, 0.0f, 1.0f);
            const float sub = std::clamp(subLevel, 0.0f, 1.0f);

            const float incSaw = static_cast<float>(f / sr);
            const float incSub = static_cast<float>((f * 0.5) / sr); // suboctava

            for (int i = 0; i < numSamples; ++i)
            {
                // Saw va [0,1)
                float saw = phaseSaw;
                saw += incSaw;
                if (saw >= 1.0f) saw -= 1.0f;

                // PolyBLEP en la saw para suavizar discontinuidad
                float outSaw = polyBlepSaw(phaseSaw, incSaw);
                phaseSaw = saw;

                // Square/PWM derivada de la saw
                float square = (phaseSaw < duty) ? 1.0f : -1.0f;

                // Sub osc square a mitad de frecuencia
                float sqSub = (phaseSub < 0.5f) ? 1.0f : -1.0f;
                phaseSub += incSub;
                if (phaseSub >= 1.0f) phaseSub -= 1.0f;

                // Mezcla: saw principal + PWM + sub
                float osc = outSaw;
                osc += 0.5f * square;     // peso PWM
                osc += sub * sqSub;       // peso sub

                // Normalizar un poco la mezcla para evitar clipping
                osc *= 0.33f;

                // Estéreo idéntico (pan se aplica después por layer)
                stereoInterleaved[2 * i + 0] += osc;
                stereoInterleaved[2 * i + 1] += osc;
            }
        }

    private:
        double sr {44100.0};
        float phaseSaw {0.0f};
        float phaseSub {0.0f};

        // PolyBLEP saw básica
        static float polyBlepSaw(float phase, float dt) noexcept
        {
            // Saw naive en -1..1
            float t = phase;
            float y = 2.0f * t - 1.0f;

            // Inicio del salto
            if (t < dt)
            {
                float x = t / dt;
                y -= (x + x - x * x - 1.0f);
            }
            // Final del salto
            else if (t > 1.0f - dt)
            {
                float x = (t - 1.0f) / dt;
                y += (x * x + x + x + 1.0f);
            }

            return y;
        }
    };
}
