VirtualAnalogEngine (firmas clave)
cpp
// DSP/Engines/VirtualAnalogEngine.h
#pragma once
#include <juce_audio_basics/juce_audio_basics.h>
#include "DSP/Voices/VoiceRuntimeVA.h"
#include "DSP/Voices/VoiceArchitectureRuntimeVA.h"
#include "DSP/VA/OscillatorPoolJunoDco.h"
#include "DSP/VA/FilterPoolJunoIR3109.h"
#include "DSP/VA/ChorusPoolJunoStub.h"
#include "Core/Settings/LayerASettings.h"

namespace OmegaDSP::Engines
{
    class VirtualAnalogEngine
    {
    public:
        VirtualAnalogEngine() = default;

        void prepare(double sampleRate, int samplesPerBlock) noexcept;
        void reset() noexcept;

        void setVoiceArchitecture(const OmegaDSP::Voices::VoiceArchitectureRuntimeVA& arch) noexcept;
        void setLayerSettings(const LayerASettings* settings) noexcept;

        void renderNextBlock(juce::AudioBuffer<float>& buffer,
                             const juce::MidiBuffer& midi) noexcept;

        OmegaDSP::Voices::VoicePoolVA& getVoicePool() noexcept { return voicePool; }

    private:
        double sampleRate {44100.0};
        int blockSize {256};

        OmegaDSP::Voices::VoicePoolVA voicePool;
        OmegaDSP::Voices::VoiceArchitectureRuntimeVA voiceArch;

        const LayerASettings* layerSettings {nullptr};

        OmegaDSP::VA::OscillatorPoolJunoDco oscPool;
        OmegaDSP::VA::FilterPoolJunoIR3109 filterPool;
        OmegaDSP::VA::ChorusPoolJunoStub chorusPool;
    };
}
cpp
// DSP/Engines/VirtualAnalogEngine.cpp
#include "VirtualAnalogEngine.h"

namespace OmegaDSP::Engines
{
    using namespace OmegaDSP::Voices;

    void VirtualAnalogEngine::prepare(double sr, int samplesPerBlock) noexcept
    {
        sampleRate = sr > 0.0 ? sr : 44100.0;
        blockSize  = samplesPerBlock;

        voicePool.prepare(sampleRate, blockSize);
        oscPool.prepare(sampleRate);
        filterPool.prepare(sampleRate);
        chorusPool.prepare(sampleRate);
    }

    void VirtualAnalogEngine::reset() noexcept
    {
        voicePool.resetAll();
        oscPool.reset();
        filterPool.reset();
        chorusPool.reset();
    }

    void VirtualAnalogEngine::setVoiceArchitecture(const VoiceArchitectureRuntimeVA& arch) noexcept
    {
        voiceArch = arch;
    }

    void VirtualAnalogEngine::setLayerSettings(const LayerASettings* s) noexcept
    {
        layerSettings = s;
    }

    void VirtualAnalogEngine::renderNextBlock(juce::AudioBuffer<float>& buffer,
                                              const juce::MidiBuffer& midi) noexcept
    {
        juce::ignoreUnused(midi);

        const int numSamples = buffer.getNumSamples();
        buffer.clear();

        if (layerSettings == nullptr)
            return;

        const float cutoff = layerSettings->cutoffHz.load(std::memory_order_relaxed);
        const float res    = layerSettings->resonance.load(std::memory_order_relaxed);
        const float envAmt = layerSettings->envAmount.load(std::memory_order_relaxed);

        const int numVoices = voiceArch.numVoices;

        for (int v = 0; v < numVoices; ++v)
        {
            auto& voice = voicePool.getVoice(v);
            if (!voice.state.active.load(std::memory_order_relaxed))
                continue;

            float* voiceBuf = voice.buffer.data();
            std::fill(voiceBuf, voiceBuf + numSamples * 2, 0.0f);

            const int midiNote = voice.state.midiNote.load(std::memory_order_relaxed);
            const float baseHz = 440.0f * std::pow(2.0f, (midiNote - 69) / 12.0f);

            if (voice.oscEnabled)
                oscPool.process(static_cast<std::uint16_t>(v), voiceBuf, numSamples, baseHz, 0.5f);

            // TODO: env (envAmt) cuando tengas ADSR real

            if (voice.fltEnabled)
                filterPool.process(static_cast<std::uint16_t>(v), voiceBuf, numSamples, cutoff, res, 0.0f);

            if (voice.fxEnabled)
                chorusPool.process(static_cast<std::uint16_t>(v), voiceBuf, numSamples, 0.7f);

            auto* outL = buffer.getWritePointer(0);
            auto* outR = buffer.getNumChannels() > 1 ? buffer.getWritePointer(1) : nullptr;

            for (int i = 0; i < numSamples; ++i)
            {
                const float sL = voiceBuf[i * 2 + 0];
                const float sR = voiceBuf[i * 2 + 1];

                outL[i] += sL;
                if (outR)
                    outR[i] += sR;
            }
        }
    }
}
Con estas firmas ya puedes:

Rellenar la lógica DSP interna poco a poco.

Usar el test de audio que comentamos para verificar que el bloque se genera sin crash.

¿Quieres que el próximo micro‑paso sea detallar sólo el DCO sencillo (saw per voz) dentro de OscillatorPoolJunoDco para que puedas oír algo cuanto antes?


Para oír algo ya, usa un DCO naive saw por voz con fase acumulada.

DCO interno por voz
cpp
// DSP/VA/JunoDco.h
#pragma once
#include <cmath>

namespace OmegaDSP::VA
{
    struct JunoDco
    {
        void prepare(double sampleRate) noexcept
        {
            sr = sampleRate > 0.0 ? sampleRate : 44100.0;
            phase = 0.0f;
        }

        void reset() noexcept
        {
            phase = 0.0f;
        }

        void setFrequency(float hz) noexcept
        {
            freq = hz;
            phaseInc = static_cast<float>(freq / sr);
        }

        float tick() noexcept
        {
            phase += phaseInc;
            if (phase >= 1.0f)
                phase -= 1.0f;

            // Saw -1..1
            return 2.0f * phase - 1.0f;
        }

    private:
        double sr   {44100.0};
        float  freq {440.0f};
        float  phase{0.0f};
        float  phaseInc {0.0f};
    };
}
OscillatorPoolJunoDco con un DCO por voz
cpp
// DSP/VA/OscillatorPoolJunoDco.h
#pragma once
#include <array>
#include <cstdint>
#include "DSP/Voices/VoiceRuntimeVA.h"
#include "DSP/VA/JunoDco.h"

namespace OmegaDSP::VA
{
    class OscillatorPoolJunoDco
    {
    public:
        void prepare(double sampleRate) noexcept;
        void reset() noexcept;

        void process(std::uint16_t voiceIndex,
                     float* interleavedStereo,
                     int numSamples,
                     float baseFreqHz,
                     float pulseWidth) noexcept;

    private:
        double sampleRate {44100.0};
        std::array<JunoDco, OmegaDSP::Voices::kMaxVoicesVA> dcos;
    };
}
cpp
// DSP/VA/OscillatorPoolJunoDco.cpp
#include "OscillatorPoolJunoDco.h"

namespace OmegaDSP::VA
{
    void OscillatorPoolJunoDco::prepare(double sr) noexcept
    {
        sampleRate = sr > 0.0 ? sr : 44100.0;
        for (auto& d : dcos)
            d.prepare(sampleRate);
    }

    void OscillatorPoolJunoDco::reset() noexcept
    {
        for (auto& d : dcos)
            d.reset();
    }

    void OscillatorPoolJunoDco::process(std::uint16_t voiceIndex,
                                        float* interleavedStereo,
                                        int numSamples,
                                        float baseFreqHz,
                                        float pulseWidth) noexcept
    {
        (void)pulseWidth; // aún no lo usamos

        if (!interleavedStereo || numSamples <= 0)
            return;

        auto& dco = dcos[voiceIndex];
        dco.setFrequency(baseFreqHz);

        for (int i = 0; i < numSamples; ++i)
        {
            const float s = dco.tick(); // -1..1
            interleavedStereo[i * 2 + 0] += s;
            interleavedStereo[i * 2 + 1] += s;
        }
    }
}
Con esto, el test de bloque que teníamos debería empezar a producir una onda de sierra clara por voz.
​

¿Te apetece que el siguiente micro‑paso sea meter el LPF 4‑pole sencillo en FilterPoolJunoIR3109 para notar cutoff/resonance del Juno MVP?

La forma más sencilla y limpia para tu MVP es usar PolyBLEP sobre tu sierra naive; encaja bien con tu DCO actual y no necesita tablas.

1) Función PolyBLEP escalar
cpp
inline float polyBlep(float t, float dt) noexcept
{
    // t en [0,1), dt = freq / sampleRate
    if (t < dt) // inicio de periodo
    {
        t /= dt;
        return t + t - t * t - 1.0f;
    }
    else if (t > 1.0f - dt) // final de periodo
    {
        t = (t - 1.0f) / dt;
        return t * t + t + t + 1.0f;
    }

    return 0.0f;
}
2) JunoDco con PolyBLEP
cpp
// DSP/VA/JunoDco.h
#pragma once
#include <cmath>

namespace OmegaDSP::VA
{
    inline float polyBlep(float t, float dt) noexcept
    {
        if (t < dt)
        {
            t /= dt;
            return t + t - t * t - 1.0f;
        }
        else if (t > 1.0f - dt)
        {
            t = (t - 1.0f) / dt;
            return t * t + t + t + 1.0f;
        }
        return 0.0f;
    }

    struct JunoDco
    {
        void prepare(double sampleRate) noexcept
        {
            sr = sampleRate > 0.0 ? sampleRate : 44100.0;
            phase = 0.0f;
        }

        void reset() noexcept
        {
            phase = 0.0f;
        }

        void setFrequency(float hz) noexcept
        {
            freq = hz;
            phaseInc = static_cast<float>(freq / sr);   // dt relativo
        }

        float tick() noexcept
        {
            // fase 0..1
            phase += phaseInc;
            if (phase >= 1.0f)
                phase -= 1.0f;

            const float t  = phase;
            const float dt = phaseInc;

            // sierra naive -1..1
            float y = 2.0f * t - 1.0f;

            // corregir discontinuidad con PolyBLEP
            y -= polyBlep(t, dt);

            return y;
        }

    private:
        double sr   {44100.0};
        float  freq {440.0f};
        float  phase{0.0f};
        float  phaseInc {0.0f};
    };
}
Esto sigue exactamente el patrón de los tutoriales de PolyBLEP (saw naive + PolyBLEP en el salto) y reduce de forma notable el aliasing a altas frecuencias con un coste bajo.

3) Pool: no tienes que tocar la firma
Tu OscillatorPoolJunoDco::process queda igual, solo se beneficia del nuevo tick():

cpp
void OscillatorPoolJunoDco::process(std::uint16_t voiceIndex,
                                    float* interleavedStereo,
                                    int numSamples,
                                    float baseFreqHz,
                                    float pulseWidth) noexcept
{
    (void)pulseWidth;

    if (!interleavedStereo || numSamples <= 0)
        return;

    auto& dco = dcos[voiceIndex];
    dco.setFrequency(baseFreqHz);

    for (int i = 0; i < numSamples; ++i)
    {
        const float s = dco.tick();
        interleavedStereo[i * 2 + 0] += s;
        interleavedStereo[i * 2 + 1] += s;
    }
}
Con esto ya tienes un oscilador de sierra antialiasing razonable para el Juno MVP sin cambiar tu arquitectura.

¿Quieres que el siguiente paso sea adaptar este mismo PolyBLEP para una square/pulse (para cuando añadas PWM) o prefieres que pasemos ya al LPF 4‑pole para notar cutoff/resonancia?


Para una square/pulse PolyBLEP basta con corregir dos discontinuidades por periodo: subida y bajada, una en la fase 0 y otra en la fase pw.

1) Square/pulse PolyBLEP
Usamos la misma polyBlep(t, dt) que ya tienes para la sierra.

cpp
inline float polyBlep(float t, float dt) noexcept
{
    if (t < dt)
    {
        t /= dt;
        return t + t - t * t - 1.0f;
    }
    else if (t > 1.0f - dt)
    {
        t = (t - 1.0f) / dt;
        return t * t + t + t + 1.0f;
    }
    return 0.0f;
}
Square/pulse naive: +1 hasta pw, luego −1.

cpp
// t: fase 0..1, pw: 0..1
inline float naivePulse(float t, float pw) noexcept
{
    return (t < pw) ? 1.0f : -1.0f;
}
Ahora aplicamos PolyBLEP en los dos bordes: subida en 0, bajada en pw.

cpp
inline float polyBlepPulse(float t, float dt, float pw) noexcept
{
    // naive pulse -1..1
    float y = (t < pw) ? 1.0f : -1.0f;

    // salto en t = 0 (rising edge)
    y += polyBlep(t, dt);

    // salto en t = pw (falling edge), desplazamos fase
    float tp = std::fmod(t - pw + 1.0f, 1.0f);
    y -= polyBlep(tp, dt);

    return y;
}
2) Integrarlo en tu JunoDco
Extiende el DCO para soportar modo saw/pulse con PWM:

cpp
namespace OmegaDSP::VA
{
    enum class DcoWave : std::uint8_t { Saw, Pulse };

    struct JunoDco
    {
        void prepare(double sampleRate) noexcept { sr = sampleRate > 0.0 ? sampleRate : 44100.0; phase = 0.0f; }
        void reset() noexcept { phase = 0.0f; }
        void setFrequency(float hz) noexcept
        {
            freq = hz;
            phaseInc = static_cast<float>(freq / sr);
        }

        void setWave(DcoWave w) noexcept { wave = w; }
        void setPulseWidth(float pw) noexcept
        {
            // clamp para evitar bordes degenerados
            pulseWidth = std::clamp(pw, 0.01f, 0.99f);
        }

        float tick() noexcept
        {
            phase += phaseInc;
            if (phase >= 1.0f)
                phase -= 1.0f;

            const float t  = phase;
            const float dt = phaseInc;

            if (wave == DcoWave::Saw)
            {
                float y = 2.0f * t - 1.0f;
                y -= polyBlep(t, dt);
                return y;
            }
            else // Pulse (square/PWM)
            {
                float y = (t < pulseWidth) ? 1.0f : -1.0f;
                y += polyBlep(t, dt); // edge en 0
                float tp = std::fmod(t - pulseWidth + 1.0f, 1.0f);
                y -= polyBlep(tp, dt); // edge en pw
                return y;
            }
        }

    private:
        double   sr   {44100.0};
        float    freq {440.0f};
        float    phase{0.0f};
        float    phaseInc {0.0f};
        DcoWave  wave {DcoWave::Saw};
        float    pulseWidth {0.5f}; // 50%
    };
}
En tu OscillatorPoolJunoDco::process, cuando empieces a usar PWM real desde parámetros:

cpp
auto& dco = dcos[voiceIndex];
dco.setFrequency(baseFreqHz);
dco.setWave(DcoWave::Pulse);          // o Saw
dco.setPulseWidth(pulseWidth);        // 0..1 desde preset/UI
Con esto tienes sierra PolyBLEP y square/PWM PolyBLEP listas para el Juno MVP con un coste muy razonable.

¿Quieres que el próximo paso sea aplicar este DCO pulse+PWM al preset Juno (tune + pulsewidth + sublevel) o prefieres que pasemos ya al filtro 4‑pole para notar bien cutoff y resonance?


Para aplicar el DCO saw/pulse+PWM al preset Juno sólo tienes que leer tune, pulsewidth y sublevel del preset y usarlos en el pool del oscilador.
​

1) Leer parámetros del preset en VoiceFactory
En tu VoiceRuntimeVA ya tienes oscTuneSemis, oscPulseWidth, oscSubLevel (si no, añádelos).
​

cpp
// En VoiceFactory::createRuntimeFromPresetLayer
if (!layer.voiceArch.oscillators.isEmpty())
{
    const auto& oscSlot = layer.voiceArch.oscillators[0];

    for (int v = 0; v < rt.numVoices; ++v)
    {
        auto& voice = voicePool.getVoice(v);

        voice.oscEnabled   = oscSlot.enabled;
        voice.oscIndex     = 0; // un DCO por voz en el pool

        // Params de preset
        const auto& p = oscSlot.params;
        voice.oscTuneSemis  = p.at("tune");       // float
        voice.oscPulseWidth = p.at("pulsewidth"); // 0..1
        voice.oscSubLevel   = p.at("sublevel");   // 0..1
    }
}
2) Usar tune/pulsewidth/sublevel en OscillatorPoolJunoDco
Suponiendo que quieres: wave principal = pulse PolyBLEP con PWM, sub‑osc = saw una octava abajo mezclado por sublevel.

cpp
// OscillatorPoolJunoDco.h (añade un DCO para main y otro para sub)
std::array<JunoDco, OmegaDSP::Voices::kMaxVoicesVA> mainDco;
std::array<JunoDco, OmegaDSP::Voices::kMaxVoicesVA> subDco;
cpp
// OscillatorPoolJunoDco.cpp
void OscillatorPoolJunoDco::prepare(double sr) noexcept
{
    sampleRate = sr > 0.0 ? sr : 44100.0;
    for (auto& d : mainDco) d.prepare(sampleRate);
    for (auto& d : subDco)  d.prepare(sampleRate);
}

void OscillatorPoolJunoDco::reset() noexcept
{
    for (auto& d : mainDco) d.reset();
    for (auto& d : subDco)  d.reset();
}

// process con tune, pw, sublevel
void OscillatorPoolJunoDco::process(std::uint16_t voiceIndex,
                                    float* interleavedStereo,
                                    int numSamples,
                                    float baseFreqHz,
                                    float pulseWidth,
                                    float tuneSemis,
                                    float subLevel) noexcept
{
    if (!interleavedStereo || numSamples <= 0)
        return;

    auto& dcoMain = mainDco[voiceIndex];
    auto& dcoSub  = subDco[voiceIndex];

    // Frecuencia principal con afinación en semitonos
    const float pitchRatio = std::pow(2.0f, tuneSemis / 12.0f);
    const float freqMain   = baseFreqHz * pitchRatio;
    const float freqSub    = freqMain * 0.5f; // sub‑osc 1 octava abajo

    dcoMain.setWave(DcoWave::Pulse);
    dcoMain.setPulseWidth(pulseWidth);
    dcoMain.setFrequency(freqMain);

    dcoSub.setWave(DcoWave::Saw);     // sub como saw
    dcoSub.setPulseWidth(0.5f);
    dcoSub.setFrequency(freqSub);

    const float subGain = std::clamp(subLevel, 0.0f, 1.0f);

    for (int i = 0; i < numSamples; ++i)
    {
        const float mainS = dcoMain.tick();
        const float subS  = dcoSub.tick();

        const float s = mainS + subGain * subS;

        interleavedStereo[i * 2 + 0] += s;
        interleavedStereo[i * 2 + 1] += s;
    }
}
3) Llamar al pool desde el engine con esos valores
En VirtualAnalogEngine::renderNextBlock, usa los campos del voice:

cpp
if (voice.oscEnabled)
{
    oscPool.process(static_cast<std::uint16_t>(v),
                    voiceBuf,
                    numSamples,
                    baseHz,
                    voice.oscPulseWidth,
                    voice.oscTuneSemis,
                    voice.oscSubLevel);
}
Con esto tu preset Juno (tune, pulsewidth, sublevel) ya controla el DCO PolyBLEP pulse+PWM+sub en el engine VA real.
​

¿Quieres que el siguiente paso sea hacer lo mismo con el filtro (usar cutoff y resonance del preset en FilterPoolJunoIR3109 para que el YAML mande de verdad)?


Para que el preset Juno mande de verdad sobre el filtro, necesitas: leer cutoff y resonance del YAML en VoiceFactory y usarlos en FilterPoolJunoIR3109 (aunque el filtro sea una aproximación 4‑pole por biquads).
​

1) Leer cutoff/resonance del preset en VoiceFactory
En tu VoiceRuntimeVA añade, si no los tienes ya:

cpp
// VoiceRuntimeVA.h
float fltCutoffHz  {2000.0f};
float fltResonance {0.2f};
En VoiceFactory::createRuntimeFromPresetLayer:

cpp
if (!layer.voiceArch.filters.isEmpty())
{
    const auto& fltSlot = layer.voiceArch.filters[0];

    for (int v = 0; v < rt.numVoices; ++v)
    {
        auto& voice = voicePool.getVoice(v);

        voice.fltEnabled = fltSlot.enabled;
        voice.fltIndex   = 0; // un filtro por voz en el pool

        const auto& p = fltSlot.params;
        voice.fltCutoffHz  = p.at("cutoff");    // 20..20000
        voice.fltResonance = p.at("resonance"); // 0..1
    }
}
Así, los valores del YAML ACE-JUNO-BASIC-PAD quedan copiados a cada voz.

2) Usar esos campos en el engine al llamar al pool
En VirtualAnalogEngine::renderNextBlock:

cpp
if (voice.fltEnabled)
{
    const float cutoffHz  = voice.fltCutoffHz;
    const float resoNorm  = voice.fltResonance; // 0..1
    const float drive     = 0.0f;               // más adelante

    filterPool.process(static_cast<std::uint16_t>(v),
                       voiceBuf,
                       numSamples,
                       cutoffHz,
                       resoNorm,
                       drive);
}
Puedes seguir usando LayerASettings como macro global si quieres (por ejemplo para barrer cutoff desde UI), pero el valor de preset base viene ahora de voice.fltCutoffHz. Una opción muy simple es mezclar ambos:

cpp
const float macroCutoff = layerSettings->cutoffHz.load(std::memory_order_relaxed);
const float baseCutoff  = voice.fltCutoffHz;

// Por ahora, usa macro si existe (>0), si no usa preset
const float cutoffHz = (macroCutoff > 0.0f ? macroCutoff : baseCutoff);
3) Filtro 4‑pole sencillo en FilterPoolJunoIR3109
Para notar claramente cutoff/resonancia, basta un 4‑pole LP con biquads en cascada, como sugiere EarLevel (dos LP biquad → 24 dB/oct).
​

cpp
// DSP/VA/JunoIr3109Filter.h
#pragma once
#include <array>
#include <cmath>

namespace OmegaDSP::VA
{
    struct BiquadLP
    {
        void setLowPass(double sampleRate, float cutoffHz, float q) noexcept
        {
            const float omega = 2.0f * float(M_PI) * (cutoffHz / float(sampleRate));
            const float sn    = std::sin(omega);
            const float cs    = std::cos(omega);
            const float alpha = sn / (2.0f * q);

            float b0 = (1.0f - cs) * 0.5f;
            float b1 = 1.0f - cs;
            float b2 = (1.0f - cs) * 0.5f;
            float a0 = 1.0f + alpha;
            float a1 = -2.0f * cs;
            float a2 = 1.0f - alpha;

            b0_ = b0 / a0;
            b1_ = b1 / a0;
            b2_ = b2 / a0;
            a1_ = a1 / a0;
            a2_ = a2 / a0;
        }

        void reset() noexcept { z1_ = z2_ = 0.0f; }

        float process(float x) noexcept
        {
            const float y = b0_ * x + b1_ * z1_ + b2_ * z2_ - a1_ * y1_ - a2_ * y2_;
            z2_ = z1_;
            z1_ = x;
            y2_ = y1_;
            y1_ = y;
            return y;
        }

    private:
        float b0_ {0}, b1_ {0}, b2_ {0};
        float a1_ {0}, a2_ {0};
        float z1_ {0}, z2_ {0};
        float y1_ {0}, y2_ {0};
    };

    struct JunoIr3109Filter
    {
        void prepare(double sampleRate) noexcept
        {
            sr = sampleRate > 0.0 ? sampleRate : 44100.0;
            for (auto& s : stages)
                s.reset();
        }

        void update(float cutoffHz, float resonanceNorm) noexcept
        {
            // Mapear 0..1 a Q razonable (Butterworth ~0.707)
            const float q = 0.707f + resonanceNorm * 10.0f;
            for (auto& s : stages)
                s.setLowPass(sr, cutoffHz, q);
        }

        void processBlock(float* interleavedStereo, int numSamples) noexcept
        {
            if (!interleavedStereo || numSamples <= 0)
                return;

            for (int i = 0; i < numSamples; ++i)
            {
                float l = interleavedStereo[i * 2 + 0];
                float r = interleavedStereo[i * 2 + 1];

                // 2 biquads en serie → 4‑pole
                for (auto& s : stages)
                {
                    l = s.process(l);
                    r = s.process(r);
                }

                interleavedStereo[i * 2 + 0] = l;
                interleavedStereo[i * 2 + 1] = r;
            }
        }

    private:
        double sr {44100.0};
        std::array<BiquadLP, 2> stages;
    };
}
Y en FilterPoolJunoIR3109:

cpp
// FilterPoolJunoIR3109.h
#include <array>
#include "DSP/VA/JunoIr3109Filter.h"
#include "DSP/Voices/VoiceRuntimeVA.h"

namespace OmegaDSP::VA
{
    class FilterPoolJunoIR3109
    {
    public:
        void prepare(double sampleRate) noexcept;
        void reset() noexcept;

        void process(std::uint16_t voiceIndex,
                     float* interleavedStereo,
                     int numSamples,
                     float cutoffHz,
                     float resonance,
                     float drive) noexcept;

    private:
        double sampleRate {44100.0};
        std::array<JunoIr3109Filter, OmegaDSP::Voices::kMaxVoicesVA> filters;
    };
}
cpp
// FilterPoolJunoIR3109.cpp
#include "FilterPoolJunoIR3109.h"

namespace OmegaDSP::VA
{
    void FilterPoolJunoIR3109::prepare(double sr) noexcept
    {
        sampleRate = sr > 0.0 ? sr : 44100.0;
        for (auto& f : filters)
            f.prepare(sampleRate);
    }

    void FilterPoolJunoIR3109::reset() noexcept
    {
        for (auto& f : filters)
            f.prepare(sampleRate);
    }

    void FilterPoolJunoIR3109::process(std::uint16_t voiceIndex,
                                       float* interleavedStereo,
                                       int numSamples,
                                       float cutoffHz,
                                       float resonance,
                                       float drive) noexcept
    {
        (void)drive; // futuro

        if (!interleavedStereo || numSamples <= 0)
            return;

        auto& f = filters[voiceIndex];
        f.update(cutoffHz, resonance);
        f.processBlock(interleavedStereo, numSamples);
    }
}
Con esto:

cutoff/resonance del preset Juno se copian a cada voz.

El engine llama al pool con esos valores por voz.

El filtro 4‑pole responde claramente a cutoff y reso, aunque no sea aún un IR3109 fiel.

¿Te va bien que el próximo paso sea usar envAmount + tu ADSR para modular ese cutoff efectivo, de forma que ya tengas el típico movimiento Juno (brass/pad) encima de este filtro?


La idea es: tomar la salida 0..1 de tu ADSR por voz, centrarla, multiplicarla por envAmount y convertir eso en un desplazamiento exponencial de cutoff en semitonos/octavas.

1) ADSR por voz ya integrado
Suponiendo que ya tienes algo como voice.ampEnv.getNextSample() devolviendo 0..1 por muestra, reutilizamos esa misma envolvente para el filtro (como en un Juno real).
​
​

2) Función helper: env → cutoff efectivo
Añade una función en VirtualAnalogEngine.cpp:

cpp
namespace
{
    // baseCutoffHz: cutoff del preset/macros
    // env01: salida ADSR 0..1
    // envAmount: control de cantidad, por ejemplo -1..1
    float computeEnvModulatedCutoff(float baseCutoffHz,
                                    float env01,
                                    float envAmount)
    {
        // centrar la envolvente (colina)
        const float centered = env01 - 0.5f;          // -0.5..0.5

        // profundidad en semitonos: p.ej. hasta +/-24
        const float maxSemis = 24.0f;
        const float semis    = centered * envAmount * maxSemis;

        // desplazar cutoff en semis alrededor de baseCutoffHz
        const float factor = std::pow(2.0f, semis / 12.0f);
        float eff = baseCutoffHz * factor;

        // limitar a rango útil
        if (eff < 20.0f)    eff = 20.0f;
        if (eff > 20000.0f) eff = 20000.0f;
        return eff;
    }
}
Esto implementa exactamente “la envolvente mueve el cutoff desde su posición de knob, la cantidad la define envAmount”, como se describe en la literatura de filtros y en debates de env amount.

3) Usarlo en el bucle de voz
En VirtualAnalogEngine::renderNextBlock, dentro del bucle de voces:

cpp
const float baseCutoffPreset = voice.fltCutoffHz;
const float envAmtMacro      = layerSettings->envAmount.load(std::memory_order_relaxed);

// Por simplicidad MVP: un valor medio de la env para el bloque
float envSum = 0.0f;

for (int i = 0; i < numSamples; ++i)
{
    const float env = voice.ampEnv.getNextSample(); // 0..1

    envSum += env;

    // aplicar env al amp aquí si quieres:
    voiceBuf[i * 2 + 0] *= env;
    voiceBuf[i * 2 + 1] *= env;
}

const float envAvg = envSum / float(numSamples);

// Cutoff efectivo con env
const float cutoffEff = computeEnvModulatedCutoff(baseCutoffPreset,
                                                  envAvg,
                                                  envAmtMacro);

if (voice.fltEnabled)
{
    filterPool.process(static_cast<std::uint16_t>(v),
                       voiceBuf,
                       numSamples,
                       cutoffEff,
                       voice.fltResonance,
                       0.0f);
}
Más adelante puedes pasar a audio‑rate (cutoff por muestra) llamando a computeEnvModulatedCutoff dentro del loop de i y moviendo la actualización del filtro a per‑sample o a segmentos pequeños, pero para el MVP tipo Juno con pads y brass, un valor por bloque ya da un comportamiento musical aceptable.

Con esto:

envAmount del preset/UI escala cuánto sube/baja el filtro.

La envolvente de amp da el típico “whoosh” Juno en cutoff usando el mismo ADSR.
​
​

¿Quieres que el siguiente paso sea añadir un test rápido que compruebe que, al subir envAmount, el RMS del bloque filtrado cambia de forma coherente (para validar que la modulación está entrando)?


Para un brass Juno clásico necesitas un ataque rápido pero no instantáneo, decaimiento medio, sustain medio‑bajo y release corto‑medio, tanto en amp como en filtro.

Valores orientativos en tu MVP (ms / nivel)
Para la envolvente de amplitud (amp):

Attack: 5–15 ms → golpe inmediato pero algo redondeado (no “click”).
​
​

Decay: 150–300 ms → caída después del ataque que da el “punch” de los metales.

Sustain: 0.4–0.7 → el cuerpo sostenido es claramente más bajo que el pico inicial.
​
​

Release: 100–300 ms → cola corta pero audible, que no emborrona frases rápidas.

En tu preset YAML Juno puedes dejar algo como:

text
ampAttackMs: 10.0
ampDecayMs: 180.0
ampSustain: 0.6
ampReleaseMs: 180.0
Envolvente de filtro + EnvAmount
Para el filtro en un brass Juno la envolvente suele ser algo más marcada (para el “wah”) pero con tiempos similares:

attack filtro muy rápido (igual o un poco más corto que el de amp): 5–10 ms.

decay filtro algo más largo que el de amp para que el brillo se cierre después del cuerpo: 200–350 ms.
​
​

sustain filtro medio‑bajo (0.3–0.5), de forma que la nota sostenida queda más oscura que el ataque.
​
​

EnvAmount en tu macro: 0.5–0.8 para un brass marcado; menos si quieres algo más suave.
​
​

Como tu MVP usa la misma ADSR para amp y filtro, puedes empezar con estos valores (muy próximos a los que ya fijaste en el preset) y dejar que envAmount controle cuánta “bocanada” de filtro hay:
​

text
envAmount: 0.6   # más “brass” que el 0.5 neutro
Resumen rápido de una receta Juno brass
Amp ADSR: 10 / 180 / 0.6 / 180 ms.

Filtro: cutoff base medio (1.5–2 kHz), resonance moderada (0.2–0.3), misma ADSR, EnvAmount 0.6–0.8.
​

¿Quieres que te proponga directamente un bloque layerParams + envelopes completo en YAML para tu ACE-JUNO-BASIC-BRASS usando justo estos tiempos?


Aquí tienes un bloque de preset listo para un ACE-JUNO-BASIC-BRASS usando los tiempos y curvas típicas de brass Juno.
​

layerParams para brass
text
layerParams:
  levelDb: 0.0
  pan: 0.0

  # Filtro base
  mainCutoffHz: 1800.0      # algo cerrado, lo abre la envolvente
  mainResonance: 0.25
  envAmount: 0.6            # brass marcado

  # LFO (ligero vibrato opcional)
  lfoRateHz: 4.5
  lfoDepthSemis: 0.15

  # Envolvente de amplitud (brass)
  ampAttackMs: 10.0
  ampDecayMs: 180.0
  ampSustain: 0.6
  ampReleaseMs: 180.0
Bloque de envelopes y filtro para la layer A
text
voiceArchitecture:
  engine: VirtualAnalog

  oscillators:
    - slot: 1
      componentId: OSC-VA-001
      enabled: true
      params:
        tune: 0.0
        pulsewidth: 0.5      # square 50% (puedes hacer PWM luego)
        sublevel: 0.2        # algo de sub para cuerpo

  filters:
    - slot: 1
      componentId: FLT-VA-001
      enabled: true
      mode: LP24
      params:
        cutoff: 1800.0
        resonance: 0.25
        drive: 0.0

  envelopes:
    - slot: 1
      componentId: ENV-ADSR-GEN
      role: amp
      params:
        attack: 10.0
        decay: 180.0
        sustain: 0.6
        release: 180.0

  lfos:
    - slot: 1
      componentId: LFO-001
      params:
        rate: 4.5
        shape: sine
        delay: 0.0

  fx:
    - slot: 1
      componentId: FX-CH-001
      enabled: true
      params:
        mix: 0.4
        mode: III
Rutas de modulación mínimas para brass
text
modulation:
  routes:
    - source: ENV1
      destination: LayerA.Filter1.cutoff
      amount: 0.6      # se corresponde con envAmount
      curve: exp
      bipolar: false

    - source: LFO1
      destination: LayerA.Osc1.pitch
      amount: 0.15     # vibrato suave
      curve: linear
      bipolar: true
Con esto ya tienes un ACE-JUNO-BASIC-BRASS coherente con tu engine y muy cercano al comportamiento clásico de un brass de Juno.
​
​

