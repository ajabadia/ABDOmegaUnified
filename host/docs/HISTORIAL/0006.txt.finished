Dentro de processVoice sustituyendo el multiplicador fijo por velocity:

cpp
void processVoice (Voices::VoiceRuntimeVA& voice,
                   uint16_t voiceIndex,
                   float baseHz,
                   float cutoffHz,
                   float resonance,
                   float envAmount,
                   float velocity,
                   int   numSamples) noexcept
{
    // DCO
    mOscPool.processVoice (voiceIndex, voice.buffer.data(), numSamples, baseHz);

    // Filtro
    const float driveDb = envAmount * 6.0f;
    mFilterPool.processVoice (voiceIndex,
                              voice.buffer.data(),
                              numSamples,
                              cutoffHz,
                              resonance,
                              driveDb);

    // ADSR amp: parámetros desde LayerASettings
    const float a = mLayerSettings->ampAttackMs.load (std::memory_order_relaxed);
    const float d = mLayerSettings->ampDecayMs.load (std::memory_order_relaxed);
    const float s = mLayerSettings->ampSustain.load (std::memory_order_relaxed);
    const float r = mLayerSettings->ampReleaseMs.load (std::memory_order_relaxed);

    voice.ampEnv.setAttackMs (a);
    voice.ampEnv.setDecayMs (d);
    voice.ampEnv.setSustain (s);
    voice.ampEnv.setReleaseMs (r);

    // Velocity como ganancia extra
    const float velGain = std::clamp (velocity, 0.0f, 1.0f);

    for (int i = 0; i < numSamples; ++i)
    {
        const float env = voice.ampEnv.processSample();
        voice.buffer[static_cast<size_t>(i)] *= (env * velGain);
    }
}
Con esto ya tienes:

ADSR por voz controlado por los macros LAYERAAMP* del APVTS.
​

Gate on/off desde startVoice/stopVoice.

Amplitud final env * velocity.

¿Quieres que el siguiente paso sea cablear envAmount también a una ruta de modulación simple env→cutoff (para que ese macro haga algo audible ya), o prefieres que pasemos a cerrar el preset Juno YAML + OmegaPreset::fromYaml/toYaml mínimo para esta cadena?


Para que envAmount haga algo ya, lo cableamos como ganancia de una mod fija “ENV amp → cutoff” dentro del engine, sin meter aún todo el ModulationGraph.

Decisión de mapping
cutoffHz: valor base (slider / preset).

envAmount: en 
[
−
1
,
1
]
[−1,1] (como ya definimos).

ADSR amp: salida 
e
n
v
env en 
[
0
,
1
]
[0,1] por muestra.

Modulación: aplicamos un factor multiplicativo sobre cutoffHz en log-domain (más musical que suma lineal en Hz).

Implementación en processVoice
Sustituimos el bucle final por uno que compute cutoffPerSample a partir del envelope:

cpp
void processVoice (Voices::VoiceRuntimeVA& voice,
                   uint16_t voiceIndex,
                   float baseHz,
                   float cutoffHz,
                   float resonance,
                   float envAmount,
                   float velocity,
                   int   numSamples) noexcept
{
    // 1) DCO
    mOscPool.processVoice (voiceIndex, voice.buffer.data(), numSamples, baseHz);

    // 2) ADSR parámetros desde LayerASettings
    const float a = mLayerSettings->ampAttackMs.load (std::memory_order_relaxed);
    const float d = mLayerSettings->ampDecayMs.load (std::memory_order_relaxed);
    const float s = mLayerSettings->ampSustain.load (std::memory_order_relaxed);
    const float r = mLayerSettings->ampReleaseMs.load (std::memory_order_relaxed);

    voice.ampEnv.setAttackMs  (a);
    voice.ampEnv.setDecayMs   (d);
    voice.ampEnv.setSustain   (s);
    voice.ampEnv.setReleaseMs (r);

    const float velGain = std::clamp (velocity, 0.0f, 1.0f);

    // 3) Env → cutoff (per-sample) + filtro + amp
    //   - envAmount > 0: abre el filtro en ataque, vuelve a cutoff base
    //   - envAmount < 0: lo cierra (inverso)
    const float baseCutoff = std::clamp (cutoffHz, 20.0f, 20000.0f);
    const float minCutoff  = 20.0f;
    const float maxCutoff  = 20000.0f;

    for (int i = 0; i < numSamples; ++i)
    {
        const float env = voice.ampEnv.processSample(); // 0..1

        // Escala log: factor entre 1/4 y 4 según envAmount y env
        // envAmount 1  -> hasta x4; -1 -> hasta /4
        const float envScale = envAmount * (2.0f * env);  // -2..2
        const float factor   = std::pow (2.0f, envScale); // ~1/4..4

        const float cutoffSample = std::clamp (baseCutoff * factor,
                                               minCutoff, maxCutoff);

        // Actualizamos filtro para esta muestra
        auto& f = mFilterPool.getFilter (voiceIndex); // añadimos getter simple
        f.setCutoffHz (cutoffSample);
        f.setResonance (resonance);
        f.setDrive (envAmount * 6.0f);

        float x = voice.buffer[static_cast<size_t>(i)];
        x = f.processSample (x);              // filtro
        x *= (env * velGain);                 // amp env * velocity

        voice.buffer[static_cast<size_t>(i)] = x;
    }
}
Y en FilterPoolJunoIr3109 añadimos:

cpp
JunoIr3109Lp24& getFilter (uint16_t voiceIndex) noexcept
{
    return mFilters[voiceIndex];
}
Esto es ligeramente más caro (coeficiente por muestra), pero perfecto como MVP para oír la macro envAmount abrir/cerrar el filtro de forma muy clara; más adelante puedes pasar el cálculo a control-rate y hacer smoothing.

¿Quieres que el siguiente paso sea optimizar este path a control-rate (coeficiente por bloque) o preferirías ya cerrar el preset Juno YAML + OmegaPreset::fromYaml/toYaml mínimo para congelar este comportamiento en presets?


Vamos a cerrar una versión mínima del preset Juno pad en YAML que casa con todo lo que ya tienes cableado (DCO Juno, IR3109, ADSR, LFO, chorus stub) y con los macros APVTS.
​

YAML del preset Juno VA básico
text
omegapresetVersion: 1
id: ACE-JUNO-BASIC-PAD
name: ACE Juno Basic Pad
author: abde/neurolab
engine: VirtualAnalog

global:
  masterGainDb: 0.0
  masterBypass: 0

layers:
  - id: A
    name: Juno Basic
    engine: VirtualAnalog
    polyphony: 8

    layerParams:
      levelDb: 0.0          # LAYERALEVELDB
      pan: 0.0              # LAYERAPAN
      mainCutoffHz: 2000.0  # LAYERAMAINCUTOFF
      mainResonance: 0.2    # LAYERAMAINRES
      envAmount: 0.5        # LAYERAENVAMT
      lfoRateHz: 0.4        # LAYERALFORATEHZ (ligero vibrato)
      lfoDepthSemis: 0.3    # LAYERALFODEPTHSEMITONES
      ampAttackMs: 40.0     # LAYERAAMPATTACKMS (pad suave)
      ampDecayMs: 160.0     # LAYERAAMPDECAYMS
      ampSustain: 0.8       # LAYERAAMPSUSTAIN
      ampReleaseMs: 600.0   # LAYERAAMPRELEASEMS

    voiceArchitecture:
      oscillators:
        - slot: 1
          componentId: OSC-VA-001
          enabled: true
          params:
            tune: 0.0
            pulsewidth: 0.5
            sublevel: 0.3

      filters:
        - slot: 1
          componentId: FLT-VA-001
          enabled: true
          mode: LP24
          params:
            cutoff: 2000.0
            resonance: 0.2
            drive: 0.0

      envelopes:
        - slot: 1
          componentId: ENV-ADSR-GEN
          role: amp
          params:
            attack: 40.0
            decay: 160.0
            sustain: 0.8
            release: 600.0

      lfos:
        - slot: 1
          componentId: LFO-001
          params:
            rate: 0.4
            shape: sine
            delay: 0.0

      fx:
        - slot: 1
          componentId: FX-CH-001
          enabled: true
          params:
            mix: 0.7
            mode: III

    modulation:
      # Vibrato simple: LFO1 -> Osc1 pitch
      - source: LFO1
        destination: LayerA.Osc1.pitch
        amount: 0.3
        curve: linear
        bipolar: true

      # Env amp -> Filter cutoff (paralelo al macro envAmount interno)
      - source: ENV1
        destination: LayerA.Filter1.cutoff
        amount: 0.5
        curve: linear
        bipolar: false
        macroBinding: ENVTOCUTOFF  # opcional para tu Tagger/ModGraph
Esto te da:

Una capa A con exactamente los bloques que tu engine VA actual soporta.

Macros de capa directamente alineados con los IDs APVTS LAYERA*.

Una ruta explícita ENV1 → Filter1.cutoff coherente con el “env→cutoff” que acabamos de hackear dentro del engine.

¿Quieres que a continuación te deje el OmegaPreset::fromYaml/toYaml mínimo para esta estructura (solo global, layers[0].layerParams y voiceArchitecture tal y como están aquí) para que puedas cargar/guardar este preset desde C++ ya mismo?

Ya tienes en el propio doc el esqueleto mínimo de OmegaPreset::fromYaml/toYaml para el Juno VA de una sola capa, así que solo hay que consolidarlo.
​

Firma en OmegaPreset.h
cpp
// SourceCorePreset/OmegaPreset.h
#pragma once
#include <juce_core/juce_core.h>

namespace OmegaPreset
{
    struct Layer
    {
        juce::String id;
        juce::String name;
        float levelDb        = 0.0f;
        float pan            = 0.0f;
        float mainCutoffHz   = 2000.0f;
        float mainResonance  = 0.2f;
        float envAmount      = 0.5f;
        float lfoRateHz      = 1.0f;
        float lfoDepthSemis  = 0.3f;
        float ampAttackMs    = 10.0f;
        float ampDecayMs     = 120.0f;
        float ampSustain     = 0.8f;
        float ampReleaseMs   = 600.0f;
        // voiceArchitecture: osc / filter / env / lfo / fx…
        // (tal y como ya lo definiste en el doc)
        VoiceArchitecture voiceArch;
        juce::Array<ModulationRoute> modulation;
    };

    class OmegaPreset
    {
    public:
        explicit OmegaPreset (juce::ValueTree rootVT);

        static OmegaPreset createEmpty (const juce::String& engine);
        static OmegaPreset fromYaml (const juce::String& yamlText);
        juce::String toYaml () const;

        juce::String getId () const;
        void setId (const juce::String& id);

        juce::String getName () const;
        void setName (const juce::String& name);

        juce::String getEngine () const;
        void setEngine (const juce::String& engine);

        juce::Array<Layer> getLayers () const;
        void addLayer (const Layer& layer);
        void replaceLayer (const juce::String& id, const Layer& layer);

        // Helpers para macros de capa A
        float getLayerMainCutoff (const juce::String& layerId) const;
        void  setLayerMainCutoff (const juce::String& layerId, float v);
        // (análogos para reso/envAmount/amp* si los necesitas)

    private:
        juce::ValueTree root; // tipo "OMEGAPRESET"
    };
}
fromYaml mínimo (solo Juno VA, una capa)
cpp
// SourceCorePreset/OmegaPresetYaml.cpp
#include "OmegaPreset.h"
#include <yaml-cpp/yaml.h>

namespace
{
    constexpr const char* kTypePreset      = "OMEGAPRESET";
    constexpr const char* kTypeLayer       = "LAYER";
    constexpr const char* kTypeLayerParams = "LAYERPARAMS";

    constexpr const char* kPropId      = "id";
    constexpr const char* kPropName    = "name";
    constexpr const char* kPropEngine  = "engine";
    constexpr const char* kPropLayers  = "layers";

    constexpr const char* kPropLevelDb       = "levelDb";
    constexpr const char* kPropPan           = "pan";
    constexpr const char* kPropCutoff        = "mainCutoffHz";
    constexpr const char* kPropResonance     = "mainResonance";
    constexpr const char* kPropEnvAmount     = "envAmount";
    constexpr const char* kPropLfoRateHz     = "lfoRateHz";
    constexpr const char* kPropLfoDepthSemis = "lfoDepthSemis";
    constexpr const char* kPropAmpAttackMs   = "ampAttackMs";
    constexpr const char* kPropAmpDecayMs    = "ampDecayMs";
    constexpr const char* kPropAmpSustain    = "ampSustain";
    constexpr const char* kPropAmpReleaseMs  = "ampReleaseMs";
}

namespace OmegaPreset
{
    OmegaPreset::OmegaPreset (juce::ValueTree rootVT)
        : root (std::move (rootVT))
    {
        if (! root.isValid() || root.getType() != juce::Identifier (kTypePreset))
            root = juce::ValueTree (kTypePreset);
    }

    OmegaPreset OmegaPreset::createEmpty (const juce::String& engine)
    {
        juce::ValueTree vt (kTypePreset);
        vt.setProperty (kPropId,     "INIT",        nullptr);
        vt.setProperty (kPropName,   "Init",        nullptr);
        vt.setProperty (kPropEngine, engine,        nullptr);
        return OmegaPreset { vt };
    }

    OmegaPreset OmegaPreset::fromYaml (const juce::String& yamlText)
    {
        const auto doc = YAML::Load (yamlText.toStdString());

        juce::ValueTree rootVT (kTypePreset);
        rootVT.setProperty (kPropId,     juce::String (doc["id"].as<std::string>()),     nullptr);
        rootVT.setProperty (kPropName,   juce::String (doc["name"].as<std::string>()),   nullptr);
        rootVT.setProperty (kPropEngine, juce::String (doc["engine"].as<std::string>()), nullptr);

        const auto layersNode = doc["layers"];
        if (layersNode && layersNode.IsSequence())
        {
            for (const auto& l : layersNode)
            {
                juce::ValueTree vtLayer (kTypeLayer);
                vtLayer.setProperty (kPropId,   juce::String (l["id"].as<std::string>()),   nullptr);
                vtLayer.setProperty (kPropName, juce::String (l["name"].as<std::string>()), nullptr);
                vtLayer.setProperty ("polyphony", l["polyphony"].as<int>(), nullptr);
                vtLayer.setProperty (kPropEngine,
                                     juce::String (l["engine"].as<std::string>()),
                                     nullptr);

                const auto lp = l["layerParams"];
                if (lp && lp.IsMap())
                {
                    juce::ValueTree vtLP (kTypeLayerParams);
                    vtLP.setProperty (kPropLevelDb,       (float) lp["levelDb"].as<double>(),       nullptr);
                    vtLP.setProperty (kPropPan,           (float) lp["pan"].as<double>(),           nullptr);
                    vtLP.setProperty (kPropCutoff,        (float) lp["mainCutoffHz"].as<double>(),  nullptr);
                    vtLP.setProperty (kPropResonance,     (float) lp["mainResonance"].as<double>(), nullptr);
                    vtLP.setProperty (kPropEnvAmount,     (float) lp["envAmount"].as<double>(),     nullptr);
                    vtLP.setProperty (kPropLfoRateHz,     (float) lp["lfoRateHz"].as<double>(),     nullptr);
                    vtLP.setProperty (kPropLfoDepthSemis, (float) lp["lfoDepthSemis"].as<double>(), nullptr);
                    vtLP.setProperty (kPropAmpAttackMs,   (float) lp["ampAttackMs"].as<double>(),   nullptr);
                    vtLP.setProperty (kPropAmpDecayMs,    (float) lp["ampDecayMs"].as<double>(),    nullptr);
                    vtLP.setProperty (kPropAmpSustain,    (float) lp["ampSustain"].as<double>(),    nullptr);
                    vtLP.setProperty (kPropAmpReleaseMs,  (float) lp["ampReleaseMs"].as<double>(),  nullptr);

                    vtLayer.addChild (vtLP, -1, nullptr);
                }

                // voiceArchitecture / modulation: igual que en el doc, pero puedes
                // añadirlo luego; para MVP Juno bastan layerParams.

                rootVT.addChild (vtLayer, -1, nullptr);
            }
        }

        return OmegaPreset { rootVT };
    }

    juce::String OmegaPreset::toYaml () const
    {
        YAML::Emitter out;

        out << YAML::BeginMap;
        out << YAML::Key << "omegapresetVersion" << YAML::Value << 1;
        out << YAML::Key << "id"     << YAML::Value << getId().toStdString();
        out << YAML::Key << "name"   << YAML::Value << getName().toStdString();
        out << YAML::Key << "engine" << YAML::Value << getEngine().toStdString();

        out << YAML::Key << "layers" << YAML::Value << YAML::BeginSeq;

        const auto layers = getLayers();
        for (const auto& l : layers)
        {
            out << YAML::BeginMap;
            out << YAML::Key << "id"        << YAML::Value << l.id.toStdString();
            out << YAML::Key << "name"      << YAML::Value << l.name.toStdString();
            out << YAML::Key << "engine"    << YAML::Value << getEngine().toStdString();
            out << YAML::Key << "polyphony" << YAML::Value << l.voiceArch.polyphony;

            out << YAML::Key << "layerParams" << YAML::Value << YAML::BeginMap;
            out << YAML::Key << "levelDb"       << YAML::Value << l.levelDb;
            out << YAML::Key << "pan"           << YAML::Value << l.pan;
            out << YAML::Key << "mainCutoffHz"  << YAML::Value << l.mainCutoffHz;
            out << YAML::Key << "mainResonance" << YAML::Value << l.mainResonance;
            out << YAML::Key << "envAmount"     << YAML::Value << l.envAmount;
            out << YAML::Key << "lfoRateHz"     << YAML::Value << l.lfoRateHz;
            out << YAML::Key << "lfoDepthSemis" << YAML::Value << l.lfoDepthSemis;
            out << YAML::Key << "ampAttackMs"   << YAML::Value << l.ampAttackMs;
            out << YAML::Key << "ampDecayMs"    << YAML::Value << l.ampDecayMs;
            out << YAML::Key << "ampSustain"    << YAML::Value << l.ampSustain;
            out << YAML::Key << "ampReleaseMs"  << YAML::Value << l.ampReleaseMs;
            out << YAML::EndMap; // layerParams

            // (puedes emitir voiceArchitecture y modulation aquí después)

            out << YAML::EndMap; // layer
        }

        out << YAML::EndSeq; // layers
        out << YAML::EndMap;

        return juce::String (out.c_str());
    }

    juce::String OmegaPreset::getId () const      { return root.getProperty (kPropId).toString(); }
    void OmegaPreset::setId (const juce::String& id)
    {
        root.setProperty (kPropId, id, nullptr);
    }

    juce::String OmegaPreset::getName () const    { return root.getProperty (kPropName).toString(); }
    void OmegaPreset::setName (const juce::String& n)
    {
        root.setProperty (kPropName, n, nullptr);
    }

    juce::String OmegaPreset::getEngine () const  { return root.getProperty (kPropEngine).toString(); }
    void OmegaPreset::setEngine (const juce::String& e)
    {
        root.setProperty (kPropEngine, e, nullptr);
    }

    juce::Array<OmegaPreset::Layer> OmegaPreset::getLayers () const
    {
        juce::Array<Layer> result;
        for (int i = 0; i < root.getNumChildren(); ++i)
        {
            auto vtLayer = root.getChild (i);
            if (vtLayer.getType() != juce::Identifier (kTypeLayer))
                continue;

            Layer l;
            l.id   = vtLayer.getProperty (kPropId).toString();
            l.name = vtLayer.getProperty (kPropName).toString();
            l.voiceArch.polyphony = (int) vtLayer.getProperty ("polyphony", 8);

            auto vtLP = vtLayer.getChildWithName (kTypeLayerParams);
            if (vtLP.isValid())
            {
                l.levelDb       = (float) vtLP.getProperty (kPropLevelDb,       0.0f);
                l.pan           = (float) vtLP.getProperty (kPropPan,           0.0f);
                l.mainCutoffHz  = (float) vtLP.getProperty (kPropCutoff,        2000.0f);
                l.mainResonance = (float) vtLP.getProperty (kPropResonance,     0.2f);
                l.envAmount     = (float) vtLP.getProperty (kPropEnvAmount,     0.5f);
                l.lfoRateHz     = (float) vtLP.getProperty (kPropLfoRateHz,     1.0f);
                l.lfoDepthSemis = (float) vtLP.getProperty (kPropLfoDepthSemis, 0.3f);
                l.ampAttackMs   = (float) vtLP.getProperty (kPropAmpAttackMs,   10.0f);
                l.ampDecayMs    = (float) vtLP.getProperty (kPropAmpDecayMs,    120.0f);
                l.ampSustain    = (float) vtLP.getProperty (kPropAmpSustain,    0.8f);
                l.ampReleaseMs  = (float) vtLP.getProperty (kPropAmpReleaseMs,  600.0f);
            }

            result.add (l);
        }
        return result;
    }

    void OmegaPreset::addLayer (const Layer& layer)
    {
        juce::ValueTree vtLayer (kTypeLayer);
        vtLayer.setProperty (kPropId,   layer.id,   nullptr);
        vtLayer.setProperty (kPropName, layer.name, nullptr);
        vtLayer.setProperty ("polyphony", layer.voiceArch.polyphony, nullptr);

        juce::ValueTree vtLP (kTypeLayerParams);
        vtLP.setProperty (kPropLevelDb,       layer.levelDb,       nullptr);
        vtLP.setProperty (kPropPan,           layer.pan,           nullptr);
        vtLP.setProperty (kPropCutoff,        layer.mainCutoffHz,  nullptr);
        vtLP.setProperty (kPropResonance,     layer.mainResonance, nullptr);
        vtLP.setProperty (kPropEnvAmount,     layer.envAmount,     nullptr);
        vtLP.setProperty (kPropLfoRateHz,     layer.lfoRateHz,     nullptr);
        vtLP.setProperty (kPropLfoDepthSemis, layer.lfoDepthSemis, nullptr);
        vtLP.setProperty (kPropAmpAttackMs,   layer.ampAttackMs,   nullptr);
        vtLP.setProperty (kPropAmpDecayMs,    layer.ampDecayMs,    nullptr);
        vtLP.setProperty (kPropAmpSustain,    layer.ampSustain,    nullptr);
        vtLP.setProperty (kPropAmpReleaseMs,  layer.ampReleaseMs,  nullptr);

        vtLayer.addChild (vtLP, -1, nullptr);
        root.addChild (vtLayer, -1, nullptr);
    }

    void OmegaPreset::replaceLayer (const juce::String& id, const Layer& layer)
    {
        for (int i = 0; i < root.getNumChildren(); ++i)
        {
            auto vtLayer = root.getChild (i);
            if (vtLayer.getType() != juce::Identifier (kTypeLayer))
                continue;
            if (vtLayer.getProperty (kPropId).toString() != id)
                continue;

            vtLayer.setProperty (kPropName, layer.name, nullptr);
            vtLayer.setProperty ("polyphony", layer.voiceArch.polyphony, nullptr);

            auto vtLP = vtLayer.getChildWithName (kTypeLayerParams);
            if (! vtLP.isValid())
            {
                vtLP = juce::ValueTree (kTypeLayerParams);
                vtLayer.addChild (vtLP, -1, nullptr);
            }

            vtLP.setProperty (kPropLevelDb,       layer.levelDb,       nullptr);
            vtLP.setProperty (kPropPan,           layer.pan,           nullptr);
            vtLP.setProperty (kPropCutoff,        layer.mainCutoffHz,  nullptr);
            vtLP.setProperty (kPropResonance,     layer.mainResonance, nullptr);
            vtLP.setProperty (kPropEnvAmount,     layer.envAmount,     nullptr);
            vtLP.setProperty (kPropLfoRateHz,     layer.lfoRateHz,     nullptr);
            vtLP.setProperty (kPropLfoDepthSemis, layer.lfoDepthSemis, nullptr);
            vtLP.setProperty (kPropAmpAttackMs,   layer.ampAttackMs,   nullptr);
            vtLP.setProperty (kPropAmpDecayMs,    layer.ampDecayMs,    nullptr);
            vtLP.setProperty (kPropAmpSustain,    layer.ampSustain,    nullptr);
            vtLP.setProperty (kPropAmpReleaseMs,  layer.ampReleaseMs,  nullptr);
            return;
        }
    }

    float OmegaPreset::getLayerMainCutoff (const juce::String& layerId) const
    {
        for (int i = 0; i < root.getNumChildren(); ++i)
        {
            auto vtLayer = root.getChild (i);
            if (vtLayer.getType() != juce::Identifier (kTypeLayer))
                continue;
            if (vtLayer.getProperty (kPropId).toString() != layerId)
                continue;
            auto vtLP = vtLayer.getChildWithName (kTypeLayerParams);
            if (! vtLP.isValid())
                break;
            return (float) vtLP.getProperty (kPropCutoff, 2000.0f);
        }
        return 2000.0f;
    }

    void OmegaPreset::setLayerMainCutoff (const juce::String& layerId, float v)
    {
        for (int i = 0; i < root.getNumChildren(); ++i)
        {
            auto vtLayer = root.getChild (i);
            if (vtLayer.getType() != juce::Identifier (kTypeLayer))
                continue;
            if (vtLayer.getProperty (kPropId).toString() != layerId)
                continue;

            auto vtLP = vtLayer.getChildWithName (kTypeLayerParams);
            if (! vtLP.isValid())
            {
                vtLP = juce::ValueTree (kTypeLayerParams);
                vtLayer.addChild (vtLP, -1, nullptr);
            }
            vtLP.setProperty (kPropCutoff, v, nullptr);
            return;
        }
    }
}
Con esto ya puedes:

Cargar tu junobasicpad.yaml a OmegaPreset::fromYaml.
​

Volcar macros de layer A a APVTS con applyPresetToApvts.

Guardar ajustes de UI de vuelta a YAML con applyApvtsToPreset + toYaml.

