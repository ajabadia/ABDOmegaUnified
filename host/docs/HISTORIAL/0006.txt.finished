2) Clase DSP C++ ENV‑ADSR‑GEN
Envelope 0..1 con curvas exponenciales simples:

cpp
// DSP/VA/EnvelopeAdsrVA.h
#pragma once
#include <algorithm>
#include <cmath>
#include <cstdint>

namespace OmegaDSP::VA
{
    class EnvelopeAdsrVA
    {
    public:
        void prepare(double sampleRate) noexcept
        {
            sr = sampleRate > 0.0 ? sampleRate : 44100.0;
            reset();
        }

        void reset() noexcept
        {
            level = 0.0f;
            state = State::Idle;
        }

        void noteOn() noexcept
        {
            state = State::Attack;
        }

        void noteOff() noexcept
        {
            if (state != State::Idle)
                state = State::Release;
        }

        void setAttackMs(float ms)  noexcept { attackMs  = std::max(ms, 0.1f);  calcAttackCoef(); }
        void setDecayMs(float ms)   noexcept { decayMs   = std::max(ms, 0.1f);  calcDecayCoef(); }
        void setSustain(float s)    noexcept { sustain   = std::clamp(s, 0.0f, 1.0f); }
        void setReleaseMs(float ms) noexcept { releaseMs = std::max(ms, 1.0f);  calcReleaseCoef(); }

        // Rellena envOut[i] con valores 0..1
        void process(float* envOut, int numSamples) noexcept
        {
            if (!envOut || numSamples <= 0)
                return;

            for (int i = 0; i < numSamples; ++i)
            {
                switch (state)
                {
                    case State::Idle:
                        level = 0.0f;
                        break;

                    case State::Attack:
                        level += attackCoef * (1.0f - level);
                        if (level >= 0.999f)
                        {
                            level = 1.0f;
                            state = State::Decay;
                        }
                        break;

                    case State::Decay:
                        level += decayCoef * (sustain - level);
                        if (std::fabs(level - sustain) < 1e-4f)
                        {
                            level = sustain;
                            state = State::Sustain;
                        }
                        break;

                    case State::Sustain:
                        // nivel constante
                        level = sustain;
                        break;

                    case State::Release:
                        level += releaseCoef * (0.0f - level);
                        if (level <= 1e-4f)
                        {
                            level = 0.0f;
                            state = State::Idle;
                        }
                        break;
                }

                envOut[i] = level;
            }
        }

        float getCurrentLevel() const noexcept { return level; }

    private:
        enum class State { Idle, Attack, Decay, Sustain, Release };

        double sr {44100.0};
        State  state { State::Idle };

        float level {0.0f};

        float attackMs  {10.0f};
        float decayMs   {120.0f};
        float sustain   {0.8f};
        float releaseMs {600.0f};

        float attackCoef  {0.0f};
        float decayCoef   {0.0f};
        float releaseCoef {0.0f};

        void calcAttackCoef()  noexcept { attackCoef  = timeMsToCoef(attackMs); }
        void calcDecayCoef()   noexcept { decayCoef   = timeMsToCoef(decayMs); }
        void calcReleaseCoef() noexcept { releaseCoef = timeMsToCoef(releaseMs); }

        float timeMsToCoef(float ms) const noexcept
        {
            const float t = ms * 0.001f;
            const float samples = t * static_cast<float>(sr);
            if (samples <= 1.0f)
                return 1.0f;
            // Coef aproximado para ~63% en 'samples' muestras
            return 1.0f - std::exp(-1.0f / samples);
        }
    };
}
3) Uso en el engine: amp + EnvAmount al cutoff
En tu engine VA, por voz:

cpp
// 1) Envelope AMP: aplicar a buffer de voz
envPool.processVoice(voice.envIndex, envBuffer, numSamples); // envBuffer 0..1

for (int i = 0; i < numSamples; ++i)
{
    const float env = envBuffer[i];
    voiceBuf[2*i+0] *= env;
    voiceBuf[2*i+1] *= env;
}

// 2) EnvAmount → cutoff (simple MVP, sin ModGraph aún)
const float baseCutoff = layerSettings->cutoffHz.load(std::memory_order_relaxed); // 20..20000
const float envAmt     = layerSettings->envAmount.load(std::memory_order_relaxed); // -1..1 o 0..1

// Para este MVP: mapear env 0..1 a +/- una octava según envAmt
// cutoffMod = base * 2^(envAmt * (env-0.5)*2)
for (int i = 0; i < numSamples; ++i)
{
    const float env = envBuffer[i]; // 0..1
    const float envCentered = (env - 0.5f) * 2.0f; // -1..1
    const float semis = envAmt * 12.0f * envCentered; // +/-12 semis
    const float factor = std::pow(2.0f, semis / 12.0f);
    perSampleCutoff[i] = std::clamp(baseCutoff * factor, 20.0f, 20000.0f);
}

// Llamar al filtro con cutoff variable frame a frame más adelante
Más adelante ese EnvAmount lo moveremos al ModulationRuntime como ganancia de la ruta ENV1 → LayerA.Filter1.cutoff, pero este MVP ya te da el comportamiento Juno‑like.

¿Te interesa ahora que definamos también LFO-001 en la misma línea (contrato ACE + clase VA simple para vibrato y quizá tremolo)?


Para LFO‑001 te propongo un contrato ACE mínimo y una implementación VA suficiente para vibrato (pitch) y, si quieres, algo de tremolo más adelante.

1) Contrato ACE para LFO‑001
En ACE YAML:

text
components:
  - id: LFO-001
    name: Generic LFO
    family: LFO
    engine: VirtualAnalog
    modelId: GenericLFO
    origin: OMEGA
    status: active
    version: 1
    tags: [lfo, generic]
    parameters:
      - id: rate
        label: Rate
        unit: Hz
        min: 0.1
        max: 10.0
        default: 1.0
      - id: shape
        label: Shape
        unit: enum
        min: 0
        max: 3           # 0=sine,1=triangle,2=saw,3=square
        default: 0
      - id: delay
        label: Delay
        unit: ms
        min: 0.0
        max: 5000.0
        default: 0.0
Para vibrato MVP nos basta con rate y shape = sine; delay lo puedes usar más adelante.

2) Clase DSP C++ para LFO‑001
LFO 0..1 o −1..1 según uso; para vibrato nos interesa una salida −1..1:

cpp
// DSP/VA/LfoGenericVA.h
#pragma once
#include <algorithm>
#include <cmath>
#include <cstdint>

namespace OmegaDSP::VA
{
    class LfoGenericVA
    {
    public:
        void prepare(double sampleRate) noexcept
        {
            sr = sampleRate > 0.0 ? sampleRate : 44100.0;
            phase = 0.0f;
        }

        void reset() noexcept { phase = 0.0f; }

        void setRateHz(float hz) noexcept
        {
            rateHz = std::clamp(hz, 0.1f, 10.0f);
        }

        void setShape(int s) noexcept
        {
            shape = std::clamp(s, 0, 3);
        }

        // out[i] en rango -1..1
        void process(float* out, int numSamples) noexcept
        {
            if (!out || numSamples <= 0)
                return;

            const float inc = static_cast<float>(rateHz / sr);

            for (int i = 0; i < numSamples; ++i)
            {
                float p = phase;
                phase += inc;
                if (phase >= 1.0f)
                    phase -= 1.0f;

                float y = 0.0f;

                switch (shape)
                {
                    case 0: // sine
                        y = std::sin(2.0f * float(M_PI) * p);
                        break;
                    case 1: // triangle -1..1
                        y = 2.0f * std::fabs(2.0f * p - 1.0f) - 1.0f;
                        break;
                    case 2: // saw -1..1
                        y = 2.0f * p - 1.0f;
                        break;
                    case 3: // square -1..1
                    default:
                        y = (p < 0.5f) ? 1.0f : -1.0f;
                        break;
                }

                out[i] = y;
            }
        }

    private:
        double sr   {44100.0};
        float  phase{0.0f};
        float  rateHz {1.0f};
        int    shape  {0}; // 0=sine
    };
}
