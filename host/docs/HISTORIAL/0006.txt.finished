C++: factor común para Brass/Reed
cpp
OmegaPreset createOmegaPreset_Prophecy_Brass01();
OmegaPreset createOmegaPreset_Prophecy_Reed01();
Si quieres, en el siguiente mensaje te escribo las dos funciones C++ completas createOmegaPreset_Prophecy_Brass01() y createOmegaPreset_Prophecy_Reed01() siguiendo exactamente la API que ya usas para JP/MS‑20/VA.

¿Prefieres que esas funciones usen directamente applyPackMacros_ProphecyBrass en el constructor, o que queden “secos” y el pack las procese después en el loader?


Aquí van las dos funciones C++ “secas” (sin aplicar macros dentro), listas para que tu loader les pase applyPackMacros_ProphecyBrass / applyPackMacros_ProphecyReed según el pack.

createOmegaPreset_Prophecy_Brass01
cpp
#include "OmegaPreset.h"

OmegaPreset createOmegaPreset_Prophecy_Brass01()
{
    OmegaPreset preset = OmegaPreset::createEmpty("VirtualAnalog");

    preset.setId("PRP-BRASS-01");
    preset.setName("Prophecy Brass Solo");
    preset.setAuthor("abdeneurolab");
    preset.setEngine("VirtualAnalog");

    preset.addTag("prophecy");
    preset.addTag("prophecy_brass");
    preset.addTag("solo");
    preset.addTag("lead");
    preset.addOriginPack("prophecy-core-pack");

    // Macros base
    preset.setMacroValue(1, 0.55f); // Energy
    preset.setMacroValue(2, 0.40f); // Movement
    preset.setMacroValue(3, 0.65f); // Air
    preset.setMacroValue(4, 0.85f); // Expressivity

    preset.setMasterGainDb(0.0f);
    preset.setMasterBypass(false);

    // Layer A
    auto layer = preset.createLayer("A", "Prophecy Brass");
    layer.setEngine("VirtualAnalog");
    layer.setPolyphony(1);
    layer.addTag("prophecy");
    layer.addTag("prophecy_brass");

    // Layer params
    layer.layerParams.levelDb        = -3.0f;
    layer.layerParams.pan            = 0.0f;
    layer.layerParams.mainCutoffHz   = 1800.0f;
    layer.layerParams.mainResonance  = 0.45f;
    layer.layerParams.envAmount      = 0.8f;
    layer.layerParams.lfoRateHz      = 5.0f;
    layer.layerParams.lfoDepthSemis  = 0.05f;
    layer.layerParams.ampAttackMs    = 6.0f;
    layer.layerParams.ampDecayMs     = 220.0f;
    layer.layerParams.ampSustain     = 0.7f;
    layer.layerParams.ampReleaseMs   = 260.0f;

    // Oscillator: modelo Brass
    {
        auto& osc = layer.addOscillator(1, "MOSS-BRASS-CORE");
        osc.enabled     = true;
        osc.componentId = "MOSS-BRASS-CORE";
        osc.params["lipTension"] = 0.6f;
        osc.params["pressure"]   = 0.5f;
        osc.params["bell"]       = 0.3f;
        osc.params["noiseLevel"] = 0.25f;
    }

    // Filter VA
    {
        auto& flt = layer.addFilter(1, "FLT-VA-001");
        flt.enabled     = true;
        flt.componentId = "FLT-VA-001";
        flt.mode        = "LP24";
        flt.params["cutoff"]    = 1800.0f;
        flt.params["resonance"] = 0.45f;
        flt.params["drive"]     = 2.0f;
    }

    // Envelopes
    {
        auto& envAmp = layer.addEnvelope(1, "ENV-ADSR-GEN");
        envAmp.componentId = "ENV-ADSR-GEN";
        envAmp.role        = "amp";
        envAmp.params["attack"]  = 6.0f;
        envAmp.params["decay"]   = 220.0f;
        envAmp.params["sustain"] = 0.7f;
        envAmp.params["release"] = 260.0f;

        auto& envMod = layer.addEnvelope(2, "ENV-ADSR-GEN");
        envMod.componentId = "ENV-ADSR-GEN";
        envMod.role        = "mod";
        envMod.params["attack"]  = 3.0f;
        envMod.params["decay"]   = 190.0f;
        envMod.params["sustain"] = 0.0f;
        envMod.params["release"] = 210.0f;
    }

    // LFO
    {
        auto& lfo = layer.addLfo(1, "LFO-001");
        lfo.componentId   = "LFO-001";
        lfo.params["rate"]  = 5.0f;
        lfo.params["shape"] = 0.0f; // sine
        lfo.params["delay"] = 80.0f;
    }

    // Modulation routes
    {
        // Ataque “brassy” en pitch y filtro
        auto& r1 = layer.addModulationRoute();
        r1.source      = "ENV2";
        r1.destination = "LayerA.Osc1.pitch";
        r1.amount      = 0.18f;
        r1.curve       = "linear";
        r1.bipolar     = true;

        auto& r2 = layer.addModulationRoute();
        r2.source      = "ENV2";
        r2.destination = "LayerA.Filter1.cutoff";
        r2.amount      = 0.75f;
        r2.curve       = "linear";
        r2.bipolar     = false;

        // Vibrato básico
        auto& r3 = layer.addModulationRoute();
        r3.source      = "LFO1";
        r3.destination = "LayerA.Osc1.pitch";
        r3.amount      = 0.05f;
        r3.curve       = "sine";
        r3.bipolar     = true;

        // Dinámica por velocity
        auto& r4 = layer.addModulationRoute();
        r4.source      = "Velocity";
        r4.destination = "LayerA.Osc1.pressure";
        r4.amount      = 0.9f;
        r4.curve       = "linear";
        r4.bipolar     = false;

        // Aftertouch → vibrato + brillo
        auto& r5 = layer.addModulationRoute();
        r5.source      = "Aftertouch";
        r5.destination = "LFO1.depth";
        r5.amount      = 1.0f;
        r5.curve       = "linear";
        r5.bipolar     = false;

        auto& r6 = layer.addModulationRoute();
        r6.source      = "Aftertouch";
        r6.destination = "LayerA.Filter1.cutoff";
        r6.amount      = 0.5f;
        r6.curve       = "linear";
        r6.bipolar     = false;

        // Ribbon → pitch
        auto& r7 = layer.addModulationRoute();
        r7.source      = "Ribbon";
        r7.destination = "LayerA.Osc1.pitch";
        r7.amount      = 0.25f;
        r7.curve       = "linear";
        r7.bipolar     = true;
    }

    preset.addLayer(layer);
    return preset;
}
createOmegaPreset_Prophecy_Reed01
cpp
#include "OmegaPreset.h"

OmegaPreset createOmegaPreset_Prophecy_Reed01()
{
    OmegaPreset preset = OmegaPreset::createEmpty("VirtualAnalog");

    preset.setId("PRP-REED-01");
    preset.setName("Prophecy Reed Solo");
    preset.setAuthor("abdeneurolab");
    preset.setEngine("VirtualAnalog");

    preset.addTag("prophecy");
    preset.addTag("prophecy_reed");
    preset.addTag("solo");
    preset.addTag("lead");
    preset.addOriginPack("prophecy-core-pack");

    // Macros base
    preset.setMacroValue(1, 0.45f); // Energy
    preset.setMacroValue(2, 0.35f); // Movement
    preset.setMacroValue(3, 0.70f); // Air
    preset.setMacroValue(4, 0.90f); // Expressivity

    preset.setMasterGainDb(0.0f);
    preset.setMasterBypass(false);

    // Layer A
    auto layer = preset.createLayer("A", "Prophecy Reed");
    layer.setEngine("VirtualAnalog");
    layer.setPolyphony(1);
    layer.addTag("prophecy");
    layer.addTag("prophecy_reed");

    // Layer params
    layer.layerParams.levelDb        = -4.0f;
    layer.layerParams.pan            = 0.0f;
    layer.layerParams.mainCutoffHz   = 1500.0f;
    layer.layerParams.mainResonance  = 0.55f;
    layer.layerParams.envAmount      = 0.85f;
    layer.layerParams.lfoRateHz      = 4.8f;
    layer.layerParams.lfoDepthSemis  = 0.04f;
    layer.layerParams.ampAttackMs    = 10.0f;
    layer.layerParams.ampDecayMs     = 260.0f;
    layer.layerParams.ampSustain     = 0.75f;
    layer.layerParams.ampReleaseMs   = 300.0f;

    // Oscillator: modelo Reed
    {
        auto& osc = layer.addOscillator(1, "MOSS-REED-CORE");
        osc.enabled     = true;
        osc.componentId = "MOSS-REED-CORE";
        osc.params["reedStiffness"] = 0.5f;
        osc.params["pressure"]      = 0.45f;
        osc.params["tone"]          = 0.4f;
        osc.params["noiseLevel"]    = 0.35f;
    }

    // Filter VA
    {
        auto& flt = layer.addFilter(1, "FLT-VA-001");
        flt.enabled     = true;
        flt.componentId = "FLT-VA-001";
        flt.mode        = "LP24";
        flt.params["cutoff"]    = 1500.0f;
        flt.params["resonance"] = 0.55f;
        flt.params["drive"]     = 1.5f;
    }

    // Envelopes
    {
        auto& envAmp = layer.addEnvelope(1, "ENV-ADSR-GEN");
        envAmp.componentId = "ENV-ADSR-GEN";
        envAmp.role        = "amp";
        envAmp.params["attack"]  = 10.0f;
        envAmp.params["decay"]   = 260.0f;
        envAmp.params["sustain"] = 0.75f;
        envAmp.params["release"] = 300.0f;

        auto& envMod = layer.addEnvelope(2, "ENV-ADSR-GEN");
        envMod.componentId = "ENV-ADSR-GEN";
        envMod.role        = "mod";
        envMod.params["attack"]  = 4.0f;
        envMod.params["decay"]   = 210.0f;
        envMod.params["sustain"] = 0.0f;
        envMod.params["release"] = 240.0f;
    }

    // LFO
    {
        auto& lfo = layer.addLfo(1, "LFO-001");
        lfo.componentId   = "LFO-001";
        lfo.params["rate"]  = 4.8f;
        lfo.params["shape"] = 0.0f; // sine
        lfo.params["delay"] = 120.0f;
    }

    // Modulation routes
    {
        // Pitch “sax-like” en ataques
        auto& r1 = layer.addModulationRoute();
        r1.source      = "ENV2";
        r1.destination = "LayerA.Osc1.pitch";
        r1.amount      = 0.22f;
        r1.curve       = "linear";
        r1.bipolar     = true;

        // Filtro muy dependiente de EG
        auto& r2 = layer.addModulationRoute();
        r2.source      = "ENV2";
        r2.destination = "LayerA.Filter1.cutoff";
        r2.amount      = 0.8f;
        r2.curve       = "linear";
        r2.bipolar     = false;

        // Vibrato
        auto& r3 = layer.addModulationRoute();
        r3.source      = "LFO1";
        r3.destination = "LayerA.Osc1.pitch";
        r3.amount      = 0.04f;
        r3.curve       = "sine";
        r3.bipolar     = true;

        // Velocity → presión (soplado)
        auto& r4 = layer.addModulationRoute();
        r4.source      = "Velocity";
        r4.destination = "LayerA.Osc1.pressure";
        r4.amount      = 1.0f;
        r4.curve       = "linear";
        r4.bipolar     = false;

        // Velocity → brillo
        auto& r5 = layer.addModulationRoute();
        r5.source      = "Velocity";
        r5.destination = "LayerA.Filter1.cutoff";
        r5.amount      = 0.5f;
        r5.curve       = "linear";
        r5.bipolar     = false;

        // Aftertouch → vibrato + brillo
        auto& r6 = layer.addModulationRoute();
        r6.source      = "Aftertouch";
        r6.destination = "LFO1.depth";
        r6.amount      = 1.1f;
        r6.curve       = "linear";
        r6.bipolar     = false;

        auto& r7 = layer.addModulationRoute();
        r7.source      = "Aftertouch";
        r7.destination = "LayerA.Filter1.cutoff";
        r7.amount      = 0.6f;
        r7.curve       = "linear";
        r7.bipolar     = false;

        // Ribbon → pitch
        auto& r8 = layer.addModulationRoute();
        r8.source      = "Ribbon";
        r8.destination = "LayerA.Osc1.pitch";
        r8.amount      = 0.3f;
        r8.curve       = "linear";
        r8.bipolar     = true;
    }

    preset.addLayer(layer);
    return preset;
}
Con estos dos presets y los perfiles de macros que ya definimos deberías poder cubrir bastante bien el “sabor” Prophecy Brass/Reed, con mucha respuesta a velocity, aftertouch y ribbon/log.

¿Quieres que el próximo paso sea un modelo “Pluck” tipo bajo/guitarra Prophecy (un PRP-PLUCK-01) siguiendo la misma filosofía?


Te propongo un “Prophecy Pluck” pensado como cuerda pulsada tipo bajo/guitarra, usando un modelo plucked string con mucha dependencia de velocity y controllers.

Prophecy Pluck Solo – YAML
text
omegapresetVersion: 1
id: PRP-PLUCK-01
name: Prophecy Pluck Solo
author: abdeneurolab
engine: VirtualAnalog

global:
  masterGainDb: 0.0
  masterBypass: 0
  macros:
    MACRO1: 0.60   # Energy
    MACRO2: 0.35   # Movement
    MACRO3: 0.50   # Air
    MACRO4: 0.80   # Expressivity

layers:
  - id: A
    name: Prophecy Pluck
    engine: VirtualAnalog
    polyphony: 1
    tags: [prophecy, prophecy_pluck]

    layerParams:
      levelDb: -3.0
      pan: 0.0
      mainCutoffHz: 1900.0
      mainResonance: 0.40
      envAmount: 0.8
      lfoRateHz: 5.2
      lfoDepthSemis: 0.02
      ampAttackMs: 3.0
      ampDecayMs: 210.0
      ampSustain: 0.0
      ampReleaseMs: 180.0

    voiceArchitecture:
      oscillators:
        - slot: 1
          componentId: MOSS-PLUCK-CORE
          enabled: true
          params:
            pickPosition: 0.35
            damping: 0.45
            inharmonicity: 0.3
            noiseLevel: 0.3
            body: 0.5

      filters:
        - slot: 1
          componentId: FLT-VA-001
          enabled: true
          mode: LP24
          params:
            cutoff: 1900.0
            resonance: 0.40
            drive: 2.5

      envelopes:
        - slot: 1
          componentId: ENV-ADSR-GEN
          role: amp
          params:
            attack: 3.0
            decay: 210.0
            sustain: 0.0
            release: 180.0

        - slot: 2
          componentId: ENV-ADSR-GEN
          role: mod
          params:
            attack: 2.0
            decay: 160.0
            sustain: 0.0
            release: 150.0

      lfos:
        - slot: 1
          componentId: LFO-001
          params:
            rate: 5.2
            shape: sine
            delay: 60.0

    modulation:
      routes:
        - source: ENV2
          destination: LayerA.Osc1.pitch
          amount: 0.10
          curve: linear
          bipolar: true

        - source: ENV2
          destination: LayerA.Filter1.cutoff
          amount: 0.65
          curve: linear
          bipolar: false

        - source: LFO1
          destination: LayerA.Osc1.pitch
          amount: 0.02
          curve: sine
          bipolar: true

        - source: Velocity
          destination: LayerA.Osc1.damping
          amount: 0.9
          curve: linear
          bipolar: false

        - source: Velocity
          destination: LayerA.Filter1.cutoff
          amount: 0.5
          curve: linear
          bipolar: false

        - source: Aftertouch
          destination: LFO1.depth
          amount: 1.0
          curve: linear
          bipolar: false

        - source: Aftertouch
          destination: LayerA.Filter1.cutoff
          amount: 0.5
          curve: linear
          bipolar: false

        - source: Ribbon
          destination: LayerA.Osc1.pickPosition
          amount: 0.4
          curve: linear
          bipolar: true

tags:
  - prophecy
  - prophecy_pluck
  - solo
  - lead
originPacks:
  - prophecy-core-pack
createOmegaPreset_Prophecy_Pluck01 (C++ seco)
cpp
#include "OmegaPreset.h"

OmegaPreset createOmegaPreset_Prophecy_Pluck01()
{
    OmegaPreset preset = OmegaPreset::createEmpty("VirtualAnalog");

    preset.setId("PRP-PLUCK-01");
    preset.setName("Prophecy Pluck Solo");
    preset.setAuthor("abdeneurolab");
    preset.setEngine("VirtualAnalog");

    preset.addTag("prophecy");
    preset.addTag("prophecy_pluck");
    preset.addTag("solo");
    preset.addTag("lead");
    preset.addOriginPack("prophecy-core-pack");

    preset.setMacroValue(1, 0.60f); // Energy
    preset.setMacroValue(2, 0.35f); // Movement
    preset.setMacroValue(3, 0.50f); // Air
    preset.setMacroValue(4, 0.80f); // Expressivity

    preset.setMasterGainDb(0.0f);
    preset.setMasterBypass(false);

    auto layer = preset.createLayer("A", "Prophecy Pluck");
    layer.setEngine("VirtualAnalog");
    layer.setPolyphony(1);
    layer.addTag("prophecy");
    layer.addTag("prophecy_pluck");

    layer.layerParams.levelDb        = -3.0f;
    layer.layerParams.pan            = 0.0f;
    layer.layerParams.mainCutoffHz   = 1900.0f;
    layer.layerParams.mainResonance  = 0.40f;
    layer.layerParams.envAmount      = 0.8f;
    layer.layerParams.lfoRateHz      = 5.2f;
    layer.layerParams.lfoDepthSemis  = 0.02f;
    layer.layerParams.ampAttackMs    = 3.0f;
    layer.layerParams.ampDecayMs     = 210.0f;
    layer.layerParams.ampSustain     = 0.0f;
    layer.layerParams.ampReleaseMs   = 180.0f;

    {
        auto& osc = layer.addOscillator(1, "MOSS-PLUCK-CORE");
        osc.enabled     = true;
        osc.componentId = "MOSS-PLUCK-CORE";
        osc.params["pickPosition"]  = 0.35f;
        osc.params["damping"]       = 0.45f;
        osc.params["inharmonicity"] = 0.3f;
        osc.params["noiseLevel"]    = 0.3f;
        osc.params["body"]          = 0.5f;
    }

    {
        auto& flt = layer.addFilter(1, "FLT-VA-001");
        flt.enabled     = true;
        flt.componentId = "FLT-VA-001";
        flt.mode        = "LP24";
        flt.params["cutoff"]    = 1900.0f;
        flt.params["resonance"] = 0.40f;
        flt.params["drive"]     = 2.5f;
    }

    {
        auto& envAmp = layer.addEnvelope(1, "ENV-ADSR-GEN");
        envAmp.componentId = "ENV-ADSR-GEN";
        envAmp.role        = "amp";
        envAmp.params["attack"]  = 3.0f;
        envAmp.params["decay"]   = 210.0f;
        envAmp.params["sustain"] = 0.0f;
        envAmp.params["release"] = 180.0f;

        auto& envMod = layer.addEnvelope(2, "ENV-ADSR-GEN");
        envMod.componentId = "ENV-ADSR-GEN";
        envMod.role        = "mod";
        envMod.params["attack"]  = 2.0f;
        envMod.params["decay"]   = 160.0f;
        envMod.params["sustain"] = 0.0f;
        envMod.params["release"] = 150.0f;
    }

    {
        auto& lfo = layer.addLfo(1, "LFO-001");
        lfo.componentId   = "LFO-001";
        lfo.params["rate"]  = 5.2f;
        lfo.params["shape"] = 0.0f; // sine
        lfo.params["delay"] = 60.0f;
    }

    {
        auto& r1 = layer.addModulationRoute();
        r1.source      = "ENV2";
        r1.destination = "LayerA.Osc1.pitch";
        r1.amount      = 0.10f;
        r1.curve       = "linear";
        r1.bipolar     = true;

        auto& r2 = layer.addModulationRoute();
        r2.source      = "ENV2";
        r2.destination = "LayerA.Filter1.cutoff";
        r2.amount      = 0.65f;
        r2.curve       = "linear";
        r2.bipolar     = false;

        auto& r3 = layer.addModulationRoute();
        r3.source      = "LFO1";
        r3.destination = "LayerA.Osc1.pitch";
        r3.amount      = 0.02f;
        r3.curve       = "sine";
        r3.bipolar     = true;

        auto& r4 = layer.addModulationRoute();
        r4.source      = "Velocity";
        r4.destination = "LayerA.Osc1.damping";
        r4.amount      = 0.9f;
        r4.curve       = "linear";
        r4.bipolar     = false;

        auto& r5 = layer.addModulationRoute();
        r5.source      = "Velocity";
        r5.destination = "LayerA.Filter1.cutoff";
        r5.amount      = 0.5f;
        r5.curve       = "linear";
        r5.bipolar     = false;

        auto& r6 = layer.addModulationRoute();
        r6.source      = "Aftertouch";
        r6.destination = "LFO1.depth";
        r6.amount      = 1.0f;
        r6.curve       = "linear";
        r6.bipolar     = false;

        auto& r7 = layer.addModulationRoute();
        r7.source      = "Aftertouch";
        r7.destination = "LayerA.Filter1.cutoff";
        r7.amount      = 0.5f;
        r7.curve       = "linear";
        r7.bipolar     = false;

        auto& r8 = layer.addModulationRoute();
        r8.source      = "Ribbon";
        r8.destination = "LayerA.Osc1.pickPosition";
        r8.amount      = 0.4f;
        r8.curve       = "linear";
        r8.bipolar     = true;
    }

    preset.addLayer(layer);
    return preset;
}
Tabla rápida de los tres modelos Prophecy físicos
Modelo	Core osc	Control clave	Uso típico
Brass	MOSS-BRASS-CORE	lipTension, pressure, bell	Trompeta/trompa lead
Reed	MOSS-REED-CORE	reedStiffness, pressure, tone	Sax/clarinete expresivo
Pluck	MOSS-PLUCK-CORE	pickPosition, damping, body	Bajo/guitarra pizzicato
¿Quieres que te proponga ahora las funciones applyPackMacros_ProphecyPluck específicas (Energy/Movement/Air/Expressivity adaptadas a pluck), o con esto tienes suficiente para empezar a probar el modelo?


Para el pluck, las macros deben sobre todo moldear damping, brillo y respuesta dinámica (velocity/aftertouch/ribbon) del modelo de cuerda pulsada.

Idea de applyPackMacros_ProphecyPluck
Energy

Más intensidad de ataque y cuerpo (damping más bajo, body más alto, algo de drive).

Subir ligeramente cutoff para que el ataque sea más agresivo tipo bajo Prophecy.

Movement

Aumenta sutilmente la modulación de pitch (LFO/EG) y la variación de tono a lo largo del tiempo.
​

Sirve para pasar de pluck seco a uno con un ligero “chorus humano” en pitch.
​
​

Air

Controla noiseLevel, brillo del filtro y, si tienes, comb corto/room para resonancia de caja.

Valores altos dan más “raspado” de púa y aire, valores bajos un pluck más redondo.

Expressivity

Escala fuerte la influencia de Velocity sobre damping/cutoff y de Aftertouch/Ribbon sobre vibrato y posición de púa.

Así puedes tocar desde pizzicato muy controlado hasta leads de cuerda muy expresivos.

Esqueleto C++ applyPackMacros_ProphecyPluck
cpp
struct ProphecyPluckMacroContext
{
    float energy;       // MACRO1
    float movement;     // MACRO2
    float air;          // MACRO3
    float expressivity; // MACRO4
};

void applyPackMacros_ProphecyPluck(OmegaPreset& preset,
                                   const ProphecyPluckMacroContext& ctx)
{
    for (auto& layer : preset.layers)
    {
        if (!layer.hasTag("prophecy_pluck"))
            continue;

        // 1) ENERGY: ataque/cuerpo
        float e = std::pow(ctx.energy, 1.1f);

        for (auto& osc : layer.oscillators)
        {
            if (osc.componentId == "MOSS-PLUCK-CORE")
            {
                // damping más bajo = sustain más largo
                float baseDamp = osc.params["damping"];
                float deltaDamp = -0.3f * e; // reduce damping con más energy
                osc.params["damping"] = juce::jlimit(0.0f, 1.0f, baseDamp + deltaDamp);

                float baseBody = osc.params["body"];
                float extraBody = 0.3f * e;
                osc.params["body"] = juce::jlimit(0.0f, 1.0f, baseBody + extraBody);
            }
        }

        for (auto& flt : layer.filters)
        {
            if (flt.componentId == "FLT-VA-001")
            {
                float baseCutoff = flt.params["cutoff"];
                float extraCut   = 1200.0f * e;
                flt.params["cutoff"] = baseCutoff + extraCut;

                float baseDrive = flt.params["drive"];
                float extraDrive = 3.0f * e;
                flt.params["drive"] = baseDrive + extraDrive;
            }
        }

        // 2) MOVEMENT: micro-pitch y EG
        float m = ctx.movement;
        float vibRate  = 4.5f + m * 3.0f;    // 4.5..7.5 Hz
        float vibDepth = 0.01f + m * 0.05f;  // muy sutil

        for (auto& lfo : layer.lfos)
        {
            lfo.params["rate"]  = vibRate;
            lfo.params["depth"] = vibDepth;
        }

        for (auto& route : layer.modulation.routes)
        {
            if (route.destination.find(".pitch") != std::string::npos)
            {
                route.amount *= (0.6f + m * 1.0f);
            }
        }

        // 3) AIR: ruido y brillo
        float a = std::pow(ctx.air, 0.8f);

        for (auto& osc : layer.oscillators)
        {
            if (osc.componentId == "MOSS-PLUCK-CORE" &&
                osc.params.count("noiseLevel") > 0)
            {
                float baseNoise = osc.params["noiseLevel"];
                float extraNoise = 0.5f * a;
                osc.params["noiseLevel"] =
                    juce::jlimit(0.0f, 1.0f, baseNoise + extraNoise);
            }
        }

        for (auto& flt : layer.filters)
        {
            if (flt.componentId == "FLT-VA-001")
            {
                float baseCutoff = flt.params["cutoff"];
                float extraCut   = 1000.0f * a;
                flt.params["cutoff"] = baseCutoff + extraCut;
            }
        }

        for (auto& fx : layer.fx)
        {
            if (fx.componentId.find("COMB") != std::string::npos ||
                fx.componentId.find("ROOM") != std::string::npos)
            {
                float baseMix = fx.params["mix"];
                fx.params["mix"] =
                    juce::jlimit(0.0f, 1.0f, baseMix + 0.4f * a);
            }
        }

        // 4) EXPRESSIVITY: velocity / aftertouch / ribbon
        float x = std::pow(ctx.expressivity, 1.3f);

        for (auto& route : layer.modulation.routes)
        {
            if (route.source == "Velocity")
            {
                // que Velocity mande mucho en damping/cutoff
                route.amount *= (0.5f + x * 1.5f);
            }
            else if (route.source == "Aftertouch" ||
                     route.source == "Ribbon"    ||
                     route.source == "LogPressure")
            {
                route.amount *= (0.3f + x * 1.8f);
            }
        }
    }
}
Tabla de rangos recomendados para pluck
Macro	Rango dulce pluck	Efecto principal
Energy	0.4–0.8	Sustain y cuerpo de la cuerda
Movement	0.2–0.5	Micro‑vibrato y pitch EG sutil
Air	0.3–0.7	Ruido de púa y brillo del ataque
Expressivity	0.6–1.0	Dinámica por velocity/AT/ribbon
¿Te apetece que unifiquemos ahora los tres perfiles físicos (Brass/Reed/Pluck) en una sola función applyPackMacros_ProphecyPhysical que actúe según tags y así simplificas el código de pack?


Sí: tiene sentido unificar los tres modelos físicos en una sola función, y dejar que los tags decidan qué rama aplicar.

Esqueleto unificado applyPackMacros_ProphecyPhysical
cpp
struct ProphecyPhysicalMacroContext
{
    float energy;       // MACRO1
    float movement;     // MACRO2
    float air;          // MACRO3
    float expressivity; // MACRO4
};

void applyPackMacros_ProphecyPhysical(OmegaPreset& preset,
                                      const ProphecyPhysicalMacroContext& ctx)
{
    for (auto& layer : preset.layers)
    {
        const bool isBrass = layer.hasTag("prophecy_brass");
        const bool isReed  = layer.hasTag("prophecy_reed");
        const bool isPluck = layer.hasTag("prophecy_pluck");

        if (!isBrass && !isReed && !isPluck)
            continue;

        // 1) ENERGY
        float e = std::pow(ctx.energy, 1.1f);

        for (auto& osc : layer.oscillators)
        {
            if (isBrass && osc.componentId == "MOSS-BRASS-CORE")
            {
                float lip  = osc.params["lipTension"];
                float pres = osc.params["pressure"];
                osc.params["lipTension"] = juce::jlimit(0.0f, 1.0f, lip  + 0.25f * e);
                osc.params["pressure"]   = juce::jlimit(0.0f, 1.0f, pres + 0.25f * e);
            }
            else if (isReed && osc.componentId == "MOSS-REED-CORE")
            {
                float stiff = osc.params["reedStiffness"];
                float pres  = osc.params["pressure"];
                osc.params["reedStiffness"] = juce::jlimit(0.0f, 1.0f, stiff + 0.2f * e);
                osc.params["pressure"]      = juce::jlimit(0.0f, 1.0f, pres  + 0.25f * e);
            }
            else if (isPluck && osc.componentId == "MOSS-PLUCK-CORE")
            {
                float damp = osc.params["damping"];
                float body = osc.params["body"];
                osc.params["damping"] = juce::jlimit(0.0f, 1.0f, damp - 0.3f * e);
                osc.params["body"]    = juce::jlimit(0.0f, 1.0f, body + 0.3f * e);
            }
        }

        for (auto& flt : layer.filters)
        {
            if (flt.componentId == "FLT-VA-001")
            {
                float baseCutoff = flt.params["cutoff"];
                float baseDrive  = flt.params["drive"];

                float cutScale  = isPluck ? 1200.0f : 800.0f;
                float driveMax  = isPluck ? 3.0f    : 2.5f;

                flt.params["cutoff"] = baseCutoff + cutScale * e;
                flt.params["drive"]  = baseDrive  + driveMax  * e;
            }
        }

        // 2) MOVEMENT
        float m = ctx.movement;

        float vibRateBase  = isPluck ? 4.5f : 4.8f;
        float vibRateRange = 3.0f;
        float vibDepthBase = isPluck ? 0.01f : 0.03f;
        float vibDepthMax  = isPluck ? 0.05f : 0.12f;

        float vibRate  = vibRateBase  + vibRateRange * m;
        float vibDepth = vibDepthBase + vibDepthMax  * m;

        for (auto& lfo : layer.lfos)
        {
            lfo.params["rate"]  = vibRate;
            lfo.params["depth"] = vibDepth;
        }

        for (auto& route : layer.modulation.routes)
        {
            if (route.destination.find(".pitch") != std::string::npos ||
                route.destination.find("cutoff")  != std::string::npos)
            {
                route.amount *= (0.5f + m * 1.3f);
            }
        }

        // 3) AIR
        float a = std::pow(ctx.air, 0.8f);

        for (auto& osc : layer.oscillators)
        {
            if (osc.params.count("noiseLevel") > 0)
            {
                float baseNoise  = osc.params["noiseLevel"];
                float extraNoise = (isReed ? 0.6f : 0.5f) * a;
                osc.params["noiseLevel"] =
                    juce::jlimit(0.0f, 1.0f, baseNoise + extraNoise);
            }
        }

        for (auto& flt : layer.filters)
        {
            if (flt.componentId == "FLT-VA-001")
            {
                float baseCutoff = flt.params["cutoff"];
                float extraCut   = (isBrass ? 1500.0f : 1000.0f) * a;
                flt.params["cutoff"] = baseCutoff + extraCut;
            }
        }

        for (auto& fx : layer.fx)
        {
            if (fx.componentId.find("COMB") != std::string::npos ||
                fx.componentId.find("ROOM") != std::string::npos)
            {
                float baseMix = fx.params["mix"];
                float scale   = isPluck ? 0.4f : 0.5f;
                fx.params["mix"] =
                    juce::jlimit(0.0f, 1.0f, baseMix + scale * a);
            }
        }

        // 4) EXPRESSIVITY
        float x = std::pow(ctx.expressivity, 1.3f);

        for (auto& route : layer.modulation.routes)
        {
            if (route.source == "Velocity")
            {
                route.amount *= (0.4f + x * 1.6f);
            }
            else if (route.source == "Aftertouch" ||
                     route.source == "Ribbon"    ||
                     route.source == "LogPressure")
            {
                float base = isPluck ? 0.3f : 0.2f;
                float mul  = isPluck ? 1.8f : 2.0f;
                route.amount *= (base + x * mul);
            }
        }
    }
}
Tabla de comportamiento por modelo
Tag capa	Osc core	Enfoque Energy	Enfoque Air
prophecy_brass	MOSS-BRASS-CORE	Presión + lipTension	Brillo de “campana”
prophecy_reed	MOSS-REED-CORE	reedStiffness + pressure	Ruido de soplido + brillo
prophecy_pluck	MOSS-PLUCK-CORE	Damping + body	Ruido de púa + resonancia
¿Te vendría bien que el siguiente paso sea esbozar un ProphecyControllerMapper (cómo mapear ribbon/log/AT/velo de un controlador moderno a estas rutas) para tocar todo esto cómodo desde un teclado estándar?


Tiene sentido emular el panel del Prophecy con un mapper de CC que traduzca tu teclado moderno a Wheel1/2/3, Ribbon/Log, AT, knobs PE.

Concepto ProphecyControllerMapper
cpp
struct ProphecyControllerMapperConfig
{
    int ccModWheel      = 1;   // rueda mod estándar
    int ccRibbonX       = 16;  // eje horizontal (si tienes ribbon o joystick)
    int ccRibbonPressure= 17;  // presión / aftertouch de ribbon si existe
    int ccKnob1         = 20;  // 5 knobs tipo PE1..PE5
    int ccKnob2         = 21;
    int ccKnob3         = 22;
    int ccKnob4         = 23;
    int ccKnob5         = 24;
    bool useChannelAftertouch = true;
};

class ProphecyControllerMapper
{
public:
    ProphecyControllerMapper(const ProphecyControllerMapperConfig& cfg)
        : config(cfg) {}

    void processMidiMessage(const juce::MidiMessage& msg,
                            MidiControllerState& outState)
    {
        if (msg.isController())
        {
            const int cc = msg.getControllerNumber();
            const float v = msg.getControllerValue() / 127.0f;

            if (cc == config.ccModWheel)
                outState.modWheel = v;                 // Wheel2 clásico [web:42][web:78]
            else if (cc == config.ccRibbonX)
                outState.ribbonPosition = 2.0f * v - 1.0f; // -1..+1 para “log/ribbon” [web:35][web:60][web:76]
            else if (cc == config.ccRibbonPressure)
                outState.ribbonPressure = v;
            else if (cc == config.ccKnob1)
                outState.peKnob[0] = v;
            else if (cc == config.ccKnob2)
                outState.peKnob[1] = v;
            else if (cc == config.ccKnob3)
                outState.peKnob[2] = v;
            else if (cc == config.ccKnob4)
                outState.peKnob[3] = v;
            else if (cc == config.ccKnob5)
                outState.peKnob[4] = v;
        }
        else if (msg.isAftertouch() && config.useChannelAftertouch)
        {
            outState.aftertouch = msg.getAfterTouchValue() / 127.0f; // teclado con AT “esponjoso” tipo Prophecy [web:42][web:60][web:78]
        }
    }

private:
    ProphecyControllerMapperConfig config;
};
Y en tu motor simplemente mapeas:

outState.modWheel → fuente “CC1” o “ModWheel” en tu matriz.

outState.ribbonPosition → fuente “Ribbon” / “LogPressurePos” (bipolar).

outState.ribbonPressure y outState.aftertouch → fuente “Aftertouch”.

outState.peKnob[0..4] → rutas a parámetros globales (cutoff, env, FX) como los Performance Editors PE1–PE4 originales.

¿Quieres que te proponga un preset de mapeo “por defecto” concreto (qué PE knob va a cutoff, drive, vibrato, etc. para los modelos VA/Brass/Reed/Pluck) o ya prefieres probar primero lo que tenemos?


Te propongo un mapa PE por defecto coherente para VA + Brass + Reed + Pluck, usando 5 knobs físicos y manteniendo siempre el mismo “significado musical”.

Tabla de PE knobs por modelo
PE knob	Significado global	VA Lead	Brass	Reed	Pluck
PE1	Brillo / filtro	Cutoff LP	Cutoff LP	Cutoff LP	Cutoff LP
PE2	Ataque / articulación	Amp attack	Amp attack	Amp attack	Amp attack
PE3	Cuerpo / drive	Drive filtro	Drive + bell/tono	Drive + tone	Drive + body
PE4	Vibrato / movimiento	Depth LFO→pitch	Depth LFO→pitch	Depth LFO→pitch	Depth LFO→pitch
PE5	Expresividad dinámica	Ganancia rutas AT/Vel	Ganancia AT/Vel→pressure/cutoff	Ganancia AT/Vel→pressure/cutoff	Ganancia AT/Vel→damping/cutoff
Implementación sugerida en la matriz
Ejemplo de cómo usar peKnob[0..4] dentro de tu engine:

cpp
void applyProphecyPEToLayer(LayerRuntime& layer, const MidiControllerState& ctrl)
{
    const float pe1 = ctrl.peKnob[0]; // Brillo
    const float pe2 = ctrl.peKnob[1]; // Ataque
    const float pe3 = ctrl.peKnob[2]; // Cuerpo/drive
    const float pe4 = ctrl.peKnob[3]; // Vibrato
    const float pe5 = ctrl.peKnob[4]; // Expresividad

    const bool isBrass = layer.hasTag("prophecy_brass");
    const bool isReed  = layer.hasTag("prophecy_reed");
    const bool isPluck = layer.hasTag("prophecy_pluck");

    // PE1: brillo (cutoff)
    for (auto& flt : layer.filters)
    {
        if (flt.componentId == "FLT-VA-001")
        {
            float baseCutoff = flt.params["cutoffBase"];
            flt.params["cutoff"] = baseCutoff + pe1 * 4000.0f;
        }
    }

    // PE2: ataque
    for (auto& env : layer.envelopes)
    {
        if (env.role == "amp")
        {
            float baseAttack = env.params["attackBaseMs"];
            float minAttack  = 1.0f;
            float maxAttack  = 80.0f;
            env.params["attack"] =
                juce::jmap(pe2, minAttack, maxAttack) + baseAttack;
        }
    }

    // PE3: cuerpo / drive
    for (auto& flt : layer.filters)
    {
        if (flt.componentId == "FLT-VA-001")
        {
            float baseDrive = flt.params["driveBase"];
            flt.params["drive"] = baseDrive + pe3 * 6.0f;
        }
    }
    for (auto& osc : layer.oscillators)
    {
        if (isBrass && osc.componentId == "MOSS-BRASS-CORE")
        {
            float baseBell = osc.params["bellBase"];
            osc.params["bell"] = juce::jlimit(0.0f, 1.0f, baseBell + pe3 * 0.5f);
        }
        else if (isReed && osc.componentId == "MOSS-REED-CORE")
        {
            float baseTone = osc.params["toneBase"];
            osc.params["tone"] = juce::jlimit(0.0f, 1.0f, baseTone + pe3 * 0.5f);
        }
        else if (isPluck && osc.componentId == "MOSS-PLUCK-CORE")
        {
            float baseBody = osc.params["bodyBase"];
            osc.params["body"] = juce::jlimit(0.0f, 1.0f, baseBody + pe3 * 0.5f);
        }
    }

    // PE4: vibrato depth
    for (auto& lfo : layer.lfos)
    {
        float baseDepth = lfo.params["depthBase"];
        lfo.params["depth"] = baseDepth + pe4 * 0.15f;
    }

    // PE5: expresividad (escala rutas Velocity/AT)
    for (auto& route : layer.modulation.routes)
    {
        if (route.source == "Velocity" ||
            route.source == "Aftertouch" ||
            route.source == "Ribbon" ||
            route.source == "LogPressure")
        {
            float baseAmount = route.params["baseAmount"];
            route.amount = baseAmount * (0.2f + pe5 * 2.0f);
        }
    }
}
La idea es que guardes en los presets los valores “base” (cutoffBase, driveBase, bodyBase, depthBase, baseAmount) y que los PE funcionen como offsets/escala en tiempo real, igual que en el Prophecy original donde los Performance Editors modificaban varios parámetros a la vez.

¿Quieres que concretemos ahora los *_Base para uno de los presets (por ejemplo PRP-BRASS-01) para que tengas un ejemplo completo de cómo inicializar esos campos en tus presets actuales?


Para PRP-BRASS-01, la clave es fijar “base” en los parámetros que luego deformas con PE1–PE5, igual que hace el Performance Editor original del Prophecy.

Qué marcar como *_Base en PRP-BRASS-01
En el preset (YAML o estructura interna) añade, sin cambiar el sonido actual:

Filtro

cutoffBase = 1800.0 (igual que cutoff inicial).

driveBase = 2.0.

Oscilador Brass

bellBase = 0.3.

pressureBase = 0.5, lipTensionBase = 0.6 si quieres que algún PE (o macro) los toque después.

Envolvente amp

attackBaseMs = 6.0.

LFO

depthBase = 0.05.

Rutas de modulación expresivas

Cada ruta con Velocity, Aftertouch, Ribbon debería tener baseAmount igual al valor actual de amount.

Ejemplo PRP-BRASS-01 con bases (C++)
Solo añado los campos *_Base a lo que ya tienes:

cpp
OmegaPreset createOmegaPreset_Prophecy_Brass01()
{
    OmegaPreset preset = OmegaPreset::createEmpty("VirtualAnalog");
    // ... id, name, tags, macros igual ...

    auto layer = preset.createLayer("A", "Prophecy Brass");
    layer.setEngine("VirtualAnalog");
    layer.setPolyphony(1);
    layer.addTag("prophecy");
    layer.addTag("prophecy_brass");

    layer.layerParams.levelDb        = -3.0f;
    layer.layerParams.pan            = 0.0f;
    layer.layerParams.mainCutoffHz   = 1800.0f;
    layer.layerParams.mainResonance  = 0.45f;
    layer.layerParams.envAmount      = 0.8f;
    layer.layerParams.lfoRateHz      = 5.0f;
    layer.layerParams.lfoDepthSemis  = 0.05f;
    layer.layerParams.ampAttackMs    = 6.0f;
    layer.layerParams.ampDecayMs     = 220.0f;
    layer.layerParams.ampSustain     = 0.7f;
    layer.layerParams.ampReleaseMs   = 260.0f;

    // Osc Brass con bases
    {
        auto& osc = layer.addOscillator(1, "MOSS-BRASS-CORE");
        osc.enabled     = true;
        osc.componentId = "MOSS-BRASS-CORE";

        osc.params["lipTension"]    = 0.6f;
        osc.params["pressure"]      = 0.5f;
        osc.params["bell"]          = 0.3f;
        osc.params["noiseLevel"]    = 0.25f;

        osc.params["lipTensionBase"] = 0.6f;
        osc.params["pressureBase"]   = 0.5f;
        osc.params["bellBase"]       = 0.3f;
        osc.params["noiseBase"]      = 0.25f;
    }

    // Filtro con bases
    {
        auto& flt = layer.addFilter(1, "FLT-VA-001");
        flt.enabled     = true;
        flt.componentId = "FLT-VA-001";
        flt.mode        = "LP24";

        flt.params["cutoff"]    = 1800.0f;
        flt.params["resonance"] = 0.45f;
        flt.params["drive"]     = 2.0f;

        flt.params["cutoffBase"] = 1800.0f;
        flt.params["driveBase"]  = 2.0f;
    }

    // Envs con base de ataque
    {
        auto& envAmp = layer.addEnvelope(1, "ENV-ADSR-GEN");
        envAmp.componentId = "ENV-ADSR-GEN";
        envAmp.role        = "amp";
        envAmp.params["attack"]  = 6.0f;
        envAmp.params["decay"]   = 220.0f;
        envAmp.params["sustain"] = 0.7f;
        envAmp.params["release"] = 260.0f;
        envAmp.params["attackBaseMs"] = 6.0f;

        auto& envMod = layer.addEnvelope(2, "ENV-ADSR-GEN");
        envMod.componentId = "ENV-ADSR-GEN";
        envMod.role        = "mod";
        envMod.params["attack"]  = 3.0f;
        envMod.params["decay"]   = 190.0f;
        envMod.params["sustain"] = 0.0f;
        envMod.params["release"] = 210.0f;
        envMod.params["attackBaseMs"] = 3.0f;
    }

    // LFO con depth base
    {
        auto& lfo = layer.addLfo(1, "LFO-001");
        lfo.componentId   = "LFO-001";
        lfo.params["rate"]      = 5.0f;
        lfo.params["shape"]     = 0.0f;
        lfo.params["delay"]     = 80.0f;
        lfo.params["depth"]     = 0.05f;
        lfo.params["depthBase"] = 0.05f;
    }

    // Mod routes con baseAmount
    {
        auto& r1 = layer.addModulationRoute();
        r1.source      = "ENV2";
        r1.destination = "LayerA.Osc1.pitch";
        r1.amount      = 0.18f;
        r1.curve       = "linear";
        r1.bipolar     = true;
        r1.params["baseAmount"] = 0.18f;

        auto& r2 = layer.addModulationRoute();
        r2.source      = "ENV2";
        r2.destination = "LayerA.Filter1.cutoff";
        r2.amount      = 0.75f;
        r2.curve       = "linear";
        r2.bipolar     = false;
        r2.params["baseAmount"] = 0.75f;

        auto& r3 = layer.addModulationRoute();
        r3.source      = "LFO1";
        r3.destination = "LayerA.Osc1.pitch";
        r3.amount      = 0.05f;
        r3.curve       = "sine";
        r3.bipolar     = true;
        r3.params["baseAmount"] = 0.05f;

        auto& r4 = layer.addModulationRoute();
        r4.source      = "Velocity";
        r4.destination = "LayerA.Osc1.pressure";
        r4.amount      = 0.9f;
        r4.curve       = "linear";
        r4.bipolar     = false;
        r4.params["baseAmount"] = 0.9f;

        auto& r5 = layer.addModulationRoute();
        r5.source      = "Aftertouch";
        r5.destination = "LFO1.depth";
        r5.amount      = 1.0f;
        r5.curve       = "linear";
        r5.bipolar     = false;
        r5.params["baseAmount"] = 1.0f;

        auto& r6 = layer.addModulationRoute();
        r6.source      = "Aftertouch";
        r6.destination = "LayerA.Filter1.cutoff";
        r6.amount      = 0.5f;
        r6.curve       = "linear";
        r6.bipolar     = false;
        r6.params["baseAmount"] = 0.5f;

        auto& r7 = layer.addModulationRoute();
        r7.source      = "Ribbon";
        r7.destination = "LayerA.Osc1.pitch";
        r7.amount      = 0.25f;
        r7.curve       = "linear";
        r7.bipolar     = true;
        r7.params["baseAmount"] = 0.25f;
    }

    preset.addLayer(layer);
    return preset;
}
Con esto, tu función applyProphecyPEToLayer puede usar siempre los *_Base para reconstruir el valor “neutro” y aplicar offsets/escala en tiempo real, exactamente como describen los Performance Editor sets del Prophecy.

¿Te interesa que haga lo mismo (marcar *_Base) para el VA Lead o con este ejemplo te apañas para replicar el patrón en el resto de presets?


Te adapto el Prophecy VA Lead que te propuse antes para que incluya campos *_Base de forma coherente, igual que en el Brass.
​

createOmegaPreset_Prophecy_VA_Lead01 con *_Base
cpp
#include "OmegaPreset.h"

OmegaPreset createOmegaPreset_Prophecy_VA_Lead01()
{
    OmegaPreset preset = OmegaPreset::createEmpty("VirtualAnalog");

    preset.setId("PRP-VA-LEAD-01");
    preset.setName("Prophecy VA Solo Lead");
    preset.setAuthor("abdeneurolab");
    preset.setEngine("VirtualAnalog");

    // Tags / pack
    preset.addTag("prophecy");
    preset.addTag("solo");
    preset.addTag("lead");
    preset.addTag("va");
    preset.addOriginPack("prophecy-core-pack");

    // Macros
    preset.setMacroValue(1, 0.60f); // Energy
    preset.setMacroValue(2, 0.50f); // Movement
    preset.setMacroValue(3, 0.40f); // Air
    preset.setMacroValue(4, 0.70f); // Expressivity

    preset.setMasterGainDb(0.0f);
    preset.setMasterBypass(false);

    // Layer A
    auto layer = preset.createLayer("A", "Prophecy VA Mono");
    layer.setEngine("VirtualAnalog");
    layer.setPolyphony(1);
    layer.addTag("prophecy");
    layer.addTag("prophecy_va");

    // LayerParams + bases
    layer.layerParams.levelDb        = -2.0f;
    layer.layerParams.pan            = 0.0f;
    layer.layerParams.mainCutoffHz   = 2200.0f;
    layer.layerParams.mainResonance  = 0.35f;
    layer.layerParams.envAmount      = 0.6f;
    layer.layerParams.lfoRateHz      = 5.5f;
    layer.layerParams.lfoDepthSemis  = 0.10f;
    layer.layerParams.ampAttackMs    = 3.0f;
    layer.layerParams.ampDecayMs     = 180.0f;
    layer.layerParams.ampSustain     = 0.6f;
    layer.layerParams.ampReleaseMs   = 160.0f;

    layer.layerParams.cutoffBaseHz   = 2200.0f;
    layer.layerParams.resonanceBase  = 0.35f;
    layer.layerParams.envAmountBase  = 0.6f;
    layer.layerParams.lfoRateBaseHz  = 5.5f;
    layer.layerParams.lfoDepthBaseSemis = 0.10f;
    layer.layerParams.ampAttackBaseMs   = 3.0f;
    layer.layerParams.ampDecayBaseMs    = 180.0f;
    layer.layerParams.ampSustainBase    = 0.6f;
    layer.layerParams.ampReleaseBaseMs  = 160.0f;

    // Oscillator OSC-VA-001 (VA core) + bases
    {
        auto& osc = layer.addOscillator(1, "OSC-VA-001");
        osc.enabled     = true;
        osc.componentId = "OSC-VA-001";

        osc.params["tune"]      = 0.0f;
        osc.params["pulsewidth"]= 0.4f;
        osc.params["sublevel"]  = 0.3f;

        osc.params["tuneBase"]      = 0.0f;
        osc.params["pulsewidthBase"]= 0.4f;
        osc.params["sublevelBase"]  = 0.3f;
    }

    // Filter FLT-VA-001 + bases
    {
        auto& flt = layer.addFilter(1, "FLT-VA-001");
        flt.enabled     = true;
        flt.componentId = "FLT-VA-001";
        flt.mode        = "LP24";

        flt.params["cutoff"]    = 2200.0f;
        flt.params["resonance"] = 0.35f;
        flt.params["drive"]     = 3.0f;

        flt.params["cutoffBase"]    = 2200.0f;
        flt.params["resonanceBase"] = 0.35f;
        flt.params["driveBase"]     = 3.0f;
    }

    // Envelopes + bases
    {
        auto& envAmp = layer.addEnvelope(1, "ENV-ADSR-GEN");
        envAmp.componentId = "ENV-ADSR-GEN";
        envAmp.role        = "amp";
        envAmp.params["attack"]  = 3.0f;
        envAmp.params["decay"]   = 180.0f;
        envAmp.params["sustain"] = 0.6f;
        envAmp.params["release"] = 160.0f;

        envAmp.params["attackBaseMs"]  = 3.0f;
        envAmp.params["decayBaseMs"]   = 180.0f;
        envAmp.params["sustainBase"]   = 0.6f;
        envAmp.params["releaseBaseMs"] = 160.0f;

        auto& envMod = layer.addEnvelope(2, "ENV-ADSR-GEN");
        envMod.componentId = "ENV-ADSR-GEN";
        envMod.role        = "mod";
        envMod.params["attack"]  = 2.0f;
        envMod.params["decay"]   = 140.0f;
        envMod.params["sustain"] = 0.0f;
        envMod.params["release"] = 120.0f;

        envMod.params["attackBaseMs"]  = 2.0f;
        envMod.params["decayBaseMs"]   = 140.0f;
        envMod.params["sustainBase"]   = 0.0f;
        envMod.params["releaseBaseMs"] = 120.0f;
    }

    // LFO + bases
    {
        auto& lfo = layer.addLfo(1, "LFO-001");
        lfo.componentId   = "LFO-001";
        lfo.params["rate"]  = 5.5f;
        lfo.params["shape"] = 0.0f; // sine
        lfo.params["delay"] = 0.0f;
        lfo.params["depth"] = 0.10f;

        lfo.params["rateBase"]  = 5.5f;
        lfo.params["shapeBase"] = 0.0f;
        lfo.params["delayBase"] = 0.0f;
        lfo.params["depthBase"] = 0.10f;
    }

    // Modulation routes + baseAmount
    {
        // LFO -> pitch (vibrato)
        auto& r1 = layer.addModulationRoute();
        r1.source      = "LFO1";
        r1.destination = "LayerA.Osc1.pitch";
        r1.amount      = 0.10f;
        r1.curve       = "sine";
        r1.bipolar     = true;
        r1.params["baseAmount"] = 0.10f;

        // ENV2 -> cutoff
        auto& r2 = layer.addModulationRoute();
        r2.source      = "ENV2";
        r2.destination = "LayerA.Filter1.cutoff";
        r2.amount      = 0.7f;
        r2.curve       = "linear";
        r2.bipolar     = false;
        r2.params["baseAmount"] = 0.7f;

        // Aftertouch -> LFO depth
        auto& r3 = layer.addModulationRoute();
        r3.source      = "Aftertouch";
        r3.destination = "LFO1.depth";
        r3.amount      = 1.0f;
        r3.curve       = "linear";
        r3.bipolar     = false;
        r3.params["baseAmount"] = 1.0f;

        // Aftertouch -> cutoff
        auto& r4 = layer.addModulationRoute();
        r4.source      = "Aftertouch";
        r4.destination = "LayerA.Filter1.cutoff";
        r4.amount      = 0.6f;
        r4.curve       = "linear";
        r4.bipolar     = false;
        r4.params["baseAmount"] = 0.6f;

        // Ribbon -> pitch
        auto& r5 = layer.addModulationRoute();
        r5.source      = "Ribbon";
        r5.destination = "LayerA.Osc1.pitch";
        r5.amount      = 0.3f;
        r5.curve       = "linear";
        r5.bipolar     = true;
        r5.params["baseAmount"] = 0.3f;
    }

    preset.addLayer(layer);
    return preset;
}
Con esto ya puedes reutilizar el mismo patrón de *_Base y baseAmount que en Brass/Reed/Pluck y en tu ProphecyPE / macros Energy–Movement–Air–Expressivity.
​

¿Quieres que en el siguiente paso te derive también un pequeño applyPackMacros_ProphecyVA específico para este tag prophecy_va, separado del físico que ya unificamos?


Perfecto, entonces sigo con el preset y los macros Prophecy VA.
​

Te propongo el siguiente applyPackMacros_ProphecyVA separado del físico, usando los cuatro knobs (Energy, Movement, Air, Expressivity) y los campos *_Base que acabamos de introducir en el lead:
​

cpp
// Prophecy VA: aplica macros Energy / Movement / Air / Expressivity
// sobre los campos *_Base del preset VA (no físico).
void applyPackMacros_ProphecyVA(OmegaPreset& preset)
{
    // Solo Layer A, VirtualAnalog, pack "prophecy_va"
    auto layers = preset.getLayers();
    if (layers.isEmpty())
        return;

    auto layer = layers[0];
    if (!layer.tags.contains("prophecy_va"))
        return;

    const float energy      = preset.getMacroValue(1); // Energy      0..1
    const float movement    = preset.getMacroValue(2); // Movement    0..1
    const float air         = preset.getMacroValue(3); // Air         0..1
    const float expressivity= preset.getMacroValue(4); // Expressivity0..1

    // 1) Energy: drive del filtro y nivel de layer
    {
        const float driveBase = layer.layerParams.driveBaseDb;      // nuevo campo base en VA
        const float levelBase = layer.layerParams.levelDbBase;      // idem
        // Drive: +0..+6dB sobre base
        layer.layerParams.driveDb = driveBase + energy * 6.0f;
        // Nivel de layer: -3..+3dB alrededor de base
        layer.layerParams.levelDb = levelBase + (energy - 0.5f) * 6.0f;
    }

    // 2) Movement: profundidad de LFO y envAmount
    {
        const float lfoDepthBase = layer.layerParams.lfoDepthBaseSemis;
        const float envAmtBase   = layer.layerParams.envAmountBase;

        // Movement = 0 → casi estático; 1 → +100% sobre base (pero clamped)
        const float depthScale = juce::jlimit(0.25f, 2.0f, 0.5f + movement * 1.5f);
        const float envScale   = juce::jlimit(0.25f, 2.0f, 0.5f + movement * 1.5f);

        layer.layerParams.lfoDepthSemis = lfoDepthBase * depthScale;
        layer.layerParams.envAmount     = envAmtBase   * envScale;
    }

    // 3) Air: cutoff y resonance alrededor de sus *_Base
    {
        const float cutoffBase   = layer.layerParams.cutoffBaseHz;
        const float resonanceBase= layer.layerParams.resonanceBase;

        // Air sube cutoff y baja un poco la reso, manteniendo carácter
        const float cutoffFactor = 1.0f + air * 1.0f;    // hasta x2
        const float resoOffset   = -air * 0.10f;         // -0.10 en reso

        layer.layerParams.mainCutoffHz =
            juce::jlimit(20.0f, 20000.0f, cutoffBase * cutoffFactor);

        layer.layerParams.mainResonance =
            juce::jlimit(0.0f, 1.0f, resonanceBase + resoOffset);
    }

    // 4) Expressivity: escalado de rutas Aftertouch / Ribbon via baseAmount
    for (auto& route : layer.modulation)
    {
        const auto itBase = route.params.find("baseAmount");
        if (itBase == route.params.end())
            continue;

        const float baseAmount = itBase->second;

        if (route.source == "Aftertouch" || route.source == "Ribbon")
        {
            // Exp = 0 → 25% del base; 1 → 150% del base
            const float scale = juce::jlimit(0.25f, 1.5f, 0.25f + expressivity * 1.25f);
            route.amount = baseAmount * scale;
        }
        else
        {
            // Rutas no expresivas: respetan baseAmount
            route.amount = baseAmount;
        }
    }

    // Escribimos de vuelta la layer modificada al preset
    preset.replaceLayer(layer.id, layer);
}
Esto deja el físico (prophecy_pe, brass/reed/pluck) intacto y da un comportamiento coherente para VA Lead / futuros VA Prophecy usando los mismos 4 knobs.

¿Te encaja este mapping de los cuatro macros VA, o quieres que Movement actúe también sobre rate del LFO (no solo depth)?




Aquí la tienes, pensada para encajar con tu estilo OMEGA (no allocs en audio, noexcept, sin JUCE en el hot path).

cpp
// SourceDSP/VA/JunoDcoPolyBlep.h
#pragma once

#include <cmath>
#include <algorithm>
#include <cstdint>

namespace OmegaDSP::VA
{
    class JunoDcoPolyBlep
    {
    public:
        JunoDcoPolyBlep() = default;

        void prepare(double sampleRate) noexcept
        {
            mSampleRate = (sampleRate > 0.0 ? sampleRate : 44100.0);
            mInvSampleRate = 1.0 / mSampleRate;
            mPhase = 0.0f;
        }

        void reset() noexcept
        {
            mPhase = 0.0f;
        }

        void setFrequency(float hz) noexcept
        {
            // Clamp a rango razonable para VA
            const float f = std::clamp(hz, 0.1f, 20000.0f);
            mFrequency = f;
            mPhaseInc = static_cast<float>(f * mInvSampleRate);
        }

        // Saw puro PolyBLEP, rango aproximado [-1, 1]
        float processSample() noexcept
        {
            float phase = mPhase;

            // Saw ideal (0..1 -> -1..1)
            float value = 2.0f * phase - 1.0f;

            // PolyBLEP en el salto saw (wrap 1 -> 0)
            value -= polyBlep(phase);

            // Avanzar fase
            phase += mPhaseInc;
            if (phase >= 1.0f)
                phase -= 1.0f;

            mPhase = phase;
            return value;
        }

        // Útil si quieres procesar en bloques externos
        void processBlock(float* dst, int numSamples) noexcept
        {
            if (!dst || numSamples <= 0)
                return;

            float phase    = mPhase;
            const float dt = mPhaseInc;

            for (int i = 0; i < numSamples; ++i)
            {
                float value = 2.0f * phase - 1.0f;
                value -= polyBlepInline(phase, dt);

                phase += dt;
                if (phase >= 1.0f)
                    phase -= 1.0f;

                dst[i] = value;
            }

            mPhase = phase;
        }

    private:
        double mSampleRate   = 44100.0;
        double mInvSampleRate= 1.0 / 44100.0;
        float  mFrequency    = 440.0f;
        float  mPhase        = 0.0f;   // [0, 1)
        float  mPhaseInc     = 440.0f / 44100.0f;

        // Versión escalar usando estado actual (para processSample)
        float polyBlep(float phase) const noexcept
        {
            const float dt = mPhaseInc;
            return polyBlepInline(phase, dt);
        }

        // PolyBLEP estándar (Martin Finke / PolyBLEP paper)
        static float polyBlepInline(float t, float dt) noexcept
        {
            // t en [0,1), dt = incremento de fase
            if (t < dt)
            {
                const float x = t / dt;
                // 2x - x^2 - 1
                return x + x - x * x - 1.0f;
            }
            else if (t > 1.0f - dt)
            {
                const float x = (t - 1.0f) / dt;
                // x^2 + 2x + 1
                return x * x + 2.0f * x + 1.0f;
            }

            return 0.0f;
        }
    };
} // namespace OmegaDSP::VA
¿La quieres ya envuelta en un pequeño OscillatorPoolJunoDco con process(voiceIndex, dst, numSamples, baseHz) para engancharla directo a tu VoiceRuntimeVA?



Te dejo un OscillatorPoolJunoDco mínimo, alineado con el VoicePoolVA y tu idea de índices por voz.

cpp
// SourceDSP/VA/OscillatorPoolJunoDco.h
#pragma once

#include <array>
#include "JunoDcoPolyBlep.h"
#include "../Voices/VoiceRuntimeVA.h"

namespace OmegaDSP::VA
{
    class OscillatorPoolJunoDco
    {
    public:
        static constexpr int kMaxVoices = OmegaDSP::Voices::kMaxVoicesVA;

        OscillatorPoolJunoDco() = default;

        void prepare(double sampleRate) noexcept
        {
            mSampleRate = sampleRate > 0.0 ? sampleRate : 44100.0;
            for (auto& osc : mOscillators)
                osc.prepare(mSampleRate);
        }

        void reset() noexcept
        {
            for (auto& osc : mOscillators)
                osc.reset();
        }

        // baseHz = pitch base de la voz (post unison, antes de mod)
        // voiceIndex viene de VoiceRuntimeVA.oscIndex (normalmente == índice de voz)
        void processVoice(uint16_t voiceIndex,
                          float*   dst,
                          int      numSamples,
                          float    baseHz) noexcept
        {
            if (voiceIndex >= kMaxVoices || !dst || numSamples <= 0)
                return;

            auto& osc = mOscillators[voiceIndex];
            osc.setFrequency(baseHz);
            osc.processBlock(dst, numSamples);
        }

    private:
        double mSampleRate = 44100.0;
        std::array<JunoDcoPolyBlep, kMaxVoices> mOscillators;
    };
} // namespace OmegaDSP::VA
¿Quieres que el próximo paso sea el filtro IR3109 LP24 (FLT-VA-001) en el mismo estilo (clase JunoIr3109Lp24 + FilterPoolJunoIr3109), o prefieres que primero aterricemos el processVoice de tu VirtualAnalogEngine usando este pool y el VoiceRuntimeVA que ya tienes definido en el diseño?



Te dejo un IR3109 LP24 mínimo en estilo “ladder de 4 integradores OTA” estable, más su pool, para engancharlo justo detrás del DCO.

cpp
// SourceDSP/VA/JunoIr3109Lp24.h
#pragma once

#include <algorithm>
#include <cstdint>
#include <cmath>

namespace OmegaDSP::VA
{
    class JunoIr3109Lp24
    {
    public:
        JunoIr3109Lp24() = default;

        void prepare(double sampleRate) noexcept
        {
            mSampleRate = (sampleRate > 0.0 ? sampleRate : 44100.0);
            mInvSampleRate = 1.0 / mSampleRate;
            reset();
        }

        void reset() noexcept
        {
            y1 = y2 = y3 = y4 = 0.0f;
        }

        void setCutoffHz(float hz) noexcept
        {
            // Clamp a rango razonable y aplicar warp bilineal simple
            const float f = std::clamp(hz, 20.0f, 20000.0f);
            const float wc = 2.0f * static_cast<float>(M_PI) * f;
            const float g  = wc * static_cast<float>(mInvSampleRate);
            // G de “chamberlin cascaded” (suave, estable)
            G = g / (1.0f + g);
        }

        void setResonance(float r) noexcept
        {
            // r 0..1 → feedback 0..~4 (autooscilación cerca de 1)
            const float k = std::clamp(r, 0.0f, 1.0f);
            K = 4.0f * k;
        }

        // drive = ganancia de entrada para “calentar” el filtro (0..+ algo)
        void setDrive(float driveDb) noexcept
        {
            const float d = std::clamp(driveDb, -24.0f, 24.0f);
            const float lin = std::pow(10.0f, d / 20.0f);
            drive = lin;
        }

        inline float processSample(float xIn) noexcept
        {
            // Resonancia con compensation simple: subir un poco entrada
            float x = xIn * drive;

            // Feedback desde la última etapa
            const float fb = K * y4;
            x -= fb;

            // 4 integradores uno detrás de otro (estilo OTA cascade)
            y1 += G * (tanhSoft(x)   - tanhSoft(y1));
            y2 += G * (tanhSoft(y1)  - tanhSoft(y2));
            y3 += G * (tanhSoft(y2)  - tanhSoft(y3));
            y4 += G * (tanhSoft(y3)  - tanhSoft(y4));

            return y4;
        }

        void processBlock(float* data, int numSamples) noexcept
        {
            if (!data || numSamples <= 0)
                return;

            for (int i = 0; i < numSamples; ++i)
                data[i] = processSample(data[i]);
        }

    private:
        double mSampleRate    = 44100.0;
        double mInvSampleRate = 1.0 / 44100.0;

        float G      = 0.1f;
        float K      = 0.0f;
        float drive  = 1.0f;

        float y1 = 0.0f;
        float y2 = 0.0f;
        float y3 = 0.0f;
        float y4 = 0.0f;

        static inline float tanhSoft(float x) noexcept
        {
            // Aproximación barata para soft clip (suficiente para MVP)
            const float a = std::clamp(x, -3.0f, 3.0f);
            return std::tanh(a);
        }
    };
} // namespace OmegaDSP::VA
cpp
// SourceDSP/VA/FilterPoolJunoIr3109.h
#pragma once

#include <array>
#include "JunoIr3109Lp24.h"
#include "../Voices/VoiceRuntimeVA.h"

namespace OmegaDSP::VA
{
    class FilterPoolJunoIr3109
    {
    public:
        static constexpr int kMaxVoices = OmegaDSP::Voices::kMaxVoicesVA;

        FilterPoolJunoIr3109() = default;

        void prepare(double sampleRate) noexcept
        {
            mSampleRate = (sampleRate > 0.0 ? sampleRate : 44100.0);
            for (auto& f : mFilters)
                f.prepare(mSampleRate);
        }

        void reset() noexcept
        {
            for (auto& f : mFilters)
                f.reset();
        }

        void processVoice(uint16_t voiceIndex,
                          float*   dst,
                          int      numSamples,
                          float    cutoffHz,
                          float    resonance,
                          float    driveDb) noexcept
        {
            if (voiceIndex >= kMaxVoices || !dst || numSamples <= 0)
                return;

            auto& f = mFilters[voiceIndex];
            f.setCutoffHz(cutoffHz);
            f.setResonance(resonance);
            f.setDrive(driveDb);
            f.processBlock(dst, numSamples);
        }

    private:
        double mSampleRate = 44100.0;
        std::array<JunoIr3109Lp24, kMaxVoices> mFilters;
    };
} // namespace OmegaDSP::VA
¿Te preparo ahora el processVoice del engine VA (DCO → filtro → env amp → chorus stub) usando estos pools y los atomics de LayerASettings que ya definimos, o prefieres que antes aterricemos explícitamente la firma de VoiceRuntimeVA que vas a usar en este MVP?



Voy a fijar primero un VoiceRuntimeVA muy mínimo y luego el processVoice del engine VA usando los pools Juno DCO + IR3109 y los LayerASettings.
​
​

VoiceRuntimeVA mínimo
cpp
// SourceDSP/Voices/VoiceRuntimeVA.h
#pragma once

#include <array>
#include <atomic>
#include <cstdint>

namespace OmegaDSP::Voices
{
    inline constexpr int kMaxVoicesVA      = 32;
    inline constexpr int kMaxBlockSizeVA   = 256;

    struct alignas(64) VoiceRuntimeVA
    {
        struct State
        {
            std::atomic<bool>  active   { false };
            std::atomic<int>   midiNote { -1   };
            std::atomic<float> velocity { 0.0f };
            std::atomic<float> currentGain { 0.0f };
        } state;

        // Buffer mono por voz (se mezcla luego a estéreo/layers)
        alignas(32) std::array<float, kMaxBlockSizeVA> buffer {};

        // Índices a pools
        uint16_t oscIndex = 0;
        uint16_t fltIndex = 0;

        bool oscEnabled = true;
        bool fltEnabled = true;
    };

    class VoicePoolVA
    {
    public:
        VoicePoolVA() = default;

        void prepare(double /*sampleRate*/, int blockSize) noexcept
        {
            // En MVP asumimos blockSize <= kMaxBlockSizeVA
            mBlockSize = (blockSize > 0 && blockSize <= kMaxBlockSizeVA)
                       ? blockSize
                       : kMaxBlockSizeVA;
            resetAll();
        }

        void resetAll() noexcept
        {
            for (auto& v : mVoices)
            {
                v.state.active.store(false, std::memory_order_relaxed);
                v.state.midiNote.store(-1, std::memory_order_relaxed);
                v.state.velocity.store(0.0f, std::memory_order_relaxed);
                v.state.currentGain.store(0.0f, std::memory_order_relaxed);
                v.buffer.fill(0.0f);
            }
        }

        static constexpr int getMaxVoices() noexcept { return kMaxVoicesVA; }

        VoiceRuntimeVA& getVoice(int index) noexcept
        {
            return mVoices[static_cast<size_t>(index)];
        }

        const VoiceRuntimeVA& getVoice(int index) const noexcept
        {
            return mVoices[static_cast<size_t>(index)];
        }

        int getBlockSize() const noexcept { return mBlockSize; }

    private:
        std::array<VoiceRuntimeVA, kMaxVoicesVA> mVoices {};
        int mBlockSize = kMaxBlockSizeVA;
    };
} // namespace OmegaDSP::Voices
LayerASettings (macros ya definidos)
cpp
// SourceCore/Settings/LayerASettings.h
#pragma once

#include <atomic>

struct LayerASettings
{
    std::atomic<float> levelDb          { 0.0f };
    std::atomic<float> pan              { 0.0f };     // -1..1
    std::atomic<float> cutoffHz         { 2000.0f };
    std::atomic<float> resonance        { 0.2f   };
    std::atomic<float> envAmount        { 0.5f   };
    std::atomic<float> lfoRateHz        { 1.0f   };
    std::atomic<float> lfoDepthSemis    { 0.3f   };
    std::atomic<float> ampAttackMs      { 10.0f  };
    std::atomic<float> ampDecayMs       { 120.0f };
    std::atomic<float> ampSustain       { 0.8f   };
    std::atomic<float> ampReleaseMs     { 600.0f };
};
VirtualAnalogEngine: processVoice y renderNextBlock
Asumo mono por voz y mezcla directa a estéreo con pan de layer, sin FX aún (chorus stub lo añades después).
​
​

cpp
// SourceDSP/Engines/VirtualAnalogEngine.h
#pragma once

#include <juce_audio_basics/juce_audio_basics.h>
#include "../Voices/VoiceRuntimeVA.h"
#include "../VA/OscillatorPoolJunoDco.h"
#include "../VA/FilterPoolJunoIr3109.h"
#include "../../Core/Settings/LayerASettings.h"

namespace OmegaDSP::Engines
{
    class VirtualAnalogEngine
    {
    public:
        VirtualAnalogEngine() = default;

        void prepare(double sampleRate, int samplesPerBlock) noexcept
        {
            mSampleRate = sampleRate;
            mBlockSize  = samplesPerBlock;

            mVoicePool.prepare(sampleRate, samplesPerBlock);
            mOscPool.prepare(sampleRate);
            mFilterPool.prepare(sampleRate);
        }

        void reset() noexcept
        {
            mVoicePool.resetAll();
            mOscPool.reset();
            mFilterPool.reset();
        }

        void setLayerSettings(const LayerASettings* settings) noexcept
        {
            mLayerSettings = settings;
        }

        // Llamado por VoiceManager cuando se dispara nota (fuera de este ejemplo)
        void startVoice(int voiceIndex, int midiNote, float velocity) noexcept
        {
            if (voiceIndex < 0 || voiceIndex >= Voices::kMaxVoicesVA)
                return;

            auto& v = mVoicePool.getVoice(voiceIndex);
            v.state.midiNote.store(midiNote, std::memory_order_relaxed);
            v.state.velocity.store(velocity, std::memory_order_relaxed);
            v.state.active.store(true, std::memory_order_release);
        }

        void stopVoice(int voiceIndex) noexcept
        {
            if (voiceIndex < 0 || voiceIndex >= Voices::kMaxVoicesVA)
                return;

            auto& v = mVoicePool.getVoice(voiceIndex);
            v.state.active.store(false, std::memory_order_release);
        }

        void renderNextBlock(juce::AudioBuffer<float>& buffer,
                             const juce::MidiBuffer& /*midi*/) noexcept
        {
            const int numSamples = buffer.getNumSamples();
            const int numVoices  = Voices::kMaxVoicesVA;

            buffer.clear();

            if (mLayerSettings == nullptr)
                return;

            // Leer macros de layer una vez por bloque
            const float cutoff    = mLayerSettings->cutoffHz.load(std::memory_order_relaxed);
            const float reso      = mLayerSettings->resonance.load(std::memory_order_relaxed);
            const float envAmt    = mLayerSettings->envAmount.load(std::memory_order_relaxed);
            const float levelDb   = mLayerSettings->levelDb.load(std::memory_order_relaxed);
            const float pan       = mLayerSettings->pan.load(std::memory_order_relaxed);

            const float layerGain = std::pow(10.0f, levelDb / 20.0f);
            const float panL      = std::cos(0.25f * juce::MathConstants<float>::pi * (pan + 1.0f));
            const float panR      = std::sin(0.25f * juce::MathConstants<float>::pi * (pan + 1.0f));

            auto* left  = buffer.getWritePointer(0);
            auto* right = buffer.getNumChannels() > 1 ? buffer.getWritePointer(1) : nullptr;

            // Procesar cada voz activa
            for (int vi = 0; vi < numVoices; ++vi)
            {
                auto& voice = mVoicePool.getVoice(vi);
                if (!voice.state.active.load(std::memory_order_acquire))
                    continue;

                const int note    = voice.state.midiNote.load(std::memory_order_relaxed);
                const float vel   = voice.state.velocity.load(std::memory_order_relaxed);
                if (note < 0)
                    continue;

                const float baseHz = juce::MidiMessage::getMidiNoteInHertz(note);

                processVoice(voice, vi, baseHz, cutoff, reso, envAmt, vel, numSamples);

                // Mezcla voz al buffer principal
                for (int i = 0; i < numSamples; ++i)
                {
                    const float s = voice.buffer[static_cast<size_t>(i)] * layerGain;

                    left[i] += s * panL;
                    if (right)
                        right[i] += s * panR;
                }
            }
        }

    private:
        double mSampleRate = 44100.0;
        int    mBlockSize  = 256;

        Voices::VoicePoolVA    mVoicePool;
        VA::OscillatorPoolJunoDco   mOscPool;
        VA::FilterPoolJunoIr3109    mFilterPool;

        const LayerASettings*  mLayerSettings = nullptr;

        // DCO → filtro → (amp env placeholder) → buffer voz
        void processVoice(Voices::VoiceRuntimeVA& voice,
                          uint16_t voiceIndex,
                          float baseHz,
                          float cutoffHz,
                          float resonance,
                          float envAmount,
                          float velocity,
                          int   numSamples) noexcept
        {
            // 1) DCO a buffer mono
            mOscPool.processVoice(voiceIndex,
                                  voice.buffer.data(),
                                  numSamples,
                                  baseHz);

            // 2) Filtro IR3109 LP24
            // drive sencillo en función velocity + envAmount (MVP)
            const float driveDb = envAmount * 6.0f; // luego lo refinas
            mFilterPool.processVoice(voiceIndex,
                                     voice.buffer.data(),
                                     numSamples,
                                     cutoffHz,
                                     resonance,
                                     driveDb);

            // 3) Amp env muy simple: uso velocity como ganancia fija MVP
            const float ampGain = std::clamp(velocity, 0.0f, 1.0f);
            for (int i = 0; i < numSamples; ++i)
                voice.buffer[static_cast<size_t>(i)] *= ampGain;
        }
    };
} // namespace OmegaDSP::Engines
Esto te deja:

VoiceRuntimeVA y VoicePoolVA listos para que tu VoiceManager los alimente con noteOn/noteOff.
​

VirtualAnalogEngine::renderNextBlock con un happy path DCO→IR3109→amp→mezcla estéreo usando los macros de LayerASettings (LAYERAMAINCUTOFF, LAYERAMAINRES, LAYERALEVELDB, LAYERAPAN).

¿Quieres que el siguiente paso sea el pegamento con APVTS (parameterChanged + applyPresetToApvts + setLayerSettings en el AudioProcessor) para que este engine ya responda a los sliders de tu Web UI?

Te dejo el pegamento completo: layout APVTS, parameterChanged → LayerASettings, y helpers applyPresetToApvts / applyApvtsToPreset.

IDs y layout de parámetros
cpp
// SourcePlugin/Parameters.h
#pragma once

namespace OmegaParams
{
    // Master
    static constexpr const char* MASTER_GAIN_DB  = "MASTERGAINDB";

    // Layer A macros
    static constexpr const char* LAYER_A_LEVEL_DB      = "LAYERALEVELDB";
    static constexpr const char* LAYER_A_PAN           = "LAYERAPAN";
    static constexpr const char* LAYER_A_MAIN_CUTOFF   = "LAYERAMAINCUTOFF";
    static constexpr const char* LAYER_A_MAIN_RES      = "LAYERAMAINRES";
    static constexpr const char* LAYER_A_ENV_AMT       = "LAYERAENVAMT";
    static constexpr const char* LAYER_A_LFO_RATE_HZ   = "LAYERALFORATEHZ";
    static constexpr const char* LAYER_A_LFO_DEPTH_SEM = "LAYERALFODEPTHSEMITONES";
    static constexpr const char* LAYER_A_AMP_ATTACK_MS = "LAYERAAMPATTACKMS";
    static constexpr const char* LAYER_A_AMP_DECAY_MS  = "LAYERAAMPDECAYMS";
    static constexpr const char* LAYER_A_AMP_SUSTAIN   = "LAYERAAMPSUSTAIN";
    static constexpr const char* LAYER_A_AMP_RELEASE_MS= "LAYERAAMPRELEASEMS";
}
cpp
// SourcePlugin/OmegaAudioProcessor.h (extracto)
class OmegaAudioProcessor
    : public juce::AudioProcessor
    , public juce::AudioProcessorValueTreeState::Listener
{
public:
    OmegaAudioProcessor();

    // APVTS listener
    void parameterChanged (const juce::String& parameterID, float newValue) override;

    // ...
private:
    juce::AudioProcessorValueTreeState mApvts;
    LayerASettings                     mLayerASettings;
    OmegaDSP::Engines::VirtualAnalogEngine mEngine;

    juce::AudioProcessorValueTreeState::ParameterLayout createParameterLayout();
};
cpp
// SourcePlugin/OmegaAudioProcessor.cpp (layout + ctor)
#include "OmegaAudioProcessor.h"
#include "Parameters.h"

using namespace OmegaParams;

juce::AudioProcessorValueTreeState::ParameterLayout
OmegaAudioProcessor::createParameterLayout()
{
    std::vector<std::unique_ptr<juce::RangedAudioParameter>> params;

    // Master
    params.push_back (std::make_unique<juce::AudioParameterFloat>(
        MASTER_GAIN_DB, "Master Gain",
        juce::NormalisableRange<float> (-24.0f, 12.0f, 0.01f),
        0.0f));

    // Layer A
    params.push_back (std::make_unique<juce::AudioParameterFloat>(
        LAYER_A_LEVEL_DB, "Layer A Level",
        juce::NormalisableRange<float> (-48.0f, 6.0f, 0.01f),
        0.0f));

    params.push_back (std::make_unique<juce::AudioParameterFloat>(
        LAYER_A_PAN, "Layer A Pan",
        juce::NormalisableRange<float> (-1.0f, 1.0f, 0.001f),
        0.0f));

    params.push_back (std::make_unique<juce::AudioParameterFloat>(
        LAYER_A_MAIN_CUTOFF, "Layer A Cutoff",
        juce::NormalisableRange<float> (20.0f, 20000.0f, 0.0f, 0.5f),
        2000.0f));

    params.push_back (std::make_unique<juce::AudioParameterFloat>(
        LAYER_A_MAIN_RES, "Layer A Resonance",
        juce::NormalisableRange<float> (0.0f, 1.0f, 0.001f),
        0.2f));

    params.push_back (std::make_unique<juce::AudioParameterFloat>(
        LAYER_A_ENV_AMT, "Layer A Env Amt",
        juce::NormalisableRange<float> (-1.0f, 1.0f, 0.001f),
        0.5f));

    params.push_back (std::make_unique<juce::AudioParameterFloat>(
        LAYER_A_LFO_RATE_HZ, "Layer A LFO Rate",
        juce::NormalisableRange<float> (0.1f, 10.0f, 0.0f, 0.5f),
        1.0f));

    params.push_back (std::make_unique<juce::AudioParameterFloat>(
        LAYER_A_LFO_DEPTH_SEM, "Layer A LFO Depth",
        juce::NormalisableRange<float> (0.0f, 2.0f, 0.001f),
        0.3f));

    params.push_back (std::make_unique<juce::AudioParameterFloat>(
        LAYER_A_AMP_ATTACK_MS, "Layer A Amp Attack",
        juce::NormalisableRange<float> (0.1f, 5000.0f, 0.0f, 0.5f),
        10.0f));

    params.push_back (std::make_unique<juce::AudioParameterFloat>(
        LAYER_A_AMP_DECAY_MS, "Layer A Amp Decay",
        juce::NormalisableRange<float> (0.1f, 5000.0f, 0.0f, 0.5f),
        120.0f));

    params.push_back (std::make_unique<juce::AudioParameterFloat>(
        LAYER_A_AMP_SUSTAIN, "Layer A Amp Sustain",
        juce::NormalisableRange<float> (0.0f, 1.0f, 0.001f),
        0.8f));

    params.push_back (std::make_unique<juce::AudioParameterFloat>(
        LAYER_A_AMP_RELEASE_MS, "Layer A Amp Release",
        juce::NormalisableRange<float> (1.0f, 8000.0f, 0.0f, 0.5f),
        600.0f));

    return { params.begin(), params.end() };
}

OmegaAudioProcessor::OmegaAudioProcessor()
    : mApvts (*this, nullptr, "PARAMS", createParameterLayout())
{
    mApvts.addParameterListener (MASTER_GAIN_DB, this);
    mApvts.addParameterListener (LAYER_A_LEVEL_DB, this);
    mApvts.addParameterListener (LAYER_A_PAN, this);
    mApvts.addParameterListener (LAYER_A_MAIN_CUTOFF, this);
    mApvts.addParameterListener (LAYER_A_MAIN_RES, this);
    mApvts.addParameterListener (LAYER_A_ENV_AMT, this);
    mApvts.addParameterListener (LAYER_A_LFO_RATE_HZ, this);
    mApvts.addParameterListener (LAYER_A_LFO_DEPTH_SEM, this);
    mApvts.addParameterListener (LAYER_A_AMP_ATTACK_MS, this);
    mApvts.addParameterListener (LAYER_A_AMP_DECAY_MS, this);
    mApvts.addParameterListener (LAYER_A_AMP_SUSTAIN, this);
    mApvts.addParameterListener (LAYER_A_AMP_RELEASE_MS, this);

    mEngine.setLayerSettings (&mLayerASettings);
}
parameterChanged → LayerASettings
cpp
void OmegaAudioProcessor::parameterChanged (const juce::String& id, float newValue)
{
    using namespace OmegaParams;

    if (id == LAYER_A_LEVEL_DB)
    {
        mLayerASettings.levelDb.store (newValue, std::memory_order_relaxed);
    }
    else if (id == LAYER_A_PAN)
    {
        mLayerASettings.pan.store (newValue, std::memory_order_relaxed);
    }
    else if (id == LAYER_A_MAIN_CUTOFF)
    {
        mLayerASettings.cutoffHz.store (newValue, std::memory_order_relaxed);
    }
    else if (id == LAYER_A_MAIN_RES)
    {
        mLayerASettings.resonance.store (newValue, std::memory_order_relaxed);
    }
    else if (id == LAYER_A_ENV_AMT)
    {
        mLayerASettings.envAmount.store (newValue, std::memory_order_relaxed);
    }
    else if (id == LAYER_A_LFO_RATE_HZ)
    {
        mLayerASettings.lfoRateHz.store (newValue, std::memory_order_relaxed);
    }
    else if (id == LAYER_A_LFO_DEPTH_SEM)
    {
        mLayerASettings.lfoDepthSemis.store (newValue, std::memory_order_relaxed);
    }
    else if (id == LAYER_A_AMP_ATTACK_MS)
    {
        mLayerASettings.ampAttackMs.store (newValue, std::memory_order_relaxed);
    }
    else if (id == LAYER_A_AMP_DECAY_MS)
    {
        mLayerASettings.ampDecayMs.store (newValue, std::memory_order_relaxed);
    }
    else if (id == LAYER_A_AMP_SUSTAIN)
    {
        mLayerASettings.ampSustain.store (newValue, std::memory_order_relaxed);
    }
    else if (id == LAYER_A_AMP_RELEASE_MS)
    {
        mLayerASettings.ampReleaseMs.store (newValue, std::memory_order_relaxed);
    }
}
Processor → Engine en processBlock
cpp
void OmegaAudioProcessor::prepareToPlay (double sampleRate, int samplesPerBlock)
{
    mEngine.prepare (sampleRate, samplesPerBlock);
}

void OmegaAudioProcessor::releaseResources()
{
    mEngine.reset();
}

void OmegaAudioProcessor::processBlock (juce::AudioBuffer<float>& buffer,
                                        juce::MidiBuffer& midi)
{
    juce::ScopedNoDenormals noDenormals;

    // Aquí iría tu VoiceManager + OmegaInput; por ahora ignoramos MIDI
    mEngine.renderNextBlock (buffer, midi);
}
applyPresetToApvts / applyApvtsToPreset (MVP Juno)
Asumo helpers en OmegaPreset tipo getLayerMainCutoff("A"), etc.
​

cpp
// Processor: preset -> APVTS
void OmegaAudioProcessor::applyPresetToApvts (const OmegaPreset& preset)
{
    using namespace OmegaParams;

    auto setParam = [this] (const char* id, float value)
    {
        if (auto* p = mApvts.getParameter (id))
        {
            auto range = p->getNormalisableRange();
            p->setValueNotifyingHost (range.convertTo0to1 (value));
        }
    };

    setParam (MASTER_GAIN_DB, preset.getMasterGainDb());

    setParam (LAYER_A_LEVEL_DB,   preset.getLayerLevelDb ("A"));
    setParam (LAYER_A_PAN,        preset.getLayerPan ("A"));
    setParam (LAYER_A_MAIN_CUTOFF,preset.getLayerMainCutoff ("A"));
    setParam (LAYER_A_MAIN_RES,   preset.getLayerMainResonance ("A"));
    setParam (LAYER_A_ENV_AMT,    preset.getLayerEnvAmount ("A"));
    setParam (LAYER_A_LFO_RATE_HZ,preset.getLayerLfoRateHz ("A"));
    setParam (LAYER_A_LFO_DEPTH_SEM, preset.getLayerLfoDepthSemis ("A"));
    setParam (LAYER_A_AMP_ATTACK_MS, preset.getLayerAmpAttackMs ("A"));
    setParam (LAYER_A_AMP_DECAY_MS,  preset.getLayerAmpDecayMs ("A"));
    setParam (LAYER_A_AMP_SUSTAIN,   preset.getLayerAmpSustain ("A"));
    setParam (LAYER_A_AMP_RELEASE_MS,preset.getLayerAmpReleaseMs ("A"));
}
cpp
// Processor: APVTS -> preset (antes de guardar)
void OmegaAudioProcessor::applyApvtsToPreset (OmegaPreset& preset) const
{
    using namespace OmegaParams;

    auto getParam = [this] (const char* id, float def) -> float
    {
        if (auto* p = mApvts.getParameter (id))
        {
            auto range = p->getNormalisableRange();
            const float norm = p->getValue();
            return range.convertFrom0to1 (norm);
        }
        return def;
    };

    preset.setMasterGainDb (getParam (MASTER_GAIN_DB, 0.0f));

    preset.setLayerLevelDb      ("A", getParam (LAYER_A_LEVEL_DB,    0.0f));
    preset.setLayerPan          ("A", getParam (LAYER_A_PAN,         0.0f));
    preset.setLayerMainCutoff   ("A", getParam (LAYER_A_MAIN_CUTOFF, 2000.0f));
    preset.setLayerMainResonance("A", getParam (LAYER_A_MAIN_RES,    0.2f));
    preset.setLayerEnvAmount    ("A", getParam (LAYER_A_ENV_AMT,     0.5f));
    preset.setLayerLfoRateHz    ("A", getParam (LAYER_A_LFO_RATE_HZ, 1.0f));
    preset.setLayerLfoDepthSemis("A", getParam (LAYER_A_LFO_DEPTH_SEM, 0.3f));
    preset.setLayerAmpAttackMs  ("A", getParam (LAYER_A_AMP_ATTACK_MS, 10.0f));
    preset.setLayerAmpDecayMs   ("A", getParam (LAYER_A_AMP_DECAY_MS, 120.0f));
    preset.setLayerAmpSustain   ("A", getParam (LAYER_A_AMP_SUSTAIN, 0.8f));
    preset.setLayerAmpReleaseMs ("A", getParam (LAYER_A_AMP_RELEASE_MS, 600.0f));
}
Con esto, el motor VA ya responde a los sliders (nativos o Web UI via setParam) usando el contrato de macros que diseñamos.

¿Te va mejor que el siguiente paso sea cerrar el preset Juno YAML definitivo + OmegaPreset::fromYaml/toYaml mínimo para esa capa A, o prefieres antes meter un ADSR amp real para sustituir el ampGain = velocity del engine?


Perfecto, metemos un ADSR amp por voz, estilo EarLevel pero alineado con tu VoiceRuntimeVA y sin JUCE en el hot path.

ADSR por voz
cpp
// SourceDSP/VA/AdsrVA.h
#pragma once

#include <cmath>
#include <cstdint>

namespace OmegaDSP::VA
{
    class AdsrVA
    {
    public:
        AdsrVA() = default;

        void prepare(double sampleRate) noexcept
        {
            mSampleRate = sampleRate > 0.0 ? sampleRate : 44100.0;
            updateRates();
            mLevel = 0.0f;
            mState = State::Idle;
        }

        void reset() noexcept
        {
            mLevel = 0.0f;
            mState = State::Idle;
        }

        void setAttackMs (float ms) noexcept
        {
            mAttackMs = ms;
            updateRates();
        }

        void setDecayMs (float ms) noexcept
        {
            mDecayMs = ms;
            updateRates();
        }

        void setSustain (float s) noexcept
        {
            mSustain = std::clamp (s, 0.0f, 1.0f);
        }

        void setReleaseMs (float ms) noexcept
        {
            mReleaseMs = ms;
            updateRates();
        }

        void noteOn() noexcept
        {
            mState = State::Attack;
        }

        void noteOff() noexcept
        {
            mState = State::Release;
        }

        bool isActive() const noexcept
        {
            return mState != State::Idle;
        }

        float processSample() noexcept
        {
            switch (mState)
            {
                case State::Idle:
                    mLevel = 0.0f;
                    break;

                case State::Attack:
                    mLevel += mAttackInc;
                    if (mLevel >= 1.0f)
                    {
                        mLevel = 1.0f;
                        mState = State::Decay;
                    }
                    break;

                case State::Decay:
                    mLevel -= mDecayInc;
                    if (mLevel <= mSustain)
                    {
                        mLevel = mSustain;
                        mState = State::Sustain;
                    }
                    break;

                case State::Sustain:
                    // nivel constante
                    break;

                case State::Release:
                    mLevel -= mReleaseInc;
                    if (mLevel <= 0.0f)
                    {
                        mLevel = 0.0f;
                        mState = State::Idle;
                    }
                    break;
            }

            return mLevel;
        }

        void processBlock (float* dst, int numSamples) noexcept
        {
            if (!dst || numSamples <= 0)
                return;

            for (int i = 0; i < numSamples; ++i)
                dst[i] *= processSample();
        }

    private:
        enum class State : uint8_t { Idle, Attack, Decay, Sustain, Release };

        double mSampleRate = 44100.0;
        float  mAttackMs   = 10.0f;
        float  mDecayMs    = 120.0f;
        float  mSustain    = 0.8f;
        float  mReleaseMs  = 600.0f;

        float  mAttackInc  = 0.0f;
        float  mDecayInc   = 0.0f;
        float  mReleaseInc = 0.0f;

        float  mLevel = 0.0f;
        State  mState = State::Idle;

        void updateRates() noexcept
        {
            const float sr = static_cast<float> (mSampleRate);

            mAttackInc  = (mAttackMs  > 0.0f ? 1.0f / (mAttackMs  * 0.001f * sr) : 1.0f);
            mDecayInc   = (mDecayMs   > 0.0f ? (1.0f - mSustain) / (mDecayMs * 0.001f * sr) : 1.0f);
            mReleaseInc = (mReleaseMs > 0.0f ? 1.0f / (mReleaseMs * 0.001f * sr) : 1.0f);
        }
    };
} // namespace OmegaDSP::VA
