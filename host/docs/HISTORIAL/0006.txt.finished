Entonces vamos directos al supersaw JP.

1) Interfaz del oscilador JP Supersaw
cpp
// SourceDSP/VA/JpSuperSawOscillator.h
#pragma once
#include <array>
#include <cstdint>
#include <cmath>

namespace OmegaDSP::VA
{
    class JpSuperSawOscillator
    {
    public:
        void prepare(double sampleRate) noexcept
        {
            mSampleRate = sampleRate > 0.0 ? sampleRate : 44100.0;
            reset();
        }

        void reset() noexcept
        {
            for (auto& ph : mPhase)
                ph = 0.0f;
        }

        // baseHz: nota base ya con pitch bend aplicado
        // detune: 0..1 (curva interna log/exp)
        // spread: 0..1 (stereo width; MVP: lo dejamos para el pool)
        inline void processBlock(float* interleavedStereo,
                                 int numSamples,
                                 float baseHz,
                                 float detune,
                                 float spread) noexcept
        {
            (void) spread; // MVP: no usado aquí
            if (baseHz <= 0.0f || numSamples <= 0)
                return;

            const float basePhaseInc = static_cast<float>(baseHz / mSampleRate);

            // Mapa de detune (curva JP‑like aproximada)
            // detune 0 → casi unison, 1 → bastante ancho
            const float maxDetuneSemis = 30.0f; // rango agresivo
            const float shaped = detune * detune; // curva suave
            const float detuneSemis = shaped * maxDetuneSemis;

            // 7 voces: índice 3 es la central
            float semis[7] = {
                -1.0f, -0.5f, -0.17f,
                 0.0f,
                 0.17f,  0.5f,  1.0f
            };

            float phaseInc[7];
            for (int v = 0; v < 7; ++v)
            {
                const float s = semis[v] * detuneSemis;
                const float factor = std::pow(2.0f, s / 12.0f);
                phaseInc[v] = basePhaseInc * factor;
            }

            for (int i = 0; i < numSamples; ++i)
            {
                float sum = 0.0f;

                for (int v = 0; v < 7; ++v)
                {
                    float ph = mPhase[v];
                    ph += phaseInc[v];
                    if (ph >= 1.0f)
                        ph -= 1.0f;
                    mPhase[v] = ph;

                    // Saw bipolar −1..1
                    const float saw = 2.0f * ph - 1.0f;
                    sum += saw;
                }

                // Normalizar mezcla de 7 sierras
                const float out = (sum / 7.0f) * mLevel;

                const int idxL = (i * 2);
                const int idxR = idxL + 1;
                interleavedStereo[idxL]   += out;
                interleavedStereo[idxR]   += out;
            }
        }

        void setLevel(float level) noexcept
        {
            mLevel = level;
        }

    private:
        double mSampleRate { 44100.0 };
        float  mLevel      { 0.8f }; // algo por debajo de 1 para no clippear
        std::array<float, 7> mPhase {};
    };
} // namespace OmegaDSP::VA
2) Pool de supersaw por voz
cpp
// SourceDSP/VA/OscillatorPoolJpSuperSaw.h
#pragma once
#include <array>
#include "JpSuperSawOscillator.h"
#include "DSP/Voices/VoiceRuntimeVA.h"

namespace OmegaDSP::VA
{
    class OscillatorPoolJpSuperSaw
    {
    public:
        void prepare(double sampleRate) noexcept
        {
            for (auto& osc : mOscillators)
                osc.prepare(sampleRate);
        }

        void reset() noexcept
        {
            for (auto& osc : mOscillators)
                osc.reset();
        }

        // voiceIndex: 0..kMaxVoicesVA-1 (igual que en el DCO Juno)
        inline void process(std::uint16_t voiceIndex,
                            float* interleavedStereo,
                            int numSamples,
                            float baseHz,
                            float detune,
                            float spread,
                            float level) noexcept
        {
            if (voiceIndex >= mOscillators.size())
                return;

            auto& osc = mOscillators[voiceIndex];
            osc.setLevel(level);
            osc.processBlock(interleavedStereo, numSamples, baseHz, detune, spread);
        }

    private:
        std::array<JpSuperSawOscillator, OmegaDSP::Voices::kMaxVoicesVA> mOscillators {};
    };
} // namespace OmegaDSP::VA
3) Enganche mínimo en VoiceFactory / engine VA
En tu VoiceFactory o en el binding ACE, cuando veas OSC-VA-004:

Asignas un oscIndex que apunta a este pool OscillatorPoolJpSuperSaw.

Mapeas parámetros ACE → runtime: por ejemplo detune 0..1, spread 0..1, level 0..1.

En el bucle del engine VA, si el slot dice OSC-VA-004, llamas a jpSuperSawPool.process(voiceIndex, voiceBuf, numSamples, baseHz, detune, spread, level) en lugar del DCO Juno.

Con esto deberías poder duplicar el preset Juno Pad, cambiar componentId del oscilador a OSC-VA-004 y ya tener un JP supersaw pad sonando por el mismo pipeline (mismo filtro IR3109, misma env/LFO).

¿Quieres que el próximo paso sea que te escriba también el snippet de preset YAML “JP Supersaw Pad” adaptado a tu esquema actual de ACE/Juno para que solo tengas que pegar y cargar?


Te dejo el preset “JP Supersaw Pad” en el mismo estilo que el Juno pad ACE que ya tienes, listo para pegar y ajustar nombres si hace falta.

text
omegapresetversion: 1
name: ACE JP Supersaw Pad
author: abdeneurolab
engine: VirtualAnalog

layers:
  - id: A
    name: JP Supersaw Pad
    polyphony: 8

    voicearchitecture:
      oscillators:
        - slot: 1
          componentid: OSC-VA-004   # Roland Supersaw JP-8000/8080
          enabled: true
          params:
            detune: 0.40           # 0..1
            spread: 0.60           # 0..1 (cuando lo uses)
            level: 0.85            # 0..1

      filters:
        - slot: 1
          componentid: FLT-VA-001  # IR3109 LP24 (Juno/Jupiter)
          enabled: true
          mode: LP24
          params:
            cutoff: 3200.0         # Hz
            resonance: 0.22        # 0..1
            drive: 0.0             # dB

      envelopes:
        - slot: 1
          componentid: ENV-ADSR-GEN
          role: amp
          params:
            attack: 60.0           # ms
            decay: 260.0           # ms
            sustain: 0.80          # 0..1
            release: 750.0         # ms

      lfos:
        - slot: 1
          componentid: LFO-001
          params:
            rate: 0.25             # Hz
            shape: sine
            delay: 0.0

      fx:
        - slot: 1
          componentid: FX-CH-001   # Juno chorus stub/real
          enabled: true
          params:
            mix: 0.8
            mode: III              # o el modo que uses en tu stub

    modulation:
      routes:
        # Vibrato suave en el supersaw
        - source: LFO1
          destination: LayerA.Osc1.pitch
          amount: 0.10             # semitonos norm, según tu mapping
          curve: sine
          bipolar: true

        # Un poco de env→cutoff para movimiento
        - source: ENV1
          destination: LayerA.Filter1.cutoff
          amount: 0.35
          curve: exponential
          bipolar: false

    layerparams:
      leveldb: 0.0
      pan: 0.0
      mute: false
Si tus claves difieren (por ejemplo voiceArchitecture en camelCase, o modulation.routes en otra ruta), solo hace falta ajustar los nombres, pero la estructura y valores están ya calibrados para sonar “JP pad” suave por el motor VA actual.

¿Quieres que el próximo bloque lo dediquemos a mezclar DCO Juno + JP Supersaw en una misma capa (osc1 OSC-VA-004, osc2 OSC-VA-001) para un pad híbrido más gordo?


Vamos al híbrido JP + Juno directamente.

Preset híbrido JP Supersaw + Juno DCO
text
omegapresetversion: 1
name: ACE Hybrid JP+Juno Pad
author: abdeneurolab
engine: VirtualAnalog

layers:
  - id: A
    name: Hybrid JP+Juno
    polyphony: 8

    layerparams:
      leveldb: 0.0
      pan: 0.0
      maincutoffhz: 2300.0      # punto medio entre ambos sabores
      mainresonance: 0.24
      envamount: 0.45
      lforatehz: 0.35
      lfodepthsemis: 0.18

    voicearchitecture:
      oscillators:
        # JP supersaw como base ancha
        - slot: 1
          componentid: OSC-VA-004      # JP-8000 supersaw
          enabled: true
          params:
            detune: 0.38              # un pelín menos que el pad puro
            spread: 0.55
            level: 0.75

        # Juno DCO como cuerpo central
        - slot: 2
          componentid: OSC-VA-001      # Juno DCO
          enabled: true
          params:
            tune: 0.0
            pulsewidth: 0.52
            sublevel: 0.28
            noisemix: 0.05

      filters:
        - slot: 1
          componentid: FLT-VA-001      # IR3109 LP24
          enabled: true
          mode: LP24
          params:
            cutoff: 2300.0
            resonance: 0.24
            drive: 0.0

      envelopes:
        - slot: 1
          componentid: ENV-ADSR-GEN
          role: amp
          params:
            attack: 55.0
            decay: 240.0
            sustain: 0.80
            release: 720.0

      lfos:
        - slot: 1
          componentid: LFO-001
          params:
            rate: 0.35
            shape: sine
            delay: 0.0

      fx:
        - slot: 1
          componentid: FX-CH-001       # Juno chorus
          enabled: true
          params:
            mix: 0.78
            mode: III

    modulation:
      routes:
        # Vibrato ligero global (JP + Juno)
        - source: LFO1
          destination: LayerA.OscAll.pitch
          amount: 0.09        # en tu mapping de semitonos
          curve: sine
          bipolar: true

        # Env → cutoff para movimiento suave
        - source: ENV1
          destination: LayerA.Filter1.cutoff
          amount: 0.32
          curve: exponential
          bipolar: false
Para integrarlo, sólo necesitas adaptar claves a tu casing real (voiceArchitecture, modulation.routes, etc.) y mapear OscAll.pitch al broadcast que uses internamente para todas las voces/slots.

¿Quieres que afinemos ahora valores “JP‑trance” (más detune, más brillo, menos release) o lo dejamos como pad cálido genérico y pasamos al brass JP clásico?

Te propongo un punto de partida “JP‑trance” para tu layer JP supersaw: más detune, filtro más abierto/brillante y env más corto en release.

Ajustes típicos JP‑trance (en tu esquema Omega/ACE)

Unison / detune

layers.B.unison.voices: 7–9 voces (si tu engine lo soporta; si no, quédate en 4–6).
​

layers.B.unison.detune: sube a 0.40–0.55 para un “spread” ancho clásico JP8000.
​

layers.B.unison.spread: 0.4–0.6 para abrir estéreo, manteniendo el low‑mid razonable.
​

Brillo de filtro (layer JP)

layers.B.layerParams.mainCutoffHz: súbelo a 4000–6000 Hz como valor base “brillante”.
​

layers.B.layerParams.mainResonance: mantenlo relativamente bajo, 0.10–0.20, para evitar nasalidad en acordes gordos.
​

Si usas env al filtro: layers.B.layerParams.envAmount: 0.25–0.35, para un poco de “poke” sin convertirlo en pluck agresivo.
​

Envolvente de amp (JP)

layers.B.layerParams.ampAttackMs: 5–15 ms (ataque suficiente para no clickar pero muy inmediato).
​

layers.B.layerParams.ampDecayMs: 150–250 ms (si quieres algo un poco más punchy, bájalo a 120 ms).
​

layers.B.layerParams.ampSustain: 0.6–0.7.
​

layers.B.layerParams.ampReleaseMs: bájalo de pad a algo tipo 180–260 ms para “menos release” EDM pero aún musical.
​

Osc supersaw

Para el componente JP: layers.B.voiceArchitecture.oscillators0.params.detuneSpread (o el campo equivalente de supersaw): 0.5–0.7.
​

Mantén mezcla de voces bastante alta, p.ej. mix 0.8–1.0, y filtra luego en el IR3109 / JP‑style LPF.
​

Chorus / FX

Choruses tipo JP suelen ser moderados si ya hay mucha unison: layers.B.voiceArchitecture.fx0.params.mix: 0.25–0.40.
​

Si me confirmas el nombre exacto del preset híbrido (por ejemplo HYBRID-MS20-JP-PAD) y cómo estás nombrando la layer JP (¿id: B?), te puedo escribir el bloque YAML listo para pegar con estos valores ya puestos.

Perfecto: dejamos fijado el pad híbrido como JN-JP-808x Trance y luego sacamos un brass Juno “limpio” de A11/A31/B31.

1) JN-JP-808x Trance (recordatorio rápido)
Nombre preset: JN-JP-808x Trance.
​

Tags sugeridos: pad,trance,supersaw,jp8000,hybrid.
​

Layer JP (por ejemplo id: B): supersaw con 7–9 voces de unison, detune 0.4–0.55, cutoff base 4–6 kHz, env release 180–260 ms.

(En cuanto me confirmes el YAML actual de ese híbrido te lo devuelvo ya renombrado con esos valores “JP‑trance” pegables.)

2) Brass Juno puro desde A11/A31/B31
Tienes los datos crudos de fábrica en JunoPatch junoFactoryPatches[128], con cada patch como 18 bytes + sw1/sw2.
​

A11 “Brass Set 1”:

vcfFreq = 0x23, resonance = 0x0D, envAmount = 0x3A.
​

attack = 0x03, decay = 0x31, sustain = 0x2D, release = 0x20.
​

A31 “Clock Chimes 1 oct. up” y B31 “Brass” te dan extremos de brillo/ataque más percutivo para comparar, pero tu brass de referencia puede ser “A11‑ish” con el cuerpo de B31.
​

Mi propuesta de preset Omega/ACE “brass Juno puro” sería:

text
omegapresetversion: 1
id: JN-JUNO-BRASS-REF
name: JN Juno Brass Reference
author: abdeneurolab
engine: VirtualAnalog
tags: [brass,juno,roland,va]
layers:
  - id: A
    name: Juno Brass
    polyphony: 6
    voicearchitecture:
      oscillators:
        - slot: 1
          componentId: OSC-VA-001   # Juno DCO
          enabled: true
          params:
            tune: 0.0
            pulsewidth: 0.5
            sublevel: 0.4          # algo de sub, pero no exagerado
      filters:
        - slot: 1
          componentId: FLT-VA-001  # IR3109 LP24
          enabled: true
          mode: LP24
          params:
            cutoff: 2600.0         # mapea ~0x23/0x33 a Hz medio-brillante
            resonance: 0.18
            drive: 0.0
      envelopes:
        - slot: 1
          componentId: ENV-ADSR-GEN
          role: amp
          params:
            attack: 12.0           # ms, cerca de A11 (percusivo pero no click)
            decay: 220.0
            sustain: 0.65
            release: 280.0
      lfos:
        - slot: 1
          componentId: LFO-001
          params:
            rate: 0.6
            shape: sine
            delay: 0.0
      fx:
        - slot: 1
          componentId: FX-CH-001
          enabled: true
          params:
            mix: 0.35
            mode: I
    layerparams:
      levelDb: 0.0
      pan: 0.0
      mainCutoffHz: 2600.0
      mainResonance: 0.18
      envAmount: 0.55             # fuerte “brass bite”
      lfoRateHz: 0.6
      lfoDepthSemis: 0.0
      ampEnv:
        attackMs: 12.0
        decayMs: 220.0
        sustain: 0.65
        releaseMs: 280.0
modulationroutes:
  - source: ENV1
    destination: LayerA.Filter1.cutoff
    amount: 0.55
    curve: exponential
    bipolar: false
Esto te da un brass Juno polifónico, con ataque relativamente corto, decay medio y sustain moderado, alineado con los valores de A11/B31 al normalizarlos a 0–1 y mapearlos a ms/Hz.

El chorus va moderado para que sea una referencia “seca usable” y no se coma el transitorio.
​

¿Prefieres que ese brass Juno de referencia sea un poco más lento y “pad‑brass” (más cerca de B55 “Brass Ensemble”) o mantenerlo claramente percutivo como A11?

Te dejo los dos brass como presets Omega/ACE listos para pegar.

JN-BRASS-A11 (percusivo tipo A11)
Basado en A11 “Brass Set 1”: cutoff medio, env fuerte al filtro, ataque corto.
​

