// DSP/VA/FilterPoolJunoIR3109.h
#pragma once
#include <cstdint>
#include "DSP/Voices/VoiceRuntimeVA.h"

namespace OmegaDSP::VA
{
    class FilterPoolJunoIR3109
    {
    public:
        void prepare(double sampleRate) noexcept;
        void reset() noexcept;

        void process(std::uint16_t voiceIndex,
                     float* interleavedStereo,
                     int numSamples,
                     float cutoffHz,
                     float resonance,
                     float drive) noexcept;

    private:
        double sampleRate {44100.0};
        // Un filtro por voz
    };
}
