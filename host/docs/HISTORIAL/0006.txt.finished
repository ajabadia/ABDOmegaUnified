Puedes usar exactamente el mismo pipeline que con el pad: OmegaPreset::fromYaml → AceValidator → VoiceFactory → tu engine VA, sin tocar nada más.

¿Quieres que el próximo paso sea añadir un test que cargue este brass, dispare una nota y compare su envolvente RMS con la del pad para asegurar que el brass tiene más “punch” (decay pronunciado) que el pad?


Puedes montar un test muy simple que compare la “forma” de la envolvente de salida del pad vs el brass midiendo energía al inicio y en la parte sostenida del bloque.
​

1) Estructura básica del test
cpp
// Tests/TestVA_Juno_PadVsBrass.cpp
#include <catch2/catch_test_macros.hpp>
#include <juce_audio_basics/juce_audio_basics.h>
#include "Core/Ace/AceCatalog.h"
#include "Core/Ace/AceValidator.h"
#include "Core/Preset/OmegaPreset.h"
#include "DSP/Voices/VoiceRuntimeVA.h"
#include "DSP/Voices/VoiceFactory.h"
#include "DSP/Engines/VirtualAnalogEngine.h"

using namespace OmegaAce;
using namespace OmegaPresetNS;
using namespace OmegaDSP::Engines;
using namespace OmegaDSP::Voices;

static const char* kJunoPadYaml = R"YAML(
... tu ACE-JUNO-BASIC-PAD ...
)YAML";

static const char* kJunoBrassYaml = R"YAML(
... ACE-JUNO-BASIC-BRASS de antes ...
)YAML";

namespace
{
    float rmsSegment(const juce::AudioBuffer<float>& buf, int start, int len)
    {
        const int n = juce::jmin(len, buf.getNumSamples() - start);
        double acc = 0.0;
        for (int ch = 0; ch < buf.getNumChannels(); ++ch)
        {
            const float* d = buf.getReadPointer(ch);
            for (int i = 0; i < n; ++i)
            {
                const float s = d[start + i];
                acc += double(s) * double(s);
            }
        }
        return n > 0 ? std::sqrt(float(acc / (n * buf.getNumChannels()))) : 0.0f;
    }

    void renderPresetBlock(const char* yaml,
                           juce::AudioBuffer<float>& buffer,
                           int numSamples)
    {
        auto catalog = AceCatalog::createFromResources();
        REQUIRE(catalog != nullptr);

        OmegaPreset preset = OmegaPreset::fromYaml(juce::String{yaml});
        AceValidator validator{*catalog};
        auto report = validator.validateAndRepairPreset(preset);
        REQUIRE(report.status != ValidationStatus::Invalid);

        auto layers = preset.getLayers();
        REQUIRE(layers.size() == 1);
        auto layerA = layers[0];

        VoicePoolVA voicePool;
        voicePool.prepare(44100.0, numSamples);
        auto rt = VoiceFactory::createRuntimeFromPresetLayer(layerA, *catalog, voicePool);

        VirtualAnalogEngine engine;
        engine.prepare(44100.0, numSamples);
        engine.setVoiceArchitecture(rt);

        // Activar una voz
        auto& v0 = voicePool.getVoice(0);
        v0.state.midiNote.store(60, std::memory_order_relaxed);
        v0.state.velocity.store(1.0f, std::memory_order_relaxed);
        v0.state.active.store(true, std::memory_order_release);

        buffer.setSize(2, numSamples);
        buffer.clear();
        juce::MidiBuffer midi;
        engine.renderNextBlock(buffer, midi);
    }
}

TEST_CASE("Juno brass tiene más punch que pad (envolvente)", "[va][juno][brass]")
{
    const int numSamples = 2048; // ~46 ms a 44.1K

    juce::AudioBuffer<float> bufPad, bufBrass;
    renderPresetBlock(kJunoPadYaml,   bufPad,   numSamples);
    renderPresetBlock(kJunoBrassYaml, bufBrass, numSamples);

    // Mide RMS en la parte inicial y en una zona posterior
    const int segLen   = 256; // ~6 ms
    const float padAttackRms   = rmsSegment(bufPad,   0,       segLen);
    const float padSustainRms  = rmsSegment(bufPad,   512,     segLen);
    const float brassAttackRms = rmsSegment(bufBrass, 0,       segLen);
    const float brassSustainRms= rmsSegment(bufBrass, 512,     segLen);

    // 1) El brass debe tener un pico inicial relativamente más fuerte que su sustain
    REQUIRE(brassAttackRms > brassSustainRms * 1.2f);

    // 2) El pad debería ser más equilibrado (menos diferencia)
    REQUIRE(padAttackRms <= padSustainRms * 1.5f);

    // 3) Comparado entre sí, el "punch ratio" del brass debe ser > que el del pad
    const float brassRatio = brassAttackRms / (brassSustainRms + 1.0e-6f);
    const float padRatio   = padAttackRms   / (padSustainRms   + 1.0e-6f);

    REQUIRE(brassRatio > padRatio);
}
Este test no comprueba afinación ni color, pero sí que tu brass tiene un ataque claramente más marcado (más energía al inicio que en la zona media) que el pad usando exactamente tu engine y presets YAML.

¿Te interesa que el siguiente paso sea un test similar pero centrado en la envolvente del filtro (comparando, por ejemplo, energía por bandas con un pequeño análisis FFT para ver que el brass abre más agudos al inicio)?


Se puede hacer, pero es fácil pasarse de scope; te propongo una versión muy ligera que sólo mira “agudos al inicio vs después” para pad y brass.

Idea del test
Renderizar un bloque corto para pad y brass.

Dividir en dos segmentos: ataque y “sustain”.

Pasar cada segmento por un filtro pasa‑altos sencillo (o restar un LP 2‑pole) para aproximar la energía de agudos.

Comprobar:

Brass: más energía de agudos al inicio que en el segmento medio.

Brass abre más que el pad en el ataque.

Esbozo de test (sin FFT pesada)
cpp
// Tests/TestVA_Juno_FilterEnv_PadVsBrass.cpp
#include <catch2/catch_test_macros.hpp>
#include <juce_audio_basics/juce_audio_basics.h>
#include "Core/Ace/AceCatalog.h"
#include "Core/Ace/AceValidator.h"
#include "Core/Preset/OmegaPreset.h"
#include "DSP/Voices/VoiceRuntimeVA.h"
#include "DSP/Voices/VoiceFactory.h"
#include "DSP/Engines/VirtualAnalogEngine.h"

using namespace OmegaAce;
using namespace OmegaPresetNS;
using namespace OmegaDSP::Engines;
using namespace OmegaDSP::Voices;

static const char* kJunoPadYaml = R"YAML(
... ACE-JUNO-BASIC-PAD ...
)YAML";

static const char* kJunoBrassYaml = R"YAML(
... ACE-JUNO-BASIC-BRASS ...
)YAML";

namespace
{
    // HP 1‑pole simple para aproximar “agudos”
    struct SimpleHP
    {
        void prepare(double sampleRate, float cutoffHz)
        {
            const float x = std::exp(-2.0f * float(M_PI) * cutoffHz / float(sampleRate));
            a = x;
            b = (1.0f + x) * 0.5f; // muy aproximado; nos vale para test relativo
            z = 0.0f;
        }

        float process(float x)
        {
            const float y = b * x - b * z + a * z;
            z = x;
            return y;
        }

        float a {0.0f}, b {0.0f}, z {0.0f};
    };

    float highBandRMS(const juce::AudioBuffer<float>& buf,
                      int start,
                      int len,
                      double sampleRate,
                      float cutoffHz)
    {
        const int n = juce::jmin(len, buf.getNumSamples() - start);
        if (n <= 0)
            return 0.0f;

        SimpleHP hpL, hpR;
        hpL.prepare(sampleRate, cutoffHz);
        hpR.prepare(sampleRate, cutoffHz);

        double acc = 0.0;
        const int chs = buf.getNumChannels();
        const float* l = buf.getReadPointer(0);
        const float* r = chs > 1 ? buf.getReadPointer(1) : nullptr;

        for (int i = 0; i < n; ++i)
        {
            const float inL = l[start + i];
            const float inR = r ? r[start + i] : inL;

            const float yL = hpL.process(inL);
            const float yR = hpR.process(inR);

            acc += double(yL) * double(yL);
            acc += double(yR) * double(yR);
        }

        return std::sqrt(float(acc / (n * 2)));
    }

    void renderPresetBlock(const char* yaml,
                           juce::AudioBuffer<float>& buffer,
                           int numSamples)
    {
        constexpr double sampleRate = 44100.0;

        auto catalog = AceCatalog::createFromResources();
        REQUIRE(catalog != nullptr);

        OmegaPreset preset = OmegaPreset::fromYaml(juce::String{yaml});
        AceValidator validator{*catalog};
        auto report = validator.validateAndRepairPreset(preset);
        REQUIRE(report.status != ValidationStatus::Invalid);

        auto layers = preset.getLayers();
        REQUIRE(layers.size() == 1);
        auto layerA = layers[0];

        VoicePoolVA voicePool;
        voicePool.prepare(sampleRate, numSamples);
        auto rt = VoiceFactory::createRuntimeFromPresetLayer(layerA, *catalog, voicePool);

        VirtualAnalogEngine engine;
        engine.prepare(sampleRate, numSamples);
        engine.setVoiceArchitecture(rt);

        auto& v0 = voicePool.getVoice(0);
        v0.state.midiNote.store(60, std::memory_order_relaxed);
        v0.state.velocity.store(1.0f, std::memory_order_relaxed);
        v0.state.active.store(true, std::memory_order_release);

        buffer.setSize(2, numSamples);
        buffer.clear();
        juce::MidiBuffer midi;
        engine.renderNextBlock(buffer, midi);
    }
}

TEST_CASE("Juno brass abre más agudos que pad (filter env)", "[va][juno][brass][filter]")
{
    constexpr double sampleRate = 44100.0;
    const int numSamples = 4096; // ~93 ms

    juce::AudioBuffer<float> bufPad, bufBrass;
    renderPresetBlock(kJunoPadYaml,   bufPad,   numSamples);
    renderPresetBlock(kJunoBrassYaml, bufBrass, numSamples);

    const int segLen = 512; // ~11.6 ms
    const int attackStart  = 0;
    const int midStart     = 2048; // ~46 ms, ya entrando en sustain

    const float cutoffHP = 3000.0f; // mirar “por encima” de 3 kHz aprox.

    // Brass: agudos al inicio y en zona media
    const float brassHighAttack = highBandRMS(bufBrass, attackStart, segLen, sampleRate, cutoffHP);
    const float brassHighMid    = highBandRMS(bufBrass, midStart,   segLen, sampleRate, cutoffHP);

    // Pad
    const float padHighAttack   = highBandRMS(bufPad, attackStart,  segLen, sampleRate, cutoffHP);
    const float padHighMid      = highBandRMS(bufPad, midStart,     segLen, sampleRate, cutoffHP);

    // 1) Brass: más brillo al ataque que en el medio
    REQUIRE(brassHighAttack > brassHighMid * 1.2f);

    // 2) Pad: menos contraste de agudos
    const float padRatio   = padHighAttack   / (padHighMid   + 1.0e-6f);
    const float brassRatio = brassHighAttack / (brassHighMid + 1.0e-6f);

    REQUIRE(brassRatio > padRatio);
}
Este test:

Usa tu engine y presets tal cual.

No necesita FFT ni librerías extra, sólo un HP 1‑pole para estimar el contenido de agudos.

Verifica que la envolvente de filtro del brass abre más agudos al ataque que el pad, y que ese “contraste” es mayor en brass.

¿Quieres que el próximo paso sea centrarte ya en MIDI/VoiceManager (note on/off reales) para disparar estos sonidos desde el host en lugar de activar voces manualmente en los tests?


Puedes arrancar con un VoiceManager muy simple (round‑robin sin stealing sofisticado) que asigne voces de tu VoicePoolVA a los note‑on/note‑off de JUCE y llame a noteOn/noteOff de tu ADSR por voz.
​

1) VoiceManager mínimo
cpp
// Core/Voices/VoiceManager.h
#pragma once
#include "DSP/Voices/VoiceRuntimeVA.h"
#include "DSP/Voices/VoiceArchitectureRuntimeVA.h"

class VoiceManager
{
public:
    void prepare(int numVoices) noexcept
    {
        totalVoices = numVoices;
        currentVoice = 0;
    }

    void noteOn(int midiNote, float velocity,
                OmegaDSP::Voices::VoicePoolVA& pool) noexcept
    {
        const int v = currentVoice;
        currentVoice = (currentVoice + 1) % totalVoices;

        auto& voice = pool.getVoice(v);
        voice.state.midiNote.store(midiNote, std::memory_order_relaxed);
        voice.state.velocity.store(velocity, std::memory_order_relaxed);
        voice.state.active.store(true, std::memory_order_release);

        voice.ampEnv.noteOn();
    }

    void noteOff(int midiNote,
                 OmegaDSP::Voices::VoicePoolVA& pool) noexcept
    {
        for (int v = 0; v < totalVoices; ++v)
        {
            auto& voice = pool.getVoice(v);
            const int note = voice.state.midiNote.load(std::memory_order_relaxed);
            if (note == midiNote && voice.state.active.load(std::memory_order_acquire))
            {
                voice.ampEnv.noteOff();
            }
        }
    }

private:
    int totalVoices {0};
    int currentVoice {0};
};
(Asumo que ya integraste el ampEnv por voz y sus métodos noteOn/noteOff.)
​

2) Integración en el AudioProcessor
En tu processor:

cpp
class OmegaAudioProcessor : public juce::AudioProcessor
{
    ...
    VoiceManager voiceManager;
    OmegaDSP::Engines::VirtualAnalogEngine engine;
    ...
};
En prepareToPlay:

cpp
void OmegaAudioProcessor::prepareToPlay(double sampleRate, int samplesPerBlock)
{
    engine.prepare(sampleRate, samplesPerBlock);

    // tras construir VoiceArchitectureRuntimeVA desde preset:
    const int numVoices = engine.getVoiceArchitecture().numVoices;
    voiceManager.prepare(numVoices);
}
En processBlock procesa MIDI y delega al engine:

cpp
void OmegaAudioProcessor::processBlock(juce::AudioBuffer<float>& buffer,
                                       juce::MidiBuffer& midiMessages)
{
    for (const auto metadata : midiMessages)
    {
        const auto msg = metadata.getMessage();

        if (msg.isNoteOn())
        {
            const int note = msg.getNoteNumber();
            const float vel = msg.getFloatVelocity();
            voiceManager.noteOn(note, vel, engine.getVoicePool());
        }
        else if (msg.isNoteOff())
        {
            const int note = msg.getNoteNumber();
            voiceManager.noteOff(note, engine.getVoicePool());
        }
    }

    engine.renderNextBlock(buffer, midiMessages);
}
Con esto ya podrás tocar tus presets Juno pad/brass desde el DAW con asignación de voces real (aunque simple) y tus ADSR se dispararán correctamente.
​

¿Quieres que el siguiente paso sea añadir soporte básico de pitch bend y wheel (CC1 → LFO depth) en este mismo esquema?


Para el MVP, puedes añadir soporte de pitch bend global (±2 semitonos) y mod wheel → profundidad de LFO con cambios mínimos en tu processor y engine.

1) Pitch bend: de MIDI a semitonos
En tu OmegaAudioProcessor::processBlock, captura pitch bend:

cpp
float pitchBendSemis {0.0f};      // miembro del processor
float pitchBendRangeSemis {2.0f}; // ±2 semitonos típico GM

void OmegaAudioProcessor::processBlock(juce::AudioBuffer<float>& buffer,
                                       juce::MidiBuffer& midiMessages)
{
    for (const auto metadata : midiMessages)
    {
        const auto msg = metadata.getMessage();

        if (msg.isPitchWheel())
        {
            const int value14 = msg.getPitchWheelValue(); // 0..16383
            const int centered = value14 - 8192;          // -8192..+8191
            const float norm = centered / 8192.0f;        // -1..+1

            pitchBendSemis = norm * pitchBendRangeSemis;  // -range..+range
            engine.setPitchBendSemitones(pitchBendSemis);
        }
        else if (msg.isNoteOn())
        {
            ...
        }
        else if (msg.isNoteOff())
        {
            ...
        }
    }

    engine.renderNextBlock(buffer, midiMessages);
}
En el engine:

cpp
// VirtualAnalogEngine.h
float globalPitchBendSemis {0.0f};

void setPitchBendSemitones(float semis) noexcept
{
    globalPitchBendSemis = semis;
}
Y en renderNextBlock, al calcular baseHz por voz:

cpp
const int midiNote = voice.state.midiNote.load(std::memory_order_relaxed);
const float baseNoteSemis = float(midiNote - 69) + globalPitchBendSemis;
const float baseHz = 440.0f * std::pow(2.0f, baseNoteSemis / 12.0f);
Con esto el wheel de pitch del host doblará ligeramente el Juno hacia arriba/abajo según estándar GM.

2) Mod wheel (CC1) → profundidad de vibrato
Decide que CC1 controle lfoDepthSemis (macro que ya tienes).
​
​
​

En el processor:

cpp
float modWheel01 {0.0f}; // 0..1

void OmegaAudioProcessor::processBlock(...)
{
    for (const auto metadata : midiMessages)
    {
        const auto msg = metadata.getMessage();

        if (msg.isController() && msg.getControllerNumber() == 1)
        {
            const float v01 = msg.getControllerValue() / 127.0f;
            modWheel01 = v01;

            // Profundidad máxima de vibrato desde preset/macro, ej. 0.3 semis
            const float maxDepth = mLayerASettings.lfoDepthSemitones.load(std::memory_order_relaxed);
            const float currentDepth = v01 * maxDepth;

            engine.setLfoDepthSemitones(currentDepth);
        }
        ...
    }

    engine.renderNextBlock(buffer, midiMessages);
}
En el engine, un simple setter:

cpp
// VirtualAnalogEngine.h
float lfoDepthSemisCurrent {0.0f};
void setLfoDepthSemitones(float semis) noexcept
{
    lfoDepthSemisCurrent = semis;
}
Y donde calculas vibrato en el DCO (si ya estás usando LFO por voz), sustituye el depth fijo del preset por lfoDepthSemisCurrent. Por ejemplo:

cpp
// por bloque o por sample, según tu implementación del LFO
const float depthSemis = lfoDepthSemisCurrent; // controlado por wheel
const float lfoValue   = lfoBuffer[i];         // -1..1

const float modSemis = lfoValue * depthSemis;
const float pitchSemis = baseNoteSemis + voice.oscTuneSemis + modSemis;
const float freqHz = 440.0f * std::pow(2.0f, pitchSemis / 12.0f);
Así CC1 a cero → sin vibrato; CC1 a tope → vibrato máximo definido por el preset, que es justo el comportamiento típico “wheel controla LFO depth”.
​
​

¿Quieres que el siguiente paso sea fijar un test rápido que verifique que mover pitch bend modifica la frecuencia media del bloque y que mover el mod wheel incrementa el rango de oscilación del pitch (vibrato) en la salida?


Puedes cubrirlo con dos tests numéricos muy simples: uno para pitch bend (cambio de frecuencia media) y otro para wheel→vibrato (cambio de rango de variación).

1) Test: pitch bend cambia la frecuencia media
Idea: renderizar un bloque con nota fija, comparar RMS de derivada de fase/periodicidad no es trivial sin FFT, pero podemos comparar periodo aparente midiendo cruces por cero, o más sencillo: medir la frecuencia estimada vía autocorrelación muy básica; para un MVP basta comparar el centro de masa espectral aproximado con un filtro all‑pass es complicado. Para mantenerlo ligero, haz esto:

Render sin pitch bend (0).

Render con pitch bend +2 semis.

Mide la frecuencia dominante vía conteo de muestras entre cruces por cero (asumiendo sierra monofónica limpia).

Esbozo:

cpp
// Tests/TestVA_PitchBendAndModWheel.cpp
#include <catch2/catch_test_macros.hpp>
#include <juce_audio_basics/juce_audio_basics.h>
#include "Core/Ace/AceCatalog.h"
#include "Core/Ace/AceValidator.h"
#include "Core/Preset/OmegaPreset.h"
#include "DSP/Voices/VoiceRuntimeVA.h"
#include "DSP/Voices/VoiceFactory.h"
#include "DSP/Engines/VirtualAnalogEngine.h"

using namespace OmegaAce;
using namespace OmegaPresetNS;
using namespace OmegaDSP::Engines;
using namespace OmegaDSP::Voices;

static const char* kJunoPadYaml = R"YAML(
... ACE-JUNO-BASIC-PAD ...
)YAML";

namespace
{
    void setupEngineForPreset(const char* yaml,
                              VirtualAnalogEngine& engine,
                              VoicePoolVA& voicePool,
                              int numSamples)
    {
        auto catalog = AceCatalog::createFromResources();
        REQUIRE(catalog != nullptr);

        OmegaPreset preset = OmegaPreset::fromYaml(juce::String{yaml});
        AceValidator validator{*catalog};
        auto report = validator.validateAndRepairPreset(preset);
        REQUIRE(report.status != ValidationStatus::Invalid);

        auto layers = preset.getLayers();
        REQUIRE(layers.size() == 1);
        auto layerA = layers[0];

        voicePool.prepare(44100.0, numSamples);
        auto rt = VoiceFactory::createRuntimeFromPresetLayer(layerA, *catalog, voicePool);

        engine.prepare(44100.0, numSamples);
        engine.setVoiceArchitecture(rt);

        auto& v0 = voicePool.getVoice(0);
        v0.state.midiNote.store(60, std::memory_order_relaxed);
        v0.state.velocity.store(1.0f, std::memory_order_relaxed);
        v0.state.active.store(true, std::memory_order_release);
    }

    int estimatePeriodSamples(const juce::AudioBuffer<float>& buf)
    {
        const float* d = buf.getReadPointer(0);
        const int N = buf.getNumSamples();

        // busca dos cruces por cero ascendentes consecutivos
        int first = -1, second = -1;

        for (int i = 1; i < N; ++i)
        {
            if (d[i - 1] <= 0.0f && d[i] > 0.0f)
            {
                if (first < 0)
                    first = i;
                else
                {
                    second = i;
                    break;
                }
            }
        }

        if (first >= 0 && second > first)
            return second - first;

        return 0;
    }
}

// Pitch bend: +2 semis debe reducir el periodo
TEST_CASE("Pitch bend modifica claramente la frecuencia", "[va][midi][pitchbend]")
{
    constexpr double sampleRate = 44100.0;
    const int numSamples = 4096;

    VirtualAnalogEngine engineNoPB, enginePB;
    VoicePoolVA poolNoPB, poolPB;

    setupEngineForPreset(kJunoPadYaml, engineNoPB, poolNoPB, numSamples);
    setupEngineForPreset(kJunoPadYaml, enginePB,  poolPB,  numSamples);

    juce::AudioBuffer<float> bufNoPB(2, numSamples);
    juce::AudioBuffer<float> bufPB(2, numSamples);
    juce::MidiBuffer midi;

    // Sin pitch bend
    engineNoPB.setPitchBendSemitones(0.0f);
    bufNoPB.clear();
    engineNoPB.renderNextBlock(bufNoPB, midi);

    // Con pitch bend +2 semis
    enginePB.setPitchBendSemitones(2.0f);
    bufPB.clear();
    enginePB.renderNextBlock(bufPB, midi);

    const int periodNoPB = estimatePeriodSamples(bufNoPB);
    const int periodPB   = estimatePeriodSamples(bufPB);

    REQUIRE(periodNoPB > 0);
    REQUIRE(periodPB > 0);

    // A +2 semis la frecuencia sube -> periodo baja ~ factor 2^(−2/12)
    REQUIRE(periodPB < periodNoPB);
}
2) Test: mod wheel aumenta la profundidad de vibrato
Idea:

Render dos bloques con LFO activo:

Wheel a 0 → lfoDepthSemisCurrent = 0.

Wheel a 1 → lfoDepthSemisCurrent = maxDepth (ej. 0.3).

Para cada buffer, medir la desviación del pitch aparente en el tiempo: como aproximación, mide la desviación estándar de la muestra tras pasar un BP alrededor de la fundamental, pero eso es pesado; más simple: mide el rango de movimiento del valor instantáneo tras restar la media, que se correlaciona con profundidad de vibrato.

En MVP: como vibrato está en pitch pero se refleja en audio, podemos usar la desviación estándar del audio como proxy: a más vibrato, la señal se “mueve” más alrededor del tono, pero la diferencia puede ser sutil. Una forma más robusta:

Render un bloque más largo.

Para cada pequeño segmento, estimar el periodo (como antes) y guardar 
1
/
periodo
1/periodo como frecuencia.

Calcular el rango (max‑min) de esa frecuencia estimada para wheel 0 y wheel 1; el de wheel 1 debe ser mayor.

Esbozo muy simplificado (sin hacer demasiado costoso):

cpp
namespace
{
    std::vector<float> estimateFreqTrace(const juce::AudioBuffer<float>& buf,
                                         int windowSize,
                                         int hop)
    {
        std::vector<float> freqs;
        const int N = buf.getNumSamples();
        for (int start = 0; start + windowSize < N; start += hop)
        {
            juce::AudioBuffer<float> sub(1, windowSize);
            sub.copyFrom(0, 0, buf, 0, start, windowSize);
            const int period = estimatePeriodSamples(sub);
            if (period > 0)
            {
                const float f = 44100.0f / float(period);
                freqs.push_back(f);
            }
        }
        return freqs;
    }

    float rangeOf(const std::vector<float>& xs)
    {
        if (xs.empty()) return 0.0f;
        auto [mn, mx] = std::minmax_element(xs.begin(), xs.end());
        return *mx - *mn;
    }
}

// Wheel 0 vs wheel 1: rango de frecuencia aparente
TEST_CASE("Mod wheel aumenta la profundidad de vibrato", "[va][midi][modwheel]")
{
    const int numSamples = 8192;
    VirtualAnalogEngine engine0, engine1;
    VoicePoolVA pool0, pool1;

    setupEngineForPreset(kJunoPadYaml, engine0, pool0, numSamples);
    setupEngineForPreset(kJunoPadYaml, engine1, pool1, numSamples);

    juce::AudioBuffer<float> buf0(2, numSamples);
    juce::AudioBuffer<float> buf1(2, numSamples);
    juce::MidiBuffer midi;

    // Wheel 0 -> depth 0
    engine0.setLfoDepthSemitones(0.0f);
    buf0.clear();
    engine0.renderNextBlock(buf0, midi);

    // Wheel 1 -> depth máxima, p.ej. 0.3 semis
    engine1.setLfoDepthSemitones(0.3f);
    buf1.clear();
    engine1.renderNextBlock(buf1, midi);

    auto freqs0 = estimateFreqTrace(buf0, 512, 128);
    auto freqs1 = estimateFreqTrace(buf1, 512, 128);

    const float range0 = rangeOf(freqs0);
    const float range1 = rangeOf(freqs1);

    // Con vibrato, el rango de freq aparente debe ser mayor
    REQUIRE(range1 > range0 * 1.5f);
}
Estos tests no son metrológicamente perfectos, pero sí suficientes para:

Detectar que el pitch bend de tu engine realmente modifica la frecuencia.

Validar que el wheel realmente aumenta la profundidad de vibrato observable en la salida.

