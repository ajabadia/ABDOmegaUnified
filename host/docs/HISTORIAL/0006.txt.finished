1) VoiceRuntimeVA mínima para el Juno MVP
Para Fase 1 (1 DCO + 1 filtro + 1 env amp + 1 LFO + 1 chorus), yo fijaría esta struct:

cpp
// DSP/Voices/VoiceRuntimeVA.h
#pragma once
#include <array>
#include <atomic>
#include <cstdint>

namespace OmegaDSP::Voices
{
    inline constexpr int kMaxVoicesVA   = 32;
    inline constexpr int kMaxBlockSizeVA = 256;

    struct alignas(64) VoiceRuntimeVA
    {
        struct State
        {
            std::atomic<bool>  active      { false };
            std::atomic<int>   midiNote    { -1 };
            std::atomic<float> velocity    { 0.0f };
            std::atomic<float> currentGain { 0.0f };
        } state;

        // Buffer temporal por voz (stereo interleaved)
        alignas(32) std::array<float, 2 * kMaxBlockSizeVA> buffer {};

        // Índices a pools concretos
        uint16_t oscIndex  = 0;
        uint16_t fltIndex  = 0;
        uint16_t envIndex  = 0;
        uint16_t lfoIndex  = 0;
        uint16_t fxIndex   = 0;

        bool oscEnabled = true;
        bool fltEnabled = true;
        bool fxEnabled  = true;

        // Campos de DCO derivados del preset + modulación
        float oscTuneSemis  = 0.0f; // OSC-VA-001 'tune'
        float modPitchSemis = 0.0f; // suma de mods
        float oscPulseWidth = 0.5f; // 0..1
        float oscSubLevel   = 0.3f; // 0..1
    };

    class VoicePoolVA
    {
    public:
        void prepare(double /*sampleRate*/, int blockSize)
        {
            blockSize_ = (blockSize > 0 && blockSize <= kMaxBlockSizeVA)
                       ? blockSize
                       : kMaxBlockSizeVA;
            resetAll();
        }

        static constexpr int getMaxVoices() noexcept { return kMaxVoicesVA; }

        VoiceRuntimeVA& getVoice(int index) noexcept
        {
            return voices_[static_cast<size_t>(index)];
        }

        const VoiceRuntimeVA& getVoice(int index) const noexcept
        {
            return voices_[static_cast<size_t>(index)];
        }

        void resetAll() noexcept
        {
            for (auto& v : voices_)
            {
                v.state.active.store(false, std::memory_order_relaxed);
                v.state.midiNote.store(-1, std::memory_order_relaxed);
                v.state.velocity.store(0.0f, std::memory_order_relaxed);
                v.state.currentGain.store(0.0f, std::memory_order_relaxed);
                v.buffer.fill(0.0f);
            }
        }

        int getBlockSize() const noexcept { return blockSize_; }

    private:
        std::array<VoiceRuntimeVA, kMaxVoicesVA> voices_{};
        int blockSize_ = kMaxBlockSizeVA;
    };
}
2) VoiceFactory::createRuntimeFromPresetLayer (Juno MVP)
Con esa struct, el VoiceFactory mínimo para ACE-JUNO-BASIC-PAD sería:

cpp
// DSP/Voices/VoiceFactory.h
#pragma once
#include "VoiceRuntimeVA.h"
#include "Core/Preset/OmegaPreset.h"
#include "Core/Ace/AceCatalog.h"

namespace OmegaDSP::Voices
{
    struct VoiceArchitectureRuntimeVA
    {
        int numVoices = 8;
    };

    class VoiceFactory
    {
    public:
        static VoiceArchitectureRuntimeVA createRuntimeFromPresetLayer(
            const OmegaPreset::Layer&      layer,
            const OmegaAce::AceCatalog&    catalog,
            VoicePoolVA&                   voicePool)
        {
            VoiceArchitectureRuntimeVA rt{};

            // 1) Clamp polyphony a límites del engine
            int requested = layer.polyphony;
            if (requested < 1) requested = 1;
            if (requested > VoicePoolVA::getMaxVoices())
                requested = VoicePoolVA::getMaxVoices();
            rt.numVoices = requested;

            // 2) Slots del preset Juno MVP (suponemos 1 de cada)
            const auto& oscSlot = layer.voiceArch.oscillators[0];
            const auto& fltSlot = layer.voiceArch.filters[0];
            const auto& fxSlot  = layer.voiceArch.fx[0];

            // (Opcional) asegurar que los IDs existen, pero si ya pasaste AceValidator puedes asumirlo
            (void)catalog;

            // 3) Leer parámetros ACE del DCO
            auto getParam = [](const auto& paramMap, const juce::String& id, float def) -> float
            {
                if (auto it = paramMap.find(id); it != paramMap.end())
                    return it->second;
                return def;
            };

            const float tuneSemis =
                getParam(oscSlot.parameters, "tune", 0.0f);       // -24..24
            const float pwNorm =
                getParam(oscSlot.parameters, "pulsewidth", 0.5f); // 0..1
            const float subLevel =
                getParam(oscSlot.parameters, "sublevel", 0.3f);   // 0..1

            // 4) Configurar cada voz del pool
            for (int v = 0; v < rt.numVoices; ++v)
            {
                auto& voice = voicePool.getVoice(v);

                voice.state.active.store(false, std::memory_order_relaxed);
                voice.state.midiNote.store(-1, std::memory_order_relaxed);
                voice.state.velocity.store(0.0f, std::memory_order_relaxed);
                voice.state.currentGain.store(0.0f, std::memory_order_relaxed);
                voice.buffer.fill(0.0f);

                // Índices a pools (para MVP: todos usan el índice 0)
                voice.oscIndex = 0;
                voice.fltIndex = 0;
                voice.envIndex = 0;
                voice.lfoIndex = 0;
                voice.fxIndex  = 0;

                voice.oscEnabled = oscSlot.enabled;
                voice.fltEnabled = fltSlot.enabled;
                voice.fxEnabled  = fxSlot.enabled;

                // DCO: parámetros por voz
                voice.oscTuneSemis  = tuneSemis;
                voice.oscPulseWidth = pwNorm;
                voice.oscSubLevel   = subLevel;
                voice.modPitchSemis = 0.0f; // ModulationRuntime lo rellenará luego
            }

            return rt;
        }
    };
}
Con esto tienes un diseño limpio para voces VA + VoiceFactory especializado en el preset Juno MVP. Cuando más adelante añadas más osciladores/capas/engines, solo tendrás que extender estas structs, no romperlas.

¿Te apetece que el siguiente bloque lo dediquemos a fijar la firma y parámetros del filtro FLT-VA-001 (IR3109 VA) con el mismo nivel de detalle que hemos hecho para el DCO?


Entonces pasamos al filtro FLT‑VA‑001 (IR3109 VA) en el mismo espíritu que el DCO: comportamiento realista, pero VA limpio y parametrización sencilla.

1) Contrato ACE para FLT‑VA‑001
En ACE YAML (ya casi lo tienes) lo dejaría así:

text
components:
  - id: FLT-VA-001
    name: Roland IR3109 LP24
    family: Filter
    engine: VirtualAnalog
    modelId: RolandJunoIR3109
    origin: Roland Juno-106
    status: active
