        unit: Hz
      - id: res
        label: Resonance
        unit: norm
2) Clase DSP C++ para FLT‑VA‑001 (VA ladder 4‑pole)
Un VA estable y barato (Topologically‑Preserving Transform tipo “ladder 4P” simplificado) con cutoff y reso normalizada 0..1:

cpp
// DSP/VA/FilterIr3109VA.h
#pragma once
#include <algorithm>
#include <cmath>

namespace OmegaDSP::VA
{
    class FilterIr3109VA
    {
    public:
        void prepare(double sampleRate) noexcept
        {
            sr = sampleRate > 0.0 ? sampleRate : 44100.0;
            reset();
        }

        void reset() noexcept
        {
            y1 = y2 = y3 = y4 = 0.0f;
            z1 = z2 = z3 = z4 = 0.0f;
        }

        // cutoffHz: 20..20000
        // resonance: 0..1 approx (0 = no reso, 1 ~ autoosc)
        // driveDb: -12..+24 dB simple pre-gain
        void process(float* stereoInterleaved,
                     int numSamples,
                     float cutoffHz,
                     float resonance,
                     float driveDb) noexcept
        {
            if (!stereoInterleaved || numSamples <= 0)
                return;

            const float f = std::clamp(cutoffHz, 20.0f, 20000.0f);
            const float g = computeG(f);
            const float k = computeK(resonance);
            const float drive = dbToLin(driveDb);

            for (int i = 0; i < numSamples; ++i)
            {
                float inL = stereoInterleaved[2 * i + 0] * drive;
                float inR = stereoInterleaved[2 * i + 1] * drive;

                float outL = processSample(inL, g, k);
                float outR = processSample(inR, g, k);

                stereoInterleaved[2 * i + 0] = outL;
                stereoInterleaved[2 * i + 1] = outR;
            }
        }

    private:
        double sr {44100.0};

        // Estado de las 4 etapas y memoria para TPT
        float y1{}, y2{}, y3{}, y4{};
        float z1{}, z2{}, z3{}, z4{};

        static float dbToLin(float db) noexcept
        {
            return std::pow(10.0f, db / 20.0f);
        }

        // Factor de integrador TPT (VA biquad-style)
        float computeG(float cutoffHz) const noexcept
        {
            const float wc = 2.0f * float(M_PI) * cutoffHz / float(sr);
            return wc / (1.0f + wc); // aproximación simple
        }

        // Mapear resonance 0..1 a realimentación k ~ 0..4
        float computeK(float resonance) const noexcept
        {
            float r = std::clamp(resonance, 0.0f, 1.0f);
            // Suavizar: que 0.7 sea ya bastante pronunciado
            r = r * r;
            return 4.0f * r;
        }

        float processSample(float x, float g, float k) noexcept
        {
            // TPT 4-pole ladder simplificado (no exacto a IR3109, pero cercano)
            const float u = (x - k * y4); // entrada con realimentación

            // Etapa 1
            float v1 = (u - y1) * g;
            float s1 = v1 + y1;
            y1 = s1;

            // Etapa 2
            float v2 = (s1 - y2) * g;
            float s2 = v2 + y2;
            y2 = s2;

            // Etapa 3
            float v3 = (s2 - y3) * g;
            float s3 = v3 + y3;
            y3 = s3;

            // Etapa 4
            float v4 = (s3 - y4) * g;
            float s4 = v4 + y4;
            y4 = s4;

            return s4;
        }
    };
}
3) Pool de filtros VA y uso en el engine
Pool para mapear voice.fltIndex a una instancia:

cpp
// DSP/VA/FilterPoolIr3109VA.h
#pragma once
#include <array>
#include "FilterIr3109VA.h"
#include "DSP/Voices/VoiceRuntimeVA.h"

namespace OmegaDSP::VA
{
    class FilterPoolIr3109VA
    {
    public:
        void prepare(double sampleRate)
        {
            for (auto& f : filters)
                f.prepare(sampleRate);
        }

        void processVoice(uint16_t voiceIndex,
                          float* stereoInterleaved,
                          int numSamples,
                          float cutoffHz,
                          float resonance,
                          float driveDb) noexcept
        {
            filters[voiceIndex].process(stereoInterleaved,
                                        numSamples,
                                        cutoffHz,
                                        resonance,
                                        driveDb);
        }

    private:
        std::array<FilterIr3109VA, OmegaDSP::Voices::kMaxVoicesVA> filters;
    };
}
Y en tu VirtualAnalogEngine::renderNextBlock, después del DCO:

cpp
// Leer macros de layer + mods para cutoff/res; aquí solo ejemplo simple
